NODE_ENV=development
PORT=3100
MONGODB_URI=mongodb://127.0.0.1:27017/findoly_b2b
APP_NAME=Findoly B2B Admin
AUTH_COOKIE_NAME=findoly_b2b_admin
AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
B2B_BOOTSTRAP_MOBILE=9000000000
B2B_BOOTSTRAP_NAME=B2B Administrator
B2B_OTP_BASE_URL=https://api.findoly.com/otp
B2B_OTP_SEND_URL=
B2B_OTP_VERIFY_URL=
B2B_OTP_API_TOKEN=
B2B_OTP_TIMEOUT_MS=12000
CORS_ORIGINS=http://localhost:3100
TRUST_PROXY=1
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_PUBLIC_PREFIX=public/b2b/
AWS_S3_PRIVATE_PREFIX=private/b2b/
AWS_CLOUDFRONT_DOMAIN=
S3_MAX_UPLOAD_MB=20

API_RATE_LIMIT_PER_MINUTE=180
OTP_SEND_LIMIT=5
OTP_VERIFY_LIMIT=10
