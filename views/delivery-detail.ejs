<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Delivery workflow</div><h1 class="page-title mb-1">Delivery detail</h1><p class="crm-page-subtitle mb-0">Order, warehouse, products, driver and status history in one connected record.</p></div><div class="d-flex gap-2"><a class="btn btn-light" href="/delivery">Back</a><% if (can('delivery.update')) { %><a class="btn btn-primary" x-show="delivery&&allowedStatuses(delivery.status).length" :href="'/delivery/'+delivery?.deliveryAssignmentId+'/update'">Continue delivery</a><% } %></div></div></div>
<div class="content" x-data="deliveryDetailPage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<template x-if="loading"><div class="card crm-data-card"><div class="card-body"><div class="crm-table-loading"><span></span><span></span><span></span></div></div></div></template>
<div x-show="delivery&&!loading" x-cloak>
<div class="row g-4">
<div class="col-xl-8"><div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1"><span x-text="delivery?.orderNumber"></span></h2><p class="text-muted mb-0" x-text="delivery?.customerSnapshot?.businessName||''"></p></div><span class="crm-status" :class="statusClass(delivery?.status)" x-text="humanize(delivery?.status)"></span></div><div class="card-body">
<div class="row g-3 mb-4"><div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Warehouse</div><strong x-text="delivery?.warehouseSnapshot?.name||'—'"></strong><div class="text-muted" x-text="joinTruthy([delivery?.warehouseSnapshot?.code,addressText(delivery?.warehouseSnapshot?.address)])"></div></div></div><div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Delivery destination</div><strong x-text="addressText(delivery?.deliveryAddressSnapshot)"></strong></div></div></div>
<h3 class="h6">Products in this delivery</h3><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>SKU</th><th class="text-end">Qty</th><th class="text-end">Delivered</th><th class="text-end">Returned</th></tr></thead><tbody><template x-for="line in delivery?.lines||[]" :key="line.deliveryLineId"><tr><td><a :href="'/products/'+line.productId" x-text="line.productName"></a></td><td x-text="line.sku"></td><td class="text-end" x-text="line.quantity"></td><td class="text-end" x-text="line.deliveredQty||0"></td><td class="text-end" x-text="line.returnedQty||0"></td></tr></template></tbody></table></div>
</div></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Delivery history</h2><p class="text-muted mb-0">Every status change is recorded with actor and note.</p></div></div><div class="card-body"><div class="d-grid gap-3"><template x-for="event in reverseCopy(delivery?.events||[])" :key="event.deliveryEventId"><div class="border rounded p-3"><div class="d-flex justify-content-between gap-2"><strong x-text="humanize(event.status)"></strong><span class="text-muted fs-sm" x-text="formatDate(event.at)"></span></div><div class="text-muted fs-sm" x-text="'By '+(event.actorId||'System')"></div><div class="mt-1" x-show="event.note" x-text="event.note"></div></div></template></div></div></div></div>
<div class="col-xl-4"><div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><h2 class="card-title mb-0">Delivery person</h2></div><div class="card-body"><dl class="row mb-0"><dt class="col-5">Type</dt><dd class="col-7" x-text="humanize(delivery?.deliveryType)"></dd><dt class="col-5">Provider</dt><dd class="col-7" x-text="delivery?.deliveryProviderName||'—'"></dd><dt class="col-5">Person</dt><dd class="col-7" x-text="delivery?.driverName||'—'"></dd><dt class="col-5">Mobile</dt><dd class="col-7" x-text="delivery?.driverMobile||'—'"></dd><dt class="col-5">Tracking ref</dt><dd class="col-7" x-text="delivery?.externalReference||'—'"></dd></dl><a x-show="safeTrackingHref(delivery?.trackingUrl)" class="btn btn-light btn-sm mt-3" :href="safeTrackingHref(delivery?.trackingUrl)" target="_blank" rel="noopener noreferrer">Open tracking</a></div></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><h2 class="card-title mb-0">Collection</h2></div><div class="card-body"><div class="d-flex justify-content-between mb-2"><span>Expected</span><strong x-text="money(delivery?.expectedCollectionPaise)"></strong></div><div class="d-flex justify-content-between mb-2"><span>Collected</span><strong x-text="money(delivery?.collectedPaise)"></strong></div><div class="d-flex justify-content-between"><span>Mode</span><strong x-text="humanize(delivery?.collectionMode||'not_recorded')"></strong></div></div></div></div>
</div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function deliveryDetailPage(){return{delivery:null,loading:true,error:'',transitionMap:{assigned:['picked_up','cancelled'],picked_up:['out_for_delivery','cancelled'],out_for_delivery:['delivered','partially_delivered','failed','returned'],failed:['out_for_delivery','returned'],delivered:[],partially_delivered:[],returned:[],cancelled:[]},id(){return decodeURIComponent(location.pathname.split('/').filter(Boolean)[1]||'')},allowedStatuses(s){return this.transitionMap[s]||[]},safeTrackingHref(value){try{const u=new URL(String(value||''),location.origin);return['http:','https:'].includes(u.protocol)?u.href:''}catch(_){return''}},addressText(a){if(!a)return'—';return[a.line1,a.line2,a.city,a.state,a.pincode].filter(Boolean).join(', ')||'—'},async load(){try{this.delivery=(await apiFetch('/api/delivery/'+this.id())).data}catch(e){this.error=e.message}finally{this.loading=false}}}}</script><%- include('partials/scripts') %>
</body></html>
