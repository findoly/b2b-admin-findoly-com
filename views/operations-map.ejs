<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Distribution network</div><h1 class="page-title mb-1">Operations map</h1><p class="crm-page-subtitle mb-0">Customers, warehouses and supplier locations, together.</p></div></div></div>
<div class="content" x-data="operationsMapPage()" x-init="load()" @b2b:map-error.window="mapError='Google Maps could not authenticate. The location list remains available.'">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" role="alert" x-text="error"></div>
<div class="card"><div class="card-body"><form class="d-flex gap-2 flex-wrap" @submit.prevent="loadRows()"><input class="form-control crm-search-input" x-model="search" placeholder="Search business, city or pincode" aria-label="Search locations"><select class="form-select crm-compact-select" x-model="filter" @change="changeFilter()" aria-label="Location filter"><option value="all">All loaded locations</option><option value="missing">Location missing</option></select><button class="btn btn-primary" :disabled="loading">Search</button><button type="button" class="btn btn-light" @click="clearRecordFilter()" x-show="recordId">Show all records</button></form>
<div class="d-flex gap-3 flex-wrap mt-3"><template x-for="entry in config.types" :key="entry.type"><label class="form-check"><input class="form-check-input" type="checkbox" :checked="types.includes(entry.type)" @change="toggleType(entry.type)"><span x-text="typeName(entry.type)"></span></label></template></div></div></div>
<div class="d-flex gap-2 align-items-center flex-wrap mb-3"><button class="btn btn-light" @click="view='map'" :aria-pressed="view==='map'">Map</button><button class="btn btn-light" @click="view='list'" :aria-pressed="view==='list'">List</button><span class="text-muted" x-text="rows.length+' of '+resultCount+' addresses loaded · '+missingCount+' without a current pin'"></span><button class="btn btn-light ms-auto" @click="loadRows(true)" x-show="hasMore" :disabled="loading">Load more locations</button></div>
<div class="alert alert-light border" x-show="mapError" x-text="mapError"></div><p class="text-muted fs-sm">C = Customer · W = Warehouse · S = Supplier. The map and location filter cover loaded addresses. Load more or narrow your search for large lists.</p>
<div x-show="loading" role="status" class="mb-2">Loading locations…</div>
<div class="crm-map-layout">
<div x-show="view==='map'"><div id="b2b-map" class="crm-operations-map" role="region" aria-label="Google map of business locations"></div></div>
<div x-show="view==='list'" class="card mb-0"><div class="card-body crm-location-list"><p x-show="!loading && !visibleRows.length">No matching locations in the loaded results.</p><template x-for="row in visibleRows" :key="row.key"><button type="button" class="crm-location-row" :class="rowClass(row)" @click="select(row)"><strong x-text="row.name"></strong><span x-text="row.address"></span><small x-text="row.location?'Pin saved · '+row.location.source:'Location missing'"></small></button></template></div></div>
<section class="card mb-0" id="map-location-detail" aria-label="Selected location"><div class="card-body"><h2 class="card-title">Location details</h2><p x-show="!selected">Select a marker or an address from the list. Enter addresses manually on the original record, then geocode them here.</p>
<template x-if="selected"><div><h3 class="h6" x-text="selected.name"></h3><p x-text="selected.address"></p><div class="d-flex gap-2 flex-wrap mb-3"><a class="btn btn-light btn-sm" :href="selected.url">Open record</a><a class="btn btn-light btn-sm" target="_blank" rel="noopener noreferrer" :href="googleLink(selected)">Open in Google Maps</a></div><p x-show="selected.location" class="text-muted fs-sm" x-text="selected.location?'Pin saved '+formatDate(selected.location.confirmedAt):''"></p>
<div x-show="selected.canEdit"><div class="d-flex gap-2 flex-wrap"><button class="btn btn-primary" :disabled="busy || !config.geocodingConfigured" @click="geocode()" x-text="busy?'Working…':'Geocode this address'"></button><button class="btn btn-light" :disabled="busy" @click="useManual()">Enter coordinates</button></div><p class="text-muted fs-sm mt-2" x-show="!config.geocodingConfigured">Address lookup is not configured. You can still enter known coordinates.</p>
<p role="status" class="mt-3" x-text="lookupMessage"></p><div x-show="source==='google' && candidates.length"><label class="form-label" for="geocode-match">Review Google match</label><select id="geocode-match" class="form-select" x-model.number="candidateIndex" @change="previewCandidate()"><template x-for="(candidate,index) in candidates" :key="index"><option :value="index" x-text="candidateLabel(candidate)"></option></template></select><a class="d-inline-block my-2" target="_blank" rel="noopener noreferrer" :href="candidateLink()">Review suggested pin in Google Maps</a><p class="text-muted fs-sm">Google Maps address result. Approximate matches need careful review.</p><button class="btn btn-primary w-100" :disabled="busy || !token" @click="savePin()">Confirm and save this pin</button></div>
<form x-show="source==='manual'" @submit.prevent="savePin()"><div class="row g-2 mt-2"><div class="col-sm-6"><label for="pin-lat" class="form-label">Latitude</label><input id="pin-lat" type="number" min="-90" max="90" step="any" class="form-control" x-model="latitude" required></div><div class="col-sm-6"><label for="pin-lng" class="form-label">Longitude</label><input id="pin-lng" type="number" min="-180" max="180" step="any" class="form-control" x-model="longitude" required></div></div><button class="btn btn-primary w-100 mt-3" :disabled="busy">Save manual coordinates</button></form>
<p class="text-muted fs-sm mt-3 mb-0">Addresses stay exactly as entered. Google pins expire and must be refreshed; changing an address also requires a new pin.</p></div><p x-show="!selected.canEdit" class="text-muted">Your role can view this location. Editing requires permission for the original record.</p></div></template>
</div></section></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>" src="/js/operations-map.js?v=1"></script><%- include('partials/scripts') %>
</body></html>
