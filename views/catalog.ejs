<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Create the groups once, then select them on products.</p></div></div></div>
<div class="content" x-data="catalogPage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak role="alert" class="alert alert-danger" x-text="error"></div>
<div class="d-flex gap-2 flex-wrap mb-3"><a href="/products" class="btn btn-light">Products</a><a href="/categories" class="btn btn-light">Categories</a><a href="/subcategories" class="btn btn-light">Subcategories</a></div>
<div class="row g-3">
<% if(can('categories.manage')) { %><div class="col-xl-4"><form class="card" @submit.prevent="save()"><div class="card-header"><h2 class="card-title" x-text="editing?'Edit '+singular:'Create '+singular"></h2></div><div class="card-body">
<div x-show="isSubcategory" class="mb-3"><label class="form-label" for="parent-category">Parent category</label><div class="input-group mb-2"><input aria-label="Search parent categories" class="form-control" x-model="categorySearch" placeholder="Search categories" :disabled="editing" @keyup.enter.prevent="searchCategories()"><button type="button" class="btn btn-light" :disabled="editing" @click="searchCategories()">Find</button></div><select id="parent-category" class="form-select" x-model="form.categoryId" :disabled="editing" :required="isSubcategory"><option value="">Select category</option><template x-for="c in categoryOptions" :key="c.categoryId"><option :value="c.categoryId" x-text="c.name"></option></template></select><button x-show="categoryMore && !editing" type="button" class="btn btn-link btn-sm" @click="searchCategories(true)">More categories</button><small class="text-muted">The parent is fixed after creation.</small></div>
<div class="mb-3"><label for="catalog-name" class="form-label">Name</label><input id="catalog-name" class="form-control" x-model="form.name" maxlength="120" required></div><div class="mb-3"><label for="catalog-description" class="form-label">Description</label><textarea id="catalog-description" class="form-control" x-model="form.description" maxlength="2000" rows="3"></textarea></div><div class="mb-3"><label for="catalog-order" class="form-label">Display order</label><input id="catalog-order" class="form-control" type="number" min="0" max="100000" x-model.number="form.displayOrder"></div><label class="form-check"><input class="form-check-input" type="checkbox" x-model="form.active"><span>Active for new product assignments</span></label></div><div class="card-footer d-flex gap-2"><button type="button" class="btn btn-light" @click="reset()">Clear</button><button class="btn btn-primary ms-auto" :disabled="saving" x-text="saving?'Saving…':'Save'"></button></div></form></div><% } %>
<div class="<%= can('categories.manage')?'col-xl-8':'col-12' %>"><div class="card"><div class="card-header"><form class="d-flex gap-2 flex-wrap" @submit.prevent="searchItems()"><input class="form-control crm-search-input" x-model="search" aria-label="Search catalogue" placeholder="Search name"><select class="form-select crm-compact-select" x-model="active" aria-label="Filter status"><option value="">All statuses</option><option value="true">Active</option><option value="false">Inactive</option></select><button class="btn btn-light">Search</button></form></div>
<div class="p-3" x-show="loading" role="status">Loading catalogue…</div><div class="p-3" x-show="!loading && !items.length">No matching entries. Create a category first, then its subcategories.</div>
<div class="table-responsive"><table class="table crm-table crm-mobile-records mb-0"><thead><tr><th>Name</th><th x-show="isSubcategory">Category</th><th>Order</th><th>Status</th><th>Created</th><th>Updated</th><% if(can('categories.manage')) { %><th>Action</th><% } %></tr></thead><tbody><template x-for="item in items" :key="itemId(item)"><tr><td><strong x-text="item.name"></strong><div class="text-muted fs-sm" x-text="item.description"></div></td><td x-show="isSubcategory" x-text="item.categoryName"></td><td x-text="item.displayOrder"></td><td x-text="item.active?'Active':'Inactive'"></td><td x-text="formatDate(item.createdAt)"></td><td x-text="formatDate(item.updatedAt)"></td><% if(can('categories.manage')) { %><td><button class="btn btn-sm btn-light" @click="edit(item)">Edit</button></td><% } %></tr></template></tbody></table></div>
<div class="card-footer d-flex gap-2 align-items-center"><button class="btn btn-light" :disabled="page<=1 || loading" @click="move(-1)">Previous</button><span x-text="'Page '+page+' of '+pages+' · '+total+' entries'"></span><button class="btn btn-light ms-auto" :disabled="page>=pages || loading" @click="move(1)">Next</button></div></div></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function catalogPage(){return{...catalogueFields(),kind:'categories',isSubcategory:false,singular:'category',items:[],search:'',active:'',page:1,pages:1,total:0,loading:false,saving:false,error:'',editing:'',form:{name:'',description:'',displayOrder:0,active:true,categoryId:''},request:0,
async load(){this.isSubcategory=location.pathname==='/subcategories';this.kind=this.isSubcategory?'subcategories':'categories';this.singular=this.isSubcategory?'subcategory':'category';try{await Promise.all([this.loadItems(),this.loadCategories()]);}catch(e){this.error=e.message;}},
itemId(item){return this.isSubcategory?item.subcategoryId:item.categoryId;},
async loadItems(){const version=++this.request;this.loading=true;this.error='';try{const data=(await apiFetch('/api/catalog/'+this.kind+'?'+new URLSearchParams({search:this.search,active:this.active,page:this.page}))).data;if(version!==this.request)return;this.items=data.items;this.pages=data.pages;this.total=data.total;}catch(e){if(version===this.request)this.error=e.message;}finally{if(version===this.request)this.loading=false;}},
searchItems(){this.page=1;return this.loadItems();},move(delta){this.page+=delta;return this.loadItems();},
reset(){this.editing='';this.form={name:'',description:'',displayOrder:0,active:true,categoryId:''};},
edit(item){this.editing=this.itemId(item);this.form={...item,category:item.categoryName||''};this.retainSelectedCategory();document.getElementById('catalog-name').focus();},
async save(){if(this.saving)return;this.saving=true;this.error='';try{await apiFetch('/api/catalog/'+this.kind+(this.editing?'/'+this.editing:''),{method:this.editing?'PUT':'POST',body:JSON.stringify(this.form)});this.reset();await this.loadItems();await this.loadCategories();showCrmToast('Catalogue saved');}catch(e){this.error=e.message;}finally{this.saving=false;}}
};}
</script><%- include('partials/scripts') %>
</body></html>