<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Procurement workflow</div><h1 class="page-title mb-1">New purchase order</h1><p class="crm-page-subtitle mb-0">Create directly or prefill from sales-order supplier allocations.</p></div><a class="btn btn-light" href="/procurement">Back to purchase orders</a></div></div>
<div class="content" x-data="procurementFormPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" role="alert" aria-live="assertive" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" role="alert" aria-live="assertive" x-text="error"></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier, warehouse & products</h2><p class="text-muted mb-0" x-text="form.procurementAllocationIds.length?(form.procurementAllocationIds.length+' sales-order allocation(s) linked'):'Manual purchase order'"></p></div></div><div class="card-body"><div class="row g-3"><div class="col-lg-4"><label class="form-label">Supplier</label><select class="form-select" x-model="form.supplierId" @change="loadLocations()"><option value="">Select supplier</option><template x-for="s in suppliers" :key="s.supplierId"><option :value="s.supplierId" x-text="s.businessName"></option></template></select></div><div class="col-lg-4"><label class="form-label">Supplier location</label><select class="form-select" x-model="form.supplierLocationId"><option value="">Select location</option><template x-for="l in locations" :key="l.supplierLocationId"><option :value="l.supplierLocationId" x-text="[l.name,l.city,l.state].filter(Boolean).join(' · ')"></option></template></select></div><div class="col-lg-4"><label class="form-label">Receiving warehouse</label><select class="form-select" x-model="form.warehouseId"><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name+' ('+w.code+')'"></option></template></select></div><div class="col-md-4"><label class="form-label">Expected delivery</label><input type="date" class="form-control" x-model="form.expectedAt"></div><div class="col-md-4"><label class="form-label">Payment term days</label><input type="number" min="0" class="form-control" x-model.number="form.paymentTermDays"></div><div class="col-md-4"><label class="form-label">Payment terms</label><input class="form-control" x-model="form.paymentTerms" placeholder="Advance / Net 30 / custom"></div></div>
<div class="d-flex justify-content-between align-items-end gap-2 mt-4 mb-2"><div><h3 class="h6 mb-0">Purchase lines</h3><div class="text-muted fs-sm">Same product appears once per PO; sales-order allocations are grouped automatically.</div></div><button class="btn btn-light btn-sm" type="button" @click="addLine()">Add product</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th style="width:110px">Qty</th><th style="width:160px">Buy price ₹</th><th style="width:130px">GST %</th><th style="width:55px"></th></tr></thead><tbody><template x-for="(line,index) in form.lines" :key="line.key"><tr><td><select class="form-select" x-model="line.productId" @change="productChanged(line)"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></td><td><input type="number" min="1" class="form-control" x-model.number="line.quantity"></td><td><input type="number" min="0" step="0.01" class="form-control" x-model.number="line.purchasePriceRupees"></td><td><input type="number" min="0" max="100" step="0.01" class="form-control" x-model.number="line.gstPercent"></td><td><button class="btn btn-light btn-sm" @click="removeLine(index)" :disabled="form.lines.length===1||form.procurementAllocationIds.length">×</button></td></tr></template></tbody></table></div><div class="mt-3"><label class="form-label">Notes</label><textarea class="form-control" rows="2" x-model="form.notes"></textarea></div><div class="text-end mt-4"><button class="btn btn-primary" @click="createPo()" :disabled="saving" x-text="saving?'Creating…':'Create purchase order'"></button></div></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
const PROCUREMENT_DRAFT_KEY='findoly.b2b.procurement-draft.v1';
function procurementFormPage(){return{
suppliers:[],locations:[],products:[],warehouses:[],planned:[],saving:false,error:'',draftTimer:null,submissionKey:requestIdempotencyKey(),form:{supplierId:'',supplierLocationId:'',warehouseId:'',expectedAt:'',paymentTermDays:0,paymentTerms:'',notes:'',procurementAllocationIds:[],lines:[]},
newLine(){return{key:crypto.randomUUID(),productId:'',quantity:1,purchasePriceRupees:0,gstPercent:18}},
scheduleDraftSave(){
  if(this.form.procurementAllocationIds.length)return;
  this.submissionKey=requestIdempotencyKey();clearTimeout(this.draftTimer);
  this.draftTimer=setTimeout(()=>{
    try{
      const selectedProducts=this.form.lines.map(line=>this.products.find(x=>x.productId===line.productId)).filter(Boolean);
      sessionStorage.setItem(PROCUREMENT_DRAFT_KEY,JSON.stringify({form:this.form,products:selectedProducts,updatedAt:Date.now()}));
    }catch(_){}
  },250);
},
clearDraft(){try{sessionStorage.removeItem(PROCUREMENT_DRAFT_KEY)}catch(_){}},
async restoreDraft(){
  try{
    const raw=sessionStorage.getItem(PROCUREMENT_DRAFT_KEY);if(!raw)return;
    const draft=JSON.parse(raw);if(!draft?.form)return;
    this.form=draft.form;
    if(!Array.isArray(this.form.lines)||!this.form.lines.length)this.form.lines=[this.newLine()];
    for(const item of draft.products||[])if(item?.productId&&!this.products.some(x=>x.productId===item.productId))this.products.push(item);
    const locationId=this.form.supplierLocationId;
    if(this.form.supplierId)await this.loadLocations(false);
    this.form.supplierLocationId=locationId;
  }catch(_){}
},
async load(){
  this.form.lines=[this.newLine()];
  try{
    const[s,p,w]=await Promise.all([apiFetch('/api/suppliers?limit=100'),apiFetch('/api/products?limit=100'),apiFetch('/api/warehouses')]);
    this.suppliers=s.data.items||[];this.products=p.data.items||[];this.warehouses=w.data.items||[];
    const ids=(new URLSearchParams(location.search).get('allocationIds')||'').split(',').filter(Boolean);
    if(ids.length)await this.prefill(ids);else await this.restoreDraft();
    this.$watch('form',()=>this.scheduleDraftSave());
  }catch(e){this.error=e.message}
},
async prefill(ids){
  const data=(await apiFetch('/api/procurement/allocations?status=planned&purchaseOrderId=&limit=100')).data.items||[];
  const rows=data.filter(x=>ids.includes(x.procurementAllocationId));
  if(rows.length!==ids.length)throw new Error('One or more selected demand rows are no longer available.');
  const first=rows[0];
  if(rows.some(x=>x.supplierId!==first.supplierId||x.supplierLocationId!==first.supplierLocationId||x.warehouseId!==first.warehouseId))throw new Error('Selected demand must use the same supplier, location and warehouse.');
  const grouped=new Map();
  for(const a of rows){
    const current=grouped.get(a.productId);
    if(current&&Number(current.purchasePricePaise)!==Number(a.purchasePricePaise))throw new Error('Selected demand has different prices for the same product; create separate purchase orders.');
    if(current)current.quantity+=Number(a.quantity||0);else grouped.set(a.productId,{productId:a.productId,quantity:Number(a.quantity||0),purchasePricePaise:Number(a.purchasePricePaise||0),gstRateBps:Number(a.gstRateBps||0)});
  }
  this.form.supplierId=first.supplierId;this.form.warehouseId=first.warehouseId;this.form.procurementAllocationIds=rows.map(x=>x.procurementAllocationId);this.form.notes='Linked to sales-order procurement demand';
  this.form.lines=[...grouped.values()].map(x=>({key:crypto.randomUUID(),productId:x.productId,quantity:x.quantity,purchasePriceRupees:x.purchasePricePaise/100,gstPercent:x.gstRateBps/100}));
  await this.loadLocations();this.form.supplierLocationId=first.supplierLocationId;
},
async loadLocations(reset=true){
  if(reset)this.form.supplierLocationId='';this.locations=[];if(!this.form.supplierId)return;
  const s=(await apiFetch('/api/suppliers/'+this.form.supplierId)).data;this.locations=(s.locations||[]).filter(x=>x.active!==false)
},
productChanged(line){const p=this.products.find(x=>x.productId===line.productId);if(p)line.gstPercent=Number(p.gstRateBps||0)/100},
addLine(){this.form.lines.push(this.newLine())},
removeLine(i){if(this.form.lines.length>1&&!this.form.procurementAllocationIds.length)this.form.lines.splice(i,1)},
async createPo(){
  if(!this.form.supplierId||!this.form.supplierLocationId||!this.form.warehouseId)return this.error='Supplier, location and warehouse are required.';
  if(this.form.lines.some(x=>!x.productId||Number(x.quantity)<1)||new Set(this.form.lines.map(x=>x.productId)).size!==this.form.lines.length)return this.error='Complete each product line without duplicates.';
  this.saving=true;
  try{
    const po=(await apiFetch('/api/procurement',{method:'POST',headers:{'Idempotency-Key':this.submissionKey},body:JSON.stringify({...this.form,lines:this.form.lines.map(x=>({productId:x.productId,quantity:Number(x.quantity),unitPurchasePricePaise:Math.round(Number(x.purchasePriceRupees||0)*100),gstRateBps:Math.round(Number(x.gstPercent||0)*100)}))})})).data;
    this.clearDraft();showCrmToast('Purchase order created');location.href='/procurement/'+po.purchaseOrderId;
  }catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}
}
}}</script>
<%- include('partials/scripts') %>
</body></html>
