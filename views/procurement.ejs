<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Procurement</div><h1 class="page-title mb-1">Purchase orders</h1><p class="crm-page-subtitle mb-0">Purchase orders are the supplier-facing execution records for sales-order demand and replenishment.</p></div><div class="d-flex gap-2"><a class="btn btn-light" href="/procurement/demand">Demand queue</a><% if (can('procurement.create')) { %><a class="btn btn-primary crm-primary-action" href="/procurement/new"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New purchase order</a><% } %></div></div></div>
<div class="content" x-data="procurementListPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Purchase-order pipeline</h2><p class="text-muted mb-0">Open one record for approval, receipt and linked sales-order demand.</p></div><div class="d-flex flex-wrap gap-2"><input class="form-control form-control-sm" placeholder="PO or supplier" x-model="search" @keyup.enter="filter()"><select class="form-select form-select-sm" x-model="statusFilter" @change="filter()"><option value="">All statuses</option><option value="draft">Draft</option><option value="approved">Approved</option><option value="placed">Placed</option><option value="partially_received">Partially received</option><option value="received">Received</option><option value="closed">Closed</option><option value="cancelled">Cancelled</option></select><button class="btn btn-light btn-sm" @click="filter()">Search</button></div></div><div class="table-responsive"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Purchase order</th><th>Supplier</th><th>Warehouse</th><th>Status</th><th>Products</th><th class="text-end">Value</th><th class="text-end">Action</th></tr></thead><tbody><template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="po in orders" :key="po.purchaseOrderId"><tr><td><a class="crm-record-title" :href="'/procurement/'+po.purchaseOrderId" x-text="po.poNumber"></a><div class="text-muted fs-sm" x-text="formatDateOnly(po.createdAt)"></div></td><td x-text="po.supplierName"></td><td x-text="crmValue(po,'warehouseSnapshot.name','Warehouse')"></td><td><span class="crm-status" :class="statusClass(po.status)" x-text="humanize(po.status)"></span></td><td x-text="(po.lines||[]).length+' SKU(s)'"></td><td class="text-end fw-semibold" x-text="money(value(po))"></td><td class="text-end crm-table-actions"><a class="btn btn-sm btn-outline-primary" :href="'/procurement/'+po.purchaseOrderId">Open</a><% if (can('procurement.receive')) { %><a x-show="['approved','placed','partially_received'].includes(po.status)" class="btn btn-sm btn-primary" :href="'/procurement/'+po.purchaseOrderId+'/receive'">Receive</a><% } %></td></tr></template><tr x-show="!loading&&!orders.length"><td colspan="7"><div class="crm-empty-state"><strong>No purchase orders found</strong></div></td></tr></tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function procurementListPage(){return{...crmPager('load'),orders:[],loading:true,error:'',statusFilter:'',search:'',async load(){this.loading=true;try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.statusFilter)q.set('status',this.statusFilter);if(this.search)q.set('search',this.search);const d=(await apiFetch('/api/procurement?'+q)).data;this.orders=d.items||[];this.setPageMeta(d)}catch(e){this.error=e.message}finally{this.loading=false}},filter(){this.resetPage();return this.load()},value(po){return(po.lines||[]).reduce((s,l)=>s+Number(l.quantity||0)*Number(l.unitPurchasePricePaise||0),0)}}}</script><%- include('partials/scripts') %>
</body></html>
