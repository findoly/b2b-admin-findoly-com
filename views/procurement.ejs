<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="ops()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="card mb-3"><div class="card-body"><h6>Create / action payload</h6><p class="small text-secondary">PO JSON: supplierId, supplierLocationId, warehouseId, paymentTermDays, lines:[{productId,quantity,unitPurchasePricePaise,gstRateBps}]. Approve and receive via PO action APIs.</p><textarea class="form-control font-monospace" rows="7" x-model="payload"></textarea><button class="btn btn-primary mt-2" @click="submit()">Submit</button></div></div><div class="card crm-data-card"><div class="card-header d-flex justify-content-between"><strong>Purchase orders</strong><button class="btn btn-sm btn-outline-secondary" @click="load()">Refresh</button></div><div class="card-body p-0"><pre class="m-0 p-3 small" style="max-height:65vh;overflow:auto" x-text="JSON.stringify(data,null,2)"></pre></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function ops(){return{data:null,error:'',payload:'{}',async submit(){try{await apiFetch('/api/procurement',{method:'POST',body:this.payload});await this.load()}catch(e){this.error=e.message}},async load(){try{this.data=(await apiFetch('/api/procurement')).data}catch(e){this.error=e.message}}}}</script></body></html>