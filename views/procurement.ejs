<!doctype html>
<html lang="en" dir="ltr">
<%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()">
<%- include('partials/navbar') %>
<div class="page-content">
  <%- include('partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header page-header-light crm-page-header">
        <div class="page-header-content crm-page-heading">
          <div><div class="crm-page-eyebrow">Operations</div><h1 class="page-title mb-1">Procurement</h1><p class="crm-page-subtitle mb-0">Create purchase orders, approve sourcing and receive goods into stock.</p></div>
          <% if (can('procurement.create')) { %><button class="btn btn-primary crm-primary-action" type="button" @click="$dispatch('open-po-form')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New purchase order</button><% } %>
        </div>
      </div>
      <div class="content" x-data="procurementPage()" x-init="load()" @open-po-form.window="showForm=true">
        <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
        <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>


        <% if (can('procurement.create')) { %>
        <div class="card crm-data-card mb-4">
          <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Sales-order procurement demand</h2><p class="text-muted mb-0">Planned shortages waiting to be linked to a purchase order.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary btn-sm" @click="useSelectedAllocations()" :disabled="!selectedAllocationIds.length">Create PO from selected</button><button class="btn btn-light btn-sm" @click="loadPlannedAllocations()">Refresh</button></div></div>
          <div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th style="width:42px"></th><th>Sales order</th><th>Product</th><th>Supplier</th><th>Warehouse</th><th class="text-end">Qty</th><th class="text-end">Buy price</th></tr></thead><tbody>
          <template x-for="a in plannedAllocations" :key="a.procurementAllocationId"><tr><td><input class="form-check-input" type="checkbox" :value="a.procurementAllocationId" x-model="selectedAllocationIds"></td><td><strong x-text="a.orderNumber||a.salesOrderId"></strong></td><td x-text="productName(a.productId)"></td><td x-text="a.supplierSnapshot?.businessName||a.supplierId"></td><td x-text="warehouseName(a.warehouseId)"></td><td class="text-end" x-text="Number(a.quantity||0)"></td><td class="text-end" x-text="money(Number(a.purchasePricePaise||0))"></td></tr></template>
          <tr x-show="!plannedAllocations.length"><td colspan="7"><div class="crm-empty-state"><strong>No planned procurement demand</strong><span>Sales-order shortages will appear here after supplier allocation.</span></div></td></tr>
          </tbody></table></div>
        </div>
        <% } %>

        <% if (can('procurement.create')) { %>
        <div class="card crm-data-card mb-4" x-show="showForm" x-cloak>
          <div class="card-header crm-card-heading">
            <div><h2 class="card-title mb-1">New purchase order</h2><p class="text-muted mb-0">Select the supplier, fulfilment warehouse and products to purchase.</p></div>
            <button type="button" class="btn btn-light btn-sm" @click="resetForm()">Close</button>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-lg-4"><label class="form-label">Supplier</label><select class="form-select" x-model="form.supplierId" @change="loadSupplierLocations()" required><option value="">Select supplier</option><template x-for="s in suppliers" :key="s.supplierId"><option :value="s.supplierId" x-text="s.businessName"></option></template></select></div>
              <div class="col-lg-4"><label class="form-label">Supplier location</label><select class="form-select" x-model="form.supplierLocationId" :disabled="!form.supplierId" required><option value="">Select location</option><template x-for="l in supplierLocations" :key="l.supplierLocationId"><option :value="l.supplierLocationId" x-text="[l.name,l.city,l.state].filter(Boolean).join(' · ')"></option></template></select></div>
              <div class="col-lg-4"><label class="form-label">Receiving warehouse</label><select class="form-select" x-model="form.warehouseId" required><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name+' ('+w.code+')'"></option></template></select></div>
              <div class="col-md-4"><label class="form-label">Expected delivery</label><input type="date" class="form-control" x-model="form.expectedAt"></div>
              <div class="col-md-4"><label class="form-label">Payment term days</label><input type="number" min="0" class="form-control" x-model.number="form.paymentTermDays"></div>
              <div class="col-md-4"><label class="form-label">Payment terms</label><input class="form-control" placeholder="Advance / Net 30 / custom" x-model="form.paymentTerms"></div>
              <div class="col-12"><label class="form-label">Notes</label><input class="form-control" placeholder="Optional purchasing notes" x-model="form.notes"></div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 mb-2"><div><h3 class="h6 mb-0">Products</h3><div class="text-muted fs-sm">Purchase prices are entered in rupees; records are stored in paise.</div></div><button class="btn btn-light btn-sm" type="button" @click="addLine()">Add product</button></div>
            <div class="table-responsive">
              <table class="table crm-table align-middle mb-0">
                <thead><tr><th style="min-width:220px">Product</th><th style="width:110px">Qty</th><th style="width:150px">Buy price ₹</th><th style="width:120px">GST %</th><th class="text-end" style="width:150px">Line value</th><th style="width:55px"></th></tr></thead>
                <tbody>
                  <template x-for="(line,index) in form.lines" :key="line.key">
                    <tr>
                      <td><select class="form-select" x-model="line.productId" @change="productChanged(line)" required><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></td>
                      <td><input type="number" min="1" class="form-control" x-model.number="line.quantity"></td>
                      <td><input type="number" min="0" step="0.01" class="form-control" x-model.number="line.purchasePriceRupees"></td>
                      <td><input type="number" min="0" max="100" step="0.01" class="form-control" x-model.number="line.gstPercent"></td>
                      <td class="text-end fw-semibold" x-text="money(Math.round(Number(line.purchasePriceRupees||0)*100)*Number(line.quantity||0))"></td>
                      <td class="text-end"><button type="button" class="btn btn-light btn-sm" @click="removeLine(index)" :disabled="form.lines.length===1">×</button></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3"><button class="btn btn-light" type="button" @click="resetForm()">Cancel</button><button class="btn btn-primary" type="button" @click="createPo()" :disabled="saving" x-text="saving?'Saving…':'Create purchase order'"></button></div>
          </div>
        </div>
        <% } %>

        <div class="card crm-data-card">
          <div class="card-header crm-card-heading">
            <div><h2 class="card-title mb-1">Purchase orders</h2><p class="text-muted mb-0">Track approval and receipt status.</p></div>
            <div class="d-flex gap-2"><select class="form-select form-select-sm" x-model="statusFilter" @change="loadOrders()"><option value="">All statuses</option><option value="draft">Draft</option><option value="approved">Approved</option><option value="placed">Placed</option><option value="partially_received">Partially received</option><option value="received">Received</option><option value="closed">Closed</option><option value="cancelled">Cancelled</option></select><button class="btn btn-light btn-sm" @click="loadOrders()">Refresh</button></div>
          </div>
          <div class="table-responsive">
            <table class="table crm-table align-middle mb-0">
              <thead><tr><th>Purchase order</th><th>Supplier</th><th>Warehouse</th><th>Status</th><th>Expected</th><th>Products</th><th class="text-end">Value</th><th class="text-end">Actions</th></tr></thead>
              <tbody>
                <template x-if="loading"><tr><td colspan="8"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
                <template x-for="po in orders" :key="po.purchaseOrderId">
                  <tr>
                    <td><div class="crm-record-title" x-text="po.poNumber"></div><div class="crm-record-id" x-text="po.purchaseOrderId"></div></td>
                    <td x-text="po.supplierName"></td>
                    <td x-text="warehouseName(po.warehouseId)"></td>
                    <td><span class="crm-status" :class="statusClass(po.status)" x-text="humanize(po.status)"></span></td>
                    <td x-text="formatDateOnly(po.expectedAt)"></td>
                    <td x-text="(po.lines||[]).length"></td>
                    <td class="text-end fw-semibold" x-text="money(poValue(po))"></td>
                    <td class="text-end crm-table-actions">
                      <% if (can('procurement.approve')) { %><button x-show="po.status==='draft'" class="btn btn-sm btn-outline-primary" @click="openApproval(po)">Approve</button><button x-show="po.status==='approved'" class="btn btn-sm btn-outline-primary" @click="placePo(po)">Mark placed</button><button x-show="['draft','approved','placed','partially_received'].includes(po.status)" class="btn btn-sm btn-outline-danger" @click="cancelPo(po)">Cancel</button><button x-show="['received','partially_received'].includes(po.status)" class="btn btn-sm btn-outline-secondary" @click="closePo(po)">Close</button><% } %>
                      <% if (can('procurement.receive')) { %><button x-show="['approved','placed','partially_received'].includes(po.status)" class="btn btn-sm btn-primary" @click="openReceive(po)">Receive / GRN</button><% } %>
                    </td>
                  </tr>
                </template>
                <tr x-show="!loading && !orders.length"><td colspan="8"><div class="crm-empty-state"><strong>No purchase orders found</strong><span>Create a purchase order to begin procurement.</span></div></td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <% if (can('procurement.approve')) { %>
<div class="card crm-data-card mt-4" x-show="approvalPo" x-cloak>
  <div class="card-header crm-card-heading">
    <div><h2 class="card-title mb-1">Approve purchase order</h2><p class="text-muted mb-0" x-text="approvalPo?.poNumber+' · '+approvalPo?.supplierName"></p></div>
    <button class="btn btn-light btn-sm" @click="approvalPo=null">Close</button>
  </div>
  <div class="card-body">
    <div class="alert alert-info mb-3">Approval marks the ordered quantities as incoming stock for the selected warehouse.</div>
    <div class="d-flex justify-content-between align-items-center">
      <div><div class="text-muted fs-sm">Purchase value</div><div class="fs-4 fw-bold" x-text="money(poValue(approvalPo))"></div></div>
      <button class="btn btn-primary" @click="approvePo()" :disabled="saving">Approve purchase order</button>
    </div>
  </div>
</div>
<% } %>
<% if (can('procurement.receive')) { %>
        <div class="card crm-data-card mt-4" x-show="receive.po" x-cloak>
          <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Receive goods / GRN</h2><p class="text-muted mb-0"><span x-text="receive.po?.poNumber"></span> · <span x-text="receive.po?.supplierName"></span></p></div><button class="btn btn-light btn-sm" @click="receive={po:null,lines:[],supplierInvoiceNumber:'',supplierInvoiceDate:'',taxableRupees:0,cgstRupees:0,sgstRupees:0,igstRupees:0,cessRupees:0,totalInvoiceRupees:0,itcStatus:'pending'}">Close</button></div>
          <div class="card-body">
            <div class="table-responsive mb-3"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Outstanding</th><th>Received</th><th>Accepted</th><th>Damaged</th><th>Rejected</th><th>Shortage</th></tr></thead><tbody><template x-for="line in receive.lines" :key="line.purchaseOrderLineId"><tr><td><strong x-text="line.productName"></strong><div class="text-muted fs-sm" x-text="line.sku"></div></td><td x-text="line.outstandingQty"></td><td><input class="form-control" type="number" min="0" :max="line.outstandingQty" x-model.number="line.receivedQty" @input="syncAccepted(line)"></td><td><input class="form-control" type="number" min="0" x-model.number="line.acceptedQty"></td><td><input class="form-control" type="number" min="0" x-model.number="line.damagedQty" @input="syncAccepted(line)"></td><td><input class="form-control" type="number" min="0" x-model.number="line.rejectedQty" @input="syncAccepted(line)"></td><td><input class="form-control" type="number" min="0" :max="line.outstandingQty-line.receivedQty" x-model.number="line.shortQty"></td></tr></template></tbody></table></div>
            <div class="row g-3">
              <div class="col-md-4"><label class="form-label">Supplier invoice number</label><input class="form-control" x-model="receive.supplierInvoiceNumber"></div>
              <div class="col-md-4"><label class="form-label">Supplier invoice date</label><input class="form-control" type="date" x-model="receive.supplierInvoiceDate"></div>
              <div class="col-md-4"><label class="form-label">ITC status</label><select class="form-select" x-model="receive.itcStatus"><option value="pending">Pending</option><option value="eligible">Eligible</option><option value="not_eligible">Not eligible</option><option value="reversed">Reversed</option></select></div>
              <div class="col-6 col-md-2"><label class="form-label">Taxable ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="receive.taxableRupees"></div>
              <div class="col-6 col-md-2"><label class="form-label">CGST ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="receive.cgstRupees"></div>
              <div class="col-6 col-md-2"><label class="form-label">SGST ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="receive.sgstRupees"></div>
              <div class="col-6 col-md-2"><label class="form-label">IGST ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="receive.igstRupees"></div>
              <div class="col-6 col-md-2"><label class="form-label">Cess ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="receive.cessRupees"></div>
              <div class="col-6 col-md-2"><label class="form-label">Invoice total ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="receive.totalInvoiceRupees"></div>
            </div>
            <div class="text-end mt-3"><button class="btn btn-primary" @click="submitReceipt()" :disabled="saving" x-text="saving?'Receiving…':'Receive goods'"></button></div>
          </div>
        </div>
        <% } %>
      </div>
      <%- include('partials/footer') %>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
function procurementPage(){return{
  orders:[],plannedAllocations:[],selectedAllocationIds:[],suppliers:[],supplierLocations:[],products:[],warehouses:[],loading:true,saving:false,error:'',showForm:false,statusFilter:'',approvalPo:null,
  form:{supplierId:'',supplierLocationId:'',warehouseId:'',expectedAt:'',paymentTermDays:0,paymentTerms:'',notes:'',procurementAllocationIds:[],lines:[]},
  receive:{po:null,lines:[],supplierInvoiceNumber:'',supplierInvoiceDate:'',taxableRupees:0,cgstRupees:0,sgstRupees:0,igstRupees:0,cessRupees:0,totalInvoiceRupees:0,itcStatus:'pending'},
  newLine(){return{key:crypto.randomUUID(),productId:'',quantity:1,purchasePriceRupees:0,gstPercent:18}},
  async load(){this.form.lines=[this.newLine()];try{const [s,p,w]=await Promise.all([apiFetch('/api/suppliers?limit=100'),apiFetch('/api/products?limit=100'),apiFetch('/api/warehouses')]);this.suppliers=s.data.items||[];this.products=p.data.items||[];this.warehouses=w.data.items||[];await Promise.all([this.loadOrders(),this.loadPlannedAllocations()])}catch(e){this.error=e.message}finally{this.loading=false}},
  async loadOrders(){this.loading=true;try{const q=this.statusFilter?'?status='+encodeURIComponent(this.statusFilter)+'&limit=100':'?limit=100';this.orders=(await apiFetch('/api/procurement'+q)).data.items||[]}catch(e){this.error=e.message}finally{this.loading=false}},async loadPlannedAllocations(){try{this.plannedAllocations=(await apiFetch('/api/procurement/allocations?status=planned&purchaseOrderId=&limit=100')).data.items||[];this.selectedAllocationIds=this.selectedAllocationIds.filter(id=>this.plannedAllocations.some(x=>x.procurementAllocationId===id))}catch(e){this.error=e.message}},
  async loadSupplierLocations(){this.form.supplierLocationId='';this.supplierLocations=[];if(!this.form.supplierId)return;try{const s=(await apiFetch('/api/suppliers/'+this.form.supplierId)).data;this.supplierLocations=(s.locations||[]).filter(x=>x.active!==false)}catch(e){this.error=e.message}},
  productChanged(line){const p=this.products.find(x=>x.productId===line.productId);if(p)line.gstPercent=Number(p.gstRateBps||0)/100},
  addLine(){this.form.lines.push(this.newLine())},removeLine(i){if(this.form.lines.length>1)this.form.lines.splice(i,1)},
  resetForm(){this.showForm=false;this.supplierLocations=[];this.selectedAllocationIds=[];this.form={supplierId:'',supplierLocationId:'',warehouseId:'',expectedAt:'',paymentTermDays:0,paymentTerms:'',notes:'',procurementAllocationIds:[],lines:[this.newLine()]}},
  paise(v){return Math.round(Number(v||0)*100)},bps(v){return Math.round(Number(v||0)*100)},productName(id){const p=this.products.find(x=>x.productId===id);return p?(p.name+' · '+p.sku):id},async useSelectedAllocations(){this.error='';const rows=this.plannedAllocations.filter(x=>this.selectedAllocationIds.includes(x.procurementAllocationId));if(!rows.length)return;const first=rows[0];if(rows.some(x=>x.supplierId!==first.supplierId||x.supplierLocationId!==first.supplierLocationId||x.warehouseId!==first.warehouseId)){this.error='Select procurement demand for the same supplier, supplier location and warehouse.';return}const grouped=new Map();for(const a of rows){const existing=grouped.get(a.productId);if(existing&&Number(existing.purchasePricePaise)!==Number(a.purchasePricePaise)){this.error='Selected demand contains different purchase prices for the same product. Create separate purchase orders.';return}if(existing)existing.quantity+=Number(a.quantity||0);else grouped.set(a.productId,{productId:a.productId,quantity:Number(a.quantity||0),purchasePricePaise:Number(a.purchasePricePaise||0),gstRateBps:Number(a.gstRateBps||0)})}this.form={supplierId:first.supplierId,supplierLocationId:'',warehouseId:first.warehouseId,expectedAt:'',paymentTermDays:0,paymentTerms:'',notes:'Linked to sales-order procurement demand',procurementAllocationIds:rows.map(x=>x.procurementAllocationId),lines:[...grouped.values()].map(x=>({key:crypto.randomUUID(),productId:x.productId,quantity:x.quantity,purchasePriceRupees:x.purchasePricePaise/100,gstPercent:x.gstRateBps/100}))};await this.loadSupplierLocations();this.form.supplierLocationId=first.supplierLocationId;this.showForm=true;this.$nextTick(()=>window.scrollTo({top:0,behavior:'smooth'}))},
  async createPo(){this.error='';if(!this.form.supplierId||!this.form.supplierLocationId||!this.form.warehouseId)return this.error='Supplier, supplier location and warehouse are required.';if(this.form.lines.some(x=>!x.productId||Number(x.quantity)<1))return this.error='Complete every purchase order line.';this.saving=true;try{await apiFetch('/api/procurement',{method:'POST',body:JSON.stringify({...this.form,lines:this.form.lines.map(x=>({productId:x.productId,quantity:Number(x.quantity),unitPurchasePricePaise:this.paise(x.purchasePriceRupees),gstRateBps:this.bps(x.gstPercent)}))})});showCrmToast('Purchase order created');this.resetForm();await Promise.all([this.loadOrders(),this.loadPlannedAllocations()])}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}},
  poValue(po){return(po.lines||[]).reduce((s,l)=>s+Number(l.unitPurchasePricePaise||0)*Number(l.quantity||0),0)},
  warehouseName(id){return this.warehouses.find(x=>x.warehouseId===id)?.name||id},
  openApproval(po){this.approvalPo=po;this.receive.po=null;this.$nextTick(()=>window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'}))},
async approvePo(){const po=this.approvalPo;if(!po)return;this.saving=true;try{await apiFetch('/api/procurement/'+po.purchaseOrderId+'/approve',{method:'POST',body:'{}'});showCrmToast('Purchase order approved');this.approvalPo=null;await Promise.all([this.loadOrders(),this.loadPlannedAllocations()])}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}},async placePo(po){try{await apiFetch('/api/procurement/'+po.purchaseOrderId+'/place',{method:'POST',body:'{}'});showCrmToast('Purchase order marked placed');await this.loadOrders()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},async cancelPo(po){if(!confirm('Cancel this purchase order? Remaining incoming stock will be released and unmet linked demand will return to planning.'))return;try{await apiFetch('/api/procurement/'+po.purchaseOrderId+'/cancel',{method:'POST',body:JSON.stringify({reason:'Cancelled from procurement portal'})});showCrmToast('Purchase order cancelled');await Promise.all([this.loadOrders(),this.loadPlannedAllocations()])}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},async closePo(po){if(!confirm('Close this purchase order? Any remaining incoming quantity will be released.'))return;try{await apiFetch('/api/procurement/'+po.purchaseOrderId+'/close',{method:'POST',body:JSON.stringify({reason:'Closed from procurement portal'})});showCrmToast('Purchase order closed');await Promise.all([this.loadOrders(),this.loadPlannedAllocations()])}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
  openReceive(po){this.receive={po,lines:(po.lines||[]).map(l=>({purchaseOrderLineId:l.purchaseOrderLineId,productName:l.productName,sku:l.sku,outstandingQty:Number(l.quantity||0)-Number(l.receivedQuantity||0)-Number(l.shortQuantity||0),receivedQty:Number(l.quantity||0)-Number(l.receivedQuantity||0)-Number(l.shortQuantity||0),acceptedQty:Number(l.quantity||0)-Number(l.receivedQuantity||0)-Number(l.shortQuantity||0),damagedQty:0,rejectedQty:0,shortQty:0})),supplierInvoiceNumber:'',supplierInvoiceDate:'',taxableRupees:0,cgstRupees:0,sgstRupees:0,igstRupees:0,cessRupees:0,totalInvoiceRupees:0,itcStatus:'pending'};setTimeout(()=>this.$el.scrollIntoView({behavior:'smooth',block:'end'}),50)},
  syncAccepted(line){line.acceptedQty=Math.max(0,Number(line.receivedQty||0)-Number(line.damagedQty||0)-Number(line.rejectedQty||0))},
  async submitReceipt(){if(!this.receive.po)return;this.saving=true;try{const body={lines:this.receive.lines.map(l=>({purchaseOrderLineId:l.purchaseOrderLineId,receivedQty:Number(l.receivedQty||0),acceptedQty:Number(l.acceptedQty||0),damagedQty:Number(l.damagedQty||0),rejectedQty:Number(l.rejectedQty||0),shortQty:Number(l.shortQty||0)})),supplierInvoiceNumber:this.receive.supplierInvoiceNumber,supplierInvoiceDate:this.receive.supplierInvoiceDate||null,taxablePaise:this.paise(this.receive.taxableRupees),cgstPaise:this.paise(this.receive.cgstRupees),sgstPaise:this.paise(this.receive.sgstRupees),igstPaise:this.paise(this.receive.igstRupees),cessPaise:this.paise(this.receive.cessRupees),totalInvoicePaise:this.paise(this.receive.totalInvoiceRupees),itcStatus:this.receive.itcStatus};await apiFetch('/api/procurement/'+this.receive.po.purchaseOrderId+'/receive',{method:'POST',body:JSON.stringify(body)});showCrmToast('Goods receipt recorded');this.receive.po=null;await Promise.all([this.loadOrders(),this.loadPlannedAllocations()])}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}
}}</script>
<%- include('partials/scripts') %>
</body></html>