<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Administration</div><h1 class="page-title mb-1">Roles & permissions</h1><p class="crm-page-subtitle mb-0">Fine-grained access for sales, procurement, warehouse, accounts and delivery teams.</p></div><% if (can('roles.create')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-role')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New role</button><% } %></div></div>
<div class="content" x-data="rolesPage()" x-init="load()" @new-role.window="startCreate()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1" x-text="editingId?'Edit role':'New role'"></h2><p class="text-muted mb-0">Only approved permission keys can be saved.</p></div><button class="btn btn-light btn-sm" @click="showForm=false">Close</button></div><div class="card-body">
<div class="row g-3 mb-4"><div class="col-md-4"><label class="form-label">Role name</label><input class="form-control" x-model="form.name"></div><div class="col-md-4"><label class="form-label">Slug</label><input class="form-control" x-model="form.slug" :readonly="Boolean(editingId)"></div><div class="col-md-4 d-flex align-items-end"><label class="form-check mb-2"><input class="form-check-input" type="checkbox" x-model="form.active"><span class="form-check-label">Role active</span></label></div><div class="col-12"><label class="form-label">Description</label><input class="form-control" x-model="form.description"></div></div>
<div class="row g-3"><template x-for="g in permissionGroups" :key="g.key"><div class="col-lg-4 col-md-6"><div class="border rounded p-3 h-100"><div class="fw-semibold mb-2" x-text="g.label"></div><template x-for="p in g.permissions" :key="p.key"><label class="form-check mb-1"><input class="form-check-input" type="checkbox" :value="p.key" x-model="form.permissions" :disabled="editingSuperAdmin"><span class="form-check-label" x-text="humanize(p.key)"></span></label></template></div></div></template></div>
<div class="text-end mt-3"><button class="btn btn-primary" @click="save()" :disabled="editingSuperAdmin" x-text="editingId?'Save role':'Create role'"></button></div>
</div></div>

<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Access roles</h2><p class="text-muted mb-0">System roles are preserved; custom roles can be tailored to operational responsibility.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Role</th><th>Description</th><th>Permissions</th><th>Type</th><th>Status</th><th class="text-end">Action</th></tr></thead><tbody>
<template x-for="r in items" :key="r.roleId"><tr><td><strong x-text="r.name"></strong><div class="text-muted fs-sm" x-text="r.slug"></div></td><td x-text="r.description||'—'"></td><td><span x-text="r.permissions?.includes('*')?'All permissions':(r.permissions||[]).length+' permissions'"></span></td><td x-text="r.isSystem?'System':'Custom'"></td><td><span class="crm-status" :class="r.active?'status-paid':'status-pending'" x-text="r.active?'Active':'Inactive'"></span></td><td class="text-end"><% if (can('roles.edit')) { %><button class="btn btn-sm btn-outline-primary" @click="edit(r)" :disabled="r.isSuperAdmin">Edit</button><button class="btn btn-sm btn-light" @click="toggle(r)" :disabled="r.isSuperAdmin" x-text="r.active?'Deactivate':'Activate'"></button><% } %></td></tr></template>
</tbody></table></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function rolesPage(){return{
items:[],permissionGroups:[],error:'',showForm:false,editingId:'',editingSuperAdmin:false,form:{name:'',slug:'',description:'',permissions:[],active:true},
async load(){try{const x=(await apiFetch('/api/roles')).data;this.items=x.items||[];this.permissionGroups=x.permissionGroups||[]}catch(e){this.error=e.message}},
startCreate(){this.editingId='';this.editingSuperAdmin=false;this.form={name:'',slug:'',description:'',permissions:[],active:true};this.showForm=true},
edit(r){this.editingId=r.roleId;this.editingSuperAdmin=Boolean(r.isSuperAdmin);this.form={name:r.name,slug:r.slug,description:r.description||'',permissions:[...(r.permissions||[])],active:r.active!==false};this.showForm=true;window.scrollTo({top:0,behavior:'smooth'})},
async save(){if(!this.form.name||!this.form.slug)return this.error='Role name and slug are required.';try{if(this.editingId)await apiFetch('/api/roles/'+this.editingId,{method:'PUT',body:JSON.stringify(this.form)});else await apiFetch('/api/roles',{method:'POST',body:JSON.stringify(this.form)});showCrmToast(this.editingId?'Role updated':'Role created');this.showForm=false;await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async toggle(r){try{await apiFetch('/api/roles/'+r.roleId,{method:'PUT',body:JSON.stringify({active:!r.active})});showCrmToast('Role status updated');await this.load()}catch(e){this.error=e.message}}
}}</script><%- include('partials/scripts') %>
</body></html>