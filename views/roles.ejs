<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="rolesPage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3"><div class="col-lg-5"><div class="card crm-data-card"><div class="card-header fw-semibold">Create role</div><div class="card-body"><input class="form-control mb-2" placeholder="Role name" x-model="form.name"><input class="form-control mb-2" placeholder="slug-example" x-model="form.slug"><textarea class="form-control mb-2" placeholder="Description" x-model="form.description"></textarea><div class="small fw-semibold mb-2">Permissions</div><template x-for="g in permissionGroups" :key="g.key"><div class="mb-2"><div class="small text-secondary" x-text="g.label"></div><template x-for="p in g.permissions" :key="p.key"><label class="form-check"><input class="form-check-input" type="checkbox" :value="p.key" x-model="form.permissions"><span class="form-check-label small" x-text="p.key"></span></label></template></div></template><button class="btn btn-primary" @click="create()">Create role</button></div></div></div><div class="col-lg-7"><div class="card crm-data-card"><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Role</th><th>Permissions</th><th>System</th><th>Status</th></tr></thead><tbody><template x-for="x in items" :key="x.roleId"><tr><td><strong x-text="x.name"></strong><div class="small text-secondary" x-text="x.slug"></div></td><td><span class="small" x-text="(x.permissions||[]).join(', ')"></span></td><td x-text="x.isSystem?'yes':'no'"></td><td x-text="x.active?'active':'inactive'"></td></tr></template></tbody></table></div></div></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function rolesPage(){return{items:[],permissionGroups:[],error:'',form:{name:'',slug:'',description:'',permissions:[]},async load(){try{const x=(await apiFetch('/api/roles')).data;this.items=x.items;this.permissionGroups=x.permissionGroups}catch(e){this.error=e.message}},async create(){try{await apiFetch('/api/roles',{method:'POST',body:JSON.stringify(this.form)});this.form={name:'',slug:'',description:'',permissions:[]};await this.load()}catch(e){this.error=e.message}}}}</script></body></html>