<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Inventory</div><h1 class="page-title mb-1">Stock balances</h1><p class="crm-page-subtitle mb-0">Current warehouse quantities by product. Movement history and manual adjustments use dedicated pages.</p></div><div class="d-flex gap-2"><a class="btn btn-light" href="/inventory/movements">Movement ledger</a><% if (can('inventory.adjust')) { %><a class="btn btn-primary" href="/inventory/adjust">Adjust inventory</a><% } %></div></div></div>
<div class="content" x-data="inventoryBalancesPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Warehouse stock</h2><p class="text-muted mb-0">Available, reserved, incoming, picked and packed quantities.</p></div><select class="form-select form-select-sm" style="max-width:260px" x-model="warehouseFilter" @change="filter()"><option value="">All warehouses</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name"></option></template></select></div><div class="table-responsive"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Product</th><th>Warehouse</th><th class="text-end">Available</th><th class="text-end">Reserved</th><th class="text-end">Incoming</th><th class="text-end">Picked</th><th class="text-end">Packed</th><th class="text-end">Damaged</th></tr></thead><tbody><template x-if="loading"><tr><td colspan="8"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="x in balances" :key="x.inventoryBalanceId"><tr><td><a :href="'/products/'+x.productId" class="crm-record-title" x-text="productName(x.productId)"></a><div class="text-muted fs-sm" x-text="productSku(x.productId)"></div></td><td x-text="warehouseName(x.warehouseId)"></td><td class="text-end fw-semibold" x-text="x.availableQty||0"></td><td class="text-end" x-text="x.reservedQty||0"></td><td class="text-end" x-text="x.incomingQty||0"></td><td class="text-end" x-text="x.pickedQty||0"></td><td class="text-end" x-text="x.packedQty||0"></td><td class="text-end" x-text="x.damagedQty||0"></td></tr></template><tr x-show="!loading&&!balances.length"><td colspan="8"><div class="crm-empty-state"><strong>No stock balances found</strong></div></td></tr></tbody></table></div><%- include('partials/pager') %></div></div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function inventoryBalancesPage(){return{...crmPager('loadBalances'),balances:[],products:[],warehouses:[],loading:true,error:'',warehouseFilter:'',async load(){try{const[p,w]=await Promise.all([apiFetch('/api/products?limit=100'),apiFetch('/api/warehouses')]);this.products=p.data.items||[];this.warehouses=w.data.items||[];await this.loadBalances()}catch(e){this.error=e.message}},async loadBalances(){this.loading=true;try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.warehouseFilter)q.set('warehouseId',this.warehouseFilter);const d=(await apiFetch('/api/inventory?'+q)).data;this.balances=d.items||[];this.setPageMeta(d)}catch(e){this.error=e.message}finally{this.loading=false}},filter(){this.resetPage();return this.loadBalances()},productName(id){return this.products.find(x=>x.productId===id)?.name||'Product'},productSku(id){return this.products.find(x=>x.productId===id)?.sku||''},warehouseName(id){return this.warehouses.find(x=>x.warehouseId===id)?.name||'Warehouse'}}}</script><%- include('partials/scripts') %>
</body></html>
