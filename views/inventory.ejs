<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Operations</div><h1 class="page-title mb-1">Inventory</h1><p class="crm-page-subtitle mb-0">Warehouse balances and immutable stock movement history.</p></div><% if (can('inventory.adjust')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('inventory-adjust')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Adjust inventory</button><% } %></div></div>
<div class="content" x-data="inventoryPage()" x-init="load()" @inventory-adjust.window="showAdjustment=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<% if (can('inventory.adjust')) { %>
<div class="card crm-data-card mb-4" x-show="showAdjustment" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Inventory adjustment</h2><p class="text-muted mb-0">Manual adjustments are fully recorded in the stock movement ledger.</p></div><button class="btn btn-light btn-sm" @click="showAdjustment=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-3"><label class="form-label">Warehouse</label><select class="form-select" x-model="adjustment.warehouseId"><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name"></option></template></select></div>
<div class="col-lg-3"><label class="form-label">Product</label><select class="form-select" x-model="adjustment.productId"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></div>
<div class="col-lg-2"><label class="form-label">Stock bucket</label><select class="form-select" x-model="adjustment.bucket"><option value="available">Available</option><option value="reserved">Reserved</option><option value="incoming">Incoming</option><option value="picked">Picked</option><option value="packed">Packed</option><option value="damaged">Damaged</option><option value="returned">Returned</option></select></div>
<div class="col-lg-2"><label class="form-label">Quantity change</label><input type="number" class="form-control" x-model.number="adjustment.quantityDelta" placeholder="+5 or -2"></div>
<div class="col-lg-2"><label class="form-label">Reason</label><input class="form-control" x-model="adjustment.reason" placeholder="Reason"></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="adjustStock()">Save adjustment</button></div></div></div>
<% } %>

<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Stock balances</h2><p class="text-muted mb-0">Available, reserved, incoming and fulfilment quantities by warehouse.</p></div><div class="d-flex gap-2"><select class="form-select form-select-sm" x-model="warehouseFilter" @change="filterBalances()"><option value="">All warehouses</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name"></option></template></select><button class="btn btn-light btn-sm" @click="loadBalances()">Refresh</button></div></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Warehouse</th><th class="text-end">Available</th><th class="text-end">Reserved</th><th class="text-end">Incoming</th><th class="text-end">Picked</th><th class="text-end">Packed</th><th class="text-end">Damaged</th></tr></thead><tbody>
<template x-for="x in balances" :key="x.inventoryBalanceId"><tr><td><strong x-text="productName(x.productId)"></strong><div class="text-muted fs-sm" x-text="productSku(x.productId)"></div></td><td x-text="warehouseName(x.warehouseId)"></td><td class="text-end fw-semibold" x-text="x.availableQty||0"></td><td class="text-end" x-text="x.reservedQty||0"></td><td class="text-end" x-text="x.incomingQty||0"></td><td class="text-end" x-text="x.pickedQty||0"></td><td class="text-end" x-text="x.packedQty||0"></td><td class="text-end" x-text="x.damagedQty||0"></td></tr></template>
<tr x-show="!loading && !balances.length"><td colspan="8"><div class="crm-empty-state"><strong>No stock balances found</strong><span>Stock will appear after goods are received or adjusted.</span></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>

<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Recent stock movements</h2><p class="text-muted mb-0">Auditable movement ledger.</p></div><button class="btn btn-light btn-sm" @click="loadMovements()">Refresh</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Time</th><th>Product</th><th>Warehouse</th><th>Movement</th><th>Bucket</th><th class="text-end">Quantity</th><th>Reason</th></tr></thead><tbody><template x-for="m in movements" :key="m.inventoryMovementId"><tr><td x-text="formatDate(m.createdAt)"></td><td x-text="productName(m.productId)"></td><td x-text="warehouseName(m.warehouseId)"></td><td><span class="crm-status" :class="statusClass(m.movementType)" x-text="humanize(m.movementType)"></span></td><td x-text="humanize(m.bucket)"></td><td class="text-end fw-semibold" :class="Number(m.quantityDelta)<0?'text-danger':'text-success'" x-text="(Number(m.quantityDelta)>0?'+':'')+Number(m.quantityDelta||0)"></td><td x-text="m.reason||'—'"></td></tr></template></tbody></table></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function inventoryPage(){return{
...crmPager('loadBalances'),balances:[],movements:[],products:[],warehouses:[],loading:true,error:'',showAdjustment:false,warehouseFilter:'',productSearch:'',adjustment:{warehouseId:'',productId:'',bucket:'available',quantityDelta:0,reason:''},
async load(){try{const[p,w]=await Promise.all([apiFetch('/api/products?limit=50'),apiFetch('/api/warehouses')]);this.products=p.data.items||[];this.warehouses=w.data.items||[];await Promise.all([this.loadBalances(),this.loadMovements()])}catch(e){this.error=e.message}finally{this.loading=false}},async searchProducts(){try{this.products=(await apiFetch('/api/products?limit=100&search='+encodeURIComponent(this.productSearch))).data.items||[]}catch(e){this.error=e.message}},
async loadBalances(){this.loading=true;try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.warehouseFilter)q.set('warehouseId',this.warehouseFilter);const data=(await apiFetch('/api/inventory?'+q)).data;this.balances=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},filterBalances(){this.resetPage();return this.loadBalances()},
async loadMovements(){try{this.movements=(await apiFetch('/api/inventory/movements?limit=100')).data.items||[]}catch(e){this.error=e.message}},
productName(id){return this.products.find(x=>x.productId===id)?.name||id},productSku(id){return this.products.find(x=>x.productId===id)?.sku||''},warehouseName(id){return this.warehouses.find(x=>x.warehouseId===id)?.name||id},
async adjustStock(){const a=this.adjustment;if(!a.warehouseId||!a.productId||!Number(a.quantityDelta))return this.error='Warehouse, product and a non-zero quantity are required.';try{await apiFetch('/api/inventory/adjustments',{method:'POST',body:JSON.stringify(a)});showCrmToast('Inventory adjusted');this.showAdjustment=false;this.adjustment={warehouseId:'',productId:'',bucket:'available',quantityDelta:0,reason:''};await Promise.all([this.loadBalances(),this.loadMovements()])}catch(e){this.error=e.message;showCrmToast(e.message,'error')}}
}}</script><%- include('partials/scripts') %>
</body></html>