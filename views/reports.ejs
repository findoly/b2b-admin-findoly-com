<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Insights</div><h1 class="page-title mb-1">Reports</h1><p class="crm-page-subtitle mb-0">Sales, procurement, margin, cash, receivables and supplier performance.</p></div><% if (can('reports.export')) { %><a class="btn btn-light crm-primary-action" :href="$data.reportExportUrl" x-data="{get reportExportUrl(){return '/api/reports/business.csv'}}" style="display:none"></a><% } %></div></div>
<div class="content" x-data="reportsPage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" role="alert"><span x-text="error"></span> <button type="button" class="btn btn-sm btn-outline-danger ms-2" @click="load()">Retry</button></div><div x-show="loading" x-cloak class="card crm-data-card mb-3" role="status" aria-live="polite"><div class="card-body d-flex align-items-center gap-3"><div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div><span>Loading business report…</span></div></div>
<section class="card crm-filter-card mb-4"><div class="crm-filter-bar"><label class="crm-filter-field crm-filter-date"><span>From</span><input class="form-control" type="date" x-model="from"></label><label class="crm-filter-field crm-filter-date"><span>To</span><input class="form-control" type="date" x-model="to"></label><div class="crm-filter-actions"><button class="btn btn-primary" :disabled="loading" @click="load()" x-text="loading ? 'Running…' : 'Run report'">Run report</button><% if (can('reports.export')) { %><a class="btn btn-light" :href="exportUrl">Export CSV</a><% } %></div></div></section>
<section class="crm-metric-grid mb-4" x-show="!loading && !error" x-cloak>
<template x-for="m in metrics" :key="m.label"><article class="crm-metric-card" :class="m.tone"><div class="crm-metric-top"><div><span class="crm-metric-label" x-text="m.label"></span><strong class="crm-metric-value" x-text="m.value"></strong></div></div><div class="crm-metric-note" x-text="m.note"></div></article></template>
</section>
<section class="crm-visual-grid mb-4" x-show="!loading && !error" x-cloak aria-label="Visual business report">
 <article class="card crm-data-card crm-visual-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Sales team comparison</h2><p class="text-muted mb-0">Top five employees · net sales excluding GST</p></div></div><div class="card-body"><div x-show="!topAgents().length" class="crm-empty-state">No sales activity in this range.</div><div class="crm-comparison-list"><template x-for="(agent,index) in topAgents()" :key="agent.employeeId"><div class="crm-comparison-row"><div class="crm-comparison-meta"><strong x-text="agent.employeeName"></strong><small x-text="money(agent.netSalesPaise)"></small></div><div class="crm-comparison-track" role="img" :aria-label="agentBarLabel(agent)"><span :style="agentBarStyle(agent,index)"></span></div></div></template></div></div></article>
 <article class="card crm-data-card crm-visual-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier comparison</h2><p class="text-muted mb-0">Top five suppliers by allocated procurement cost</p></div><% if(can('suppliers.view')){ %><a class="btn btn-light btn-sm" href="/suppliers">Manage suppliers</a><% } %></div><div class="card-body"><div x-show="!topSuppliers().length" class="crm-empty-state">No supplier activity in this range.</div><div class="crm-comparison-list"><template x-for="(supplier,index) in topSuppliers()" :key="supplier.supplierId"><div class="crm-comparison-row"><div class="crm-comparison-meta"><strong x-text="supplier.supplierName"></strong><small x-text="money(supplier.procurementCostPaise)"></small></div><div class="crm-comparison-track" role="img" :aria-label="supplierBarLabel(supplier)"><span :style="supplierBarStyle(supplier,index)"></span></div><% if(can('suppliers.view')){ %><a class="crm-chart-text-link" :href="'/suppliers?supplierId='+supplier.supplierId">Open supplier</a><% } %></div></template></div></div></article>
</section>
<div class="row g-4" x-show="!loading && !error" x-cloak>
<div class="col-lg-7"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Sales employee performance</h2><p class="text-muted mb-0">Net sales and gross margin by assigned employee.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Employee</th><th class="text-end">Orders</th><th class="text-end">Net sales</th><th class="text-end">Stock cost</th><th class="text-end">Procurement</th><th class="text-end">COGS</th><th class="text-end">Margin</th></tr></thead><tbody><template x-for="x in data.agentPerformance||[]" :key="x.employeeId"><tr><td><strong x-text="x.employeeName||'Unknown employee'"></strong></td><td class="text-end" x-text="x.orderCount"></td><td class="text-end" x-text="money(x.netSalesPaise)"></td><td class="text-end" x-text="money(x.stockCostPaise)"></td><td class="text-end" x-text="money(x.procurementCostPaise)"></td><td class="text-end" x-text="money(x.cogsPaise)"></td><td class="text-end fw-semibold" x-text="money(x.grossMarginPaise)"></td></tr></template><tr x-show="!(data.agentPerformance||[]).length"><td colspan="7"><div class="crm-empty-state"><strong>No sales activity in this range</strong></div></td></tr></tbody></table></div></div></div>
<div class="col-lg-5"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier performance</h2><p class="text-muted mb-0">Procurement allocation and purchase cost.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Supplier</th><th class="text-end">Qty</th><th class="text-end">Cost</th></tr></thead><tbody><template x-for="x in data.supplierPerformance||[]" :key="x.supplierId"><tr><td><strong x-text="x.supplierName||'Supplier'"></strong><div class="text-muted fs-sm" x-text="x.allocationCount+' allocations'"></div></td><td class="text-end" x-text="x.quantity"></td><td class="text-end fw-semibold" x-text="money(x.procurementCostPaise)"></td></tr></template><tr x-show="!(data.supplierPerformance||[]).length"><td colspan="3"><div class="crm-empty-state"><strong>No supplier activity in this range</strong></div></td></tr></tbody></table></div></div></div>
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Order status mix</h2><p class="text-muted mb-0">Operational distribution across the selected period.</p></div></div><div class="card-body crm-donut-layout"><div class="crm-donut-wrap"><div class="crm-donut" :style="reportDonutStyle()" role="img" :aria-label="reportDonutLabel()"><span><strong x-text="data.salesOrderCount||0"></strong><small>orders</small></span></div></div><div class="crm-donut-legend"><template x-for="slice in reportSlices()" :key="slice.status"><div class="crm-donut-legend-row"><span class="crm-chart-dot" :style="slice.dotStyle"></span><span x-text="slice.label"></span><strong x-text="slice.count"></strong><% if(can('orders.view')) { %><a x-show="slice.href" :href="slice.href">View</a><% } %></div></template></div></div></div></div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function reportsPage(){const today=new Date(),fromDate=new Date(Date.now()-30*86400000);return{
from:fromDate.toISOString().slice(0,10),to:today.toISOString().slice(0,10),data:{},error:'',loading:false,
get exportUrl(){return '/api/reports/business.csv?from='+encodeURIComponent(this.from)+'&to='+encodeURIComponent(this.to)},
get metrics(){return[
{label:'Orders',value:new Intl.NumberFormat('en-IN').format(this.data.salesOrderCount||0),note:'Sales orders in period',tone:'crm-metric-blue'},
{label:'Net sales',value:money(this.data.netSalesPaise),note:'Taxable sales value',tone:'crm-metric-green'},
{label:'COGS',value:money(this.data.cogsPaise),note:'Existing-stock cost plus procured-stock cost',tone:'crm-metric-amber'},
{label:'Gross margin',value:money(this.data.grossMarginPaise),note:'Net sales less COGS',tone:'crm-metric-purple'},
{label:'Customer collections',value:money(this.data.customerCollectionsPaise),note:'Payments received in period',tone:'crm-metric-blue'},
{label:'Supplier payments',value:money(this.data.supplierPaymentsPaise),note:'Payments made in period',tone:'crm-metric-amber'},
{label:'Receivables',value:money(this.data.currentReceivableOutstandingPaise),note:'Current outstanding customer invoices',tone:'crm-metric-amber'},
{label:'Payables',value:money(this.data.currentPayableOutstandingPaise),note:'Current outstanding supplier bills',tone:'crm-metric-purple'},
{label:'Returns',value:new Intl.NumberFormat('en-IN').format(this.data.returnCount||0),note:'Returns opened in period',tone:'crm-metric-blue'}]},
topAgents(){return(this.data.agentPerformance||[]).slice(0,5)},topSuppliers(){return(this.data.supplierPerformance||[]).slice(0,5)},
agentBarLabel(x){return (x.employeeName||'Employee')+': '+money(x.netSalesPaise)},supplierBarLabel(x){return (x.supplierName||'Supplier')+': '+money(x.procurementCostPaise)},
agentBarStyle(x,index){const max=Math.max(1,...this.topAgents().map(a=>Math.max(0,Number(a.netSalesPaise||0))));return 'width:'+Math.max(0,Math.min(100,Number(x.netSalesPaise||0)/max*100))+'%;background-color:'+['#3478d4','#32a17b','#8766c7','#e49a47','#de6b72'][index%5]},
supplierBarStyle(x,index){const max=Math.max(1,...this.topSuppliers().map(a=>Number(a.procurementCostPaise||0)));return 'width:'+Math.max(0,Math.min(100,Number(x.procurementCostPaise||0)/max*100))+'%;background-color:'+['#8766c7','#3478d4','#32a17b','#e49a47','#de6b72'][index%5]},
reportSlices(){const entries=Object.entries(this.data.orderStatusCounts||{}).filter(([,n])=>Number(n)>0).sort((a,b)=>b[1]-a[1]),top=entries.slice(0,4).map(([status,count])=>({status,label:humanize(status),count:Number(count)}));if(entries.length>4)top.push({status:'other',label:'Other statuses',count:entries.slice(4).reduce((n,e)=>n+Number(e[1]),0)});const colors=['#3478d4','#32a17b','#8766c7','#e49a47','#de6b72'];return top.map((x,i)=>({...x,color:colors[i],dotStyle:'background-color:'+colors[i],href:x.status==='other'?'':'/orders?status='+encodeURIComponent(x.status)}));},
reportDonutStyle(){const slices=this.reportSlices(),total=slices.reduce((n,x)=>n+x.count,0);if(!total)return 'background:var(--crm-chart-track,#edf1f5)';let offset=0;return 'background:conic-gradient('+slices.map(x=>{const start=offset;offset+=100*x.count/total;return x.color+' '+start+'% '+offset+'%'}).join(',')+')'},
reportDonutLabel(){return 'Order status distribution of '+(this.data.salesOrderCount||0)+' orders'},
async load(){if(this.loading)return;this.loading=true;this.error='';try{this.data=(await apiFetch('/api/reports/business?from='+encodeURIComponent(this.from)+'&to='+encodeURIComponent(this.to))).data||{}}catch(e){this.error=e.message}finally{this.loading=false}}
}}</script><%- include('partials/scripts') %>
</body></html>