<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Insights</div><h1 class="page-title mb-1">Reports</h1><p class="crm-page-subtitle mb-0">Sales, procurement, margin, cash, receivables and supplier performance.</p></div><% if (can('reports.export')) { %><a class="btn btn-light crm-primary-action" :href="$data.reportExportUrl" x-data="{get reportExportUrl(){return '/api/reports/business.csv'}}" style="display:none"></a><% } %></div></div>
<div class="content" x-data="reportsPage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card mb-4"><div class="card-body"><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">From</label><input class="form-control" type="date" x-model="from"></div><div class="col-md-3"><label class="form-label">To</label><input class="form-control" type="date" x-model="to"></div><div class="col-md-3"><button class="btn btn-primary w-100" @click="load()">Run report</button></div><% if (can('reports.export')) { %><div class="col-md-3"><a class="btn btn-outline-secondary w-100" :href="exportUrl">Export CSV</a></div><% } %></div></div></div>
<section class="crm-metric-grid mb-4">
<template x-for="m in metrics" :key="m.label"><article class="crm-metric-card" :class="m.tone"><div class="crm-metric-top"><div><span class="crm-metric-label" x-text="m.label"></span><strong class="crm-metric-value" x-text="m.value"></strong></div></div><div class="crm-metric-note" x-text="m.note"></div></article></template>
</section>
<div class="row g-4">
<div class="col-lg-7"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Sales employee performance</h2><p class="text-muted mb-0">Net sales and gross margin by assigned employee.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Employee</th><th class="text-end">Orders</th><th class="text-end">Net sales</th><th class="text-end">Stock cost</th><th class="text-end">Procurement</th><th class="text-end">COGS</th><th class="text-end">Margin</th></tr></thead><tbody><template x-for="x in data.agentPerformance||[]" :key="x.employeeId"><tr><td><strong x-text="x.employeeName||'Unknown employee'"></strong><div class="crm-record-id" x-text="x.employeeId"></div></td><td class="text-end" x-text="x.orderCount"></td><td class="text-end" x-text="money(x.netSalesPaise)"></td><td class="text-end" x-text="money(x.stockCostPaise)"></td><td class="text-end" x-text="money(x.procurementCostPaise)"></td><td class="text-end" x-text="money(x.cogsPaise)"></td><td class="text-end fw-semibold" x-text="money(x.grossMarginPaise)"></td></tr></template><tr x-show="!(data.agentPerformance||[]).length"><td colspan="7"><div class="crm-empty-state"><strong>No sales activity in this range</strong></div></td></tr></tbody></table></div></div></div>
<div class="col-lg-5"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier performance</h2><p class="text-muted mb-0">Procurement allocation and purchase cost.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Supplier</th><th class="text-end">Qty</th><th class="text-end">Cost</th></tr></thead><tbody><template x-for="x in data.supplierPerformance||[]" :key="x.supplierId"><tr><td><strong x-text="x.supplierName||'Supplier'"></strong><div class="text-muted fs-sm" x-text="x.allocationCount+' allocations'"></div></td><td class="text-end" x-text="x.quantity"></td><td class="text-end fw-semibold" x-text="money(x.procurementCostPaise)"></td></tr></template></tbody></table></div></div></div>
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Order status mix</h2><p class="text-muted mb-0">Operational distribution across the selected period.</p></div></div><div class="card-body"><div class="row g-2"><template x-for="[status,count] in Object.entries(data.orderStatusCounts||{})" :key="status"><div class="col-6 col-md-3 col-xl-2"><div class="border rounded p-3"><div class="text-muted fs-sm" x-text="humanize(status)"></div><div class="fs-4 fw-bold" x-text="count"></div></div></div></template></div></div></div></div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function reportsPage(){const today=new Date(),fromDate=new Date(Date.now()-30*86400000);return{
from:fromDate.toISOString().slice(0,10),to:today.toISOString().slice(0,10),data:{},error:'',
get exportUrl(){return '/api/reports/business.csv?from='+encodeURIComponent(this.from)+'&to='+encodeURIComponent(this.to)},
get metrics(){return[
{label:'Orders',value:new Intl.NumberFormat('en-IN').format(this.data.salesOrderCount||0),note:'Sales orders in period',tone:'crm-metric-blue'},
{label:'Net sales',value:money(this.data.netSalesPaise),note:'Taxable sales value',tone:'crm-metric-green'},
{label:'COGS',value:money(this.data.cogsPaise),note:'Existing-stock cost plus procured-stock cost',tone:'crm-metric-amber'},
{label:'Gross margin',value:money(this.data.grossMarginPaise),note:'Net sales less COGS',tone:'crm-metric-purple'},
{label:'Customer collections',value:money(this.data.customerCollectionsPaise),note:'Payments received in period',tone:'crm-metric-blue'},
{label:'Supplier payments',value:money(this.data.supplierPaymentsPaise),note:'Payments made in period',tone:'crm-metric-amber'},
{label:'Receivables',value:money(this.data.currentReceivableOutstandingPaise),note:'Current outstanding customer invoices',tone:'crm-metric-amber'},
{label:'Payables',value:money(this.data.currentPayableOutstandingPaise),note:'Current outstanding supplier bills',tone:'crm-metric-purple'},
{label:'Returns',value:new Intl.NumberFormat('en-IN').format(this.data.returnCount||0),note:'Returns opened in period',tone:'crm-metric-blue'}]},
async load(){try{this.data=(await apiFetch('/api/reports/business?from='+encodeURIComponent(this.from)+'&to='+encodeURIComponent(this.to))).data||{}}catch(e){this.error=e.message}}
}}</script><%- include('partials/scripts') %>
</body></html>