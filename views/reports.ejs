<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="reportsPage()" x-init="load()"><div class="d-flex gap-2 align-items-end mb-3"><div><label class="form-label">From</label><input class="form-control" type="date" x-model="from"></div><div><label class="form-label">To</label><input class="form-control" type="date" x-model="to"></div><button class="btn btn-primary" @click="load()">Run report</button><a class="btn btn-outline-secondary" :href="'/api/reports/business.csv?from='+encodeURIComponent(from)+'&to='+encodeURIComponent(to)">CSV export</a></div><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3 mb-3"><template x-for="m in metrics" :key="m.label"><div class="col-6 col-xl-3"><div class="card metric"><div class="card-body"><div class="small text-secondary" x-text="m.label"></div><div class="fs-4 fw-bold" x-text="m.value"></div></div></div></div></template></div><div class="row g-3"><div class="col-lg-6"><div class="card crm-data-card"><div class="card-header fw-semibold">Sales agent performance</div><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Employee</th><th>Orders</th><th>Net sales</th><th>Margin</th></tr></thead><tbody><template x-for="x in data.agentPerformance||[]"><tr><td class="small" x-text="x.employeeId"></td><td x-text="x.orderCount"></td><td x-text="money(x.netSalesPaise)"></td><td x-text="money(x.grossMarginPaise)"></td></tr></template></tbody></table></div></div></div><div class="col-lg-6"><div class="card crm-data-card"><div class="card-header fw-semibold">Supplier performance</div><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Supplier</th><th>Allocations</th><th>Qty</th><th>Cost</th></tr></thead><tbody><template x-for="x in data.supplierPerformance||[]"><tr><td><span x-text="x.supplierName||x.supplierId"></span></td><td x-text="x.allocationCount"></td><td x-text="x.quantity"></td><td x-text="money(x.procurementCostPaise)"></td></tr></template></tbody></table></div></div></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function reportsPage(){const d=new Date(),t=d.toISOString().slice(0,10),f=new Date(Date.now()-30*86400000).toISOString().slice(0,10);return{from:f,to:t,data:{},error:'',get metrics(){return[{label:'Orders',value:this.data.salesOrderCount||0},{label:'Net sales',value:money(this.data.netSalesPaise||0)},{label:'Procurement cost',value:money(this.data.procurementCostPaise||0)},{label:'Gross margin',value:money(this.data.grossMarginPaise||0)},{label:'Customer collections',value:money(this.data.customerCollectionsPaise||0)},{label:'Supplier payments',value:money(this.data.supplierPaymentsPaise||0)},{label:'Receivables',value:money(this.data.currentReceivableOutstandingPaise||0)},{label:'Payables',value:money(this.data.currentPayableOutstandingPaise||0)}]},async load(){try{this.data=(await apiFetch('/api/reports/business?from='+encodeURIComponent(this.from)+'&to='+encodeURIComponent(this.to))).data}catch(e){this.error=e.message}}}}</script></body></html>