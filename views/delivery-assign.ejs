<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Delivery workflow</div><h1 class="page-title mb-1">Assign delivery</h1><p class="crm-page-subtitle mb-0">Order, warehouse and product data are connected automatically. Enter only the delivery information that is still missing.</p></div><a class="btn btn-light" href="/delivery">Back to delivery</a></div></div>
<div class="content" x-data="deliveryAssignPage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card mb-4"><div class="card-body"><div class="row g-2">
<template x-for="(label,index) in steps" :key="label"><div class="col-6 col-lg-3"><button type="button" class="btn w-100" :class="step===index+1?'btn-primary':'btn-light'" :disabled="index+1>step" @click="step=index+1"><span class="me-1" x-text="index+1"></span><span x-text="label"></span></button></div></template>
</div></div></div>

<div class="card crm-data-card" x-show="step===1" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">1. Select sales order</h2><p class="text-muted mb-0">Only packed or ready-for-dispatch orders are available.</p></div></div><div class="card-body">
<div class="input-group mb-3"><input class="form-control" placeholder="Search order, customer or mobile" x-model="search" @keyup.enter="searchOrders()"><button class="btn btn-light" type="button" @click="searchOrders()">Find</button></div>
<select class="form-select" x-model="form.salesOrderId" @change="orderChanged()"><option value="">Select eligible order</option><template x-for="o in options.orders" :key="o.salesOrderId"><option :value="o.salesOrderId" x-text="o.orderNumber+' · '+(crmValue(o,'customerSnapshot.businessName',''))+' · '+(o.lines||[]).length+' products'"></option></template></select>
<template x-if="selectedOrder"><div class="row g-3 mt-2"><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Customer</div><strong x-text="crmValue(selectedOrder,'customerSnapshot.businessName','—')"></strong><div class="text-muted fs-sm" x-text="crmValue(selectedOrder,'customerSnapshot.mobile','')"></div></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Order</div><strong x-text="selectedOrder.orderNumber"></strong><div class="text-muted fs-sm" x-text="humanize(selectedOrder.status)"></div></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Delivery address</div><strong x-text="addressText(selectedOrder.deliveryAddressSnapshot)"></strong></div></div></div></template>
<div class="text-end mt-4"><button class="btn btn-primary" @click="next()">Continue</button></div>
</div></div>

<div class="card crm-data-card" x-show="step===2" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">2. Warehouse & products</h2><p class="text-muted mb-0">These values come from the sales order and packed warehouse stock; they cannot be manually replaced here.</p></div></div><div class="card-body">
<div class="alert alert-info"><strong x-text="crmValue(selectedWarehouse,'name','Warehouse')"></strong><span x-show="crmValue(selectedWarehouse,'code','')"> · </span><span x-text="crmValue(selectedWarehouse,'code','')||''"></span><div class="mt-1" x-text="addressText(crmValue(selectedWarehouse,'address',null))"></div></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>SKU</th><th class="text-end">Packed / delivery qty</th></tr></thead><tbody><template x-for="line in crmList(selectedOrder,'lines')" :key="line.salesOrderLineId"><tr><td><a :href="'/products/'+line.productId" x-text="line.productName"></a></td><td x-text="line.sku"></td><td class="text-end fw-semibold" x-text="line.quantity"></td></tr></template></tbody></table></div>
<div class="d-flex justify-content-between mt-4"><button class="btn btn-light" @click="step=1">Back</button><button class="btn btn-primary" @click="next()">Continue</button></div>
</div></div>

<div class="card crm-data-card" x-show="step===3" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">3. Delivery person / provider</h2><p class="text-muted mb-0">Internal employee details are auto-filled from Employees; third-party details are entered only when needed.</p></div></div><div class="card-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Delivery type</label><select class="form-select" x-model="form.deliveryType" @change="deliveryTypeChanged()"><option value="internal">Findoly / internal</option><option value="third_party">Third party</option></select></div>
<template x-if="form.deliveryType==='internal'"><div class="col-md-8"><label class="form-label">Delivery employee</label><select class="form-select" x-model="form.assignedDriverId"><option value="">Select delivery employee</option><template x-for="d in options.drivers" :key="d.employeeId"><option :value="d.employeeId" x-text="d.name+' · '+d.mobile+(d.designation?' · '+d.designation:'')"></option></template></select><div class="text-muted fs-sm mt-1" x-show="!options.drivers.length">No active delivery-eligible employee is configured. Enable one from Employees.</div></div></template>
<template x-if="form.deliveryType==='third_party'"><div class="col-12"><div class="row g-3"><div class="col-md-4"><label class="form-label">Provider name</label><input class="form-control" x-model="form.deliveryProviderName" placeholder="Courier / logistics partner"></div><div class="col-md-4"><label class="form-label">Driver / contact name</label><input class="form-control" x-model="form.driverName"></div><div class="col-md-4"><label class="form-label">Driver / contact mobile</label><input class="form-control" inputmode="numeric" maxlength="10" x-model="form.driverMobile"></div><div class="col-md-6"><label class="form-label">External tracking reference</label><input class="form-control" x-model="form.externalReference"></div><div class="col-md-6"><label class="form-label">Tracking URL</label><input class="form-control" x-model="form.trackingUrl"></div></div></div></template>
<div class="col-md-6"><label class="form-label">Expected collection ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.expectedCollectionRupees"><div class="text-muted fs-sm">Enter only the amount the delivery person is expected to collect for this trip.</div></div>
<div class="col-md-6"><label class="form-label">Assignment note</label><input class="form-control" x-model="form.note" placeholder="Optional operational note"></div>
</div><div class="d-flex justify-content-between mt-4"><button class="btn btn-light" @click="step=2">Back</button><button class="btn btn-primary" @click="next()">Review</button></div></div></div>

<div class="card crm-data-card" x-show="step===4" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">4. Review & assign</h2><p class="text-muted mb-0">Confirm the connected order, warehouse, products and delivery person before assignment.</p></div></div><div class="card-body">
<div class="row g-3"><div class="col-lg-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Order / customer</div><strong x-text="crmValue(selectedOrder,'orderNumber','—')"></strong><div x-text="crmValue(selectedOrder,'customerSnapshot.businessName','')"></div></div></div><div class="col-lg-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Warehouse</div><strong x-text="crmValue(selectedWarehouse,'name','—')"></strong><div x-text="crmValue(selectedWarehouse,'code','')||''"></div></div></div><div class="col-lg-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Delivery person / provider</div><strong x-text="reviewDriverName()"></strong><div x-text="reviewDriverMobile()"></div></div></div></div>
<div class="table-responsive mt-4"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>SKU</th><th class="text-end">Qty</th></tr></thead><tbody><template x-for="line in crmList(selectedOrder,'lines')" :key="line.salesOrderLineId"><tr><td x-text="line.productName"></td><td x-text="line.sku"></td><td class="text-end" x-text="line.quantity"></td></tr></template></tbody></table></div>
<div class="d-flex justify-content-between align-items-center mt-4"><button class="btn btn-light" @click="step=3">Back</button><div class="text-end"><div class="text-muted fs-sm">Expected collection</div><div class="fw-semibold mb-2" x-text="'₹'+Number(form.expectedCollectionRupees||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})"></div><button class="btn btn-primary" @click="assign()" :disabled="saving" x-text="saving?'Assigning…':'Confirm & assign delivery'"></button></div></div>
</div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function deliveryAssignPage(){return{
steps:['Order','Warehouse & products','Delivery person','Review'],step:1,options:{orders:[],drivers:[],warehouses:[]},search:'',error:'',saving:false,prefill:'',form:{salesOrderId:'',deliveryType:'internal',assignedDriverId:'',deliveryProviderName:'Findoly',driverName:'',driverMobile:'',externalReference:'',trackingUrl:'',expectedCollectionRupees:0,note:''},
get selectedOrder(){return this.options.orders.find(x=>x.salesOrderId===this.form.salesOrderId)||null},get selectedWarehouse(){return this.options.warehouses.find(x=>x.warehouseId===this.selectedOrder?.warehouseId)||null},get selectedDriver(){return this.options.drivers.find(x=>x.employeeId===this.form.assignedDriverId)||null},
async load(){this.prefill=new URLSearchParams(location.search).get('salesOrderId')||'';try{await this.loadOptions(this.prefill?{salesOrderId:this.prefill}:{})}catch(e){this.error=e.message}},
async loadOptions(extra={}){const q=new URLSearchParams(extra);const data=(await apiFetch('/api/delivery/options'+(q.toString()?'?'+q:''))).data;this.options=data;if(this.prefill&&data.orders?.some(o=>o.salesOrderId===this.prefill)){this.form.salesOrderId=this.prefill;this.orderChanged()}},
async searchOrders(){try{await this.loadOptions(this.search?{search:this.search}:{})}catch(e){this.error=e.message}},
orderChanged(){if(!this.selectedOrder)return;this.error='';this.form.expectedCollectionRupees=0},
deliveryTypeChanged(){this.error='';if(this.form.deliveryType==='internal'){this.form.deliveryProviderName='Findoly';this.form.driverName='';this.form.driverMobile='';this.form.externalReference='';this.form.trackingUrl=''}else{this.form.assignedDriverId='';this.form.deliveryProviderName=''}},
addressText(a){if(!a)return'—';return[a.line1,a.line2,a.city,a.state,a.pincode].filter(Boolean).join(', ')||'—'},
next(){this.error='';if(this.step===1&&!this.selectedOrder)return this.error='Select a sales order.';if(this.step===2&&(!this.selectedWarehouse||!(this.selectedOrder?.lines||[]).length))return this.error='The selected order is missing warehouse or product information.';if(this.step===3){if(this.form.deliveryType==='internal'&&!this.selectedDriver)return this.error='Select a delivery employee.';if(this.form.deliveryType==='third_party'&&!this.form.deliveryProviderName.trim())return this.error='Enter the third-party delivery provider.';}this.step=Math.min(4,this.step+1);window.scrollTo({top:0,behavior:'smooth'})},
reviewDriverName(){return this.form.deliveryType==='internal'?(this.selectedDriver?.name||'—'):(this.form.driverName||this.form.deliveryProviderName||'—')},reviewDriverMobile(){return this.form.deliveryType==='internal'?(this.selectedDriver?.mobile||''):(this.form.driverMobile||this.form.deliveryProviderName||'')},
async assign(){if(!this.selectedOrder)return this.error='Select a sales order.';this.saving=true;this.error='';try{const body={salesOrderId:this.form.salesOrderId,deliveryType:this.form.deliveryType,assignedDriverId:this.form.assignedDriverId,deliveryProviderName:this.form.deliveryProviderName,driverName:this.form.driverName,driverMobile:this.form.driverMobile,externalReference:this.form.externalReference,trackingUrl:this.form.trackingUrl,expectedCollectionPaise:Math.round(Number(this.form.expectedCollectionRupees||0)*100),note:this.form.note};const x=(await apiFetch('/api/delivery',{method:'POST',body:JSON.stringify(body)})).data;showCrmToast('Delivery assigned');location.href='/delivery/'+x.deliveryAssignmentId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}
}}</script><%- include('partials/scripts') %>
</body></html>
