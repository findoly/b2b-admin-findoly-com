<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Inventory</div><h1 class="page-title mb-1">Movement ledger</h1><p class="crm-page-subtitle mb-0">Immutable stock events from receipt, reservation, fulfilment, delivery, returns and adjustments.</p></div><a class="btn btn-light" href="/inventory">Stock balances</a></div></div>
<div class="content" x-data="inventoryMovementsPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div class="card crm-data-card"><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Time</th><th>Product</th><th>Warehouse</th><th>Movement</th><th>Bucket</th><th class="text-end">Qty</th><th>Reason</th></tr></thead><tbody><template x-for="m in movements" :key="m.inventoryMovementId"><tr><td x-text="formatDate(m.createdAt)"></td><td><a :href="'/products/'+m.productId" x-text="productName(m.productId)"></a></td><td x-text="warehouseName(m.warehouseId)"></td><td><span class="crm-status" :class="statusClass(m.movementType)" x-text="humanize(m.movementType)"></span></td><td x-text="humanize(m.bucket)"></td><td class="text-end fw-semibold" :class="Number(m.quantityDelta)<0?'text-danger':'text-success'" x-text="(Number(m.quantityDelta)>0?'+':'')+Number(m.quantityDelta||0)"></td><td x-text="m.reason||'—'"></td></tr></template><tr x-show="!movements.length"><td colspan="7"><div class="crm-empty-state"><strong>No stock movements</strong></div></td></tr></tbody></table></div></div></div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function inventoryMovementsPage(){return{movements:[],products:[],warehouses:[],error:'',async load(){try{const[m,p,w]=await Promise.all([apiFetch('/api/inventory/movements?limit=100'),apiFetch('/api/products?limit=100'),apiFetch('/api/warehouses')]);this.movements=m.data.items||[];this.products=p.data.items||[];this.warehouses=w.data.items||[]}catch(e){this.error=e.message}},productName(id){const p=this.products.find(x=>x.productId===id);return p?p.name+' · '+p.sku:'Product'},warehouseName(id){return this.warehouses.find(x=>x.warehouseId===id)?.name||'Warehouse'}}}</script><%- include('partials/scripts') %>
</body></html>
