<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Sales order workflow</div><h1 class="page-title mb-1">New sales order</h1><p class="crm-page-subtitle mb-0">Customer → products and pricing → warehouse → review.</p></div><a class="btn btn-light" href="/orders">Back to orders</a></div></div>
<div class="content" x-data="orderFormPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" role="alert" aria-live="assertive" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" role="alert" aria-live="assertive" x-text="error"></div>

<div class="card crm-data-card mb-4 crm-order-timeline-card"><div class="card-body">
  <div class="crm-order-timeline" role="list" aria-label="Sales order stages">
    <template x-for="(label,index) in steps" :key="label">
      <button class="crm-order-timeline-step" type="button" role="listitem" :class="{'is-active':step===index+1,'is-complete':step>index+1}" :disabled="index+1>step" @click="go(index+1)">
        <span class="crm-order-timeline-node"><span x-show="step<=index+1" x-text="index+1"></span><span x-show="step>index+1" aria-hidden="true">✓</span></span>
        <span class="crm-order-timeline-copy"><strong x-text="label"></strong><small x-text="stageStatus(index+1)"></small></span>
      </button>
    </template>
  </div>
</div></div>

<div class="card crm-data-card" x-show="step===1" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">1. Customer</h2><p class="text-muted mb-0">Select the business account receiving this order.</p></div></div><div class="card-body">
  <label class="visually-hidden" for="customer-search">Search customer by business name or mobile</label><div class="input-group mb-3"><input id="customer-search" class="form-control" placeholder="Search business name or mobile" x-model="customerSearch" @input.debounce.300ms="searchCustomers()" @keyup.enter="searchCustomers()"><button class="btn btn-light" type="button" @click="searchCustomers()">Find</button></div>
  <label class="visually-hidden" for="customer-select">Select customer</label><select id="customer-select" class="form-select" x-model="form.customerId" @change="customerChanged()"><option value="">Select customer</option><template x-for="c in customers" :key="c.customerId"><option :value="c.customerId" x-text="c.businessName+' · '+c.mobile"></option></template></select>
  <template x-if="selectedCustomer"><div class="row g-3 mt-2"><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Customer</div><strong x-text="selectedCustomer.businessName"></strong><div class="text-muted fs-sm" x-text="selectedCustomer.customerType"></div></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Credit limit</div><strong x-text="money(selectedCustomer.creditLimitPaise)"></strong><div class="text-muted fs-sm" x-text="selectedCustomer.creditHold?'Credit hold active':'Credit available subject to exposure'"></div></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Default terms</div><strong x-text="Number(selectedCustomer.paymentTermDays||0)+' days'"></strong></div></div></div></template>
  <div class="text-end mt-4"><button class="btn btn-primary" type="button" @click="next()">Continue</button></div>
</div></div>

<div class="card crm-data-card" x-show="step===2" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">2. Products & selling price</h2><p class="text-muted mb-0">Choose products and quantities first. Warehouse availability is calculated from this demand.</p></div><div class="d-flex gap-2"><label class="visually-hidden" for="product-search">Search products</label><input id="product-search" class="form-control form-control-sm" placeholder="Search products" x-model="productSearch" @input.debounce.300ms="searchProducts()" @keyup.enter="searchProducts()"><button class="btn btn-light btn-sm" type="button" @click="searchProducts()">Find</button><button class="btn btn-light btn-sm" type="button" @click="addLine()">Add product</button></div></div>
  <div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Manufacturer</th><th style="width:120px">Qty</th><th style="width:180px">Agreed price ₹</th><th style="width:55px"></th></tr></thead><tbody><template x-for="(line,index) in form.lines" :key="line.key"><tr><td><select class="form-select" x-model="line.productId" @change="productsChanged()"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></td><td x-text="product(line.productId)?.manufacturer||'—'"></td><td><input type="number" min="1" class="form-control" x-model.number="line.quantity" @input="productsChanged()"></td><td><input type="number" min="0" step="0.01" class="form-control" placeholder="Auto" x-model="line.unitPriceRupees"><div class="text-muted fs-sm" x-show="product(line.productId)" x-text="'Reference '+money(product(line.productId)?.referenceSellingPricePaise)"></div></td><td><button class="btn btn-light btn-sm" type="button" @click="removeLine(index)" :disabled="form.lines.length===1">×</button></td></tr></template></tbody></table></div>
  <div class="d-flex justify-content-between p-3"><button class="btn btn-light" type="button" @click="step=1">Back</button><button class="btn btn-primary" type="button" @click="next()" :disabled="warehouseAvailabilityLoading" x-text="warehouseAvailabilityLoading?'Checking stock…':'Continue'"></button></div>
</div>

<div class="card crm-data-card" x-show="step===3" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">3. Warehouse & commercial terms</h2><p class="text-muted mb-0">The best warehouse is selected automatically from current available stock for the chosen products.</p></div><span class="badge bg-primary bg-opacity-10 text-primary" x-show="selectedWarehouse">Auto-selected</span></div><div class="card-body">
  <template x-if="selectedWarehouseAvailability"><div>
    <div class="crm-order-warehouse-summary mb-3" :class="selectedWarehouseAvailability.canFulfilAll?'is-ready':'is-short'">
      <div><div class="text-muted fs-sm">Recommended fulfilment warehouse</div><strong x-text="selectedWarehouse?.name||'—'"></strong><div class="text-muted fs-sm" x-text="selectedWarehouse?.code||''"></div></div>
      <div class="text-end"><span class="badge" :class="selectedWarehouseAvailability.canFulfilAll?'bg-success':'bg-warning text-dark'" x-text="selectedWarehouseAvailability.canFulfilAll?'Full stock available':selectedWarehouseAvailability.shortageQty+' unit(s) need procurement'"></span><div class="text-muted fs-sm mt-1" x-text="selectedWarehouseAvailability.coveredQty+' of '+selectedWarehouseAvailability.requestedQty+' unit(s) available now'"></div></div>
    </div>
  </div></template>

  <div class="row g-3 mb-3"><div class="col-lg-6"><label class="form-label">Fulfilment warehouse</label><select class="form-select" x-model="form.warehouseId"><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="warehouseOptionLabel(w)"></option></template></select><div class="form-text">Recommendation uses available inventory only. You may choose another active warehouse when operationally required.</div></div><div class="col-md-3"><label class="form-label">Payment term days</label><input type="number" min="0" class="form-control" x-model.number="form.paymentTermDays"></div><div class="col-md-3"><label class="form-label">GST treatment</label><select class="form-select" x-model="form.gstTreatment"><option value="unclassified">Decide before invoice</option><option value="intra_state">Intra-state</option><option value="inter_state">Inter-state</option><option value="no_gst">No GST</option></select></div><div class="col-12"><label class="form-label">Order notes</label><textarea class="form-control" rows="2" x-model="form.notes"></textarea></div></div>

  <template x-if="selectedWarehouseAvailability"><div>
    <div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th class="text-end">Requested</th><th class="text-end">Available</th><th class="text-end">Shortage</th></tr></thead><tbody><template x-for="line in selectedWarehouseAvailability.lines" :key="line.productId"><tr><td><strong x-text="line.productName||product(line.productId)?.name||'—'"></strong><div class="text-muted fs-sm" x-text="line.sku||product(line.productId)?.sku||''"></div></td><td class="text-end" x-text="line.requestedQty"></td><td class="text-end" x-text="line.availableQty"></td><td class="text-end"><span :class="line.shortageQty>0?'text-warning fw-semibold':'text-success fw-semibold'" x-text="line.shortageQty"></span></td></tr></template></tbody></table></div>
    <div class="alert alert-warning mt-3 mb-0" x-show="selectedWarehouseAvailability.shortageQty>0">The selected warehouse cannot fulfil the complete order from current stock. The shortage will use the existing procurement workflow after order confirmation.</div>
    <div class="alert alert-success mt-3 mb-0" x-show="selectedWarehouseAvailability.shortageQty===0">All selected quantities are currently available in this warehouse.</div>
  </div></template>
  <div class="d-flex justify-content-between mt-4"><button class="btn btn-light" type="button" @click="step=2">Back</button><button class="btn btn-primary" type="button" @click="next()">Review</button></div>
</div></div>

<div class="card crm-data-card" x-show="step===4" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">4. Review sales order</h2><p class="text-muted mb-0">Confirm customer demand, selling price and the stock-based warehouse recommendation before creating the order.</p></div></div><div class="card-body">
  <div class="row g-3 mb-4"><div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Customer</div><strong x-text="selectedCustomer?.businessName||'—'"></strong><div x-text="selectedCustomer?.mobile||''"></div></div></div><div class="col-md-6"><div class="border rounded p-3 h-100"><div class="d-flex justify-content-between gap-2"><div><div class="text-muted fs-sm">Warehouse</div><strong x-text="selectedWarehouse?.name||'—'"></strong><div x-text="selectedWarehouse?.code||''"></div></div><span class="badge align-self-start" x-show="selectedWarehouseAvailability" :class="selectedWarehouseAvailability?.canFulfilAll?'bg-success':'bg-warning text-dark'" x-text="selectedWarehouseAvailability?.canFulfilAll?'Full stock':'Procurement needed'"></span></div></div></div></div>
  <div class="table-responsive"><table class="table crm-table align-middle"><thead><tr><th>Product</th><th>Manufacturer</th><th class="text-end">Qty</th><th class="text-end">Price</th></tr></thead><tbody><template x-for="line in form.lines" :key="line.key"><tr><td><strong x-text="product(line.productId)?.name||'—'"></strong><div class="text-muted fs-sm" x-text="product(line.productId)?.sku||''"></div></td><td x-text="product(line.productId)?.manufacturer||'—'"></td><td class="text-end" x-text="line.quantity"></td><td class="text-end" x-text="line.unitPriceRupees===''?'Automatic':moneyFromRupees(line.unitPriceRupees)"></td></tr></template></tbody></table></div>
  <div class="alert alert-warning" x-show="selectedWarehouseAvailability?.shortageQty>0"><strong x-text="selectedWarehouseAvailability?.shortageQty"></strong> unit(s) will require procurement into the selected warehouse after confirmation.</div>
  <div class="d-flex justify-content-between align-items-center mt-4"><button class="btn btn-light" type="button" @click="step=3">Back</button><button class="btn btn-primary" type="button" @click="createOrder()" :disabled="saving" x-text="saving?'Creating…':'Create sales order'"></button></div>
</div></div>

</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
const ORDER_DRAFT_KEY='findoly.b2b.order-draft.v1';
function orderFormPage(){return{
steps:['Customer','Products','Warehouse','Review'],step:1,customers:[],products:[],warehouses:[],customerSearch:'',productSearch:'',error:'',saving:false,warehouseAvailabilityLoading:false,customerAbort:null,productAbort:null,draftTimer:null,submissionKey:requestIdempotencyKey(),form:{customerId:'',warehouseId:'',paymentTermDays:0,gstTreatment:'unclassified',notes:'',lines:[]},
newLine(){return{key:crypto.randomUUID(),productId:'',quantity:1,unitPriceRupees:''}},
get selectedCustomer(){return this.customers.find(x=>x.customerId===this.form.customerId)||null},
get selectedWarehouse(){return this.warehouses.find(x=>x.warehouseId===this.form.warehouseId)||null},
get selectedWarehouseAvailability(){return this.selectedWarehouse||null},
product(id){return this.products.find(x=>x.productId===id)||null},
stageStatus(stage){if(this.step>stage)return'Completed';if(this.step===stage)return'Current stage';return'Upcoming'},
warehouseOptionLabel(w){return w.name+' ('+w.code+') · '+(w.canFulfilAll?'Full stock':w.shortageQty+' unit shortage')},
restoreDraft(){
  try{
    const raw=sessionStorage.getItem(ORDER_DRAFT_KEY);if(!raw)return;
    const draft=JSON.parse(raw);if(!draft?.form)return;
    this.form=draft.form;
    if(!Array.isArray(this.form.lines)||!this.form.lines.length)this.form.lines=[this.newLine()];
    this.form.warehouseId='';
    const merge=(target,items,key)=>{for(const item of items||[])if(item?.[key]&&!target.some(x=>x[key]===item[key]))target.push(item)};
    merge(this.customers,draft.customer?[draft.customer]:[],'customerId');
    merge(this.products,draft.products||[],'productId');
  }catch(_){}
},
scheduleDraftSave(){
  this.submissionKey=requestIdempotencyKey();
  clearTimeout(this.draftTimer);
  this.draftTimer=setTimeout(()=>{
    try{
      const selectedProducts=this.form.lines.map(line=>this.product(line.productId)).filter(Boolean);
      sessionStorage.setItem(ORDER_DRAFT_KEY,JSON.stringify({form:this.form,customer:this.selectedCustomer,products:selectedProducts,updatedAt:Date.now()}));
    }catch(_){}
  },250);
},
clearDraft(){try{sessionStorage.removeItem(ORDER_DRAFT_KEY)}catch(_){}},
async load(){
  this.form.lines=[this.newLine()];
  try{
    const[c,p]=await Promise.all([apiFetch('/api/customers?limit=50'),apiFetch('/api/products?limit=50')]);
    this.customers=c.data.items||[];this.products=p.data.items||[];
    this.restoreDraft();
    this.$watch('form',()=>this.scheduleDraftSave());
  }catch(e){this.error=e.message}
},
async searchCustomers(){
  const query=this.customerSearch.trim();if(query.length<2)return;
  this.customerAbort?.abort();this.customerAbort=new AbortController();
  try{this.customers=(await apiFetch('/api/customers?limit=25&search='+encodeURIComponent(query),{signal:this.customerAbort.signal})).data.items||[]}
  catch(e){if(e.name!=='AbortError')this.error=e.message}
},
async searchProducts(){
  const query=this.productSearch.trim();if(query.length<2)return;
  this.productAbort?.abort();this.productAbort=new AbortController();
  try{this.products=(await apiFetch('/api/products?limit=25&search='+encodeURIComponent(query),{signal:this.productAbort.signal})).data.items||[]}
  catch(e){if(e.name!=='AbortError')this.error=e.message}
},
customerChanged(){if(this.selectedCustomer)this.form.paymentTermDays=Number(this.selectedCustomer.paymentTermDays||0)},
productsChanged(){this.form.warehouseId='';this.warehouses=[]},
addLine(){this.form.lines.push(this.newLine());this.productsChanged()},
removeLine(i){if(this.form.lines.length>1){this.form.lines.splice(i,1);this.productsChanged()}},
validateStep(target){
  this.error='';
  if(target>1&&!this.form.customerId){this.error='Select a customer.';return false}
  if(target>2&&(this.form.lines.some(x=>!x.productId||Number(x.quantity)<1)||new Set(this.form.lines.map(x=>x.productId)).size!==this.form.lines.length)){this.error='Complete every product line and do not add the same product twice.';return false}
  if(target>3&&!this.form.warehouseId){this.error='No fulfilment warehouse is selected.';return false}
  return true
},
async loadWarehouseAvailability(){
  this.error='';this.warehouseAvailabilityLoading=true;
  try{
    const lines=this.form.lines.map(x=>({productId:x.productId,quantity:Number(x.quantity)}));
    const result=(await apiFetch('/api/orders/options/warehouse-availability?lines='+encodeURIComponent(JSON.stringify(lines)))).data;
    this.warehouses=result?.warehouses||[];
    this.form.warehouseId=result?.recommendedWarehouseId||'';
    if(!this.warehouses.length||!this.form.warehouseId){this.error='No active warehouse is available for this sales order.';return false}
    return true;
  }catch(e){this.error=e.message;return false}
  finally{this.warehouseAvailabilityLoading=false}
},
async next(){
  if(this.step===1){if(this.validateStep(2))this.step=2;return}
  if(this.step===2){if(!this.validateStep(3))return;if(await this.loadWarehouseAvailability())this.step=3;return}
  if(this.step===3&&this.validateStep(4))this.step=4;
},
go(target){if(target<=this.step){this.error='';this.step=target}},
async createOrder(){
  if(!this.validateStep(4))return;this.saving=true;
  try{
    const lines=this.form.lines.map(l=>{const x={productId:l.productId,quantity:Number(l.quantity)};if(String(l.unitPriceRupees)!=='')x.unitPricePaise=Math.round(Number(l.unitPriceRupees||0)*100);return x});
    const order=(await apiFetch('/api/orders',{method:'POST',headers:{'Idempotency-Key':this.submissionKey},body:JSON.stringify({...this.form,lines})})).data;
    this.clearDraft();showCrmToast('Sales order created');location.href='/orders/'+order.salesOrderId;
  }catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}
}
}}</script>
<%- include('partials/scripts') %>
</body></html>
