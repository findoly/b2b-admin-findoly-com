<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Sales order workflow</div><h1 class="page-title mb-1">New sales order</h1><p class="crm-page-subtitle mb-0">Customer → warehouse → products and pricing → review.</p></div><a class="btn btn-light" href="/orders">Back to orders</a></div></div>
<div class="content" x-data="orderFormPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card mb-4"><div class="card-body"><div class="row g-2"><template x-for="(label,index) in steps" :key="label"><div class="col-6 col-lg-3"><button class="btn w-100" type="button" :class="step===index+1?'btn-primary':'btn-light'" @click="go(index+1)"><span class="me-1" x-text="index+1"></span><span x-text="label"></span></button></div></template></div></div></div>
<div class="card crm-data-card" x-show="step===1" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">1. Customer</h2><p class="text-muted mb-0">Select the business account receiving this order.</p></div></div><div class="card-body"><div class="input-group mb-3"><input class="form-control" placeholder="Search business name or mobile" x-model="customerSearch" @keyup.enter="searchCustomers()"><button class="btn btn-light" type="button" @click="searchCustomers()">Find</button></div><select class="form-select" x-model="form.customerId" @change="customerChanged()"><option value="">Select customer</option><template x-for="c in customers" :key="c.customerId"><option :value="c.customerId" x-text="c.businessName+' · '+c.mobile"></option></template></select><template x-if="selectedCustomer"><div class="row g-3 mt-2"><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Customer</div><strong x-text="selectedCustomer.businessName"></strong><div class="text-muted fs-sm" x-text="selectedCustomer.customerType"></div></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Credit limit</div><strong x-text="money(selectedCustomer.creditLimitPaise)"></strong><div class="text-muted fs-sm" x-text="selectedCustomer.creditHold?'Credit hold active':'Credit available subject to exposure'"></div></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Default terms</div><strong x-text="Number(selectedCustomer.paymentTermDays||0)+' days'"></strong></div></div></div></template><div class="text-end mt-4"><button class="btn btn-primary" type="button" @click="next()">Continue</button></div></div></div>
<div class="card crm-data-card" x-show="step===2" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">2. Warehouse & commercial terms</h2><p class="text-muted mb-0">One warehouse fulfils this sales order. Procurement shortages will be sourced into the same warehouse.</p></div></div><div class="card-body"><div class="row g-3"><div class="col-lg-6"><label class="form-label">Fulfilment warehouse</label><select class="form-select" x-model="form.warehouseId"><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name+' ('+w.code+')'"></option></template></select></div><div class="col-md-3"><label class="form-label">Payment term days</label><input type="number" min="0" class="form-control" x-model.number="form.paymentTermDays"></div><div class="col-md-3"><label class="form-label">GST treatment</label><select class="form-select" x-model="form.gstTreatment"><option value="unclassified">Decide before invoice</option><option value="intra_state">Intra-state</option><option value="inter_state">Inter-state</option><option value="no_gst">No GST</option></select></div><div class="col-12"><label class="form-label">Order notes</label><textarea class="form-control" rows="2" x-model="form.notes"></textarea></div></div><div class="d-flex justify-content-between mt-4"><button class="btn btn-light" type="button" @click="step=1">Back</button><button class="btn btn-primary" type="button" @click="next()">Continue</button></div></div></div>
<div class="card crm-data-card" x-show="step===3" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">3. Products & selling price</h2><p class="text-muted mb-0">The product is independent of supplier. Any stock shortage can later be split across multiple supplier offers.</p></div><div class="d-flex gap-2"><input class="form-control form-control-sm" placeholder="Search products" x-model="productSearch" @keyup.enter="searchProducts()"><button class="btn btn-light btn-sm" type="button" @click="searchProducts()">Find</button><button class="btn btn-light btn-sm" type="button" @click="addLine()">Add product</button></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Manufacturer</th><th style="width:120px">Qty</th><th style="width:180px">Agreed price ₹</th><th style="width:55px"></th></tr></thead><tbody><template x-for="(line,index) in form.lines" :key="line.key"><tr><td><select class="form-select" x-model="line.productId"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></td><td x-text="product(line.productId)?.manufacturer||'—'"></td><td><input type="number" min="1" class="form-control" x-model.number="line.quantity"></td><td><input type="number" min="0" step="0.01" class="form-control" placeholder="Auto" x-model="line.unitPriceRupees"><div class="text-muted fs-sm" x-show="product(line.productId)" x-text="'Reference '+money(product(line.productId)?.referenceSellingPricePaise)"></div></td><td><button class="btn btn-light btn-sm" type="button" @click="removeLine(index)" :disabled="form.lines.length===1">×</button></td></tr></template></tbody></table></div><div class="d-flex justify-content-between p-3"><button class="btn btn-light" type="button" @click="step=2">Back</button><button class="btn btn-primary" type="button" @click="next()">Review</button></div></div>
<div class="card crm-data-card" x-show="step===4" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">4. Review sales order</h2><p class="text-muted mb-0">Confirm the customer, warehouse and product demand. Stock reservation happens when the order is confirmed.</p></div></div><div class="card-body"><div class="row g-3 mb-4"><div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Customer</div><strong x-text="selectedCustomer?.businessName||'—'"></strong><div x-text="selectedCustomer?.mobile||''"></div></div></div><div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Warehouse</div><strong x-text="selectedWarehouse?.name||'—'"></strong><div x-text="selectedWarehouse?.code||''"></div></div></div></div><div class="table-responsive"><table class="table crm-table align-middle"><thead><tr><th>Product</th><th>Manufacturer</th><th class="text-end">Qty</th><th class="text-end">Price</th></tr></thead><tbody><template x-for="line in form.lines" :key="line.key"><tr><td><strong x-text="product(line.productId)?.name||'—'"></strong><div class="text-muted fs-sm" x-text="product(line.productId)?.sku||''"></div></td><td x-text="product(line.productId)?.manufacturer||'—'"></td><td class="text-end" x-text="line.quantity"></td><td class="text-end" x-text="line.unitPriceRupees===''?'Automatic':money(Math.round(Number(line.unitPriceRupees||0)*100))"></td></tr></template></tbody></table></div><div class="d-flex justify-content-between align-items-center mt-4"><button class="btn btn-light" type="button" @click="step=3">Back</button><button class="btn btn-primary" type="button" @click="createOrder()" :disabled="saving" x-text="saving?'Creating…':'Create sales order'"></button></div></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function orderFormPage(){return{
steps:['Customer','Warehouse','Products','Review'],step:1,customers:[],products:[],warehouses:[],customerSearch:'',productSearch:'',error:'',saving:false,form:{customerId:'',warehouseId:'',paymentTermDays:0,gstTreatment:'unclassified',notes:'',lines:[]},
newLine(){return{key:crypto.randomUUID(),productId:'',quantity:1,unitPriceRupees:''}},get selectedCustomer(){return this.customers.find(x=>x.customerId===this.form.customerId)||null},get selectedWarehouse(){return this.warehouses.find(x=>x.warehouseId===this.form.warehouseId)||null},product(id){return this.products.find(x=>x.productId===id)||null},
async load(){this.form.lines=[this.newLine()];try{const[c,p,w]=await Promise.all([apiFetch('/api/customers?limit=50'),apiFetch('/api/products?limit=50'),apiFetch('/api/warehouses')]);this.customers=c.data.items||[];this.products=p.data.items||[];this.warehouses=w.data.items||[]}catch(e){this.error=e.message}},
async searchCustomers(){try{this.customers=(await apiFetch('/api/customers?limit=100&search='+encodeURIComponent(this.customerSearch))).data.items||[]}catch(e){this.error=e.message}},async searchProducts(){try{this.products=(await apiFetch('/api/products?limit=100&search='+encodeURIComponent(this.productSearch))).data.items||[]}catch(e){this.error=e.message}},customerChanged(){if(this.selectedCustomer)this.form.paymentTermDays=Number(this.selectedCustomer.paymentTermDays||0)},addLine(){this.form.lines.push(this.newLine())},removeLine(i){if(this.form.lines.length>1)this.form.lines.splice(i,1)},
validateStep(target){this.error='';if(target>1&&!this.form.customerId){this.error='Select a customer.';return false}if(target>2&&!this.form.warehouseId){this.error='Select a fulfilment warehouse.';return false}if(target>3&&(this.form.lines.some(x=>!x.productId||Number(x.quantity)<1)||new Set(this.form.lines.map(x=>x.productId)).size!==this.form.lines.length)){this.error='Complete every product line and do not add the same product twice.';return false}return true},next(){if(this.validateStep(this.step+1))this.step=Math.min(4,this.step+1)},go(target){if(target<=this.step||this.validateStep(target))this.step=target},
async createOrder(){if(!this.validateStep(4))return;this.saving=true;try{const lines=this.form.lines.map(l=>{const x={productId:l.productId,quantity:Number(l.quantity)};if(String(l.unitPriceRupees)!=='')x.unitPricePaise=Math.round(Number(l.unitPriceRupees||0)*100);return x});const order=(await apiFetch('/api/orders',{method:'POST',body:JSON.stringify({...this.form,lines})})).data;showCrmToast('Sales order created');location.href='/orders/'+order.salesOrderId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}
}}</script><%- include('partials/scripts') %>
</body></html>
