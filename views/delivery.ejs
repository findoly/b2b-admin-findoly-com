<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Operations</div><h1 class="page-title mb-1">Delivery</h1><p class="crm-page-subtitle mb-0">Assign packed orders, capture collections and handle partial/returned stock safely.</p></div><% if (can('delivery.assign')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-delivery')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Assign delivery</button><% } %></div></div>
<div class="content" x-data="deliveryPage()" x-init="load()" @new-delivery.window="showForm=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<% if (can('delivery.assign')) { %>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Assign delivery</h2><p class="text-muted mb-0">Only packed or ready-for-dispatch orders can be assigned.</p></div><button class="btn btn-light btn-sm" @click="showForm=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-4"><label class="form-label">Sales order</label><select class="form-select" x-model="form.salesOrderId"><option value="">Select order</option><template x-for="o in eligibleOrders" :key="o.salesOrderId"><option :value="o.salesOrderId" x-text="o.orderNumber+' · '+(o.customerSnapshot?.businessName||'')"></option></template></select></div>
<div class="col-lg-2"><label class="form-label">Delivery type</label><select class="form-select" x-model="form.deliveryType"><option value="internal">Findoly / internal</option><option value="third_party">Third party</option></select></div>
<div class="col-lg-3"><label class="form-label">Delivery provider</label><input class="form-control" x-model="form.deliveryProviderName" placeholder="Findoly / partner name"></div>
<div class="col-lg-3"><label class="form-label">External tracking reference</label><input class="form-control" x-model="form.externalReference" placeholder="Optional partner reference"></div>
<div class="col-md-4"><label class="form-label">Driver name</label><input class="form-control" x-model="form.driverName"></div>
<div class="col-md-4"><label class="form-label">Driver mobile</label><input class="form-control" x-model="form.driverMobile" inputmode="numeric"></div>
<div class="col-md-4"><label class="form-label">Expected collection ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.expectedCollectionRupees"></div>
<div class="col-12"><label class="form-label">Tracking URL</label><input class="form-control" x-model="form.trackingUrl" placeholder="Optional third-party tracking URL"></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="assign()">Assign delivery</button></div></div></div>
<% } %>

<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Delivery assignments</h2><p class="text-muted mb-0">Only valid next statuses are offered for each assignment.</p></div><button class="btn btn-light btn-sm" @click="loadDeliveries()">Refresh</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Order</th><th>Provider</th><th>Driver</th><th>Status</th><th>Tracking</th><th class="text-end">Expected collection</th><th class="text-end">Collected</th><th class="text-end">Action</th></tr></thead><tbody>
<template x-for="d in deliveries" :key="d.deliveryAssignmentId"><tr><td><strong x-text="orderNumber(d.salesOrderId)"></strong><div class="text-muted fs-sm" x-text="customerName(d.salesOrderId)"></div></td><td><span x-text="d.deliveryProviderName||humanize(d.deliveryType)"></span><div class="text-muted fs-sm" x-text="humanize(d.deliveryType)"></div></td><td><span x-text="d.driverName||'—'"></span><div class="text-muted fs-sm" x-text="d.driverMobile||''"></div></td><td><span class="crm-status" :class="statusClass(d.status)" x-text="humanize(d.status)"></span></td><td x-text="d.externalReference||'—'"></td><td class="text-end" x-text="money(d.expectedCollectionPaise)"></td><td class="text-end" x-text="money(d.collectedPaise)"></td><td class="text-end"><% if (can('delivery.update')) { %><button class="btn btn-sm btn-outline-primary" @click="openUpdate(d)" :disabled="!allowedStatuses(d.status).length">Update</button><% } %></td></tr></template>
<tr x-show="!loading && !deliveries.length"><td colspan="8"><div class="crm-empty-state"><strong>No delivery assignments</strong><span>Assign a packed order when it is ready for dispatch.</span></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>

<% if (can('delivery.update')) { %>
<div class="card crm-data-card mt-4" x-show="update.delivery" x-cloak>
<div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Update delivery</h2><p class="text-muted mb-0"><span x-text="orderNumber(update.delivery?.salesOrderId)"></span> · current status <span x-text="humanize(update.delivery?.status)"></span></p></div><button class="btn btn-light btn-sm" @click="closeUpdate()">Close</button></div>
<div class="card-body">
<div class="row g-3">
<div class="col-md-4"><label class="form-label">Next status</label><select class="form-select" x-model="update.status" @change="preparePartial()"><option value="">Select next status</option><template x-for="s in allowedStatuses(update.delivery?.status)" :key="s"><option :value="s" x-text="humanize(s)"></option></template></select></div>
<div class="col-md-3"><label class="form-label">Collected amount ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="update.collectedRupees"></div>
<div class="col-md-2"><label class="form-label">Collection mode</label><select class="form-select" x-model="update.collectionMode"><option value="">Not recorded</option><option value="cash">Cash</option><option value="upi">UPI</option><option value="bank_transfer">Bank transfer</option><option value="card">Card</option><option value="cheque">Cheque</option></select></div>
<div class="col-md-3"><label class="form-label">Note</label><input class="form-control" x-model="update.note" placeholder="Optional status note"></div>
<div class="col-12" x-show="update.status==='failed'" x-cloak><label class="form-label">Failure reason</label><input class="form-control" x-model="update.failureReason" placeholder="Required operational reason"></div>
</div>

<div class="mt-4" x-show="update.status==='partially_delivered'" x-cloak>
<div class="alert alert-info">Enter delivered quantity for every line. Returned quantity is calculated automatically and moves back into the warehouse returned-stock bucket.</div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th class="text-end">Order qty</th><th style="width:160px">Delivered</th><th class="text-end">Returned</th></tr></thead><tbody><template x-for="line in update.lines" :key="line.deliveryLineId||line.salesOrderLineId"><tr><td><strong x-text="line.productName"></strong><div class="text-muted fs-sm" x-text="line.sku"></div></td><td class="text-end" x-text="line.quantity"></td><td><input type="number" min="0" :max="line.quantity" class="form-control" x-model.number="line.deliveredQty" @input="line.returnedQty=Math.max(0,Number(line.quantity)-Number(line.deliveredQty||0))"></td><td class="text-end fw-semibold" x-text="line.returnedQty"></td></tr></template></tbody></table></div>
</div>
<div class="text-end mt-3"><button class="btn btn-primary" @click="saveUpdate()" :disabled="!update.status">Save delivery update</button></div>
</div></div>
<% } %>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function deliveryPage(){return{
...crmPager('loadDeliveries'),deliveries:[],orders:[],loading:true,error:'',showForm:false,form:{salesOrderId:'',deliveryType:'internal',deliveryProviderName:'Findoly',driverName:'',driverMobile:'',externalReference:'',trackingUrl:'',expectedCollectionRupees:0},update:{delivery:null,status:'',collectedRupees:0,collectionMode:'',note:'',failureReason:'',lines:[]},
transitionMap:{assigned:['picked_up','cancelled'],picked_up:['out_for_delivery','cancelled'],out_for_delivery:['delivered','partially_delivered','failed','returned'],failed:['out_for_delivery','returned'],delivered:[],partially_delivered:[],returned:[],cancelled:[]},
get eligibleOrders(){return this.orders.filter(o=>['packed','ready_for_dispatch'].includes(o.status))},
async load(){try{this.orders=(await apiFetch('/api/orders?limit=100')).data.items||[];await this.loadDeliveries()}catch(e){this.error=e.message}finally{this.loading=false}},
async loadDeliveries(){this.loading=true;try{const data=(await apiFetch('/api/delivery?limit='+this.pageSize+'&page='+this.page)).data;this.deliveries=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},
orderNumber(id){return this.orders.find(x=>x.salesOrderId===id)?.orderNumber||id},customerName(id){return this.orders.find(x=>x.salesOrderId===id)?.customerSnapshot?.businessName||''},allowedStatuses(status){return this.transitionMap[status]||[]},
async assign(){if(!this.form.salesOrderId)return this.error='Select a sales order.';try{await apiFetch('/api/delivery',{method:'POST',body:JSON.stringify({...this.form,expectedCollectionPaise:Math.round(Number(this.form.expectedCollectionRupees||0)*100)})});showCrmToast('Delivery assigned');this.showForm=false;this.form={salesOrderId:'',deliveryType:'internal',deliveryProviderName:'Findoly',driverName:'',driverMobile:'',externalReference:'',trackingUrl:'',expectedCollectionRupees:0};this.orders=(await apiFetch('/api/orders?limit=100')).data.items||[];await this.loadDeliveries()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
openUpdate(d){const order=this.orders.find(x=>x.salesOrderId===d.salesOrderId);const lines=(d.lines?.length?d.lines:(order?.lines||[]).map(l=>({salesOrderLineId:l.salesOrderLineId,productId:l.productId,productName:l.productName,sku:l.sku,quantity:l.quantity,deliveredQty:0,returnedQty:0}))).map(l=>({...l,deliveredQty:Number(l.deliveredQty||0),returnedQty:Number(l.returnedQty||0)}));this.update={delivery:d,status:'',collectedRupees:Number(d.collectedPaise||0)/100,collectionMode:d.collectionMode||'',note:'',failureReason:d.failureReason||'',lines};this.$nextTick(()=>window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'}))},
closeUpdate(){this.update={delivery:null,status:'',collectedRupees:0,collectionMode:'',note:'',failureReason:'',lines:[]}},
preparePartial(){if(this.update.status==='partially_delivered')for(const line of this.update.lines){if(!Number.isFinite(Number(line.deliveredQty)))line.deliveredQty=0;line.returnedQty=Math.max(0,Number(line.quantity)-Number(line.deliveredQty||0))}},
async saveUpdate(){const u=this.update;if(!u.delivery||!u.status)return;if(u.status==='failed'&&!u.failureReason.trim())return this.error='Failure reason is required.';const body={status:u.status,collectedPaise:Math.round(Number(u.collectedRupees||0)*100),collectionMode:u.collectionMode,note:u.note,failureReason:u.failureReason};if(u.status==='partially_delivered')body.lines=u.lines.map(l=>({deliveryLineId:l.deliveryLineId,salesOrderLineId:l.salesOrderLineId,deliveredQty:Number(l.deliveredQty||0),returnedQty:Number(l.returnedQty||0)}));try{await apiFetch('/api/delivery/'+u.delivery.deliveryAssignmentId+'/status',{method:'POST',body:JSON.stringify(body)});showCrmToast('Delivery status updated');this.closeUpdate();this.orders=(await apiFetch('/api/orders?limit=100')).data.items||[];await this.loadDeliveries()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}}
}}</script><%- include('partials/scripts') %>
</body></html>