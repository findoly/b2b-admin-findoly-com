<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Operations</div><h1 class="page-title mb-1">Delivery</h1><p class="crm-page-subtitle mb-0">Assign packed orders to internal or third-party delivery and update status.</p></div><% if (can('delivery.assign')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-delivery')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Assign delivery</button><% } %></div></div>
<div class="content" x-data="deliveryPage()" x-init="load()" @new-delivery.window="showForm=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<% if (can('delivery.assign')) { %>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Assign delivery</h2><p class="text-muted mb-0">Only packed or ready-for-dispatch orders can be assigned.</p></div><button class="btn btn-light btn-sm" @click="showForm=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-4"><label class="form-label">Sales order</label><select class="form-select" x-model="form.salesOrderId"><option value="">Select order</option><template x-for="o in eligibleOrders" :key="o.salesOrderId"><option :value="o.salesOrderId" x-text="o.orderNumber+' · '+(o.customerSnapshot?.businessName||'')"></option></template></select></div>
<div class="col-lg-2"><label class="form-label">Delivery type</label><select class="form-select" x-model="form.deliveryType"><option value="internal">Findoly / internal</option><option value="third_party">Third party</option></select></div>
<div class="col-lg-3"><label class="form-label">Delivery provider</label><input class="form-control" x-model="form.deliveryProviderName" placeholder="Findoly / partner name"></div>
<div class="col-lg-3"><label class="form-label">External tracking reference</label><input class="form-control" x-model="form.externalReference" placeholder="Optional partner reference"></div>
<div class="col-md-4"><label class="form-label">Driver name</label><input class="form-control" x-model="form.driverName"></div>
<div class="col-md-4"><label class="form-label">Driver mobile</label><input class="form-control" x-model="form.driverMobile" inputmode="numeric"></div>
<div class="col-md-4"><label class="form-label">Expected collection ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.expectedCollectionRupees"></div>
<div class="col-12"><label class="form-label">Tracking URL</label><input class="form-control" x-model="form.trackingUrl" placeholder="Optional third-party tracking URL"></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="assign()">Assign delivery</button></div></div></div>
<% } %>

<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Delivery assignments</h2><p class="text-muted mb-0">Track dispatch and proof/collection status.</p></div><button class="btn btn-light btn-sm" @click="loadDeliveries()">Refresh</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Order</th><th>Type / provider</th><th>Driver</th><th>Status</th><th>Tracking</th><th class="text-end">Expected collection</th><th class="text-end">Update</th></tr></thead><tbody>
<template x-for="d in deliveries" :key="d.deliveryAssignmentId"><tr><td><strong x-text="orderNumber(d.salesOrderId)"></strong><div class="crm-record-id" x-text="d.deliveryAssignmentId"></div></td><td><span x-text="humanize(d.deliveryType)"></span><div class="text-muted fs-sm" x-text="d.deliveryProviderName||'—'"></div></td><td><span x-text="d.driverName||'—'"></span><div class="text-muted fs-sm" x-text="d.driverMobile||''"></div></td><td><span class="crm-status" :class="statusClass(d.status)" x-text="humanize(d.status)"></span></td><td><span x-text="d.externalReference||'—'"></span></td><td class="text-end" x-text="money(d.expectedCollectionPaise)"></td><td class="text-end">
<% if (can('delivery.update')) { %><div class="d-flex gap-1 justify-content-end"><select class="form-select form-select-sm" style="min-width:150px" x-model="statusDraft[d.deliveryAssignmentId]"><option value="">Choose status</option><option value="picked_up">Picked up</option><option value="out_for_delivery">Out for delivery</option><option value="delivered">Delivered</option><option value="partially_delivered">Partially delivered</option><option value="failed">Failed</option><option value="returned">Returned</option><option value="cancelled">Cancelled</option></select><button class="btn btn-sm btn-outline-primary" @click="updateStatus(d)" :disabled="!statusDraft[d.deliveryAssignmentId]">Save</button></div><% } %>
</td></tr></template>
<tr x-show="!loading && !deliveries.length"><td colspan="7"><div class="crm-empty-state"><strong>No delivery assignments</strong><span>Assign a packed order when it is ready for dispatch.</span></div></td></tr>
</tbody></table></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function deliveryPage(){return{
deliveries:[],orders:[],loading:true,error:'',showForm:false,statusDraft:{},form:{salesOrderId:'',deliveryType:'internal',deliveryProviderName:'Findoly',driverName:'',driverMobile:'',externalReference:'',trackingUrl:'',expectedCollectionRupees:0},
get eligibleOrders(){return this.orders.filter(o=>['packed','ready_for_dispatch'].includes(o.status))},
async load(){try{const[o]=await Promise.all([apiFetch('/api/orders?limit=100')]);this.orders=o.data.items||[];await this.loadDeliveries()}catch(e){this.error=e.message}finally{this.loading=false}},
async loadDeliveries(){this.loading=true;try{this.deliveries=(await apiFetch('/api/delivery?limit=100')).data.items||[];this.statusDraft={}}catch(e){this.error=e.message}finally{this.loading=false}},
orderNumber(id){return this.orders.find(x=>x.salesOrderId===id)?.orderNumber||id},
async assign(){if(!this.form.salesOrderId)return this.error='Select a sales order.';try{await apiFetch('/api/delivery',{method:'POST',body:JSON.stringify({...this.form,expectedCollectionPaise:Math.round(Number(this.form.expectedCollectionRupees||0)*100)})});showCrmToast('Delivery assigned');this.showForm=false;this.form={salesOrderId:'',deliveryType:'internal',deliveryProviderName:'Findoly',driverName:'',driverMobile:'',externalReference:'',trackingUrl:'',expectedCollectionRupees:0};await Promise.all([this.loadDeliveries(),apiFetch('/api/orders?limit=100').then(x=>this.orders=x.data.items||[])])}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async updateStatus(d){const status=this.statusDraft[d.deliveryAssignmentId];if(!status)return;try{await apiFetch('/api/delivery/'+d.deliveryAssignmentId+'/status',{method:'POST',body:JSON.stringify({status})});showCrmToast('Delivery status updated');await this.loadDeliveries()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}}
}}</script><%- include('partials/scripts') %>
</body></html>