<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Operations</div><h1 class="page-title mb-1">Delivery</h1><p class="crm-page-subtitle mb-0">Track assignments and continue each delivery from its dedicated workflow.</p></div><% if (can('delivery.assign')) { %><a class="btn btn-primary crm-primary-action" href="/delivery/assign"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Assign delivery</a><% } %></div></div>
<div class="content" x-data="deliveryListPage()" x-init="loadDeliveries()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<div class="card crm-data-card">
<section class="card crm-filter-card mb-3"><div class="crm-filter-bar"><label class="crm-filter-field"><span>Status</span><select x-model="statusFilter" @change="filter()"><option value="">All statuses</option><option value="assigned">Assigned</option><option value="picked_up">Picked up</option><option value="out_for_delivery">Out for delivery</option><option value="delivered">Delivered</option><option value="partially_delivered">Partially delivered</option><option value="failed">Failed</option><option value="returned">Returned</option><option value="cancelled">Cancelled</option></select></label><label class="crm-filter-field crm-filter-field-wide"><span>Delivery type</span><select x-model="typeFilter" @change="filter()"><option value="">All delivery types</option><option value="internal">Findoly / internal</option><option value="third_party">Third party</option></select></label><div class="crm-filter-actions"><button class="btn btn-primary" @click="loadDeliveries()">Refresh</button></div></div></section>
<div class="card crm-data-card">
<div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Delivery assignments</h2><p class="text-muted mb-0">One row per assignment. Open the record to view products, warehouse and history.</p></div></div>
<div class="table-responsive"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Order</th><th>Warehouse</th><th>Products</th><th>Delivery person / provider</th><th>Status</th><th class="text-end">Expected</th><th class="text-end">Collected</th><th class="text-end">Action</th></tr></thead><tbody>
<template x-if="loading"><tr><td colspan="8"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
<template x-for="d in deliveries" :key="d.deliveryAssignmentId"><tr>
<td><a class="crm-record-title" :href="'/orders?search='+encodeURIComponent(d.orderNumber||d.salesOrderId)" x-text="d.orderNumber||d.salesOrderId"></a><div class="text-muted fs-sm" x-text="crmValue(d,'customerSnapshot.businessName','')"></div></td>
<td><strong x-text="crmValue(d,'warehouseSnapshot.name','Warehouse')"></strong><div class="text-muted fs-sm" x-text="crmValue(d,'warehouseSnapshot.code',d.warehouseId||'')"></div></td>
<td><span x-text="(d.lines||[]).length+' products'"></span><div class="text-muted fs-sm" x-text="totalQty(d)+' units'"></div></td>
<td><span class="fw-semibold" x-text="d.driverName||d.deliveryProviderName||humanize(d.deliveryType)"></span><div class="text-muted fs-sm" x-text="d.driverMobile||d.deliveryProviderName||humanize(d.deliveryType)"></div></td>
<td><span class="crm-status" :class="statusClass(d.status)" x-text="humanize(d.status)"></span></td>
<td class="text-end" x-text="money(d.expectedCollectionPaise)"></td><td class="text-end" x-text="money(d.collectedPaise)"></td>
<td class="text-end crm-table-actions"><a class="btn btn-sm btn-outline-primary" :href="'/delivery/'+d.deliveryAssignmentId">View</a><% if (can('delivery.update')) { %><a x-show="allowedStatuses(d.status).length" class="btn btn-sm btn-primary" :href="'/delivery/'+d.deliveryAssignmentId+'/update'">Continue</a><% } %></td>
</tr></template>
<tr x-show="!loading && !deliveries.length"><td colspan="8"><div class="crm-empty-state"><strong>No delivery assignments found</strong><span>Assign a packed order when it is ready to leave the warehouse.</span></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function deliveryListPage(){return{
...crmPager('loadDeliveries'),deliveries:[],loading:true,error:'',statusFilter:'',typeFilter:'',
transitionMap:{assigned:['picked_up','cancelled'],picked_up:['out_for_delivery','cancelled'],out_for_delivery:['delivered','partially_delivered','failed','returned'],failed:['out_for_delivery','returned'],delivered:[],partially_delivered:[],returned:[],cancelled:[]},
allowedStatuses(status){return this.transitionMap[status]||[]},totalQty(d){return(d.lines||[]).reduce((sum,line)=>sum+Number(line.quantity||0),0)},
async loadDeliveries(){this.loading=true;try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.statusFilter)q.set('status',this.statusFilter);if(this.typeFilter)q.set('deliveryType',this.typeFilter);const data=(await apiFetch('/api/delivery?'+q)).data;this.deliveries=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},
filter(){this.resetPage();return this.loadDeliveries()}
}}</script><%- include('partials/scripts') %>
</body></html>
