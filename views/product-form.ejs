<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner" x-data="productFormPage()" x-init="load()">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Catalogue workflow</div><h1 class="page-title mb-1" x-text="editing?'Edit product':'New product'"></h1><p class="crm-page-subtitle mb-0">Commercial master data and a safe rich HTML description in one focused editor.</p></div><a class="btn btn-light" :href="editing?'/products/'+productId:'/products'">Back</a></div></div>
<div class="content">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Product master</h2><p class="text-muted mb-0">Amounts are entered in rupees and stored as integer paise.</p></div></div><div class="card-body">
<div class="row g-3">
<div class="col-lg-5"><label class="form-label">Product name</label><input class="form-control" x-model="form.name"></div><div class="col-lg-2"><label class="form-label">SKU</label><input class="form-control" x-model="form.sku"></div><div class="col-lg-2"><label class="form-label">Barcode</label><input class="form-control" x-model="form.barcode"></div><div class="col-lg-3"><label class="form-label">Brand</label><input class="form-control" x-model="form.brand"></div>
<div class="col-md-6"><label class="form-label" for="product-category">Category</label><div class="input-group mb-2"><input class="form-control" aria-label="Search categories" placeholder="Search categories" x-model="categorySearch" @keyup.enter="searchCategories()"><button type="button" class="btn btn-light" @click="searchCategories()">Find</button></div><select id="product-category" class="form-select" x-model="form.categoryId" @change="categoryChanged()"><option value="">Select category</option><template x-for="c in categoryOptions" :key="c.categoryId"><option :value="c.categoryId" x-text="c.name"></option></template></select><button type="button" x-show="categoryMore" class="btn btn-link btn-sm" @click="searchCategories(true)">More categories</button></div>
<div class="col-md-6"><label class="form-label" for="product-subcategory">Subcategory</label><div class="input-group mb-2"><input class="form-control" aria-label="Search subcategories" placeholder="Search subcategories" x-model="subcategorySearch" @keyup.enter="searchSubcategories()" :disabled="!form.categoryId"><button type="button" class="btn btn-light" @click="searchSubcategories()" :disabled="!form.categoryId">Find</button></div><select id="product-subcategory" class="form-select" x-model="form.subcategoryId" :disabled="!form.categoryId"><option value="">No subcategory</option><template x-for="c in subcategoryOptions" :key="c.subcategoryId"><option :value="c.subcategoryId" x-text="c.name"></option></template></select><button type="button" x-show="subcategoryMore" class="btn btn-link btn-sm" @click="searchSubcategories(true)">More subcategories</button></div>
<div class="col-12"><a href="/categories">Manage categories</a> · <a href="/subcategories">Manage subcategories</a><p class="text-muted mb-0" x-show="editing && !form.categoryId">This product has an older category label. Select a managed category to classify it.</p></div><div class="col-md-3"><label class="form-label">Manufacturer</label><input class="form-control" x-model="form.manufacturer"></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" x-model="form.status"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
<div class="col-md-2"><label class="form-label">Unit</label><input class="form-control" x-model="form.unit" placeholder="piece / box / kg"></div><div class="col-md-2"><label class="form-label">Pack size</label><input type="number" min="1" class="form-control" x-model.number="form.packSize"></div><div class="col-md-2"><label class="form-label">Carton size</label><input type="number" min="1" class="form-control" x-model.number="form.cartonSize"></div><div class="col-md-2"><label class="form-label">HSN</label><input class="form-control" x-model="form.hsnCode"></div><div class="col-md-2"><label class="form-label">GST %</label><input type="number" min="0" max="100" step="0.01" class="form-control" x-model.number="form.gstPercent"></div><div class="col-md-2"><label class="form-label">Reorder level</label><input type="number" min="0" class="form-control" x-model.number="form.reorderLevel"></div>
<div class="col-md-4"><label class="form-label">MRP ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.mrpRupees"></div><div class="col-md-4"><label class="form-label">Reference selling price ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.referenceRupees"></div><div class="col-md-4"><label class="form-label">Minimum permitted price ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.minimumRupees"></div>
<div class="col-12"><label class="form-label">Plain description / summary</label><textarea class="form-control" rows="3" maxlength="20000" x-model="form.description" placeholder="Short plain-text summary for integrations that do not render HTML."></textarea></div>
<div class="col-12"><div class="d-flex flex-wrap justify-content-between align-items-end gap-2"><div><label class="form-label mb-0">HTML description</label><div class="text-muted fs-sm">Paste HTML directly or import an .html file. The server removes scripts, event handlers, unsafe URLs and unsupported markup before saving.</div></div><label class="btn btn-light mb-0">Import HTML<input class="d-none" type="file" accept=".html,text/html" @change="importHtml($event)"></label></div><textarea class="form-control mt-2" rows="14" maxlength="100000" spellcheck="false" x-model="form.descriptionHtml" placeholder="<h2>Product features</h2><p>Paste safe product HTML here...</p>"></textarea><div class="text-muted fs-sm mt-1" x-show="importedFileName" x-text="'Imported: '+importedFileName"></div></div>
<div class="col-12"><label class="form-label">Internal notes</label><textarea class="form-control" rows="3" maxlength="10000" x-model="form.notes"></textarea></div>
</div>
<div class="d-flex justify-content-between align-items-center mt-4"><a class="btn btn-light" :href="editing?'/products/'+productId:'/products'">Cancel</a><button class="btn btn-primary" @click="save()" :disabled="saving" x-text="saving?'Saving…':(editing?'Save changes':'Create product')"></button></div>
</div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function productFormPage(){return{
...catalogueFields(),
productId:'',originalCategoryId:'',editing:false,loading:true,saving:false,error:'',importedFileName:'',form:null,
blankForm(){return{name:'',sku:'',barcode:'',brand:'',categoryId:'',subcategoryId:'',category:'',subcategory:'',manufacturer:'',description:'',descriptionHtml:'',unit:'piece',packSize:1,cartonSize:1,hsnCode:'',gstPercent:18,mrpRupees:0,referenceRupees:0,minimumRupees:0,reorderLevel:0,status:'active',notes:''}},
async load(){const parts=location.pathname.split('/').filter(Boolean);this.productId=parts[1]&&parts[1]!=='new'?decodeURIComponent(parts[1]):'';this.editing=Boolean(this.productId);this.form=this.blankForm();try{await this.loadCategories();if(!this.editing){this.loading=false;return}const p=(await apiFetch('/api/products/'+this.productId)).data;this.originalCategoryId=p.categoryId||'';this.form={name:p.name,sku:p.sku,barcode:p.barcode||'',brand:p.brand||'',categoryId:p.categoryId||'',subcategoryId:p.subcategoryId||'',category:p.category||'',subcategory:p.subcategory||'',manufacturer:p.manufacturer||'',description:p.description||'',descriptionHtml:p.descriptionHtml||'',unit:p.unit||'piece',packSize:Number(p.packSize||1),cartonSize:Number(p.cartonSize||1),hsnCode:p.hsnCode||'',gstPercent:Number(p.gstRateBps||0)/100,mrpRupees:Number(p.mrpPaise||0)/100,referenceRupees:Number(p.referenceSellingPricePaise||0)/100,minimumRupees:Number(p.minimumSellingPricePaise||0)/100,reorderLevel:Number(p.reorderLevel||0),status:p.status||'active',notes:p.notes||''};this.retainSelectedCategory();await this.loadSubcategories()}catch(e){this.error=e.message}finally{this.loading=false}},
async importHtml(event){const file=event.target.files?.[0];event.target.value='';if(!file)return;if(file.size>150000)return this.error='HTML file is too large to import.';try{const html=await file.text();if(html.length>100000)return this.error='HTML description cannot exceed 100000 characters.';this.form.descriptionHtml=html;this.importedFileName=file.name;this.error=''}catch(e){this.error='Could not read the HTML file.'}},
payload(){return{name:this.form.name,sku:this.form.sku,barcode:this.form.barcode,brand:this.form.brand,...(this.form.categoryId?{categoryId:this.form.categoryId,subcategoryId:this.form.subcategoryId}:{}),category:this.form.category,subcategory:this.form.subcategory,manufacturer:this.form.manufacturer,description:this.form.description,descriptionHtml:this.form.descriptionHtml,unit:this.form.unit,packSize:Number(this.form.packSize||1),cartonSize:Number(this.form.cartonSize||1),hsnCode:this.form.hsnCode,gstRateBps:Math.round(Number(this.form.gstPercent||0)*100),mrpPaise:Math.round(Number(this.form.mrpRupees||0)*100),referenceSellingPricePaise:Math.round(Number(this.form.referenceRupees||0)*100),minimumSellingPricePaise:Math.round(Number(this.form.minimumRupees||0)*100),reorderLevel:Number(this.form.reorderLevel||0),status:this.form.status,notes:this.form.notes}},
async save(){if(!this.form.categoryId&&(!this.editing||this.originalCategoryId))return this.error='Select a category before saving.';if(!this.form.name.trim()||!this.form.sku.trim())return this.error='Product name and SKU are required.';this.saving=true;this.error='';try{let p;if(this.editing)p=(await apiFetch('/api/products/'+this.productId,{method:'PUT',body:JSON.stringify(this.payload())})).data;else p=(await apiFetch('/api/products',{method:'POST',body:JSON.stringify(this.payload())})).data;showCrmToast(this.editing?'Product updated':'Product created');location.href='/products/'+p.productId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}
}}</script><%- include('partials/scripts') %>
</body></html>
