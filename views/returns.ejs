<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Operations</div><h1 class="page-title mb-1">Returns</h1><p class="crm-page-subtitle mb-0">Record customer or supplier returns and process stock outcomes.</p></div><% if (can('returns.manage')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-return')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New return</button><% } %></div></div>
<div class="content" x-data="returnsPage()" x-init="load()" @new-return.window="showForm=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<% if (can('returns.manage')) { %>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Create return</h2><p class="text-muted mb-0">Select the source order or purchase order, then choose the items being returned.</p></div><button class="btn btn-light btn-sm" @click="showForm=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-3"><label class="form-label">Return type</label><select class="form-select" x-model="form.returnType" @change="sourceChanged()"><option value="customer">Customer return</option><option value="supplier">Supplier return</option></select></div>
<div class="col-lg-5"><label class="form-label" x-text="form.returnType==='customer'?'Sales order':'Purchase order'"></label><select class="form-select" x-model="form.sourceId" @change="loadSourceLines()"><option value="">Select source</option><template x-for="s in returnSources" :key="form.returnType==='customer'?s.salesOrderId:s.purchaseOrderId"><option :value="form.returnType==='customer'?s.salesOrderId:s.purchaseOrderId" x-text="form.returnType==='customer'?(s.orderNumber+' · '+(s.customerSnapshot?.businessName||'')):(s.poNumber+' · '+s.supplierName)"></option></template></select></div>
<div class="col-lg-4"><label class="form-label">Warehouse</label><select class="form-select" x-model="form.warehouseId"><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name"></option></template></select></div>
</div>
<div class="table-responsive mt-4" x-show="form.lines.length"><table class="table crm-table align-middle mb-0"><thead><tr><th>Return?</th><th>Product</th><th>Source qty</th><th style="width:120px">Return qty</th><th>Reason</th></tr></thead><tbody><template x-for="l in form.lines" :key="l.key"><tr><td><input type="checkbox" class="form-check-input" x-model="l.selected"></td><td><strong x-text="l.productName"></strong><div class="text-muted fs-sm" x-text="l.sku||''"></div></td><td x-text="l.sourceQty"></td><td><input type="number" min="1" :max="l.sourceQty" class="form-control" x-model.number="l.quantity" :disabled="!l.selected"></td><td><input class="form-control" x-model="l.reason" :disabled="!l.selected" placeholder="Reason for return"></td></tr></template></tbody></table></div>
<div class="text-end mt-3"><button class="btn btn-primary" @click="createReturn()">Create return</button></div></div></div>
<% } %>

<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Returns</h2><p class="text-muted mb-0">Customer and supplier return workflow.</p></div><button class="btn btn-light btn-sm" @click="loadReturns()">Refresh</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Return</th><th>Type</th><th>Source</th><th>Warehouse</th><th>Status</th><th>Products</th><th class="text-end">Action</th></tr></thead><tbody>
<template x-for="r in returns" :key="r.returnId"><tr><td><div class="crm-record-title" x-text="r.returnId.slice(0,12)+'…'"></div><div class="text-muted fs-sm" x-text="formatDate(r.createdAt)"></div></td><td x-text="humanize(r.returnType)"></td><td x-text="r.salesOrderId||r.purchaseOrderId||'—'"></td><td x-text="warehouseName(r.warehouseId)"></td><td><span class="crm-status" :class="statusClass(r.status)" x-text="humanize(r.status)"></span></td><td x-text="(r.lines||[]).length"></td><td class="text-end"><% if (can('returns.manage')) { %><button x-show="['requested','approved','received'].includes(r.status)" class="btn btn-sm btn-outline-primary" @click="openProcess(r)">Process</button><% } %></td></tr></template>
<tr x-show="!returns.length"><td colspan="7"><div class="crm-empty-state"><strong>No returns found</strong></div></td></tr>
</tbody></table></div></div>

<% if (can('returns.manage')) { %>
<div class="card crm-data-card mt-4" x-show="processing.return" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Process return</h2><p class="text-muted mb-0" x-text="processing.return?.returnId"></p></div><button class="btn btn-light btn-sm" @click="processing.return=null">Close</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Qty</th><th>Reason</th><th>Outcome</th></tr></thead><tbody><template x-for="l in processing.return?.lines||[]" :key="l.returnLineId"><tr><td x-text="l.productName"></td><td x-text="l.quantity"></td><td x-text="l.reason"></td><td><select class="form-select" x-model="processing.outcomes[l.returnLineId]"><option value="sellable">Return to sellable stock</option><option value="damaged">Damaged</option><option value="supplier_return">Return to supplier</option><option value="replacement">Replacement</option><option value="credit_note">Credit note</option><option value="rejected">Rejected</option></select></td></tr></template></tbody></table></div><div class="card-body text-end"><button class="btn btn-primary" @click="processReturn()">Process return</button></div></div>
<% } %>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function returnsPage(){return{
returns:[],orders:[],purchaseOrders:[],warehouses:[],error:'',showForm:false,form:{returnType:'customer',sourceId:'',warehouseId:'',lines:[]},processing:{return:null,outcomes:{}},
get returnSources(){return this.form.returnType==='customer'?this.orders:this.purchaseOrders},
async load(){try{const[o,p,w]=await Promise.all([apiFetch('/api/orders?limit=100'),apiFetch('/api/procurement?limit=100'),apiFetch('/api/warehouses')]);this.orders=o.data.items||[];this.purchaseOrders=p.data.items||[];this.warehouses=w.data.items||[];await this.loadReturns()}catch(e){this.error=e.message}},
async loadReturns(){try{this.returns=(await apiFetch('/api/returns?limit=100')).data.items||[]}catch(e){this.error=e.message}},
sourceChanged(){this.form.sourceId='';this.form.lines=[]},
async loadSourceLines(){this.form.lines=[];if(!this.form.sourceId)return;try{const url=this.form.returnType==='customer'?'/api/orders/'+this.form.sourceId:'/api/procurement/'+this.form.sourceId;const source=(await apiFetch(url)).data;const lines=source.lines||[];this.form.warehouseId=source.warehouseId||this.form.warehouseId;this.form.lines=lines.map(l=>({key:l.salesOrderLineId||l.purchaseOrderLineId||l.productId,productId:l.productId,productName:l.productName,sku:l.sku||'',sourceQty:Number(l.quantity||0),quantity:1,reason:'',selected:false}))}catch(e){this.error=e.message}},
async createReturn(){const lines=this.form.lines.filter(x=>x.selected).map(x=>({productId:x.productId,productName:x.productName,quantity:Number(x.quantity),reason:x.reason||'Return'}));if(!this.form.sourceId||!this.form.warehouseId||!lines.length)return this.error='Select a source, warehouse and at least one product.';const body={returnType:this.form.returnType,warehouseId:this.form.warehouseId,lines};if(this.form.returnType==='customer')body.salesOrderId=this.form.sourceId;else body.purchaseOrderId=this.form.sourceId;try{await apiFetch('/api/returns',{method:'POST',body:JSON.stringify(body)});showCrmToast('Return created');this.showForm=false;this.form={returnType:'customer',sourceId:'',warehouseId:'',lines:[]};await this.loadReturns()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
openProcess(r){const outcomes={};for(const l of r.lines||[])outcomes[l.returnLineId]=r.returnType==='customer'?'sellable':'supplier_return';this.processing={return:r,outcomes}},
async processReturn(){const r=this.processing.return;if(!r)return;try{await apiFetch('/api/returns/'+r.returnId+'/process',{method:'POST',body:JSON.stringify({outcomes:this.processing.outcomes})});showCrmToast('Return processed');this.processing.return=null;await this.loadReturns()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
warehouseName(id){return this.warehouses.find(x=>x.warehouseId===id)?.name||id}
}}</script><%- include('partials/scripts') %>
</body></html>