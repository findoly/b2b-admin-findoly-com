<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="returnsPage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="card mb-3"><div class="card-header fw-semibold">Create return</div><div class="card-body"><p class="small text-secondary">Customer return: returnType customer, salesOrderId, warehouseId, lines. Supplier return: returnType supplier, purchaseOrderId, warehouseId, lines.</p><textarea class="form-control font-monospace" rows="7" x-model="payload"></textarea><button class="btn btn-primary mt-2" @click="create()">Create return</button></div></div><div class="card"><div class="card-header d-flex justify-content-between"><strong>Returns</strong><button class="btn btn-sm btn-outline-secondary" @click="load()">Refresh</button></div><div class="scroll-table"><table class="table mb-0"><thead><tr><th>ID</th><th>Type</th><th>Reference</th><th>Status</th><th>Lines</th></tr></thead><tbody><template x-for="x in items" :key="x.returnId"><tr><td class="small" x-text="x.returnId"></td><td x-text="x.returnType"></td><td x-text="x.salesOrderId||x.purchaseOrderId"></td><td x-text="x.status"></td><td x-text="(x.lines||[]).length"></td></tr></template></tbody></table></div></div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function returnsPage(){return{items:[],error:'',payload:'{"returnType":"customer","salesOrderId":"","warehouseId":"","lines":[]}',async load(){try{this.items=(await apiFetch('/api/returns')).data.items}catch(e){this.error=e.message}},async create(){try{await apiFetch('/api/returns',{method:'POST',body:this.payload});await this.load()}catch(e){this.error=e.message}}}}</script></body></html>