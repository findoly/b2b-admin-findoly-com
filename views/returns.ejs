<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="returnsPage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="card mb-3"><div class="card-header fw-semibold">Create return</div><div class="card-body"><p class="small text-secondary">Customer return: returnType customer, salesOrderId, warehouseId, lines. Supplier return: returnType supplier, purchaseOrderId, warehouseId, lines.</p><textarea class="form-control font-monospace" rows="7" x-model="payload"></textarea><button class="btn btn-primary mt-2" @click="create()">Create return</button></div></div><div class="card crm-data-card"><div class="card-header d-flex justify-content-between"><strong>Returns</strong><button class="btn btn-sm btn-outline-secondary" @click="load()">Refresh</button></div><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>ID</th><th>Type</th><th>Reference</th><th>Status</th><th>Lines</th></tr></thead><tbody><template x-for="x in items" :key="x.returnId"><tr><td class="small" x-text="x.returnId"></td><td x-text="x.returnType"></td><td x-text="x.salesOrderId||x.purchaseOrderId"></td><td x-text="x.status"></td><td x-text="(x.lines||[]).length"></td></tr></template></tbody></table></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function returnsPage(){return{items:[],error:'',payload:'{"returnType":"customer","salesOrderId":"","warehouseId":"","lines":[]}',async load(){try{this.items=(await apiFetch('/api/returns')).data.items}catch(e){this.error=e.message}},async create(){try{await apiFetch('/api/returns',{method:'POST',body:this.payload});await this.load()}catch(e){this.error=e.message}}}}</script></body></html>