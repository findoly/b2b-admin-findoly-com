<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="invoicePage()" x-init="load()"><div class="d-print-none mb-3"><button class="btn btn-primary" onclick="window.print()">Print invoice</button></div><div class="card"><div class="card-body p-4"><div class="d-flex justify-content-between"><div><h3>Findoly Solutions LLP</h3><div class="text-secondary">B2B Tax Invoice</div></div><div class="text-end"><strong x-text="invoice.invoiceNumber"></strong><div x-text="shortDate(invoice.createdAt)"></div></div></div><hr><div><strong>Bill to:</strong> <span x-text="invoice.customerSnapshot?.businessName"></span><div x-text="invoice.customerSnapshot?.gstin||''"></div></div><div class="scroll-table mt-4"><table class="table"><thead><tr><th>Product</th><th>HSN</th><th>Qty</th><th>Unit</th><th>GST</th><th>Total</th></tr></thead><tbody><template x-for="l in invoice.lines||[]"><tr><td><span x-text="l.productName"></span><div class="small" x-text="l.sku"></div></td><td x-text="l.hsnCode||'—'"></td><td x-text="l.quantity"></td><td x-text="money(l.unitPricePaise)"></td><td x-text="money(l.gstPaise)"></td><td x-text="money(l.taxablePaise+l.gstPaise)"></td></tr></template></tbody></table></div><div class="text-end"><div>Taxable: <strong x-text="money(invoice.taxablePaise)"></strong></div><div x-show="invoice.cgstPaise">CGST: <strong x-text="money(invoice.cgstPaise)"></strong></div><div x-show="invoice.sgstPaise">SGST: <strong x-text="money(invoice.sgstPaise)"></strong></div><div x-show="invoice.igstPaise">IGST: <strong x-text="money(invoice.igstPaise)"></strong></div><div>GST: <strong x-text="money(invoice.totalGstPaise)"></strong></div><div class="fs-5">Total: <strong x-text="money(invoice.totalPaise)"></strong></div><div>Paid: <span x-text="money(invoice.paidPaise)"></span> · Outstanding: <span x-text="money(invoice.outstandingPaise)"></span></div></div></div></div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function invoicePage(){return{invoice:{},async load(){const id=location.pathname.split('/').pop();this.invoice=(await apiFetch('/api/finance/invoices/'+encodeURIComponent(id))).data}}}</script></body></html>