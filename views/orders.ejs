<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Distribution</div><h1 class="page-title mb-1">Sales orders</h1><p class="crm-page-subtitle mb-0">One connected order per customer fulfilment flow: warehouse, sourcing, picking and delivery.</p></div><% if (can('orders.create')) { %><a class="btn btn-primary crm-primary-action" href="/orders/new"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New sales order</a><% } %></div></div>
<div class="content" x-data="ordersListPage()" x-init="loadOrders()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Order pipeline</h2><p class="text-muted mb-0">Open an order to see its customer, warehouse, supplier allocations and delivery mapping.</p></div><div class="d-flex flex-wrap gap-2"><input class="form-control form-control-sm" placeholder="Order or customer" x-model="search" @keyup.enter="filterOrders()"><select class="form-select form-select-sm" x-model="statusFilter" @change="filterOrders()"><option value="">All statuses</option><option value="created">Created</option><option value="procurement_required">Procurement required</option><option value="procurement_in_progress">Procurement in progress</option><option value="stock_ready">Stock ready</option><option value="picking">Picking</option><option value="packed">Packed</option><option value="ready_for_dispatch">Ready for dispatch</option><option value="assigned_for_delivery">Assigned for delivery</option><option value="out_for_delivery">Out for delivery</option><option value="delivered">Delivered</option><option value="partially_delivered">Partially delivered</option><option value="cancelled">Cancelled</option></select><button class="btn btn-light btn-sm" @click="filterOrders()">Search</button></div></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Sales order</th><th>Customer</th><th>Status</th><th>Warehouse</th><th>Products</th><th class="text-end">Total</th><th class="text-end">Next</th></tr></thead><tbody>
<template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
<template x-for="o in orders" :key="o.salesOrderId"><tr><td><a class="crm-record-title" :href="'/orders/'+o.salesOrderId" x-text="o.orderNumber"></a><div class="text-muted fs-sm" x-text="humanize(o.approvalStatus)"></div></td><td><div class="fw-semibold" x-text="o.customerSnapshot?.businessName||'—'"></div><div class="text-muted fs-sm" x-text="o.customerSnapshot?.mobile||''"></div></td><td><span class="crm-status" :class="statusClass(o.status)" x-text="humanize(o.status)"></span></td><td x-text="warehouseName(o.warehouseId)"></td><td><span x-text="(o.lines||[]).length+' SKU(s)'"></span><div class="text-muted fs-sm" x-text="totalQty(o)+' units'"></div></td><td class="text-end fw-semibold" x-text="money(o.totalPaise)"></td><td class="text-end crm-table-actions"><a class="btn btn-sm btn-outline-primary" :href="'/orders/'+o.salesOrderId">Open</a><% if (can('procurement.create')) { %><a x-show="['procurement_required','procurement_in_progress'].includes(o.status)" class="btn btn-sm btn-light" :href="'/orders/'+o.salesOrderId+'/procurement'">Source</a><% } %><% if (can('orders.fulfil')) { %><a x-show="['procurement_required','procurement_in_progress','stock_ready','picking','packed','ready_for_dispatch'].includes(o.status)" class="btn btn-sm btn-light" :href="'/orders/'+o.salesOrderId+'/fulfilment'">Fulfil</a><% } %></td></tr></template>
<tr x-show="!loading && !orders.length"><td colspan="7"><div class="crm-empty-state"><strong>No sales orders found</strong><span>Create a sales order to start a customer distribution flow.</span></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function ordersListPage(){return{
...crmPager('loadOrders'),orders:[],warehouses:[],loading:true,error:'',statusFilter:'',search:'',
async loadOrders(){this.loading=true;try{if(!this.warehouses.length)this.warehouses=(await apiFetch('/api/warehouses')).data.items||[];const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.statusFilter)q.set('status',this.statusFilter);if(this.search)q.set('search',this.search);const data=(await apiFetch('/api/orders?'+q)).data;this.orders=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},
filterOrders(){this.resetPage();return this.loadOrders()},warehouseName(id){return this.warehouses.find(x=>x.warehouseId===id)?.name||'Warehouse'},totalQty(o){return(o.lines||[]).reduce((s,l)=>s+Number(l.quantity||0),0)}
}}</script><%- include('partials/scripts') %>
</body></html>
