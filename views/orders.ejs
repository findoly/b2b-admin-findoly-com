<!doctype html>
<html lang="en" dir="ltr">
<%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()">
<%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Operations</div><h1 class="page-title mb-1">Sales orders</h1><p class="crm-page-subtitle mb-0">Create and fulfil customer orders using approved B2B pricing.</p></div><% if (can('orders.create')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-order')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New sales order</button><% } %></div></div>
<div class="content" x-data="ordersPage()" x-init="load()" @new-order.window="showForm=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<% if (can('orders.create')) { %>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">New sales order</h2><p class="text-muted mb-0">Customers do not place orders; Findoly employees create them here.</p></div><button class="btn btn-light btn-sm" @click="resetForm()">Close</button></div><div class="card-body">
<div class="row g-3">
<div class="col-lg-4"><label class="form-label">Customer</label><select class="form-select" x-model="form.customerId"><option value="">Select customer</option><template x-for="c in customers" :key="c.customerId"><option :value="c.customerId" x-text="c.businessName+' · '+c.mobile"></option></template></select></div>
<div class="col-lg-4"><label class="form-label">Warehouse</label><select class="form-select" x-model="form.warehouseId"><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name+' ('+w.code+')'"></option></template></select></div>
<div class="col-lg-2"><label class="form-label">Payment term days</label><input type="number" min="0" class="form-control" x-model.number="form.paymentTermDays"></div>
<div class="col-lg-2"><label class="form-label">GST treatment</label><select class="form-select" x-model="form.gstTreatment"><option value="unclassified">Decide later</option><option value="intra_state">Intra-state</option><option value="inter_state">Inter-state</option><option value="no_gst">No GST</option></select></div>
<div class="col-12"><label class="form-label">Notes</label><input class="form-control" placeholder="Optional order notes" x-model="form.notes"></div>
</div>
<div class="d-flex justify-content-between align-items-center mt-4 mb-2"><div><h3 class="h6 mb-0">Order products</h3><div class="text-muted fs-sm">Leave agreed price blank to use the approved/customer reference price.</div></div><button class="btn btn-light btn-sm" @click="addLine()">Add product</button></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th style="width:110px">Qty</th><th style="width:170px">Agreed price ₹</th><th style="width:55px"></th></tr></thead><tbody><template x-for="(line,index) in form.lines" :key="line.key"><tr><td><select class="form-select" x-model="line.productId"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></td><td><input type="number" min="1" class="form-control" x-model.number="line.quantity"></td><td><input type="number" min="0" step="0.01" class="form-control" placeholder="Auto" x-model="line.unitPriceRupees"></td><td class="text-end"><button class="btn btn-light btn-sm" @click="removeLine(index)" :disabled="form.lines.length===1">×</button></td></tr></template></tbody></table></div>
<div class="text-end mt-3"><button class="btn btn-primary" @click="createOrder()" :disabled="saving" x-text="saving?'Creating…':'Create sales order'"></button></div>
</div></div>
<% } %>

<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Sales orders</h2><p class="text-muted mb-0">Approval, stock and fulfilment workflow.</p></div><div class="d-flex gap-2"><select class="form-select form-select-sm" x-model="statusFilter" @change="loadOrders()"><option value="">All statuses</option><option value="created">Created</option><option value="procurement_required">Procurement required</option><option value="procurement_in_progress">Procurement in progress</option><option value="stock_ready">Stock ready</option><option value="picking">Picking</option><option value="packed">Packed</option><option value="ready_for_dispatch">Ready for dispatch</option><option value="delivered">Delivered</option><option value="cancelled">Cancelled</option></select><button class="btn btn-light btn-sm" @click="loadOrders()">Refresh</button></div></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Approval</th><th>Products</th><th class="text-end">Total</th><th class="text-end">Actions</th></tr></thead><tbody>
<template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
<template x-for="o in orders" :key="o.salesOrderId"><tr><td><div class="crm-record-title" x-text="o.orderNumber"></div><div class="crm-record-id" x-text="o.salesOrderId"></div></td><td><div class="fw-semibold" x-text="o.customerSnapshot?.businessName"></div><div class="text-muted fs-sm" x-text="o.customerSnapshot?.mobile"></div></td><td><span class="crm-status" :class="statusClass(o.status)" x-text="humanize(o.status)"></span></td><td><span class="crm-status" :class="statusClass(o.approvalStatus)" x-text="humanize(o.approvalStatus)"></span></td><td x-text="(o.lines||[]).length"></td><td class="text-end fw-semibold" x-text="money(o.totalPaise)"></td><td class="text-end crm-table-actions">
<% if (can('orders.approve')) { %><button x-show="o.approvalStatus==='pending'" class="btn btn-sm btn-outline-primary" @click="approve(o)">Approve</button><% } %>
<% if (can('orders.edit')) { %><button x-show="['created','draft'].includes(o.status) && o.approvalStatus!=='pending'" class="btn btn-sm btn-primary" @click="confirmOrder(o)">Confirm</button><% } %>
<% if (can('orders.fulfil')) { %><button x-show="['procurement_required','procurement_in_progress'].includes(o.status)" class="btn btn-sm btn-outline-secondary" @click="recheckStock(o)">Recheck stock</button><button x-show="o.status==='stock_ready'" class="btn btn-sm btn-outline-primary" @click="fulfil(o,'picking')">Start picking</button><button x-show="o.status==='picking'" class="btn btn-sm btn-outline-primary" @click="fulfil(o,'packed')">Mark packed</button><button x-show="o.status==='packed'" class="btn btn-sm btn-outline-primary" @click="fulfil(o,'ready_for_dispatch')">Ready dispatch</button><% } %>
<% if (can('procurement.create')) { %><button x-show="['procurement_required','procurement_in_progress'].includes(o.status)" class="btn btn-sm btn-light" @click="openAllocation(o)">Allocate supplier</button><% } %>
<% if (can('finance.invoice')) { %><button x-show="!['draft','cancelled'].includes(o.status)" class="btn btn-sm btn-light" @click="issueInvoice(o)">Invoice</button><% } %><% if (can('orders.edit')) { %><button x-show="['draft','created','procurement_required','procurement_in_progress','stock_ready','picking','packed','ready_for_dispatch'].includes(o.status)" class="btn btn-sm btn-outline-danger" @click="openCancel(o)">Cancel</button><% } %>
</td></tr></template>
<tr x-show="!loading && !orders.length"><td colspan="7"><div class="crm-empty-state"><strong>No sales orders found</strong><span>Create a customer order to start the B2B workflow.</span></div></td></tr>
</tbody></table></div></div>

<% if (can('orders.edit')) { %>
<div class="card crm-data-card mt-4" x-show="cancellation.order" x-cloak>
  <div class="card-header crm-card-heading">
    <div><h2 class="card-title mb-1">Cancel sales order</h2><p class="text-muted mb-0" x-text="cancellation.order?.orderNumber"></p></div>
    <button class="btn btn-light btn-sm" @click="cancellation={order:null,reason:''}">Close</button>
  </div>
  <div class="card-body">
    <div class="alert alert-warning mb-3">Cancelling releases reserved, picked or packed stock back to available inventory. Orders with an issued invoice cannot be cancelled here.</div>
    <label class="form-label">Cancellation reason</label>
    <textarea class="form-control" rows="3" maxlength="1000" x-model="cancellation.reason" placeholder="Customer cancelled, duplicate order, operational issue…"></textarea>
    <div class="text-end mt-3"><button class="btn btn-danger" @click="submitCancel()" :disabled="!cancellation.reason.trim()">Cancel order and release stock</button></div>
  </div>
</div>
<% } %>
<% if (can('procurement.create')) { %>
<div class="card crm-data-card mt-4" x-show="allocation.order" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Procurement allocation</h2><p class="text-muted mb-0" x-text="allocation.order?.orderNumber"></p></div><button class="btn btn-light btn-sm" @click="allocation.order=null">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-4"><label class="form-label">Order line</label><select class="form-select" x-model="allocation.salesOrderLineId"><option value="">Select product</option><template x-for="l in allocation.order?.lines||[]" :key="l.salesOrderLineId"><option :value="l.salesOrderLineId" x-text="l.productName+' · '+l.sku+' · Qty '+l.quantity"></option></template></select></div>
<div class="col-lg-4"><label class="form-label">Supplier</label><select class="form-select" x-model="allocation.supplierId" @change="loadAllocationLocations()"><option value="">Select supplier</option><template x-for="s in suppliers" :key="s.supplierId"><option :value="s.supplierId" x-text="s.businessName"></option></template></select></div>
<div class="col-lg-4"><label class="form-label">Supplier location</label><select class="form-select" x-model="allocation.supplierLocationId"><option value="">Select location</option><template x-for="l in allocation.locations" :key="l.supplierLocationId"><option :value="l.supplierLocationId" x-text="[l.name,l.city].filter(Boolean).join(' · ')"></option></template></select></div>
<div class="col-md-4"><label class="form-label">Quantity</label><input type="number" min="1" class="form-control" x-model.number="allocation.quantity"></div>
<div class="col-md-4"><label class="form-label">Purchase price ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="allocation.purchasePriceRupees"></div>
<div class="col-md-4"><label class="form-label">GST %</label><input type="number" min="0" max="100" step="0.01" class="form-control" x-model.number="allocation.gstPercent"></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="saveAllocation()">Save allocation</button></div></div></div>
<% } %>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function ordersPage(){return{
orders:[],customers:[],products:[],warehouses:[],suppliers:[],loading:true,saving:false,error:'',showForm:false,statusFilter:'',
form:{customerId:'',warehouseId:'',paymentTermDays:0,gstTreatment:'unclassified',notes:'',lines:[]},
allocation:{order:null,salesOrderLineId:'',supplierId:'',supplierLocationId:'',locations:[],quantity:1,purchasePriceRupees:0,gstPercent:18},
cancellation:{order:null,reason:''},
newLine(){return{key:crypto.randomUUID(),productId:'',quantity:1,unitPriceRupees:''}},
async load(){this.form.lines=[this.newLine()];try{const [c,p,w,s]=await Promise.all([apiFetch('/api/customers?limit=100'),apiFetch('/api/products?limit=100'),apiFetch('/api/warehouses'),apiFetch('/api/suppliers?limit=100')]);this.customers=c.data.items||[];this.products=p.data.items||[];this.warehouses=w.data.items||[];this.suppliers=s.data.items||[];await this.loadOrders()}catch(e){this.error=e.message}finally{this.loading=false}},
async loadOrders(){this.loading=true;try{const q=this.statusFilter?'?status='+encodeURIComponent(this.statusFilter)+'&limit=100':'?limit=100';this.orders=(await apiFetch('/api/orders'+q)).data.items||[]}catch(e){this.error=e.message}finally{this.loading=false}},
addLine(){this.form.lines.push(this.newLine())},removeLine(i){if(this.form.lines.length>1)this.form.lines.splice(i,1)},resetForm(){this.showForm=false;this.form={customerId:'',warehouseId:'',paymentTermDays:0,gstTreatment:'unclassified',notes:'',lines:[this.newLine()]}},
async createOrder(){if(!this.form.customerId||!this.form.warehouseId)return this.error='Customer and warehouse are required.';if(this.form.lines.some(l=>!l.productId||Number(l.quantity)<1))return this.error='Complete every order line.';this.saving=true;try{const lines=this.form.lines.map(l=>{const x={productId:l.productId,quantity:Number(l.quantity)};if(String(l.unitPriceRupees)!=='')x.unitPricePaise=Math.round(Number(l.unitPriceRupees||0)*100);return x});await apiFetch('/api/orders',{method:'POST',body:JSON.stringify({...this.form,lines})});showCrmToast('Sales order created');this.resetForm();await this.loadOrders()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}},
async approve(o){try{await apiFetch('/api/orders/'+o.salesOrderId+'/approve',{method:'POST',body:'{}'});showCrmToast('Order approved');await this.loadOrders()}catch(e){this.error=e.message}},
async confirmOrder(o){try{await apiFetch('/api/orders/'+o.salesOrderId+'/confirm',{method:'POST',body:'{}'});showCrmToast('Order confirmed');await this.loadOrders()}catch(e){this.error=e.message}},
async fulfil(o,status){try{await apiFetch('/api/orders/'+o.salesOrderId+'/fulfil',{method:'POST',body:JSON.stringify({status})});showCrmToast('Order updated');await this.loadOrders()}catch(e){this.error=e.message}},
async recheckStock(o){try{const x=(await apiFetch('/api/orders/'+o.salesOrderId+'/recheck-stock',{method:'POST',body:'{}'})).data;showCrmToast(x.status==='stock_ready'?'Stock reserved; order is ready':'Stock rechecked; procurement is still required');await this.loadOrders()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
openCancel(o){this.cancellation={order:o,reason:''};this.allocation.order=null;this.$nextTick(()=>window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'}))},
async submitCancel(){const c=this.cancellation;if(!c.order||!c.reason.trim())return this.error='Cancellation reason is required.';try{await apiFetch('/api/orders/'+c.order.salesOrderId+'/cancel',{method:'POST',body:JSON.stringify({reason:c.reason.trim()})});showCrmToast('Order cancelled and stock released');this.cancellation={order:null,reason:''};await this.loadOrders()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async issueInvoice(o){try{const x=(await apiFetch('/api/finance/invoices/order/'+o.salesOrderId,{method:'POST',body:'{}'})).data;showCrmToast('Invoice issued');location.href='/invoices/'+x.invoiceId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
openAllocation(o){this.allocation={order:o,salesOrderLineId:o.lines?.[0]?.salesOrderLineId||'',supplierId:'',supplierLocationId:'',locations:[],quantity:1,purchasePriceRupees:0,gstPercent:18}},
async loadAllocationLocations(){this.allocation.supplierLocationId='';this.allocation.locations=[];if(!this.allocation.supplierId)return;try{const s=(await apiFetch('/api/suppliers/'+this.allocation.supplierId)).data;this.allocation.locations=(s.locations||[]).filter(x=>x.active!==false)}catch(e){this.error=e.message}},
async saveAllocation(){const a=this.allocation;if(!a.order||!a.salesOrderLineId||!a.supplierId||!a.supplierLocationId)return this.error='Complete the procurement allocation.';try{await apiFetch('/api/orders/'+a.order.salesOrderId+'/procurement',{method:'POST',body:JSON.stringify({salesOrderLineId:a.salesOrderLineId,supplierId:a.supplierId,supplierLocationId:a.supplierLocationId,quantity:Number(a.quantity),purchasePricePaise:Math.round(Number(a.purchasePriceRupees||0)*100),gstRateBps:Math.round(Number(a.gstPercent||0)*100)})});showCrmToast('Procurement allocation saved');a.order=null;await this.loadOrders()}catch(e){this.error=e.message}}
}}</script>
<%- include('partials/scripts') %>
</body></html>