<!doctype html><html><head><%- include('partials/head') %></head><body><main class="login-wrap" x-data="loginApp()"><div class="login-card card"><div class="card-body p-4"><div class="mb-4"><h2 class="h4 mb-1">Findoly B2B Admin</h2><p class="text-secondary mb-0">Employee OTP access</p></div><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div x-show="step===1"><label class="form-label">Mobile number</label><input class="form-control form-control-lg" x-model="mobile" inputmode="numeric" maxlength="10"><button class="btn btn-primary w-100 mt-3" @click="send" :disabled="busy"><span x-text="busy?'Sending…':'Send OTP'"></span></button></div><div x-show="step===2" x-cloak><label class="form-label">OTP</label><input class="form-control form-control-lg" x-model="otp" inputmode="numeric" maxlength="8"><button class="btn btn-primary w-100 mt-3" @click="verify" :disabled="busy"><span x-text="busy?'Verifying…':'Verify & sign in'"></span></button><button class="btn btn-link w-100 mt-2" @click="step=1">Change mobile</button></div></div></div></main><script src="/assets/js/app.js"></script><script nonce="<%= cspNonce %>">function loginApp(){return{step:1,mobile:'',otp:'',busy:false,error:'',async send(){this.error='';this.busy=true;try{await apiFetch('/api/auth/send-otp',{method:'POST',body:JSON.stringify({mobile:this.mobile})});this.step=2}catch(e){this.error=e.message}finally{this.busy=false}},async verify(){this.error='';this.busy=true;try{await apiFetch('/api/auth/verify-otp',{method:'POST',body:JSON.stringify({mobile:this.mobile,otp:this.otp})});const q=new URLSearchParams(location.search);location.href=q.get('returnTo')||'/dashboard'}catch(e){this.error=e.message}finally{this.busy=false}}}}</script><script defer src="/vendor/alpinejs/cdn.min.js"></script></body></html>