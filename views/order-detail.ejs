<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Connected distribution record</div><h1 class="page-title mb-1" x-data x-text="document.body.dataset.orderTitle||'Sales order'">Sales order</h1><p class="crm-page-subtitle mb-0">Customer, product demand, supplier sourcing, warehouse fulfilment and delivery in one operational view.</p></div><div class="d-flex gap-2"><a class="btn btn-light" href="/orders">Back</a></div></div></div>
<div class="content" x-data="orderDetailPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<template x-if="loading"><div class="card crm-data-card"><div class="card-body"><div class="crm-table-loading"><span></span><span></span><span></span></div></div></div></template>
<div x-show="order" x-cloak>
<div class="d-flex flex-wrap gap-2 mb-4"><% if (can('procurement.create')) { %><a x-show="['procurement_required','procurement_in_progress'].includes(order?.status)" class="btn btn-outline-primary" :href="'/orders/'+orderId+'/procurement'">Source shortage</a><% } %><% if (can('orders.fulfil')) { %><a x-show="['procurement_required','procurement_in_progress','stock_ready','picking','packed','ready_for_dispatch'].includes(order?.status)" class="btn btn-outline-primary" :href="'/orders/'+orderId+'/fulfilment'">Warehouse fulfilment</a><% } %><% if (can('delivery.assign')) { %><a x-show="['packed','ready_for_dispatch'].includes(order?.status)" class="btn btn-primary" :href="'/delivery/assign?salesOrderId='+orderId">Assign delivery</a><% } %></div>
<div class="row g-4 mb-4"><div class="col-lg-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Sales order</div><h2 class="h5 mb-2" x-text="order?.orderNumber"></h2><span class="crm-status" :class="statusClass(order?.status)" x-text="humanize(order?.status)"></span><div class="mt-3 text-muted fs-sm">Approval</div><span class="crm-status" :class="statusClass(order?.approvalStatus)" x-text="humanize(order?.approvalStatus)"></span></div></div></div><div class="col-lg-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Customer</div><h2 class="h5 mb-1" x-text="order?.customerSnapshot?.businessName||'—'"></h2><div x-text="order?.customerSnapshot?.mobile||''"></div><div class="text-muted fs-sm mt-3">Delivery address</div><div x-text="addressText(order?.deliveryAddressSnapshot)"></div></div></div></div><div class="col-lg-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Fulfilment warehouse</div><h2 class="h5 mb-1" x-text="warehouse?.name||'—'"></h2><div x-text="warehouse?.code||''"></div><div class="text-muted fs-sm mt-3">Order total</div><strong class="fs-5" x-text="money(order?.totalPaise)"></strong></div></div></div></div>
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Product demand & source mapping</h2><p class="text-muted mb-0">Each product can be supplied by one or more supplier allocations while the sales order remains the customer-facing demand record.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th class="text-end">Ordered</th><th class="text-end">Warehouse reserved</th><th class="text-end">Procurement required</th><th class="text-end">Allocated</th><th>Supplier sources</th></tr></thead><tbody><template x-for="line in order?.lines||[]" :key="line.salesOrderLineId"><tr><td><a class="crm-record-title" :href="'/products/'+line.productId" x-text="line.productName"></a><div class="text-muted fs-sm" x-text="line.sku"></div></td><td class="text-end" x-text="line.quantity"></td><td class="text-end" x-text="line.stockReservedQty||0"></td><td class="text-end" x-text="line.procurementRequiredQty||0"></td><td class="text-end" x-text="allocatedQty(line.salesOrderLineId)"></td><td><template x-if="lineAllocations(line.salesOrderLineId).length"><div><template x-for="a in lineAllocations(line.salesOrderLineId)" :key="a.procurementAllocationId"><div class="mb-2"><strong x-text="a.supplierSnapshot?.businessName||'Supplier'"></strong><div class="text-muted fs-sm"><span x-text="a.quantity+' units'"></span><span> · </span><span x-text="money(a.purchasePricePaise)+' buy price'"></span><span> · </span><span x-text="humanize(a.status)"></span></div></div></template></div></template><span x-show="!lineAllocations(line.salesOrderLineId).length" class="text-muted">Warehouse stock / not yet sourced</span></td></tr></template></tbody></table></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Linked purchase orders</h2><p class="text-muted mb-0">Purchase orders generated from this order's supplier allocations.</p></div></div><div class="card-body"><% if (can('procurement.view')) { %><template x-for="po in purchaseOrders" :key="po.purchaseOrderId"><div class="border rounded p-3 mb-2 d-flex justify-content-between gap-3"><div><a class="crm-record-title" :href="'/procurement/'+po.purchaseOrderId" x-text="po.poNumber"></a><div class="text-muted fs-sm" x-text="po.supplierName"></div></div><span class="crm-status" :class="statusClass(po.status)" x-text="humanize(po.status)"></span></div></template><div x-show="!purchaseOrders.length" class="text-muted">No linked purchase order yet.</div><% } else { %><div class="text-muted">Procurement-view permission is required to open purchase orders.</div><% } %></div></div></div><div class="col-lg-6"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Delivery mapping</h2><p class="text-muted mb-0">Delivery always inherits this sales order's warehouse and product lines.</p></div></div><div class="card-body"><% if (can('delivery.view')) { %><template x-for="d in deliveries" :key="d.deliveryAssignmentId"><div class="border rounded p-3 mb-2 d-flex justify-content-between gap-3"><div><a class="crm-record-title" :href="'/delivery/'+d.deliveryAssignmentId" x-text="d.driverName||d.deliveryProviderName||humanize(d.deliveryType)"></a><div class="text-muted fs-sm" x-text="(d.warehouseSnapshot?.name||warehouse?.name||'Warehouse')+' · '+(d.lines||[]).length+' SKU(s)'"></div></div><span class="crm-status" :class="statusClass(d.status)" x-text="humanize(d.status)"></span></div></template><div x-show="!deliveries.length" class="text-muted">No delivery assignment yet.</div><% } else { %><div class="text-muted">Delivery-view permission is required to open delivery assignments.</div><% } %></div></div></div></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Order actions</h2><p class="text-muted mb-0">State-changing actions remain permission controlled and audited.</p></div></div><div class="card-body"><div class="d-flex flex-wrap gap-2"><% if (can('orders.approve')) { %><button x-show="order?.approvalStatus==='pending'" class="btn btn-outline-primary" @click="approve()">Approve order</button><% } %><% if (can('orders.edit')) { %><button x-show="['created','draft'].includes(order?.status) && order?.approvalStatus!=='pending'" class="btn btn-primary" @click="confirmOrder()">Confirm & reserve stock</button><% } %><% if (can('finance.invoice')) { %><button x-show="!['draft','created','cancelled'].includes(order?.status)" class="btn btn-light" @click="issueInvoice()">Issue invoice</button><% } %><% if (can('orders.edit')) { %><button x-show="cancellable()" class="btn btn-outline-danger" @click="showCancel=!showCancel">Cancel order</button><% } %></div><% if (can('orders.edit')) { %><div x-show="showCancel" x-cloak class="border rounded p-3 mt-3"><label class="form-label">Cancellation reason</label><textarea class="form-control" rows="3" maxlength="1000" x-model="cancelReason"></textarea><div class="text-end mt-2"><button class="btn btn-danger" @click="cancelOrder()" :disabled="!cancelReason.trim()">Cancel and release stock</button></div></div><% } %></div></div>
</div></div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function orderDetailPage(){return{
orderId:location.pathname.split('/')[2]||'',order:null,warehouse:null,deliveries:[],purchaseOrders:[],loading:true,error:'',showCancel:false,cancelReason:'',
async load(){try{const order=(await apiFetch('/api/orders/'+this.orderId)).data;this.order=order;document.body.dataset.orderTitle=order.orderNumber;const warehouses=(await apiFetch('/api/warehouses')).data.items||[];this.warehouse=warehouses.find(x=>x.warehouseId===order.warehouseId)||null;<% if (can('delivery.view')) { %>this.deliveries=(await apiFetch('/api/delivery?salesOrderId='+encodeURIComponent(this.orderId)+'&limit=100')).data.items||[];<% } %><% if (can('procurement.view')) { %>const ids=[...new Set((order.procurementAllocations||[]).map(x=>x.purchaseOrderId).filter(Boolean))];this.purchaseOrders=(await Promise.all(ids.map(async id=>{try{return(await apiFetch('/api/procurement/'+id)).data}catch(_){return null}}))).filter(Boolean);<% } %>}catch(e){this.error=e.message}finally{this.loading=false}},
lineAllocations(id){return(this.order?.procurementAllocations||[]).filter(x=>x.salesOrderLineId===id&&x.status!=='cancelled')},allocatedQty(id){return this.lineAllocations(id).reduce((s,x)=>s+Number(x.quantity||0),0)},addressText(a){return[a?.line1,a?.line2,a?.city,a?.state,a?.pincode].filter(Boolean).join(', ')||'—'},cancellable(){return['draft','created','procurement_required','procurement_in_progress','stock_ready','picking','packed','ready_for_dispatch'].includes(this.order?.status)},
async approve(){try{this.order=(await apiFetch('/api/orders/'+this.orderId+'/approve',{method:'POST',body:'{}'})).data;showCrmToast('Order approved')}catch(e){this.error=e.message}},async confirmOrder(){try{this.order=(await apiFetch('/api/orders/'+this.orderId+'/confirm',{method:'POST',body:'{}'})).data;showCrmToast(this.order.status==='stock_ready'?'Stock reserved; order is ready':'Order confirmed; procurement is required');await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},async issueInvoice(){try{const x=(await apiFetch('/api/finance/invoices/order/'+this.orderId,{method:'POST',body:'{}'})).data;showCrmToast('Invoice issued');location.href='/invoices/'+x.invoiceId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},async cancelOrder(){if(!this.cancelReason.trim())return;try{this.order=(await apiFetch('/api/orders/'+this.orderId+'/cancel',{method:'POST',body:JSON.stringify({reason:this.cancelReason.trim()})})).data;this.showCancel=false;showCrmToast('Order cancelled and stock released')}catch(e){this.error=e.message;showCrmToast(e.message,'error')}}
}}</script><%- include('partials/scripts') %>
</body></html>
