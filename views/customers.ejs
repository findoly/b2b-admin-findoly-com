<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="customers()" x-init="load()"><div class="d-flex gap-2 mb-3"><input class="form-control" placeholder="Search customers" x-model="search" @keyup.enter="load()"><button class="btn btn-outline-secondary" @click="load()">Search</button><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newCustomer">New customer</button></div><div class="collapse mb-3" id="newCustomer"><div class="card"><div class="card-body"><div class="row g-2"><div class="col-md-4"><input class="form-control" placeholder="Business name" x-model="form.businessName"></div><div class="col-md-3"><input class="form-control" placeholder="Contact name" x-model="form.contactName"></div><div class="col-md-2"><input class="form-control" placeholder="Mobile" x-model="form.mobile"></div><div class="col-md-3"><select class="form-select" x-model="form.customerType"><option>retailer</option><option>wholesaler</option><option>distributor</option><option>other</option></select></div><div class="col-md-4"><input class="form-control" placeholder="Address" x-model="form.billingAddress.line1"></div><div class="col-md-2"><input class="form-control" placeholder="City" x-model="form.billingAddress.city"></div><div class="col-md-2"><input class="form-control" placeholder="State" x-model="form.billingAddress.state"></div><div class="col-md-2"><input class="form-control" placeholder="Pincode" x-model="form.billingAddress.pincode"></div><div class="col-md-2"><input class="form-control" type="number" placeholder="Credit limit paise" x-model.number="form.creditLimitPaise"></div><div class="col-12"><button class="btn btn-primary" @click="create()">Save customer</button></div></div></div></div></div><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="card"><div class="scroll-table"><table class="table mb-0"><thead><tr><th>Business</th><th>Type</th><th>Contact</th><th>GSTIN</th><th>Terms</th><th>Status</th></tr></thead><tbody><template x-for="x in items" :key="x.customerId"><tr><td><strong x-text="x.businessName"></strong><div class="small text-secondary" x-text="x.customerId"></div></td><td x-text="x.customerType"></td><td><span x-text="x.contactName"></span><div class="small" x-text="x.mobile"></div></td><td x-text="x.gstin||'—'"></td><td x-text="(x.paymentTermDays||0)+' days'"></td><td x-text="x.status"></td></tr></template></tbody></table></div></div></div></div></main></div><%- include('partials/scripts') %><script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script><script nonce="<%= cspNonce %>">function customers(){return{items:[],search:'',error:'',form:{customerType:'retailer',businessName:'',contactName:'',mobile:'',creditLimitPaise:0,billingAddress:{line1:'',city:'',state:'Maharashtra',pincode:''}},async load(){try{this.items=(await apiFetch('/api/customers?search='+encodeURIComponent(this.search))).data.items}catch(e){this.error=e.message}},async create(){try{await apiFetch('/api/customers',{method:'POST',body:JSON.stringify(this.form)});this.form={customerType:'retailer',businessName:'',contactName:'',mobile:'',creditLimitPaise:0,billingAddress:{line1:'',city:'',state:'Maharashtra',pincode:''}};await this.load()}catch(e){this.error=e.message}}}}</script></body></html>