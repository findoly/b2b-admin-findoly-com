<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Sales</div><h1 class="page-title mb-1">Customers</h1><p class="crm-page-subtitle mb-0">Retailer, wholesaler and distributor accounts, credit terms and complete customer history.</p></div><% if (can('customers.create')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-customer')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New customer</button><% } %></div></div>
<div class="content" x-data="customersPage()" x-init="load()" @new-customer.window="startCreate()"><div class="d-flex justify-content-end mb-3"><a class="btn btn-light" href="/operations-map?type=customer">View locations on Google Maps</a></div>
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<div class="card crm-data-card mb-4" x-show="showForm" x-cloak>
  <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1" x-text="editingId?'Edit customer':'New customer'"></h2><p class="text-muted mb-0">Business, contact, route, payment, portal and delivery-address settings.</p></div><button class="btn btn-light btn-sm" @click="closeForm()">Close</button></div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-lg-4"><label class="form-label">Business name</label><input class="form-control" x-model="form.businessName"></div>
      <div class="col-lg-2"><label class="form-label">Customer type</label><select class="form-select" x-model="form.customerType"><option value="retailer">Retailer</option><option value="wholesaler">Wholesaler</option><option value="distributor">Distributor</option><option value="other">Other</option></select></div>
      <div class="col-lg-3"><label class="form-label">Contact name</label><input class="form-control" x-model="form.contactName"></div>
      <div class="col-lg-3"><label class="form-label">Mobile</label><input class="form-control" inputmode="numeric" maxlength="10" x-model="form.mobile"></div>
      <div class="col-md-4"><label class="form-label">Email</label><input type="email" class="form-control" x-model="form.email"></div>
      <div class="col-md-4"><label class="form-label">GSTIN</label><input class="form-control" x-model="form.gstin"></div>
      <div class="col-md-4"><label class="form-label">Assigned sales employee</label><select class="form-select" x-model="form.assignedEmployeeId"><option value="">Auto assign current employee</option><template x-for="e in assignees" :key="e.employeeId"><option :value="e.employeeId" x-text="e.name+(e.employeeCode?' · '+e.employeeCode:'')"></option></template></select></div>
      <div class="col-md-3"><label class="form-label">Territory</label><input class="form-control" x-model="form.territory"></div>
      <div class="col-md-3"><label class="form-label">Route</label><input class="form-control" x-model="form.routeName"></div>
      <div class="col-md-3"><label class="form-label">Payment term days</label><input type="number" min="0" class="form-control" x-model.number="form.paymentTermDays"></div>
      <div class="col-md-3"><label class="form-label">Account status</label><select class="form-select" x-model="form.status"><option value="active">Active</option><option value="inactive">Inactive</option><option value="blocked">Blocked</option></select></div>
      <% if (can('customers.credit')) { %>
      <div class="col-md-4"><label class="form-label">Credit limit ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.creditLimitRupees"></div>
      <div class="col-md-4 d-flex align-items-end"><label class="form-check mb-2"><input class="form-check-input" type="checkbox" x-model="form.creditHold"><span class="form-check-label">Place customer on credit hold</span></label></div>
      <% } %>
      <div class="col-md-4 d-flex align-items-end"><label class="form-check mb-2"><input class="form-check-input" type="checkbox" x-model="form.portalAccessEnabled"><span class="form-check-label">Customer portal access enabled</span></label></div>
    </div>
    <hr class="my-4">
    <h3 class="h6">Billing address</h3>
    <div class="row g-3">
      <div class="col-md-5"><input class="form-control" placeholder="Address line 1" x-model="form.billingAddress.line1"></div><div class="col-md-3"><input class="form-control" placeholder="Address line 2" x-model="form.billingAddress.line2"></div><div class="col-md-2"><input class="form-control" placeholder="City" x-model="form.billingAddress.city"></div><div class="col-md-1"><input class="form-control" placeholder="State" x-model="form.billingAddress.state"></div><div class="col-md-1"><input class="form-control" placeholder="Pincode" x-model="form.billingAddress.pincode"></div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-4 mb-2"><div><h3 class="h6 mb-0">Delivery addresses</h3><div class="text-muted fs-sm">Store multiple delivery points for future orders.</div></div><button class="btn btn-light btn-sm" @click="addAddress()">Add address</button></div>
    <template x-for="(a,index) in form.deliveryAddresses" :key="a.key"><div class="border rounded p-3 mb-2"><div class="row g-2"><div class="col-md-2"><input class="form-control" placeholder="Label" x-model="a.label"></div><div class="col-md-3"><input class="form-control" placeholder="Address line 1" x-model="a.line1"></div><div class="col-md-2"><input class="form-control" placeholder="City" x-model="a.city"></div><div class="col-md-2"><input class="form-control" placeholder="State" x-model="a.state"></div><div class="col-md-1"><input class="form-control" placeholder="Pincode" x-model="a.pincode"></div><div class="col-md-1 d-flex align-items-center"><label class="form-check"><input class="form-check-input" type="checkbox" x-model="a.isDefault"><span class="form-check-label fs-sm">Default</span></label></div><div class="col-md-1 text-end"><button class="btn btn-light btn-sm" @click="removeAddress(index)">×</button></div></div></div></template>
    <div class="mt-3"><label class="form-label">Customer documents</label><input class="form-control" type="file" @change="uploadCustomerDocument($event)" accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt"><div class="text-muted fs-sm mt-1">Private customer documents. Maximum size follows the configured S3 upload limit.</div><div class="d-flex flex-wrap gap-2 mt-2"><template x-for="(key,index) in form.documentKeys||[]" :key="key"><span class="badge bg-light text-dark border d-inline-flex align-items-center gap-2"><button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @click="openCustomerDocument(key)" x-text="attachmentName(key)"></button><button type="button" class="btn-close" aria-label="Remove" @click="form.documentKeys.splice(index,1)"></button></span></template></div></div>
    <div class="mt-3"><label class="form-label">Notes</label><textarea class="form-control" rows="2" x-model="form.notes"></textarea></div>
    <div class="text-end mt-3"><button class="btn btn-primary" @click="save()" :disabled="saving" x-text="saving?'Saving…':(editingId?'Save changes':'Create customer')"></button></div>
  </div>
</div>

<div class="card crm-data-card mb-4">
  <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Customer accounts</h2><p class="text-muted mb-0">Search and open the complete customer record.</p></div><div class="d-flex gap-2"><input class="form-control form-control-sm" placeholder="Search business, contact, mobile or GSTIN" x-model="search" @keyup.enter="searchCustomers()"><select class="form-select form-select-sm" x-model="statusFilter" @change="searchCustomers()"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option><option value="blocked">Blocked</option></select><button class="btn btn-light btn-sm" @click="searchCustomers()">Search</button></div></div>
  <div class="table-responsive"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Customer</th><th>Contact</th><th>Assigned</th><th>Terms</th><th>Credit</th><th>Portal</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
    <template x-for="c in items" :key="c.customerId"><tr><td><strong x-text="c.businessName"></strong><div class="text-muted fs-sm" x-text="humanize(c.customerType)"></div></td><td><span x-text="c.contactName"></span><div class="text-muted fs-sm" x-text="c.mobile"></div></td><td x-text="assigneeName(c.assignedEmployeeId)"></td><td x-text="(c.paymentTermDays||0)+' days'"></td><td><span x-text="money(c.creditLimitPaise)"></span><div class="text-danger fs-sm" x-show="c.creditHold">Credit hold</div></td><td><span class="crm-status" :class="c.portalAccessEnabled?'status-paid':'status-pending'" x-text="c.portalAccessEnabled?'Enabled':'Disabled'"></span></td><td><span class="crm-status" :class="statusClass(c.status)" x-text="humanize(c.status)"></span></td><td class="text-end crm-table-actions"><button class="btn btn-sm btn-outline-primary" @click="open360(c)">360°</button><% if (can('customers.edit')) { %><button class="btn btn-sm btn-light" @click="edit(c)">Edit</button><% } %></td></tr></template>
    <tr x-show="!loading && !items.length"><td colspan="8"><div class="crm-empty-state"><strong>No customers found</strong></div></td></tr>
  </tbody></table></div>
<%- include('partials/pager') %>
</div>

<div x-show="selected360" x-cloak>
  <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h4 mb-1" x-text="crmValue(selected360,'customer.businessName','')"></h2><div class="text-muted" x-text="crmValue(selected360,'customer.mobile','')"></div></div><button class="btn btn-light" @click="selected360=null">Close 360°</button></div>
  <section class="crm-metric-grid mb-4">
    <article class="crm-metric-card crm-metric-blue"><div class="crm-metric-top"><div><span class="crm-metric-label">Credit exposure</span><strong class="crm-metric-value" x-text="money(crmValue(selected360,'creditExposurePaise',0))">₹0.00</strong></div></div><div class="crm-metric-note" x-text="'Invoices '+money(crmValue(selected360,'outstandingPaise',0))+' + open orders '+money(crmValue(selected360,'openOrderExposurePaise',0))"></div></article>
    <article class="crm-metric-card crm-metric-purple"><div class="crm-metric-top"><div><span class="crm-metric-label">Credit limit</span><strong class="crm-metric-value" x-text="money(crmValue(selected360,'customer.creditLimitPaise',0))">₹0.00</strong></div></div><div class="crm-metric-note">Configured customer credit</div></article>
    <article class="crm-metric-card crm-metric-green"><div class="crm-metric-top"><div><span class="crm-metric-label">Available credit</span><strong class="crm-metric-value" x-text="money(crmValue(selected360,'availableCreditPaise',0))">₹0.00</strong></div></div><div class="crm-metric-note">After invoices and confirmed uninvoiced orders</div></article>
    <article class="crm-metric-card crm-metric-amber"><div class="crm-metric-top"><div><span class="crm-metric-label">Orders</span><strong class="crm-metric-value" x-text="crmList(selected360,'orders').length">0</strong></div></div><div class="crm-metric-note">Recent order history</div></article>
  </section>
  <div class="row g-4">
    <div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><h3 class="card-title mb-0">Recent orders</h3></div><div class="table-responsive"><table class="table crm-table crm-mobile-records mb-0"><thead><tr><th>Order</th><th>Status</th><th>Date</th><th class="text-end">Total</th></tr></thead><tbody><template x-for="o in crmList(selected360,'orders')" :key="o.salesOrderId"><tr><td x-text="o.orderNumber"></td><td><span class="crm-status" :class="statusClass(o.status)" x-text="humanize(o.status)"></span></td><td x-text="formatDateOnly(o.createdAt)"></td><td class="text-end" x-text="money(o.totalPaise)"></td></tr></template></tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><h3 class="card-title mb-0">Invoices & payments</h3></div><div class="card-body"><div class="mb-3"><strong>Invoices</strong><template x-for="i in crmList(selected360,'invoices')" :key="i.invoiceId"><div class="d-flex justify-content-between border-bottom py-2"><span><span x-text="i.invoiceNumber"></span><small class="d-block text-muted" x-text="humanize(i.paymentStatus)"></small></span><strong x-text="money(i.outstandingPaise)"></strong></div></template></div><div><strong>Payments</strong><template x-for="p in crmList(selected360,'payments')" :key="p.paymentId"><div class="d-flex justify-content-between border-bottom py-2"><span x-text="formatDateOnly(p.paidAt)"></span><strong x-text="money(p.amountPaise)"></strong></div></template></div></div></div></div>
    <div class="col-lg-6"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><h3 class="card-title mb-0">Delivery, pricing & returns</h3></div><div class="card-body"><div class="mb-3"><strong>Deliveries</strong><template x-for="d in crmList(selected360,'deliveries')" :key="d.deliveryAssignmentId"><div class="d-flex justify-content-between border-bottom py-2"><span x-text="d.deliveryProviderName||humanize(d.deliveryType)"></span><span class="crm-status" :class="statusClass(d.status)" x-text="humanize(d.status)"></span></div></template></div><div class="mb-3"><strong>Negotiated prices</strong><div class="text-muted fs-sm" x-text="crmList(selected360,'prices').length+' price agreements'"></div></div><div><strong>Returns</strong><div class="text-muted fs-sm" x-text="crmList(selected360,'returns').length+' return records'"></div></div></div></div></div>
  </div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function customersPage(){return{
...crmPager('loadCustomers'),items:[],assignees:[],selected360:null,loading:true,saving:false,error:'',search:'',statusFilter:'',showForm:false,editingId:'',form:null,
blankAddress(){return{key:crypto.randomUUID(),label:'',line1:'',line2:'',city:'',state:'Maharashtra',pincode:'',contactName:'',contactMobile:'',isDefault:false}},
blankForm(){return{businessName:'',customerType:'retailer',contactName:'',mobile:'',email:'',gstin:'',assignedEmployeeId:'',territory:'',routeName:'',paymentTermDays:0,creditLimitRupees:0,creditHold:false,portalAccessEnabled:true,status:'active',billingAddress:{label:'Billing',line1:'',line2:'',city:'',state:'Maharashtra',pincode:'',contactName:'',contactMobile:'',isDefault:true},deliveryAddresses:[],documentKeys:[],notes:''}},
async load(){this.form=this.blankForm();try{const a=await apiFetch('/api/customers/options/assignees');this.assignees=a.data.items||[];await this.loadCustomers();const id=new URLSearchParams(location.search).get("customerId");if(id)await this.open360({customerId:id})}catch(e){this.error=e.message}finally{this.loading=false}},
async loadCustomers(){this.loading=true;try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.search)q.set('search',this.search);if(this.statusFilter)q.set('status',this.statusFilter);const data=(await apiFetch('/api/customers?'+q)).data;this.items=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},searchCustomers(){this.resetPage();return this.loadCustomers()},
startCreate(){this.editingId='';this.form=this.blankForm();this.showForm=true;this.selected360=null},
closeForm(){this.showForm=false;this.editingId=''},
addAddress(){this.form.deliveryAddresses.push(this.blankAddress())},removeAddress(i){this.form.deliveryAddresses.splice(i,1)},
assigneeName(id){return this.assignees.find(x=>x.employeeId===id)?.name||'Unassigned'},async uploadCustomerDocument(event){const file=event.target.files?.[0];if(!file)return;try{const uploaded=await uploadBusinessAttachment('customers',file);this.form.documentKeys=[...(this.form.documentKeys||[]),uploaded.key];showCrmToast('Customer document uploaded')}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{event.target.value=''}},async openCustomerDocument(key){try{await openBusinessAttachment('customers',key)}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async edit(c){try{const x=(await apiFetch('/api/customers/'+c.customerId)).data;this.editingId=x.customerId;this.form={businessName:x.businessName,customerType:x.customerType,contactName:x.contactName,mobile:x.mobile,email:x.email||'',gstin:x.gstin||'',assignedEmployeeId:x.assignedEmployeeId||'',territory:x.territory||'',routeName:x.routeName||'',paymentTermDays:Number(x.paymentTermDays||0),creditLimitRupees:Number(x.creditLimitPaise||0)/100,creditHold:Boolean(x.creditHold),portalAccessEnabled:x.portalAccessEnabled!==false,status:x.status,billingAddress:{...(x.billingAddress||{})},deliveryAddresses:(x.deliveryAddresses||[]).map(a=>({key:crypto.randomUUID(),...a})),documentKeys:[...(x.documentKeys||[])],notes:x.notes||''};this.showForm=true;this.selected360=null;window.scrollTo({top:0,behavior:'smooth'})}catch(e){this.error=e.message}},
async save(){const body={...this.form,deliveryAddresses:this.form.deliveryAddresses.map(({key,...a})=>a)};delete body.creditLimitRupees;<% if (can('customers.credit')) { %>body.creditLimitPaise=Math.round(Number(this.form.creditLimitRupees||0)*100);<% } else { %>delete body.creditHold;<% } %>this.saving=true;try{if(this.editingId)await apiFetch('/api/customers/'+this.editingId,{method:'PUT',body:JSON.stringify(body)});else await apiFetch('/api/customers',{method:'POST',body:JSON.stringify(body)});showCrmToast(this.editingId?'Customer updated':'Customer created');this.closeForm();await this.loadCustomers()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}},
async open360(c){try{this.selected360=(await apiFetch('/api/customers/'+c.customerId+'/360')).data;this.showForm=false;this.$nextTick(()=>this.$el.scrollIntoView({behavior:'smooth'}))}catch(e){this.error=e.message}}
}}</script>
<%- include('partials/scripts') %>
</body></html>