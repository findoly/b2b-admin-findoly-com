<!doctype html>
<html lang="en" dir="ltr">
  <%- include('partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('partials/navbar') %>
    <div class="page-content">
      <%- include('partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header crm-dashboard-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Overview</div>
                <h1 class="page-title mb-1">Dashboard</h1>
                <p class="crm-page-subtitle mb-0">Monitor B2B orders, procurement, dispatch, receivables and payables.</p>
              </div>
              <% if (can('orders.create')) { %>
                <a href="/orders/new" class="btn btn-primary crm-primary-action">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  Create sales order
                </a>
              <% } %>
            </div>
          </div>
          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
            <main x-data="dashboardPage()" x-init="load()">
              <div x-show="error" x-cloak role="alert" class="alert alert-danger"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><span x-text="error"></span><button type="button" class="btn btn-sm btn-outline-danger" @click="load()" :disabled="loading">Retry dashboard</button></div></div><div x-show="loading" x-cloak class="card crm-data-card mb-3" role="status" aria-live="polite"><div class="card-body"><div class="crm-table-loading"><span></span><span></span><span></span></div><span class="visually-hidden">Loading dashboard metrics</span></div></div>

<section class="crm-workflow-header mb-3" aria-label="Action-oriented workspace"><div><span class="crm-workflow-eyebrow">Your next steps</span><h2 class="h4 mb-1">Business action center</h2><p class="text-muted mb-0">Start with the work that needs attention. Every action opens a real Findoly workflow.</p></div><% if(can('reports.view')) { %><a class="btn btn-light" href="/reports">View reports →</a><% } %></section>
<section x-show="!loading && !error" x-cloak class="crm-attention-grid mb-4" aria-label="Operational actions">
 <% if(can('procurement.view')) { %><a class="crm-attention-card crm-soft-purple" href="/procurement/demand"><span class="crm-attention-tag">Sourcing</span><strong x-text="number(data.pendingProcurement)">0</strong><span>Orders needing procurement</span><b>Open demand →</b></a><% } %>
 <% if(can('delivery.view')) { %><a class="crm-attention-card crm-soft-green" href="/delivery"><span class="crm-attention-tag">Fulfilment</span><strong x-text="number(data.readyDispatch)">0</strong><span>Orders ready to dispatch</span><b>Manage delivery →</b></a><% } %>
 <% if(can('pricing.view')) { %><a class="crm-attention-card crm-soft-orange" href="/pricing"><span class="crm-attention-tag">Approvals</span><strong x-text="number(data.pendingPrices)">0</strong><span>Prices awaiting review</span><b>Review requests →</b></a><% } %>
 <% if(can('inventory.view')) { %><a class="crm-attention-card crm-soft-red" href="/inventory"><span class="crm-attention-tag">Inventory</span><strong x-text="number(data.lowStockCount)">0</strong><span>Products at or below reorder level</span><b>Check stock →</b></a><% } %>
 <% if(can('finance.view')) { %><a class="crm-attention-card crm-soft-blue" href="/finance#finance-invoices"><span class="crm-attention-tag">Collections</span><strong x-text="money(data.overdueReceivablePaise)">₹0.00</strong><span>Overdue customer invoices</span><b>Review receivables →</b></a><% } %>
</section>
<section x-show="!loading && !error" x-cloak class="crm-visual-grid mb-4" aria-label="Sales trend and order pipeline">
 <article class="card crm-data-card crm-visual-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Daily taxable sales trend</h2><p class="text-muted mb-0">Last 14 India-calendar days · taxable sales value, before GST and returns</p></div><% if(can('reports.view')) { %><a class="btn btn-light btn-sm" href="/reports">Open reports</a><% } %></div>
 <div class="card-body"><div class="crm-spark-chart" role="list" aria-label="Daily taxable sales by date"><template x-for="day in data.salesTrend||[]" :key="day.day"><div class="crm-spark-day" role="listitem" :aria-label="dailySalesLabel(day)" :title="dailySalesLabel(day)" tabindex="0"><span class="crm-spark-amount" x-text="money(day.salesPaise)"></span><div class="crm-spark-track" aria-hidden="true"><span :style="dailyBarStyle(day)"></span></div><small x-text="day.label"></small></div></template></div><p class="text-muted fs-sm mt-2 mb-0">Hover or focus on day labels for actual values; no demo data shown.</p></div></article>
 <article class="card crm-data-card crm-visual-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Order pipeline</h2><p class="text-muted mb-0">Actual order-status distribution · replacements excluded</p></div><% if(can('orders.view')) { %><a class="btn btn-light btn-sm" href="/orders">All orders</a><% } %></div>
 <div class="card-body crm-donut-layout"><div class="crm-donut-wrap"><div class="crm-donut" :style="orderDonutStyle()" role="img" :aria-label="orderDonutLabel()"><span><strong x-text="number(orderStatusTotal())">0</strong><small>orders</small></span></div></div><div class="crm-donut-legend"><template x-for="item in orderStatusSlices()" :key="item.status"><div class="crm-donut-legend-row"><span class="crm-chart-dot" :style="item.dotStyle"></span><span x-text="item.label"></span><strong x-text="number(item.count)"></strong><% if(can('orders.view')) { %><a x-show="item.href" :href="item.href" :aria-label="item.actionLabel">View</a><% } %></div></template></div></div></article>
</section>
<% if(can('products.view')) { %><section x-show="!loading && !error && (data.lowStockItems||[]).length" x-cloak class="card crm-data-card mb-4" aria-label="Stock attention"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Stock needing attention</h2><p class="text-muted mb-0">Up to 10 products below their reorder threshold, across warehouses</p></div><% if(can('inventory.view')) { %><a href="/inventory" class="btn btn-light btn-sm">Stock balances</a><% } %></div><div class="card-body crm-risk-list"><template x-for="item in data.lowStockItems||[]" :key="item.productId"><a class="crm-risk-row" :href="'/products/'+item.productId"><span><strong x-text="item.name"></strong><small x-text="item.sku"></small></span><span><b x-text="number(item.availableQty)"></b> available / <span x-text="number(item.reorderLevel)"></span> reorder</span><span aria-hidden="true">→</span></a></template></div></section><% } %>
              <section x-show="!loading && !error" x-cloak class="crm-metric-grid mb-4" aria-label="B2B dashboard totals">
                <article class="crm-metric-card crm-metric-blue">
                  <div class="crm-metric-top"><div><span class="crm-metric-label">Today's orders</span><strong class="crm-metric-value" x-text="number(data.todayOrders)">0</strong></div><span class="crm-metric-icon"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span></div>
                  <div class="crm-metric-note">Sales orders created today</div><% if (can('orders.view')) { %><a class="crm-metric-action" href="/orders" aria-label="View orders">View orders <span aria-hidden="true">→</span></a><% } %>
                </article>
                <article class="crm-metric-card crm-metric-purple">
                  <div class="crm-metric-top"><div><span class="crm-metric-label">Pending procurement</span><strong class="crm-metric-value" x-text="number(data.pendingProcurement)">0</strong></div><span class="crm-metric-icon"><svg viewBox="0 0 24 24"><path d="M4 7h16l-2 12H6L4 7Z"/><path d="M8 7a4 4 0 0 1 8 0"/></svg></span></div>
                  <div class="crm-metric-note">Orders waiting on sourcing</div><% if (can('procurement.view')) { %><a class="crm-metric-action" href="/procurement/demand" aria-label="View demand">View demand <span aria-hidden="true">→</span></a><% } %>
                </article>
                <article class="crm-metric-card crm-metric-green">
                  <div class="crm-metric-top"><div><span class="crm-metric-label">Ready to dispatch</span><strong class="crm-metric-value" x-text="number(data.readyDispatch)">0</strong></div><span class="crm-metric-icon"><svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span></div>
                  <div class="crm-metric-note">Packed orders ready for delivery</div><% if (can('delivery.view')) { %><a class="crm-metric-action" href="/delivery" aria-label="View deliveries">View deliveries <span aria-hidden="true">→</span></a><% } %>
                </article>
                <article class="crm-metric-card crm-metric-amber">
                  <div class="crm-metric-top"><div><span class="crm-metric-label">Price approvals</span><strong class="crm-metric-value" x-text="number(data.pendingPrices)">0</strong></div><span class="crm-metric-icon"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h5M16 16h.01"/></svg></span></div>
                  <div class="crm-metric-note">Negotiated prices awaiting approval</div><% if (can('pricing.view')) { %><a class="crm-metric-action" href="/pricing" aria-label="Review prices">Review prices <span aria-hidden="true">→</span></a><% } %>
                </article>
              </section>

              <section x-show="!loading && !error" x-cloak class="crm-metric-grid mb-4" aria-label="B2B finance totals">
                <article class="crm-metric-card crm-metric-blue"><div class="crm-metric-top"><div><span class="crm-metric-label">Overdue receivables</span><strong class="crm-metric-value" x-text="money(data.overdueReceivablePaise)">₹0.00</strong></div><span class="crm-metric-icon"><svg viewBox="0 0 24 24"><path d="M6 4h12M6 8h12M8 4c7 0 7 9 0 9H7l8 7"/></svg></span></div><div class="crm-metric-note">Customer collections overdue</div><% if (can('finance.view')) { %><a class="crm-metric-action" href="/finance#finance-invoices" aria-label="View receivables">View receivables <span aria-hidden="true">→</span></a><% } %></article>
                <article class="crm-metric-card crm-metric-purple"><div class="crm-metric-top"><div><span class="crm-metric-label">Overdue payables</span><strong class="crm-metric-value" x-text="money(data.overduePayablePaise)">₹0.00</strong></div><span class="crm-metric-icon"><svg viewBox="0 0 24 24"><path d="M6 4h12M6 8h12M8 4c7 0 7 9 0 9H7l8 7"/></svg></span></div><div class="crm-metric-note">Supplier payments overdue</div><% if (can('finance.view')) { %><a class="crm-metric-action" href="/finance#finance-bills" aria-label="View payables">View payables <span aria-hidden="true">→</span></a><% } %></article>
                <article class="crm-metric-card crm-metric-amber"><div class="crm-metric-top"><div><span class="crm-metric-label">Low / zero stock</span><strong class="crm-metric-value" x-text="number(data.lowStockCount)">0</strong></div><span class="crm-metric-icon"><svg viewBox="0 0 24 24"><path d="M4 6h16v14H4z"/><path d="M4 10h16M9 14h6"/></svg></span></div><div class="crm-metric-note">Inventory balances needing attention</div><% if (can('inventory.view')) { %><a class="crm-metric-action" href="/inventory" aria-label="Check inventory">Check inventory <span aria-hidden="true">→</span></a><% } %></article>
              </section>

              <section x-show="!loading && !error" x-cloak class="crm-dashboard-grid">
                <div class="card crm-data-card">
                  <div class="card-header crm-card-heading">
                    <div><h2 class="card-title mb-1">Recent sales orders</h2><p class="text-muted mb-0">Latest B2B customer orders created by the Findoly team.</p></div>
                    <% if (can('orders.view')) { %><a href="/orders" class="btn btn-light btn-sm">View all orders</a><% } %>
                  </div>
                  <div class="table-responsive">
                    <table class="table crm-table crm-dashboard-record-table mb-0">
                      <thead><tr><th>Order</th><th>Customer</th><th>Status</th><th class="text-end">Total</th><th>Created</th></tr></thead>
                      <tbody>
                        <template x-if="loading"><tr><td colspan="5"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
                        <template x-for="order in (data.recentOrders || [])" :key="order.salesOrderId">
                          <tr>
                            <td><a class="crm-record-title"  :href="'/orders/'+order.salesOrderId" x-text="order.orderNumber"></a></td>
                            <td><div class="fw-semibold" x-text="crmValue(order,'customerSnapshot.businessName','—')"></div><div class="text-muted fs-sm" x-text="crmValue(order,'customerSnapshot.mobile','')"></div></td>
                            <td><span class="crm-status" :class="statusClass(order.status)" x-text="humanize(order.status)"></span></td>
                            <td class="text-end fw-semibold" x-text="money(order.totalPaise)"></td>
                            <td class="crm-nowrap" x-text="formatDateOnly(order.createdAt)"></td>
                          </tr>
                        </template>
                        <tr x-show="!loading && !(data.recentOrders || []).length"><td colspan="5"><div class="crm-empty-state"><span class="crm-empty-icon"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><strong>No sales orders yet</strong><span>Create the first B2B order to start the workflow.</span><% if (can('orders.create')) { %><a href="/orders/new" class="btn btn-primary btn-sm">Create sales order</a><% } else if (can('orders.view')) { %><a href="/orders" class="btn btn-light btn-sm">View orders</a><% } %></div></td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>
                <aside class="card crm-quick-card">
                  <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Quick actions</h2><p class="text-muted mb-0">Common B2B operations.</p></div></div>
                  <div class="crm-quick-actions">
                    <% if (can("orders.create")) { %><a href="/orders/new"><span><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><div><strong>Create sales order</strong><small>Record a customer order</small></div><b>›</b></a><% } %>
                    <% if (can("procurement.view")) { %><a href="/procurement"><span><svg viewBox="0 0 24 24"><path d="M4 7h16l-2 12H6L4 7Z"/></svg></span><div><strong>Open procurement</strong><small>Purchase and receive stock</small></div><b>›</b></a><% } %>
                    <% if (can("inventory.view")) { %><a href="/inventory"><span><svg viewBox="0 0 24 24"><path d="M4 6h16v14H4zM4 10h16"/></svg></span><div><strong>Review inventory</strong><small>Check warehouse stock</small></div><b>›</b></a><% } %>
                    <% if (can("finance.view")) { %><a href="/finance"><span><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9h16"/></svg></span><div><strong>Open finance</strong><small>Receivables and payables</small></div><b>›</b></a><% } %>
                  </div>
                </aside>
              </section>
            </main>
          </div>
          <%- include('partials/footer') %>
        </div>
      </div>
    </div>
    <script nonce="<%= cspNonce %>">
      const crmDashboardChartPalette=['#3478d4','#32a17b','#8766c7','#e49a47','#de6b72'];
function dashboardPage(){return{data:{},loading:true,error:'',number(v){return new Intl.NumberFormat('en-IN').format(Number(v||0));},
dailySalesLabel(day){return day.day+': '+money(day.salesPaise)+' in '+this.number(day.orders)+' orders';},
dailyBarStyle(day){const max=Math.max(1,...(this.data.salesTrend||[]).map(x=>Number(x.salesPaise||0)));return 'height:'+Math.max(day.salesPaise>0?4:0,Math.min(100,Math.max(0,Number(day.salesPaise||0))/max*100))+'%;';},
orderStatusTotal(){return(this.data.orderStatusMix||[]).reduce((n,x)=>n+Number(x.count||0),0);},
orderStatusSlices(){const rows=(this.data.orderStatusMix||[]).filter(x=>Number(x.count)>0),total=this.orderStatusTotal()||1,top=rows.slice(0,4).map(x=>({status:x.status,label:humanize(x.status),count:Number(x.count)}));if(rows.length>4)top.push({status:'other',label:'Other statuses',count:rows.slice(4).reduce((n,x)=>n+Number(x.count||0),0)});return top.map((x,i)=>({...x,color:crmDashboardChartPalette[i],dotStyle:'background-color:'+crmDashboardChartPalette[i],percent:Math.round(x.count/total*100),href:x.status==='other'?'':'/orders?status='+encodeURIComponent(x.status),actionLabel:'View '+x.label+' orders'}));},
orderDonutStyle(){const slices=this.orderStatusSlices(),sum=this.orderStatusTotal();if(!sum)return 'background:var(--crm-chart-track,#edf1f5)';let offset=0;const pieces=slices.map(x=>{const a=offset;offset+=x.count/sum*100;return x.color+' '+a+'% '+offset+'%'});return 'background:conic-gradient('+pieces.join(',')+')';},
orderDonutLabel(){return this.number(this.orderStatusTotal())+' orders by status';},
async load(){this.loading=true;this.error='';try{this.data=(await apiFetch('/api/dashboard')).data||{};}catch(e){this.error=e.message;}finally{this.loading=false;}}}}
    </script>
    <%- include('partials/scripts') %>
  </body>
</html>