<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="dash()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3"><template x-for="m in metrics" :key="m.label"><div class="col-6 col-xl-3"><div class="card metric h-100"><div class="card-body"><div class="text-secondary small" x-text="m.label"></div><div class="fs-3 fw-bold mt-1" x-text="m.value"></div></div></div></div></template></div><div class="card mt-4"><div class="card-header fw-semibold">Recent sales orders</div><div class="scroll-table"><table class="table mb-0"><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead><tbody><template x-for="o in data.recentOrders||[]"><tr><td x-text="o.orderNumber"></td><td x-text="o.customerSnapshot?.businessName"></td><td><span class="badge text-bg-light" x-text="o.status"></span></td><td x-text="money(o.totalPaise)"></td></tr></template></tbody></table></div></div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function dash(){return{data:{},error:'',get metrics(){return[{label:'Today orders',value:this.data.todayOrders||0},{label:'Pending procurement',value:this.data.pendingProcurement||0},{label:'Ready dispatch',value:this.data.readyDispatch||0},{label:'Pending price approvals',value:this.data.pendingPrices||0},{label:'Overdue receivables',value:money(this.data.overdueReceivablePaise||0)},{label:'Overdue payables',value:money(this.data.overduePayablePaise||0)},{label:'Low / zero stock',value:this.data.lowStockCount||0}]},async load(){try{this.data=(await apiFetch('/api/dashboard')).data}catch(e){this.error=e.message}}}}</script></body></html>