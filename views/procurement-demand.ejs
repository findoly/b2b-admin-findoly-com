<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Procurement</div><h1 class="page-title mb-1">Sales-order demand queue</h1><p class="crm-page-subtitle mb-0">Planned supplier allocations waiting to be converted into purchase orders.</p></div><a class="btn btn-light" href="/procurement">Purchase orders</a></div></div>
<div class="content" x-data="procurementDemandPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" role="alert"><span x-text="error"></span><button type="button" class="btn btn-sm btn-outline-danger ms-2" @click="load()" :disabled="loading">Retry</button></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Planned supplier demand</h2><p class="text-muted mb-0">Select rows only when supplier, location and warehouse match; they can then become one purchase order.</p></div><% if (can('procurement.create')) { %><div class="d-flex gap-2 align-items-center flex-wrap"><span class="text-muted fs-sm" role="status" aria-live="polite" x-text="selected.length+' selected'"></span><button type="button" class="btn btn-light" @click="selected=[]" :disabled="!selected.length">Clear</button><button class="btn btn-primary" @click="createPo()" :disabled="!selected.length||loading">Create PO from selected</button></div><% } %></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th style="width:45px"><span class="visually-hidden">Select demand</span></th><th>Sales order</th><th>Product</th><th>Supplier</th><th>Warehouse</th><th class="text-end">Qty</th><th class="text-end">Buy price</th></tr></thead><tbody><template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading" role="status" aria-label="Loading demand"><span></span><span></span><span></span></div></td></tr></template><template x-for="a in items" :key="a.procurementAllocationId"><tr><td><% if (can('procurement.create')) { %><input class="form-check-input" type="checkbox" :value="a.procurementAllocationId" x-model="selected" :disabled="!canSelect(a)" :aria-label="'Select demand for '+(a.orderNumber||'sales order')" :title="selectionHint(a)"><% } %></td><td><a :href="'/orders/'+a.salesOrderId" x-text="a.orderNumber||'Sales order'"></a></td><td x-text="a.productSnapshot?(a.productSnapshot.name+' · '+a.productSnapshot.sku):'Product'"></td><td><strong x-text="crmValue(a,'supplierSnapshot.businessName','Supplier')"></strong><div class="text-muted fs-sm" x-text="crmValue(a,'supplierLocationSnapshot.name','')"></div></td><td x-text="crmValue(a,'warehouseSnapshot.name','Warehouse')"></td><td class="text-end" x-text="a.quantity"></td><td class="text-end" x-text="money(a.purchasePricePaise)"></td></tr></template><tr x-show="!loading && !error && !items.length"><td colspan="7"><div class="crm-empty-state"><strong>No planned demand</strong><span>Supplier allocations created from sales orders will appear here.</span></div></td></tr></tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function procurementDemandPage(){return{...crmPager('load'),items:[],selected:[],error:'',loading:true,
canSelect(a){const first=this.items.find(x=>this.selected.includes(x.procurementAllocationId));return !first||this.selected.includes(a.procurementAllocationId)||(a.supplierId===first.supplierId&&a.supplierLocationId===first.supplierLocationId&&a.warehouseId===first.warehouseId)},
selectionHint(a){return this.canSelect(a)?'Compatible demand':'Select same supplier, location and warehouse'},
async load(){this.loading=true;this.error='';try{const d=await apiFetch('/api/procurement/allocations?status=planned&purchaseOrderId=&limit='+this.pageSize+'&page='+this.page);this.items=d.data.items||[];this.selected=[];this.setPageMeta(d.data)}catch(e){this.items=[];this.selected=[];this.error=e.message}finally{this.loading=false}},createPo(){const rows=this.items.filter(x=>this.selected.includes(x.procurementAllocationId));if(!rows.length)return;const first=rows[0];if(rows.some(x=>x.supplierId!==first.supplierId||x.supplierLocationId!==first.supplierLocationId||x.warehouseId!==first.warehouseId)){this.error='Selected demand must use the same supplier, location and warehouse.';return}location.href='/procurement/new?allocationIds='+encodeURIComponent(this.selected.join(','))}}}</script><%- include('partials/scripts') %>
</body></html>
