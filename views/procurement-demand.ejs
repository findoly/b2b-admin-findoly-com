<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Procurement</div><h1 class="page-title mb-1">Sales-order demand queue</h1><p class="crm-page-subtitle mb-0">Planned supplier allocations waiting to be converted into purchase orders.</p></div><a class="btn btn-light" href="/procurement">Purchase orders</a></div></div>
<div class="content" x-data="procurementDemandPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Planned supplier demand</h2><p class="text-muted mb-0">Select rows only when supplier, location and warehouse match; they can then become one purchase order.</p></div><% if (can('procurement.create')) { %><button class="btn btn-primary" @click="createPo()" :disabled="!selected.length">Create PO from selected</button><% } %></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th style="width:45px"></th><th>Sales order</th><th>Product</th><th>Supplier</th><th>Warehouse</th><th class="text-end">Qty</th><th class="text-end">Buy price</th></tr></thead><tbody><template x-for="a in items" :key="a.procurementAllocationId"><tr><td><input class="form-check-input" type="checkbox" :value="a.procurementAllocationId" x-model="selected"></td><td><a :href="'/orders/'+a.salesOrderId" x-text="a.orderNumber||'Sales order'"></a></td><td x-text="productName(a.productId)"></td><td><strong x-text="a.supplierSnapshot?.businessName||'Supplier'"></strong><div class="text-muted fs-sm" x-text="a.supplierLocationSnapshot?.name||''"></div></td><td x-text="warehouseName(a.warehouseId)"></td><td class="text-end" x-text="a.quantity"></td><td class="text-end" x-text="money(a.purchasePricePaise)"></td></tr></template><tr x-show="!items.length"><td colspan="7"><div class="crm-empty-state"><strong>No planned demand</strong><span>Supplier allocations created from sales orders will appear here.</span></div></td></tr></tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function procurementDemandPage(){return{...crmPager('load'),items:[],selected:[],products:[],warehouses:[],error:'',async load(){try{const[d,p,w]=await Promise.all([apiFetch('/api/procurement/allocations?status=planned&purchaseOrderId=&limit='+this.pageSize+'&page='+this.page),apiFetch('/api/products?limit=100'),apiFetch('/api/warehouses')]);this.items=d.data.items||[];this.setPageMeta(d.data);this.products=p.data.items||[];this.warehouses=w.data.items||[]}catch(e){this.error=e.message}},productName(id){const p=this.products.find(x=>x.productId===id);return p?p.name+' · '+p.sku:'Product'},warehouseName(id){return this.warehouses.find(x=>x.warehouseId===id)?.name||'Warehouse'},createPo(){const rows=this.items.filter(x=>this.selected.includes(x.procurementAllocationId));if(!rows.length)return;const first=rows[0];if(rows.some(x=>x.supplierId!==first.supplierId||x.supplierLocationId!==first.supplierLocationId||x.warehouseId!==first.warehouseId)){this.error='Selected demand must use the same supplier, location and warehouse.';return}location.href='/procurement/new?allocationIds='+encodeURIComponent(this.selected.join(','))}}}</script><%- include('partials/scripts') %>
</body></html>
