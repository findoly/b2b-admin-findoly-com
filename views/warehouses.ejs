<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Inventory</div><h1 class="page-title mb-1">Warehouses</h1><p class="crm-page-subtitle mb-0">Fulfilment locations used consistently by purchase orders, inventory, sales orders and delivery.</p></div><% if (can('warehouse.manage')) { %><a class="btn btn-primary crm-primary-action" href="/warehouses/new"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New warehouse</a><% } %></div></div>
<div class="content" x-data="warehouseListPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div class="card crm-data-card"><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Warehouse</th><th>Code</th><th>Location</th><th>Occupancy</th><th class="text-end">Physical stock</th><th>Status</th><th class="text-end">Action</th></tr></thead><tbody><template x-for="w in items" :key="w.warehouseId"><tr><td><strong x-text="w.name"></strong></td><td x-text="w.code"></td><td x-text="[w.address?.line1,w.address?.city,w.address?.state,w.address?.pincode].filter(Boolean).join(', ')||'—'"></td><td><span class="crm-status" :class="w.occupancyStatus==='in_use'?'status-paid':'status-pending'" x-text="w.occupancyStatus==='in_use'?'In use':'Empty'"></span><div class="text-muted fs-sm" x-text="Number(w.occupiedSkuCount||0)+' SKU(s) physically stored'"></div></td><td class="text-end"><strong x-text="Number(w.physicalStockUnits||0).toLocaleString()"></strong><div class="text-muted fs-sm" x-show="Number(w.incomingStockUnits||0)>0" x-text="Number(w.incomingStockUnits||0).toLocaleString()+' incoming'"></div></td><td><span class="crm-status" :class="w.active?'status-paid':'status-pending'" x-text="w.active?'Active':'Inactive'"></span></td><td class="text-end crm-table-actions"><% if (can('warehouse.manage')) { %><a class="btn btn-sm btn-outline-primary" :href="'/warehouses/'+w.warehouseId+'/edit'">Edit</a><button class="btn btn-sm btn-light" @click="toggle(w)" x-text="w.active?'Deactivate':'Activate'"></button><% } %></td></tr></template><tr x-show="!items.length"><td colspan="7"><div class="crm-empty-state"><strong>No warehouses configured</strong></div></td></tr></tbody></table></div></div></div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function warehouseListPage(){return{items:[],error:'',async load(){try{this.items=(await apiFetch('/api/warehouses')).data.items||[]}catch(e){this.error=e.message}},async toggle(w){try{await apiFetch('/api/warehouses/'+w.warehouseId,{method:'PUT',body:JSON.stringify({active:!w.active})});showCrmToast('Warehouse status updated');await this.load()}catch(e){this.error=e.message}}}}</script><%- include('partials/scripts') %>
</body></html>
