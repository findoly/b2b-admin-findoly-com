<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="warehousePage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3"><div class="col-lg-4"><div class="card crm-data-card"><div class="card-header fw-semibold">New warehouse</div><div class="card-body"><input class="form-control mb-2" placeholder="Name" x-model="form.name"><input class="form-control mb-2" placeholder="Code" x-model="form.code"><input class="form-control mb-2" placeholder="Address" x-model="form.address.line1"><div class="row g-2"><div class="col"><input class="form-control" placeholder="City" x-model="form.address.city"></div><div class="col"><input class="form-control" placeholder="State" x-model="form.address.state"></div></div><input class="form-control mt-2" placeholder="Pincode" x-model="form.address.pincode"><button class="btn btn-primary mt-2" @click="create()">Create</button></div></div></div><div class="col-lg-8"><div class="card crm-data-card"><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Name</th><th>Code</th><th>Location</th><th>Status</th></tr></thead><tbody><template x-for="x in items" :key="x.warehouseId"><tr><td><strong x-text="x.name"></strong><div class="small text-secondary" x-text="x.warehouseId"></div></td><td x-text="x.code"></td><td x-text="[x.address?.city,x.address?.state].filter(Boolean).join(', ')"></td><td x-text="x.active?'active':'inactive'"></td></tr></template></tbody></table></div></div></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function warehousePage(){return{items:[],error:'',form:{name:'',code:'',address:{line1:'',city:'',state:'Maharashtra',pincode:''}},async load(){try{this.items=(await apiFetch('/api/warehouses')).data.items}catch(e){this.error=e.message}},async create(){try{await apiFetch('/api/warehouses',{method:'POST',body:JSON.stringify(this.form)});await this.load()}catch(e){this.error=e.message}}}}</script></body></html>