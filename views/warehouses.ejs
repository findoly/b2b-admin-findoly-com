<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Inventory</div><h1 class="page-title mb-1">Warehouses</h1><p class="crm-page-subtitle mb-0">Manage fulfilment locations used by procurement, inventory and sales orders.</p></div><% if (can('warehouse.manage')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-warehouse')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New warehouse</button><% } %></div></div>
<div class="content" x-data="warehousePage()" x-init="load()" @new-warehouse.window="startCreate()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<% if (can('warehouse.manage')) { %>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1" x-text="editingId?'Edit warehouse':'New warehouse'"></h2><p class="text-muted mb-0">Warehouse codes remain the human operational reference.</p></div><button class="btn btn-light btn-sm" @click="showForm=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Warehouse name</label><input class="form-control" x-model="form.name"></div>
<div class="col-md-2"><label class="form-label">Code</label><input class="form-control" x-model="form.code"></div>
<div class="col-md-6"><label class="form-label">Address line 1</label><input class="form-control" x-model="form.address.line1"></div>
<div class="col-md-3"><label class="form-label">Address line 2</label><input class="form-control" x-model="form.address.line2"></div>
<div class="col-md-3"><label class="form-label">City</label><input class="form-control" x-model="form.address.city"></div>
<div class="col-md-3"><label class="form-label">State</label><input class="form-control" x-model="form.address.state"></div>
<div class="col-md-3"><label class="form-label">Pincode</label><input class="form-control" x-model="form.address.pincode"></div>
<div class="col-12"><label class="form-check"><input type="checkbox" class="form-check-input" x-model="form.active"><span class="form-check-label">Warehouse active for new operations</span></label></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="save()" x-text="editingId?'Save changes':'Create warehouse'"></button></div></div></div>
<% } %>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Warehouse locations</h2><p class="text-muted mb-0">Inactive warehouses remain in historical records but cannot be selected for new operations.</p></div><button class="btn btn-light btn-sm" @click="load()">Refresh</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Warehouse</th><th>Code</th><th>Location</th><th>Status</th><th class="text-end">Action</th></tr></thead><tbody>
<template x-for="w in items" :key="w.warehouseId"><tr><td><strong x-text="w.name"></strong></td><td x-text="w.code"></td><td x-text="[w.address?.line1,w.address?.city,w.address?.state,w.address?.pincode].filter(Boolean).join(', ')||'—'"></td><td><span class="crm-status" :class="w.active?'status-paid':'status-pending'" x-text="w.active?'Active':'Inactive'"></span></td><td class="text-end"><% if (can('warehouse.manage')) { %><button class="btn btn-sm btn-outline-primary" @click="edit(w)">Edit</button><button class="btn btn-sm btn-light" @click="toggle(w)" x-text="w.active?'Deactivate':'Activate'"></button><% } %></td></tr></template>
<tr x-show="!items.length"><td colspan="5"><div class="crm-empty-state"><strong>No warehouses configured</strong></div></td></tr>
</tbody></table></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function warehousePage(){return{
items:[],error:'',showForm:false,editingId:'',form:null,
blank(){return{name:'',code:'',address:{line1:'',line2:'',city:'',state:'Maharashtra',pincode:''},active:true}},
async load(){this.form=this.form||this.blank();try{this.items=(await apiFetch('/api/warehouses')).data.items||[]}catch(e){this.error=e.message}},
startCreate(){this.editingId='';this.form=this.blank();this.showForm=true},edit(w){this.editingId=w.warehouseId;this.form={name:w.name,code:w.code,address:{...(w.address||{})},active:w.active!==false};this.showForm=true;window.scrollTo({top:0,behavior:'smooth'})},
async save(){if(!this.form.name||!this.form.code)return this.error='Warehouse name and code are required.';try{if(this.editingId)await apiFetch('/api/warehouses/'+this.editingId,{method:'PUT',body:JSON.stringify(this.form)});else await apiFetch('/api/warehouses',{method:'POST',body:JSON.stringify(this.form)});showCrmToast(this.editingId?'Warehouse updated':'Warehouse created');this.showForm=false;this.editingId='';this.form=this.blank();await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async toggle(w){try{await apiFetch('/api/warehouses/'+w.warehouseId,{method:'PUT',body:JSON.stringify({active:!w.active})});showCrmToast('Warehouse status updated');await this.load()}catch(e){this.error=e.message}}
}}</script><%- include('partials/scripts') %>
</body></html>