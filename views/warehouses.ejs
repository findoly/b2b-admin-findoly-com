<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="warehousePage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3"><div class="col-lg-4"><div class="card"><div class="card-header fw-semibold">New warehouse</div><div class="card-body"><input class="form-control mb-2" placeholder="Name" x-model="form.name"><input class="form-control mb-2" placeholder="Code" x-model="form.code"><input class="form-control mb-2" placeholder="Address" x-model="form.address.line1"><div class="row g-2"><div class="col"><input class="form-control" placeholder="City" x-model="form.address.city"></div><div class="col"><input class="form-control" placeholder="State" x-model="form.address.state"></div></div><input class="form-control mt-2" placeholder="Pincode" x-model="form.address.pincode"><button class="btn btn-primary mt-2" @click="create()">Create</button></div></div></div><div class="col-lg-8"><div class="card"><div class="scroll-table"><table class="table mb-0"><thead><tr><th>Name</th><th>Code</th><th>Location</th><th>Status</th></tr></thead><tbody><template x-for="x in items" :key="x.warehouseId"><tr><td><strong x-text="x.name"></strong><div class="small text-secondary" x-text="x.warehouseId"></div></td><td x-text="x.code"></td><td x-text="[x.address?.city,x.address?.state].filter(Boolean).join(', ')"></td><td x-text="x.active?'active':'inactive'"></td></tr></template></tbody></table></div></div></div></div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function warehousePage(){return{items:[],error:'',form:{name:'',code:'',address:{line1:'',city:'',state:'Maharashtra',pincode:''}},async load(){try{this.items=(await apiFetch('/api/warehouses')).data.items}catch(e){this.error=e.message}},async create(){try{await apiFetch('/api/warehouses',{method:'POST',body:JSON.stringify(this.form)});await this.load()}catch(e){this.error=e.message}}}}</script></body></html>