<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Catalogue</div><h1 class="page-title mb-1">Products</h1><p class="crm-page-subtitle mb-0">SKU master, pricing guardrails, stock settings, media and supplier sourcing comparison.</p></div><% if (can('products.create')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-product')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New product</button><% } %></div></div>
<div class="content" x-data="productsPage()" x-init="load()" @new-product.window="startCreate()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<div class="card crm-data-card mb-4" x-show="showForm" x-cloak>
<div class="card-header crm-card-heading"><div><h2 class="card-title mb-1" x-text="editingId?'Edit product':'New product'"></h2><p class="text-muted mb-0">All commercial amounts are entered in rupees and stored as integer paise.</p></div><button class="btn btn-light btn-sm" @click="closeForm()">Close</button></div>
<div class="card-body"><div class="row g-3">
<div class="col-lg-5"><label class="form-label">Product name</label><input class="form-control" x-model="form.name"></div>
<div class="col-lg-2"><label class="form-label">SKU</label><input class="form-control" x-model="form.sku"></div>
<div class="col-lg-2"><label class="form-label">Barcode</label><input class="form-control" x-model="form.barcode"></div>
<div class="col-lg-3"><label class="form-label">Brand</label><input class="form-control" x-model="form.brand"></div>
<div class="col-md-3"><label class="form-label">Category</label><input class="form-control" x-model="form.category"></div>
<div class="col-md-3"><label class="form-label">Subcategory</label><input class="form-control" x-model="form.subcategory"></div>
<div class="col-md-3"><label class="form-label">Manufacturer</label><input class="form-control" x-model="form.manufacturer"></div>
<div class="col-md-3"><label class="form-label">Status</label><select class="form-select" x-model="form.status"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
<div class="col-md-2"><label class="form-label">Unit</label><input class="form-control" x-model="form.unit" placeholder="piece / box / kg"></div>
<div class="col-md-2"><label class="form-label">Pack size</label><input type="number" min="1" class="form-control" x-model.number="form.packSize"></div>
<div class="col-md-2"><label class="form-label">Carton size</label><input type="number" min="1" class="form-control" x-model.number="form.cartonSize"></div>
<div class="col-md-2"><label class="form-label">HSN</label><input class="form-control" x-model="form.hsnCode"></div>
<div class="col-md-2"><label class="form-label">GST %</label><input type="number" min="0" max="100" step="0.01" class="form-control" x-model.number="form.gstPercent"></div>
<div class="col-md-2"><label class="form-label">Reorder level</label><input type="number" min="0" class="form-control" x-model.number="form.reorderLevel"></div>
<div class="col-md-4"><label class="form-label">MRP ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.mrpRupees"></div>
<div class="col-md-4"><label class="form-label">Reference selling price ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.referenceRupees"></div>
<div class="col-md-4"><label class="form-label">Minimum permitted price ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.minimumRupees"></div>
<div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="2" x-model="form.description"></textarea></div>
<div class="col-12"><label class="form-label">Internal notes</label><textarea class="form-control" rows="2" x-model="form.notes"></textarea></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="save()" :disabled="saving" x-text="saving?'Saving…':(editingId?'Save changes':'Create product')"></button></div></div></div>

<div class="card crm-data-card mb-4">
<div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Product catalogue</h2><p class="text-muted mb-0">Select a product to manage media and compare suppliers.</p></div><div class="d-flex gap-2"><input class="form-control form-control-sm" placeholder="Search name, SKU, brand or barcode" x-model="search" @keyup.enter="loadProducts()"><select class="form-select form-select-sm" x-model="statusFilter" @change="loadProducts()"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select><button class="btn btn-light btn-sm" @click="loadProducts()">Search</button></div></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Category</th><th>GST</th><th class="text-end">MRP</th><th class="text-end">Reference</th><th class="text-end">Minimum</th><th>Reorder</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
<template x-for="p in items" :key="p.productId"><tr><td><strong x-text="p.name"></strong><div class="text-muted fs-sm" x-text="p.sku+(p.brand?' · '+p.brand:'')"></div></td><td x-text="[p.category,p.subcategory].filter(Boolean).join(' / ')||'—'"></td><td x-text="(Number(p.gstRateBps||0)/100)+'%'"></td><td class="text-end" x-text="money(p.mrpPaise)"></td><td class="text-end" x-text="money(p.referenceSellingPricePaise)"></td><td class="text-end" x-text="money(p.minimumSellingPricePaise)"></td><td x-text="p.reorderLevel||0"></td><td><span class="crm-status" :class="statusClass(p.status)" x-text="humanize(p.status)"></span></td><td class="text-end crm-table-actions"><button class="btn btn-sm btn-outline-primary" @click="openProduct(p)">Open</button><% if (can('products.edit')) { %><button class="btn btn-sm btn-light" @click="edit(p)">Edit</button><% } %></td></tr></template>
<tr x-show="!loading && !items.length"><td colspan="9"><div class="crm-empty-state"><strong>No products found</strong></div></td></tr>
</tbody></table></div></div>

<div x-show="selected" x-cloak>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h4 mb-1" x-text="selected?.name"></h2><div class="text-muted" x-text="selected?.sku"></div></div><button class="btn btn-light" @click="selected=null">Close</button></div>
<div class="row g-4">
<div class="col-lg-5"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h3 class="card-title mb-1">Photos & documents</h3><p class="text-muted mb-0">Product images, brochures, certificates and specifications.</p></div></div><div class="card-body">
<div x-show="selected?.media?.length" class="mb-3"><template x-for="m in selected?.media||[]" :key="m.productMediaId"><div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2"><div><div class="fw-semibold" x-text="m.label||m.fileName"></div><div class="text-muted fs-sm"><span x-text="humanize(m.kind)"></span><span x-show="m.isPrimary"> · Primary</span></div></div><button class="btn btn-sm btn-light" @click="openMedia(m)">Open</button></div></template></div>
<% if (can('products.media')) { %><div class="border-top pt-3"><label class="form-label">Media type</label><select class="form-select mb-2" x-model="mediaKind"><option value="image">Product image</option><option value="document">Document</option></select><input class="form-control" type="file" @change="file=$event.target.files[0]"><label class="form-check mt-2"><input class="form-check-input" type="checkbox" x-model="primary"><span class="form-check-label">Make primary image</span></label><button class="btn btn-outline-primary mt-2" @click="uploadMedia()" :disabled="!file||uploading" x-text="uploading?'Uploading…':'Upload & attach'"></button></div><% } %>
</div></div></div>

<div class="col-lg-7"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h3 class="card-title mb-1">Supplier comparison</h3><p class="text-muted mb-0">Current supplier/location offers for this SKU.</p></div></div>
<% if (can('suppliers.view')) { %><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Supplier</th><th class="text-end">Buy price</th><th>GST</th><th>MOQ</th><th>Lead time</th><th>Valid until</th></tr></thead><tbody><template x-for="o in offers" :key="o.supplierProductOfferId"><tr><td><strong x-text="supplierName(o.supplierId)"></strong><div class="crm-record-id" x-text="o.supplierLocationId"></div></td><td class="text-end fw-semibold" x-text="money(o.purchasePricePaise)"></td><td x-text="o.gstCharged?((Number(o.gstRateBps||0)/100)+'%'):'Not charged'"></td><td x-text="o.moq||1"></td><td x-text="(o.leadTimeDays||0)+' days'"></td><td x-text="formatDateOnly(o.priceValidUntil)"></td></tr></template><tr x-show="!offers.length"><td colspan="6"><div class="crm-empty-state"><strong>No supplier offers</strong><span>Add supplier pricing from the Suppliers screen.</span></div></td></tr></tbody></table></div><% } else { %><div class="card-body text-muted">Supplier comparison requires supplier-view permission.</div><% } %>
</div></div>
</div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function productsPage(){return{
items:[],suppliers:[],offers:[],selected:null,loading:true,saving:false,uploading:false,error:'',search:'',statusFilter:'',showForm:false,editingId:'',file:null,mediaKind:'image',primary:false,form:null,
blankForm(){return{name:'',sku:'',barcode:'',brand:'',category:'',subcategory:'',manufacturer:'',description:'',unit:'piece',packSize:1,cartonSize:1,hsnCode:'',gstPercent:18,mrpRupees:0,referenceRupees:0,minimumRupees:0,reorderLevel:0,status:'active',notes:''}},
async load(){this.form=this.blankForm();try{<% if (can('suppliers.view')) { %>this.suppliers=(await apiFetch('/api/suppliers?limit=100')).data.items||[];<% } %>await this.loadProducts()}catch(e){this.error=e.message}finally{this.loading=false}},
async loadProducts(){this.loading=true;try{const q=new URLSearchParams({limit:'100'});if(this.search)q.set('search',this.search);if(this.statusFilter)q.set('status',this.statusFilter);this.items=(await apiFetch('/api/products?'+q)).data.items||[]}catch(e){this.error=e.message}finally{this.loading=false}},
startCreate(){this.editingId='';this.form=this.blankForm();this.showForm=true;this.selected=null},closeForm(){this.showForm=false;this.editingId=''},
toForm(p){return{name:p.name,sku:p.sku,barcode:p.barcode||'',brand:p.brand||'',category:p.category||'',subcategory:p.subcategory||'',manufacturer:p.manufacturer||'',description:p.description||'',unit:p.unit||'piece',packSize:Number(p.packSize||1),cartonSize:Number(p.cartonSize||1),hsnCode:p.hsnCode||'',gstPercent:Number(p.gstRateBps||0)/100,mrpRupees:Number(p.mrpPaise||0)/100,referenceRupees:Number(p.referenceSellingPricePaise||0)/100,minimumRupees:Number(p.minimumSellingPricePaise||0)/100,reorderLevel:Number(p.reorderLevel||0),status:p.status||'active',notes:p.notes||''}},
edit(p){this.editingId=p.productId;this.form=this.toForm(p);this.showForm=true;this.selected=null;window.scrollTo({top:0,behavior:'smooth'})},
payload(){return{name:this.form.name,sku:this.form.sku,barcode:this.form.barcode,brand:this.form.brand,category:this.form.category,subcategory:this.form.subcategory,manufacturer:this.form.manufacturer,description:this.form.description,unit:this.form.unit,packSize:Number(this.form.packSize||1),cartonSize:Number(this.form.cartonSize||1),hsnCode:this.form.hsnCode,gstRateBps:Math.round(Number(this.form.gstPercent||0)*100),mrpPaise:Math.round(Number(this.form.mrpRupees||0)*100),referenceSellingPricePaise:Math.round(Number(this.form.referenceRupees||0)*100),minimumSellingPricePaise:Math.round(Number(this.form.minimumRupees||0)*100),reorderLevel:Number(this.form.reorderLevel||0),status:this.form.status,notes:this.form.notes}},
async save(){this.saving=true;try{if(this.editingId)await apiFetch('/api/products/'+this.editingId,{method:'PUT',body:JSON.stringify(this.payload())});else await apiFetch('/api/products',{method:'POST',body:JSON.stringify(this.payload())});showCrmToast(this.editingId?'Product updated':'Product created');this.closeForm();await this.loadProducts()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}},
async openProduct(p){try{this.selected=(await apiFetch('/api/products/'+p.productId)).data;this.offers=[];<% if (can('suppliers.view')) { %>this.offers=(await apiFetch('/api/products/'+p.productId+'/supplier-offers')).data||[];<% } %>this.showForm=false}catch(e){this.error=e.message}},
supplierName(id){return this.suppliers.find(x=>x.supplierId===id)?.businessName||'Supplier'},
async uploadMedia(){if(!this.selected||!this.file)return;this.uploading=true;try{const signed=(await apiFetch('/api/products/media/upload-url',{method:'POST',body:JSON.stringify({kind:this.mediaKind,fileName:this.selected.productId+'-'+Date.now()+'-'+this.file.name,contentType:this.file.type||'application/octet-stream',sizeBytes:this.file.size})})).data;const put=await fetch(signed.url,{method:'PUT',headers:signed.headers,body:this.file});if(!put.ok)throw new Error('S3 upload failed');await apiFetch('/api/products/'+this.selected.productId+'/media',{method:'POST',body:JSON.stringify({kind:this.mediaKind,key:signed.key,fileName:this.file.name,contentType:this.file.type,label:this.file.name,isPrimary:this.primary})});showCrmToast('Product media attached');this.file=null;this.primary=false;await this.openProduct(this.selected)}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.uploading=false}},
async openMedia(m){try{const x=(await apiFetch('/api/products/media/download-url',{method:'POST',body:JSON.stringify({key:m.key})})).data;window.open(x.url,'_blank','noopener')}catch(e){this.error=e.message}}
}}</script>
<%- include('partials/scripts') %>
</body></html>