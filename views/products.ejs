<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Catalogue</div><h1 class="page-title mb-1">Products</h1><p class="crm-page-subtitle mb-0">A focused catalogue list. Open a product for description, gallery, documents and supplier sourcing.</p></div><% if (can('products.create')) { %><a class="btn btn-primary crm-primary-action" href="/products/new"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New product</a><% } %></div></div>
<div class="content" x-data="productsListPage()" x-init="loadProducts()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak role="alert" class="alert alert-danger"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><span x-text="error"></span><button type="button" class="btn btn-sm btn-outline-danger" :disabled="loading" @click="loadProducts()">Retry</button></div></div>
<div class="d-flex gap-2 flex-wrap mb-3"><a href="/categories" class="btn btn-light">Categories</a><a href="/subcategories" class="btn btn-light">Subcategories</a></div>
<section class="card crm-filter-card mb-3">
  <div class="crm-filter-bar">
    <div class="crm-search-control"><label class="visually-hidden" for="product-list-search">Search product catalogue</label><input id="product-list-search" class="form-control" placeholder="Search name, SKU, brand or barcode" x-model="search" @keyup.enter="searchProducts()"></div>
    <label class="crm-filter-field"><span>Status</span><select aria-label="Product status filter" x-model="statusFilter" @change="searchProducts()"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
    <div class="crm-filter-actions"><button class="btn btn-primary" @click="searchProducts()">Search</button></div>
  </div>
</section>
<div class="crm-filter-summary mb-3" x-show="search || statusFilter" x-cloak role="status" aria-live="polite"><span>Filtered products · use Clear to see the whole catalogue</span><button type="button" class="btn btn-light btn-sm" @click="search='';statusFilter='';searchProducts()">Clear filters</button></div>

<div class="card crm-data-card">
<div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Product catalogue</h2><p class="text-muted mb-0">Search the master catalogue and open a dedicated product record.</p></div></div>
<div class="table-responsive"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Product</th><th>Category</th><th>Unit / pack</th><th>Gallery</th><th class="text-end">MRP</th><th class="text-end">Reference</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
<template x-if="loading"><tr><td colspan="8"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
<template x-for="p in items" :key="p.productId"><tr><td><a class="crm-record-title" :href="'/products/'+p.productId" x-text="p.name"></a><div class="text-muted fs-sm" x-text="p.sku+(p.brand?' · '+p.brand:'')"></div></td><td x-text="joinTruthy([p.category,p.subcategory],' / ')||'—'"></td><td><span x-text="p.unit||'piece'"></span><div class="text-muted fs-sm" x-text="'Pack '+Number(p.packSize||1)+' · Carton '+Number(p.cartonSize||1)"></div></td><td><span x-text="imageCount(p)+' photos'"></span><div class="text-muted fs-sm" x-text="documentCount(p)+' documents'"></div></td><td class="text-end" x-text="money(p.mrpPaise)"></td><td class="text-end" x-text="money(p.referenceSellingPricePaise)"></td><td><span class="crm-status" :class="statusClass(p.status)" x-text="humanize(p.status)"></span></td><td class="text-end crm-table-actions"><a class="btn btn-sm btn-outline-primary" :href="'/products/'+p.productId">Open</a><% if (can('products.edit')) { %><a class="btn btn-sm btn-light" :href="'/products/'+p.productId+'/edit'">Edit</a><% } %></td></tr></template>
<tr x-show="!loading && !error && !items.length"><td colspan="8"><div class="crm-empty-state"><strong>No products found</strong><span x-show="search || statusFilter">Try a different search or clear the active filters.</span><span x-show="!search && !statusFilter">No products have been added yet.</span><button type="button" class="btn btn-light btn-sm mt-2" x-show="search || statusFilter" @click="search='';statusFilter='';searchProducts()">Clear filters</button></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function productsListPage(){return{
...crmPager('loadProducts'),items:[],loading:true,error:'',search:'',statusFilter:'',
imageCount(p){return(p.media||[]).filter(m=>m.active!==false&&m.kind==='image').length},documentCount(p){return(p.media||[]).filter(m=>m.active!==false&&m.kind==='document').length},
async loadProducts(){this.loading=true;this.error='';try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.search)q.set('search',this.search);if(this.statusFilter)q.set('status',this.statusFilter);const data=(await apiFetch('/api/products?'+q)).data;this.items=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},searchProducts(){this.resetPage();return this.loadProducts()}
}}</script><%- include('partials/scripts') %>
</body></html>
