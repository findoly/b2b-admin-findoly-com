<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="productsPage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3">
<div class="col-xl-5"><div class="card"><div class="card-header fw-semibold">Create product / SKU</div><div class="card-body"><div class="row g-2">
<div class="col-8"><input class="form-control" placeholder="Product name" x-model="form.name"></div><div class="col-4"><input class="form-control" placeholder="SKU" x-model="form.sku"></div>
<div class="col-4"><input class="form-control" placeholder="Brand" x-model="form.brand"></div><div class="col-4"><input class="form-control" placeholder="Category" x-model="form.category"></div><div class="col-4"><input class="form-control" placeholder="Manufacturer" x-model="form.manufacturer"></div>
<div class="col-4"><input class="form-control" placeholder="HSN" x-model="form.hsnCode"></div><div class="col-4"><input class="form-control" type="number" placeholder="GST bps (1800)" x-model.number="form.gstRateBps"></div><div class="col-4"><input class="form-control" type="number" placeholder="Pack size" x-model.number="form.packSize"></div>
<div class="col-4"><input class="form-control" type="number" placeholder="MRP paise" x-model.number="form.mrpPaise"></div><div class="col-4"><input class="form-control" type="number" placeholder="Reference sell paise" x-model.number="form.referenceSellingPricePaise"></div><div class="col-4"><input class="form-control" type="number" placeholder="Minimum sell paise" x-model.number="form.minimumSellingPricePaise"></div>
<div class="col-12"><textarea class="form-control" placeholder="Description" x-model="form.description"></textarea></div><div class="col-12"><button class="btn btn-primary" @click="create()">Create product</button></div>
</div></div></div>
<div class="card mt-3" x-show="selected"><div class="card-header fw-semibold">Photos & documents</div><div class="card-body"><div class="small text-secondary mb-2">Selected: <span x-text="selected?.name"></span> / <span x-text="selected?.sku"></span></div><select class="form-select mb-2" x-model="mediaKind"><option value="image">Product image</option><option value="document">Document</option></select><input class="form-control" type="file" @change="file=$event.target.files[0]"><div class="form-check mt-2"><input class="form-check-input" type="checkbox" x-model="primary" id="primaryImage"><label class="form-check-label" for="primaryImage">Primary image</label></div><button class="btn btn-outline-primary mt-2" @click="uploadMedia()" :disabled="!file">Upload to S3 & attach</button></div></div></div>
<div class="col-xl-7"><div class="card"><div class="card-header d-flex gap-2"><input class="form-control form-control-sm" placeholder="Search products" x-model="search" @keyup.enter="load()"><button class="btn btn-sm btn-outline-secondary" @click="load()">Search</button></div><div class="scroll-table"><table class="table mb-0"><thead><tr><th>Product</th><th>Category</th><th>GST</th><th>Reference</th><th>Min</th><th>Media</th></tr></thead><tbody><template x-for="p in items" :key="p.productId"><tr style="cursor:pointer" @click="selected=p"><td><strong x-text="p.name"></strong><div class="small text-secondary" x-text="p.sku"></div></td><td x-text="p.category||'—'"></td><td x-text="((p.gstRateBps||0)/100)+'%'"></td><td x-text="money(p.referenceSellingPricePaise)"></td><td x-text="money(p.minimumSellingPricePaise)"></td><td x-text="(p.media||[]).length"></td></tr></template></tbody></table></div></div></div>
</div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function productsPage(){return{items:[],selected:null,file:null,mediaKind:'image',primary:false,search:'',error:'',form:{name:'',sku:'',brand:'',category:'',manufacturer:'',hsnCode:'',gstRateBps:1800,packSize:1,mrpPaise:0,referenceSellingPricePaise:0,minimumSellingPricePaise:0,description:''},async load(){try{this.items=(await apiFetch('/api/products?search='+encodeURIComponent(this.search))).data.items}catch(e){this.error=e.message}},async create(){try{const x=(await apiFetch('/api/products',{method:'POST',body:JSON.stringify(this.form)})).data;this.selected=x;await this.load()}catch(e){this.error=e.message}},async uploadMedia(){if(!this.selected||!this.file)return;try{const prefix=this.mediaKind==='image'?'public/b2b/products/':'private/b2b/products/';const signed=(await apiFetch('/api/storage/upload-url',{method:'POST',body:JSON.stringify({prefix,fileName:this.selected.productId+'-'+Date.now()+'-'+this.file.name,contentType:this.file.type||'application/octet-stream',sizeBytes:this.file.size})})).data;const put=await fetch(signed.url,{method:'PUT',headers:signed.headers,body:this.file});if(!put.ok)throw new Error('S3 upload failed');await apiFetch('/api/products/'+this.selected.productId+'/media',{method:'POST',body:JSON.stringify({kind:this.mediaKind,key:signed.key,fileName:this.file.name,contentType:this.file.type,label:this.file.name,isPrimary:this.primary})});this.file=null;this.primary=false;await this.load();this.selected=this.items.find(x=>x.productId===this.selected.productId)||this.selected}catch(e){this.error=e.message}}}}</script></body></html>