<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Goods receipt</div><h1 class="page-title mb-1">Receive purchase order</h1><p class="crm-page-subtitle mb-0">Classify received, damaged, rejected and short quantities before stock reaches the warehouse.</p></div><a class="btn btn-light" href="/procurement/<%= encodeURIComponent(typeof recordId === "string" ? recordId : "") %>">Back to PO</a></div></div>
<div class="content" x-data="procurementReceivePage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1" x-text="crmValue(po,'poNumber','Purchase order')"></h2><p class="text-muted mb-0" x-text="crmValue(po,'supplierName','')"></p></div></div><div class="card-body"><div class="table-responsive mb-4"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Product</th><th class="text-end">Outstanding</th><th>Received</th><th>Accepted</th><th>Damaged</th><th>Rejected</th><th>Short</th></tr></thead><tbody><template x-for="l in form.lines" :key="l.purchaseOrderLineId"><tr><td><strong x-text="l.productName"></strong><div class="text-muted fs-sm" x-text="l.sku"></div></td><td class="text-end" x-text="l.outstandingQty"></td><td><input type="number" min="0" :max="l.outstandingQty" class="form-control" x-model.number="l.receivedQty" @input="sync(l)"></td><td><input type="number" min="0" class="form-control" x-model.number="l.acceptedQty"></td><td><input type="number" min="0" class="form-control" x-model.number="l.damagedQty" @input="sync(l)"></td><td><input type="number" min="0" class="form-control" x-model.number="l.rejectedQty" @input="sync(l)"></td><td><input type="number" min="0" class="form-control" x-model.number="l.shortQty"></td></tr></template></tbody></table></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Supplier invoice number</label><input class="form-control" x-model="form.supplierInvoiceNumber"></div><div class="col-md-4"><label class="form-label">Supplier invoice date</label><input type="date" class="form-control" x-model="form.supplierInvoiceDate"></div><div class="col-md-4"><label class="form-label">ITC status</label><select class="form-select" x-model="form.itcStatus"><option value="pending">Pending</option><option value="eligible">Eligible</option><option value="not_eligible">Not eligible</option><option value="reversed">Reversed</option></select></div><div class="col-12"><label class="form-label">Supplier invoice document</label><input class="form-control" type="file" @change="uploadInvoice($event)" accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt"><div class="mt-2" x-show="form.supplierInvoiceDocumentKey"><button class="btn btn-sm btn-outline-secondary" type="button" @click="openInvoice()" x-text="attachmentName(form.supplierInvoiceDocumentKey)"></button></div></div><div class="col-6 col-md-2"><label class="form-label">Taxable ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.taxableRupees"></div><div class="col-6 col-md-2"><label class="form-label">CGST ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.cgstRupees"></div><div class="col-6 col-md-2"><label class="form-label">SGST ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.sgstRupees"></div><div class="col-6 col-md-2"><label class="form-label">IGST ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.igstRupees"></div><div class="col-6 col-md-2"><label class="form-label">Cess ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.cessRupees"></div><div class="col-6 col-md-2"><label class="form-label">Invoice total ₹</label><input class="form-control" type="number" min="0" step="0.01" x-model.number="form.totalInvoiceRupees"></div></div><div class="text-end mt-4"><button class="btn btn-primary" @click="submit()" :disabled="saving" x-text="saving?'Receiving…':'Record goods receipt'"></button></div></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function procurementReceivePage(){return{poId:location.pathname.split('/')[2]||'',po:null,saving:false,error:'',form:{lines:[],supplierInvoiceNumber:'',supplierInvoiceDate:'',taxableRupees:0,cgstRupees:0,sgstRupees:0,igstRupees:0,cessRupees:0,totalInvoiceRupees:0,itcStatus:'pending',supplierInvoiceDocumentKey:''},async load(){try{this.po=(await apiFetch('/api/procurement/'+this.poId)).data;if(!['approved','placed','partially_received'].includes(this.po.status))throw new Error('This purchase order is not receivable in its current status.');this.form.lines=(this.po.lines||[]).map(l=>{const out=Number(l.quantity||0)-Number(l.receivedQuantity||0)-Number(l.shortQuantity||0);return{purchaseOrderLineId:l.purchaseOrderLineId,productName:l.productName,sku:l.sku,outstandingQty:out,receivedQty:out,acceptedQty:out,damagedQty:0,rejectedQty:0,shortQty:0}})}catch(e){this.error=e.message}},sync(l){l.acceptedQty=Math.max(0,Number(l.receivedQty||0)-Number(l.damagedQty||0)-Number(l.rejectedQty||0))},paise(v){return Math.round(Number(v||0)*100)},async uploadInvoice(event){const file=event.target.files?.[0];if(!file)return;try{const x=await uploadBusinessAttachment('invoices',file);this.form.supplierInvoiceDocumentKey=x.key;showCrmToast('Supplier invoice uploaded')}catch(e){this.error=e.message}finally{event.target.value=''}},async openInvoice(){await openBusinessAttachment('invoices',this.form.supplierInvoiceDocumentKey)},async submit(){this.saving=true;try{const body={lines:this.form.lines.map(l=>({purchaseOrderLineId:l.purchaseOrderLineId,receivedQty:Number(l.receivedQty||0),acceptedQty:Number(l.acceptedQty||0),damagedQty:Number(l.damagedQty||0),rejectedQty:Number(l.rejectedQty||0),shortQty:Number(l.shortQty||0)})),supplierInvoiceNumber:this.form.supplierInvoiceNumber,supplierInvoiceDate:this.form.supplierInvoiceDate||null,taxablePaise:this.paise(this.form.taxableRupees),cgstPaise:this.paise(this.form.cgstRupees),sgstPaise:this.paise(this.form.sgstRupees),igstPaise:this.paise(this.form.igstRupees),cessPaise:this.paise(this.form.cessRupees),totalInvoicePaise:this.paise(this.form.totalInvoiceRupees),itcStatus:this.form.itcStatus,supplierInvoiceDocumentKey:this.form.supplierInvoiceDocumentKey||''};await apiFetch('/api/procurement/'+this.poId+'/receive',{method:'POST',body:JSON.stringify(body)});showCrmToast('Goods receipt recorded');location.href='/procurement/'+this.poId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}}}</script><%- include('partials/scripts') %>
</body></html>
