<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Warehouse master</div><h1 class="page-title mb-1" x-data x-text="location.pathname.endsWith('/new')?'New warehouse':'Edit warehouse'">Warehouse</h1><p class="crm-page-subtitle mb-0">This location will be selectable consistently in procurement, inventory and sales-order fulfilment.</p></div><a class="btn btn-light" href="/warehouses">Back to warehouses</a></div></div>
<div class="content" x-data="warehouseFormPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" role="alert" x-text="error"></div><div class="card crm-data-card"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="warehouse-field-1">Warehouse name</label><input id="warehouse-field-1" class="form-control" x-model="form.name"></div><div class="col-md-3"><label class="form-label" for="warehouse-field-2">Code</label><input id="warehouse-field-2" class="form-control" x-model="form.code"></div><div class="col-md-3 d-flex align-items-end"><label class="form-check mb-2"><input type="checkbox" class="form-check-input" x-model="form.active"><span class="form-check-label">Active for new operations</span></label></div><div class="col-md-6"><label class="form-label" for="warehouse-field-3">Address line 1</label><input id="warehouse-field-3" class="form-control" x-model="form.address.line1"></div><div class="col-md-6"><label class="form-label" for="warehouse-field-4">Address line 2</label><input id="warehouse-field-4" class="form-control" x-model="form.address.line2"></div><div class="col-md-4"><label class="form-label" for="warehouse-field-5">City</label><input id="warehouse-field-5" class="form-control" x-model="form.address.city"></div><div class="col-md-4"><label class="form-label" for="warehouse-field-6">State</label><input id="warehouse-field-6" class="form-control" x-model="form.address.state"></div><div class="col-md-4"><label class="form-label" for="warehouse-field-7">Pincode</label><input id="warehouse-field-7" class="form-control" x-model="form.address.pincode"></div></div><div class="text-end mt-4"><button class="btn btn-primary" @click="save()" :disabled="saving" x-text="saving?'Saving warehouse…':(editing?'Save changes':'Create warehouse')"></button></div></div></div></div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function warehouseFormPage(){return{warehouseId:location.pathname.split('/')[2]||'',editing:!location.pathname.endsWith('/new'),error:'',saving:false,form:{name:'',code:'',address:{line1:'',line2:'',city:'',state:'Maharashtra',pincode:''},active:true},async load(){if(!this.editing)return;try{const rows=(await apiFetch('/api/warehouses')).data.items||[];const w=rows.find(x=>x.warehouseId===this.warehouseId);if(!w)throw new Error('Warehouse not found');this.form={name:w.name,code:w.code,address:{line1:w.address?.line1||'',line2:w.address?.line2||'',city:w.address?.city||'',state:w.address?.state||'',pincode:w.address?.pincode||''},active:w.active!==false}}catch(e){this.error=e.message}},async save(){if(this.saving)return;this.error='';if(!this.form.name.trim()||!this.form.code.trim())return this.error='Warehouse name and code are required.';this.saving=true;try{if(this.editing)await apiFetch('/api/warehouses/'+this.warehouseId,{method:'PUT',body:JSON.stringify(this.form)});else await apiFetch('/api/warehouses',{method:'POST',body:JSON.stringify(this.form)});showCrmToast(this.editing?'Warehouse updated':'Warehouse created');location.href='/warehouses'}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}}}</script><%- include('partials/scripts') %>
</body></html>
