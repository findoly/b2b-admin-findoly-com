<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="finance()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3"><div class="col-lg-6"><div class="card crm-data-card"><div class="card-header fw-semibold">Customer invoices</div><pre class="p-3 small mb-0" style="max-height:45vh;overflow:auto" x-text="JSON.stringify(invoices,null,2)"></pre></div></div><div class="col-lg-6"><div class="card crm-data-card"><div class="card-header fw-semibold">Supplier bills</div><pre class="p-3 small mb-0" style="max-height:45vh;overflow:auto" x-text="JSON.stringify(bills,null,2)"></pre></div></div><div class="col-12"><div class="card crm-data-card"><div class="card-header fw-semibold">Record payment / advance</div><div class="card-body"><textarea class="form-control font-monospace" rows="6" x-model="payload"></textarea><button class="btn btn-primary mt-2" @click="pay()">Record payment</button><div class="small text-secondary mt-2">Supports receivable/payable, partial allocations, and unallocated advances.</div></div></div></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function finance(){return{invoices:null,bills:null,error:'',payload:'{"direction":"receivable","customerId":"","amountPaise":10000,"mode":"bank_transfer","allocations":[]}',async load(){try{[this.invoices,this.bills]=await Promise.all([apiFetch('/api/finance/invoices').then(x=>x.data),apiFetch('/api/finance/supplier-bills').then(x=>x.data)])}catch(e){this.error=e.message}},async pay(){try{await apiFetch('/api/finance/payments',{method:'POST',body:this.payload});await this.load()}catch(e){this.error=e.message}}}}</script></body></html>