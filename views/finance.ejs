<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="finance()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3"><div class="col-lg-6"><div class="card"><div class="card-header fw-semibold">Customer invoices</div><pre class="p-3 small mb-0" style="max-height:45vh;overflow:auto" x-text="JSON.stringify(invoices,null,2)"></pre></div></div><div class="col-lg-6"><div class="card"><div class="card-header fw-semibold">Supplier bills</div><pre class="p-3 small mb-0" style="max-height:45vh;overflow:auto" x-text="JSON.stringify(bills,null,2)"></pre></div></div><div class="col-12"><div class="card"><div class="card-header fw-semibold">Record payment / advance</div><div class="card-body"><textarea class="form-control font-monospace" rows="6" x-model="payload"></textarea><button class="btn btn-primary mt-2" @click="pay()">Record payment</button><div class="small text-secondary mt-2">Supports receivable/payable, partial allocations, and unallocated advances.</div></div></div></div></div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function finance(){return{invoices:null,bills:null,error:'',payload:'{"direction":"receivable","customerId":"","amountPaise":10000,"mode":"bank_transfer","allocations":[]}',async load(){try{[this.invoices,this.bills]=await Promise.all([apiFetch('/api/finance/invoices').then(x=>x.data),apiFetch('/api/finance/supplier-bills').then(x=>x.data)])}catch(e){this.error=e.message}},async pay(){try{await apiFetch('/api/finance/payments',{method:'POST',body:this.payload});await this.load()}catch(e){this.error=e.message}}}}</script></body></html>