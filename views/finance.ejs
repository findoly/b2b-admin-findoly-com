<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Finance</div><h1 class="page-title mb-1">Finance</h1><p class="crm-page-subtitle mb-0">Customer receivables, supplier payables, advances and payment reconciliation.</p></div><% if (can('finance.receive') || can('finance.pay')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-payment')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Record payment</button><% } %></div></div>
<div class="content" x-data="financePage()" x-init="load()" @new-payment.window="showPayment=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<section class="crm-metric-grid mb-4"><article class="crm-metric-card crm-metric-blue"><div class="crm-metric-top"><div><span class="crm-metric-label">Customer receivables</span><strong class="crm-metric-value" x-text="money(summary.receivableOutstandingPaise)">₹0.00</strong></div></div><div class="crm-metric-note">All current issued invoice outstanding</div></article><article class="crm-metric-card crm-metric-purple"><div class="crm-metric-top"><div><span class="crm-metric-label">Supplier payables</span><strong class="crm-metric-value" x-text="money(summary.payableOutstandingPaise)">₹0.00</strong></div></div><div class="crm-metric-note">All current supplier bill outstanding</div></article><article class="crm-metric-card crm-metric-green"><div class="crm-metric-top"><div><span class="crm-metric-label">Unallocated advances</span><strong class="crm-metric-value" x-text="money(Number(summary.customerAdvancePaise||0)+Number(summary.supplierAdvancePaise||0))">₹0.00</strong></div></div><div class="crm-metric-note" x-text="'Payments recorded: '+Number(summary.paymentCount||0).toLocaleString()"></div></article></section>

<% if (can('finance.invoice')) { %>
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Issue customer invoice</h2><p class="text-muted mb-0">Generate the structured HTML invoice from an eligible sales order.</p></div></div><div class="card-body"><div class="row g-3 align-items-end"><div class="col-lg-8"><label class="form-label">Sales order</label><div class="input-group mb-2"><input class="form-control" placeholder="Search order/customer" x-model="orderSearch" @keyup.enter="searchOrders()"><button class="btn btn-light" type="button" @click="searchOrders()">Find</button></div><select class="form-select" x-model="invoiceOrderId"><option value="">Select order</option><template x-for="o in invoiceEligibleOrders" :key="o.salesOrderId"><option :value="o.salesOrderId" x-text="o.orderNumber+' · '+(o.customerSnapshot?.businessName||'')+' · '+money(o.totalPaise)"></option></template></select></div><div class="col-lg-4"><button class="btn btn-primary w-100" @click="issueInvoice()" :disabled="!invoiceOrderId">Issue invoice</button></div></div></div></div>
<% } %>

<% if (can('finance.receive') || can('finance.pay')) { %>
<div class="card crm-data-card mb-4" x-show="showPayment" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Record payment or advance</h2><p class="text-muted mb-0">Leave allocation blank to record an advance for later allocation.</p></div><button class="btn btn-light btn-sm" @click="showPayment=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-md-3"><label class="form-label">Direction</label><select class="form-select" x-model="payment.direction" @change="payment.partyId='';payment.documentId='';payment.allocationRupees=0"><% if (can('finance.receive')) { %><option value="receivable">Money received from customer</option><% } %><% if (can('finance.pay')) { %><option value="payable">Money paid to supplier</option><% } %></select></div>
<div class="col-md-3"><label class="form-label" x-text="payment.direction==='receivable'?'Customer':'Supplier'"></label><div class="input-group mb-2"><input class="form-control" placeholder="Search party" x-model="partySearch" @keyup.enter="searchParties()"><button class="btn btn-light" type="button" @click="searchParties()">Find</button></div><select class="form-select" x-model="payment.partyId" @change="payment.documentId=''"><option value="">Select party</option><template x-for="p in paymentParties" :key="payment.direction==='receivable'?p.customerId:p.supplierId"><option :value="payment.direction==='receivable'?p.customerId:p.supplierId" x-text="payment.direction==='receivable'?p.businessName:p.businessName"></option></template></select></div>
<div class="col-md-2"><label class="form-label">Amount ₹</label><input type="number" min="0.01" step="0.01" class="form-control" x-model.number="payment.amountRupees"></div>
<div class="col-md-2"><label class="form-label">Mode</label><select class="form-select" x-model="payment.mode"><option value="bank_transfer">Bank transfer</option><option value="upi">UPI</option><option value="cash">Cash</option><option value="cheque">Cheque</option><option value="card">Card</option><option value="other">Other</option></select></div>
<div class="col-md-2"><label class="form-label">Paid on</label><input type="date" class="form-control" x-model="payment.paidAt"></div>
<div class="col-md-6"><label class="form-label">Reference</label><input class="form-control" x-model="payment.reference" placeholder="UTR / cheque / receipt reference"></div>
<div class="col-md-6"><label class="form-label">Allocate to document (optional)</label><select class="form-select" x-model="payment.documentId" @change="syncAllocation()"><option value="">Keep as unallocated advance</option><template x-for="d in paymentDocuments" :key="payment.direction==='receivable'?d.invoiceId:d.supplierBillId"><option :value="payment.direction==='receivable'?d.invoiceId:d.supplierBillId" x-text="documentLabel(d)"></option></template></select></div>
<div class="col-md-3" x-show="payment.documentId" x-cloak><label class="form-label">Allocate amount ₹</label><input type="number" min="0.01" step="0.01" class="form-control" x-model.number="payment.allocationRupees"><div class="text-muted fs-sm mt-1">Any balance stays as an advance.</div></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="recordPayment()">Record payment</button></div></div></div>
<% } %>

<% if (can('finance.receive') || can('finance.pay')) { %>
<div class="card crm-data-card mb-4" x-show="advance.payment" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Allocate existing advance</h2><p class="text-muted mb-0" x-text="advance.payment ? ((advance.payment.direction==='receivable'?'Customer':'Supplier')+' advance · '+money(advance.payment.unallocatedPaise)) : ''"></p></div><button class="btn btn-light btn-sm" @click="advance={payment:null,documentId:'',amountRupees:0,note:''}">Close</button></div><div class="card-body"><div class="row g-3 align-items-end"><div class="col-lg-6"><label class="form-label">Outstanding document</label><select class="form-select" x-model="advance.documentId" @change="syncAdvanceAmount()"><option value="">Select document</option><template x-for="d in advanceDocuments" :key="advance.payment?.direction==='receivable'?d.invoiceId:d.supplierBillId"><option :value="advance.payment?.direction==='receivable'?d.invoiceId:d.supplierBillId" x-text="advanceDocumentLabel(d)"></option></template></select></div><div class="col-lg-3"><label class="form-label">Allocate amount ₹</label><input type="number" min="0.01" step="0.01" class="form-control" x-model.number="advance.amountRupees"></div><div class="col-lg-3"><button class="btn btn-primary w-100" @click="allocateAdvance()" :disabled="!advance.documentId||Number(advance.amountRupees)<=0">Allocate advance</button></div><div class="col-12"><label class="form-label">Note</label><input class="form-control" x-model="advance.note" placeholder="Optional allocation note"></div></div></div></div>
<% } %>
<div class="row g-4">
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Customer invoices</h2><p class="text-muted mb-0">Issued invoices and outstanding balances.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Invoice</th><th>Customer</th><th>Due</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Outstanding</th><th class="text-end">Action</th></tr></thead><tbody><template x-for="i in invoices" :key="i.invoiceId"><tr><td><a class="crm-record-title" :href="'/invoices/'+i.invoiceId" x-text="i.invoiceNumber"></a><div class="crm-record-id" x-text="i.invoiceId"></div></td><td x-text="customerName(i.customerId)"></td><td x-text="formatDateOnly(i.dueAt)"></td><td><span class="crm-status" :class="statusClass(i.paymentStatus)" x-text="humanize(i.paymentStatus)"></span></td><td class="text-end" x-text="money(i.totalPaise)"></td><td class="text-end" x-text="money(i.paidPaise)"></td><td class="text-end fw-semibold" x-text="money(i.outstandingPaise)"></td><td class="text-end"><% if (can('finance.invoice')) { %><button x-show="i.status==='issued'" class="btn btn-sm btn-outline-danger" @click="voidInvoice(i)">Void</button><% } %></td></tr></template><tr x-show="!invoices.length"><td colspan="8"><div class="crm-empty-state"><strong>No customer invoices</strong></div></td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between align-items-center gap-2" x-show="invoiceMeta.total>0"><div class="text-muted fs-sm"><span x-text="invoiceMeta.total.toLocaleString()"></span> records · page <span x-text="invoiceMeta.page"></span> of <span x-text="invoiceMeta.pages"></span></div><div class="btn-group btn-group-sm"><button class="btn btn-light" @click="loadInvoices(invoiceMeta.page-1)" :disabled="invoiceMeta.page<=1">Previous</button><button class="btn btn-light" @click="loadInvoices(invoiceMeta.page+1)" :disabled="invoiceMeta.page>=invoiceMeta.pages">Next</button></div></div></div></div>
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier bills</h2><p class="text-muted mb-0">Payables created from supplier invoices received during GRN.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Supplier invoice</th><th>Supplier</th><th>Due</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Outstanding</th><th class="text-end">Action</th></tr></thead><tbody><template x-for="b in bills" :key="b.supplierBillId"><tr><td><strong x-text="b.supplierInvoiceNumber"></strong><div class="crm-record-id" x-text="b.supplierBillId"></div></td><td x-text="supplierName(b.supplierId)"></td><td x-text="formatDateOnly(b.dueAt)"></td><td><span class="crm-status" :class="statusClass(b.paymentStatus)" x-text="humanize(b.paymentStatus)"></span></td><td class="text-end" x-text="money(b.totalPaise)"></td><td class="text-end" x-text="money(b.paidPaise)"></td><td class="text-end fw-semibold" x-text="money(b.outstandingPaise)"></td><td class="text-end"><% if (can('finance.pay')) { %><button x-show="b.paymentStatus!=='void'" class="btn btn-sm btn-outline-danger" @click="voidBill(b)">Void</button><% } %></td></tr></template><tr x-show="!bills.length"><td colspan="8"><div class="crm-empty-state"><strong>No supplier bills</strong></div></td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between align-items-center gap-2" x-show="billMeta.total>0"><div class="text-muted fs-sm"><span x-text="billMeta.total.toLocaleString()"></span> records · page <span x-text="billMeta.page"></span> of <span x-text="billMeta.pages"></span></div><div class="btn-group btn-group-sm"><button class="btn btn-light" @click="loadBills(billMeta.page-1)" :disabled="billMeta.page<=1">Previous</button><button class="btn btn-light" @click="loadBills(billMeta.page+1)" :disabled="billMeta.page>=billMeta.pages">Next</button></div></div></div></div>
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Payments</h2><p class="text-muted mb-0">Receipts, supplier payments and advances.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Date</th><th>Direction</th><th>Party</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th><th class="text-end">Unallocated</th><th>Reconciled</th><th></th></tr></thead><tbody><template x-for="p in payments" :key="p.paymentId"><tr><td x-text="formatDateOnly(p.paidAt)"></td><td><span class="crm-status" :class="p.direction==='receivable'?'status-paid':'status-pending'" x-text="p.direction==='receivable'?'Received':'Paid'"></span></td><td x-text="p.direction==='receivable'?customerName(p.customerId):supplierName(p.supplierId)"></td><td x-text="humanize(p.mode)"></td><td x-text="p.reference||'—'"></td><td class="text-end fw-semibold" x-text="money(p.amountPaise)"></td><td class="text-end" x-text="money(p.unallocatedPaise)"></td><td x-text="p.reconciled?'Yes':'No'"></td><td class="text-end"><% if (can('finance.receive') || can('finance.pay')) { %><button x-show="Number(p.unallocatedPaise||0)>0 && ((p.direction==='receivable' && <%= can("finance.receive") ? "true" : "false" %>) || (p.direction==='payable' && <%= can("finance.pay") ? "true" : "false" %>))" class="btn btn-sm btn-outline-primary me-1" @click="openAdvanceAllocation(p)">Allocate</button><% } %><% if (can('finance.reconcile')) { %><button x-show="!p.reconciled" class="btn btn-sm btn-outline-secondary" @click="reconcile(p)">Reconcile</button><% } %></td></tr></template><tr x-show="!payments.length"><td colspan="9"><div class="crm-empty-state"><strong>No payments recorded</strong></div></td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between align-items-center gap-2" x-show="paymentMeta.total>0"><div class="text-muted fs-sm"><span x-text="paymentMeta.total.toLocaleString()"></span> records · page <span x-text="paymentMeta.page"></span> of <span x-text="paymentMeta.pages"></span></div><div class="btn-group btn-group-sm"><button class="btn btn-light" @click="loadPayments(paymentMeta.page-1)" :disabled="paymentMeta.page<=1">Previous</button><button class="btn btn-light" @click="loadPayments(paymentMeta.page+1)" :disabled="paymentMeta.page>=paymentMeta.pages">Next</button></div></div></div></div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function financePage(){return{
invoices:[],bills:[],payments:[],customers:[],suppliers:[],orders:[],orderSearch:'',partySearch:'',invoiceMeta:{page:1,pages:1,total:0},billMeta:{page:1,pages:1,total:0},paymentMeta:{page:1,pages:1,total:0},summary:{receivableOutstandingPaise:0,payableOutstandingPaise:0,paymentCount:0,customerAdvancePaise:0,supplierAdvancePaise:0},advance:{payment:null,documentId:'',amountRupees:0,note:''},error:'',showPayment:false,invoiceOrderId:'',payment:{direction:'<%= can("finance.receive") ? "receivable" : "payable" %>',partyId:'',amountRupees:0,mode:'bank_transfer',paidAt:new Date().toISOString().slice(0,10),reference:'',documentId:'',allocationRupees:0},
get invoiceEligibleOrders(){return this.orders.filter(o=>!['draft','created','cancelled'].includes(o.status)&&!['pending','rejected'].includes(o.approvalStatus))},get advanceDocuments(){const p=this.advance.payment;if(!p)return[];return p.direction==='receivable'?this.invoices.filter(x=>x.status==='issued'&&x.customerId===p.customerId&&Number(x.outstandingPaise)>0):this.bills.filter(x=>x.paymentStatus!=='void'&&x.supplierId===p.supplierId&&Number(x.outstandingPaise)>0)},
get paymentParties(){return this.payment.direction==='receivable'?this.customers:this.suppliers},
get paymentDocuments(){return this.payment.direction==='receivable'?this.invoices.filter(x=>x.customerId===this.payment.partyId&&Number(x.outstandingPaise)>0):this.bills.filter(x=>x.supplierId===this.payment.partyId&&Number(x.outstandingPaise)>0)},
customerName(id){return this.customers.find(x=>x.customerId===id)?.businessName||id},supplierName(id){return this.suppliers.find(x=>x.supplierId===id)?.businessName||id},documentLabel(d){return this.payment.direction==='receivable'?(d.invoiceNumber+' · '+money(d.outstandingPaise)):(d.supplierInvoiceNumber+' · '+money(d.outstandingPaise))},
selectedDocument(){return this.paymentDocuments.find(d=>(this.payment.direction==='receivable'?d.invoiceId:d.supplierBillId)===this.payment.documentId)},
syncAllocation(){const d=this.selectedDocument();if(!d){this.payment.allocationRupees=0;return}this.payment.allocationRupees=Math.min(Number(this.payment.amountRupees||0),Number(d.outstandingPaise||0)/100)},
setFinanceMeta(target,data){this[target]={page:Number(data?.page||1),pages:Math.max(1,Number(data?.pages||1)),total:Number(data?.total||0)}},
async loadInvoices(page=this.invoiceMeta.page){const data=(await apiFetch('/api/finance/invoices?limit=50&page='+Math.max(1,page))).data;this.invoices=data.items||[];this.setFinanceMeta('invoiceMeta',data)},
async loadBills(page=this.billMeta.page){const data=(await apiFetch('/api/finance/supplier-bills?limit=50&page='+Math.max(1,page))).data;this.bills=data.items||[];this.setFinanceMeta('billMeta',data)},
async loadPayments(page=this.paymentMeta.page){const data=(await apiFetch('/api/finance/payments?limit=50&page='+Math.max(1,page))).data;this.payments=data.items||[];this.setFinanceMeta('paymentMeta',data)},
async load(){try{const[c,s,o,summary]=await Promise.all([apiFetch('/api/customers?limit=50'),apiFetch('/api/suppliers?limit=50'),apiFetch('/api/orders?limit=50'),apiFetch('/api/finance/summary')]);this.customers=c.data.items||[];this.suppliers=s.data.items||[];this.orders=o.data.items||[];this.summary=summary.data||this.summary;await Promise.all([this.loadInvoices(),this.loadBills(),this.loadPayments()])}catch(e){this.error=e.message}},async searchOrders(){try{this.orders=(await apiFetch('/api/orders?limit=100&search='+encodeURIComponent(this.orderSearch))).data.items||[]}catch(e){this.error=e.message}},async searchParties(){try{const endpoint=this.payment.direction==='receivable'?'/api/customers':'/api/suppliers',data=(await apiFetch(endpoint+'?limit=100&search='+encodeURIComponent(this.partySearch))).data;if(this.payment.direction==='receivable')this.customers=data.items||[];else this.suppliers=data.items||[]}catch(e){this.error=e.message}},
async issueInvoice(){if(!this.invoiceOrderId)return;try{const x=(await apiFetch('/api/finance/invoices/order/'+this.invoiceOrderId,{method:'POST',body:'{}'})).data;showCrmToast('Invoice issued');location.href='/invoices/'+x.invoiceId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async recordPayment(){const p=this.payment;if(!p.partyId||Number(p.amountRupees)<=0)return this.error='Select a party and enter a payment amount.';const amountPaise=Math.round(Number(p.amountRupees)*100);const allocationPaise=p.documentId?Math.round(Number(p.allocationRupees||0)*100):0;const doc=this.selectedDocument();if(allocationPaise>amountPaise)return this.error='Allocated amount cannot exceed the payment amount.';if(doc&&allocationPaise>Number(doc.outstandingPaise||0))return this.error='Allocated amount cannot exceed document outstanding.';const body={direction:p.direction,amountPaise,mode:p.mode,paidAt:p.paidAt,reference:p.reference,allocations:p.documentId&&allocationPaise>0?[{documentId:p.documentId,amountPaise:allocationPaise}]:[]};if(p.direction==='receivable')body.customerId=p.partyId;else body.supplierId=p.partyId;try{await apiFetch('/api/finance/payments',{method:'POST',body:JSON.stringify(body)});showCrmToast('Payment recorded');this.showPayment=false;this.payment={direction:'<%= can("finance.receive") ? "receivable" : "payable" %>',partyId:'',amountRupees:0,mode:'bank_transfer',paidAt:new Date().toISOString().slice(0,10),reference:'',documentId:'',allocationRupees:0};await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
openAdvanceAllocation(p){this.advance={payment:p,documentId:'',amountRupees:0,note:''};this.$nextTick(()=>this.$el.scrollIntoView({behavior:'smooth',block:'start'}))},
advanceDocumentLabel(d){return this.advance.payment?.direction==='receivable'?(d.invoiceNumber+' · '+money(d.outstandingPaise)):(d.supplierInvoiceNumber+' · '+money(d.outstandingPaise))},
syncAdvanceAmount(){const p=this.advance.payment,d=this.advanceDocuments.find(x=>(p?.direction==='receivable'?x.invoiceId:x.supplierBillId)===this.advance.documentId);this.advance.amountRupees=d?Math.min(Number(p?.unallocatedPaise||0),Number(d.outstandingPaise||0))/100:0},
async allocateAdvance(){const a=this.advance,p=a.payment;if(!p||!a.documentId)return;const amountPaise=Math.round(Number(a.amountRupees||0)*100);if(amountPaise<=0||amountPaise>Number(p.unallocatedPaise||0))return this.error='Allocation must be positive and cannot exceed the advance balance.';try{await apiFetch('/api/finance/payments/'+p.paymentId+'/allocate',{method:'POST',body:JSON.stringify({allocations:[{documentId:a.documentId,amountPaise}],note:a.note})});showCrmToast('Advance allocated');this.advance={payment:null,documentId:'',amountRupees:0,note:''};await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async voidInvoice(i){if(!confirm('Void this invoice? Any linked payment allocation will return to customer advance.'))return;try{await apiFetch('/api/finance/invoices/'+i.invoiceId+'/void',{method:'POST',body:JSON.stringify({reason:'Voided from finance portal'})});showCrmToast('Invoice voided');await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async voidBill(b){if(!confirm('Void this supplier bill? Any linked payment allocation will return to supplier advance.'))return;try{await apiFetch('/api/finance/supplier-bills/'+b.supplierBillId+'/void',{method:'POST',body:JSON.stringify({reason:'Voided from finance portal'})});showCrmToast('Supplier bill voided');await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async reconcile(p){try{await apiFetch('/api/finance/payments/'+p.paymentId+'/reconcile',{method:'POST',body:'{}'});showCrmToast('Payment reconciled');await this.load()}catch(e){this.error=e.message}}
}}</script><%- include('partials/scripts') %>
</body></html>