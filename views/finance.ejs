<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Finance</div><h1 class="page-title mb-1">Finance</h1><p class="crm-page-subtitle mb-0">Customer receivables, supplier payables, advances and payment reconciliation.</p></div><% if (can('finance.receive') || can('finance.pay')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-payment')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Record payment</button><% } %></div></div>
<div class="content" x-data="financePage()" x-init="load()" @new-payment.window="showPayment=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<section class="crm-metric-grid mb-4"><article class="crm-metric-card crm-metric-blue"><div class="crm-metric-top"><div><span class="crm-metric-label">Customer receivables</span><strong class="crm-metric-value" x-text="money(receivableOutstanding)">₹0.00</strong></div></div><div class="crm-metric-note">Current issued invoice outstanding</div></article><article class="crm-metric-card crm-metric-purple"><div class="crm-metric-top"><div><span class="crm-metric-label">Supplier payables</span><strong class="crm-metric-value" x-text="money(payableOutstanding)">₹0.00</strong></div></div><div class="crm-metric-note">Current supplier bill outstanding</div></article><article class="crm-metric-card crm-metric-green"><div class="crm-metric-top"><div><span class="crm-metric-label">Payments recorded</span><strong class="crm-metric-value" x-text="payments.length">0</strong></div></div><div class="crm-metric-note">Recent receivable and payable transactions</div></article></section>

<% if (can('finance.invoice')) { %>
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Issue customer invoice</h2><p class="text-muted mb-0">Generate the structured HTML invoice from an eligible sales order.</p></div></div><div class="card-body"><div class="row g-3 align-items-end"><div class="col-lg-8"><label class="form-label">Sales order</label><select class="form-select" x-model="invoiceOrderId"><option value="">Select order</option><template x-for="o in invoiceEligibleOrders" :key="o.salesOrderId"><option :value="o.salesOrderId" x-text="o.orderNumber+' · '+(o.customerSnapshot?.businessName||'')+' · '+money(o.totalPaise)"></option></template></select></div><div class="col-lg-4"><button class="btn btn-primary w-100" @click="issueInvoice()" :disabled="!invoiceOrderId">Issue invoice</button></div></div></div></div>
<% } %>

<% if (can('finance.receive') || can('finance.pay')) { %>
<div class="card crm-data-card mb-4" x-show="showPayment" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Record payment or advance</h2><p class="text-muted mb-0">Leave allocation blank to record an advance for later allocation.</p></div><button class="btn btn-light btn-sm" @click="showPayment=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-md-3"><label class="form-label">Direction</label><select class="form-select" x-model="payment.direction" @change="payment.partyId='';payment.documentId=''"><option value="receivable">Money received from customer</option><option value="payable">Money paid to supplier</option></select></div>
<div class="col-md-3"><label class="form-label" x-text="payment.direction==='receivable'?'Customer':'Supplier'"></label><select class="form-select" x-model="payment.partyId" @change="payment.documentId=''"><option value="">Select party</option><template x-for="p in paymentParties" :key="payment.direction==='receivable'?p.customerId:p.supplierId"><option :value="payment.direction==='receivable'?p.customerId:p.supplierId" x-text="payment.direction==='receivable'?p.businessName:p.businessName"></option></template></select></div>
<div class="col-md-2"><label class="form-label">Amount ₹</label><input type="number" min="0.01" step="0.01" class="form-control" x-model.number="payment.amountRupees"></div>
<div class="col-md-2"><label class="form-label">Mode</label><select class="form-select" x-model="payment.mode"><option value="bank_transfer">Bank transfer</option><option value="upi">UPI</option><option value="cash">Cash</option><option value="cheque">Cheque</option><option value="card">Card</option><option value="other">Other</option></select></div>
<div class="col-md-2"><label class="form-label">Paid on</label><input type="date" class="form-control" x-model="payment.paidAt"></div>
<div class="col-md-6"><label class="form-label">Reference</label><input class="form-control" x-model="payment.reference" placeholder="UTR / cheque / receipt reference"></div>
<div class="col-md-6"><label class="form-label">Allocate to document (optional)</label><select class="form-select" x-model="payment.documentId"><option value="">Keep as unallocated advance</option><template x-for="d in paymentDocuments" :key="payment.direction==='receivable'?d.invoiceId:d.supplierBillId"><option :value="payment.direction==='receivable'?d.invoiceId:d.supplierBillId" x-text="documentLabel(d)"></option></template></select></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="recordPayment()">Record payment</button></div></div></div>
<% } %>

<div class="row g-4">
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Customer invoices</h2><p class="text-muted mb-0">Issued invoices and outstanding balances.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Invoice</th><th>Customer</th><th>Due</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Outstanding</th></tr></thead><tbody><template x-for="i in invoices" :key="i.invoiceId"><tr><td><a class="crm-record-title" :href="'/invoices/'+i.invoiceId" x-text="i.invoiceNumber"></a><div class="crm-record-id" x-text="i.invoiceId"></div></td><td x-text="customerName(i.customerId)"></td><td x-text="formatDateOnly(i.dueAt)"></td><td><span class="crm-status" :class="statusClass(i.paymentStatus)" x-text="humanize(i.paymentStatus)"></span></td><td class="text-end" x-text="money(i.totalPaise)"></td><td class="text-end" x-text="money(i.paidPaise)"></td><td class="text-end fw-semibold" x-text="money(i.outstandingPaise)"></td></tr></template><tr x-show="!invoices.length"><td colspan="7"><div class="crm-empty-state"><strong>No customer invoices</strong></div></td></tr></tbody></table></div></div></div>
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier bills</h2><p class="text-muted mb-0">Payables created from supplier invoices received during GRN.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Supplier invoice</th><th>Supplier</th><th>Due</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Outstanding</th></tr></thead><tbody><template x-for="b in bills" :key="b.supplierBillId"><tr><td><strong x-text="b.supplierInvoiceNumber"></strong><div class="crm-record-id" x-text="b.supplierBillId"></div></td><td x-text="supplierName(b.supplierId)"></td><td x-text="formatDateOnly(b.dueAt)"></td><td><span class="crm-status" :class="statusClass(b.paymentStatus)" x-text="humanize(b.paymentStatus)"></span></td><td class="text-end" x-text="money(b.totalPaise)"></td><td class="text-end" x-text="money(b.paidPaise)"></td><td class="text-end fw-semibold" x-text="money(b.outstandingPaise)"></td></tr></template><tr x-show="!bills.length"><td colspan="7"><div class="crm-empty-state"><strong>No supplier bills</strong></div></td></tr></tbody></table></div></div></div>
<div class="col-12"><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Payments</h2><p class="text-muted mb-0">Receipts, supplier payments and advances.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Date</th><th>Direction</th><th>Party</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th><th class="text-end">Unallocated</th><th>Reconciled</th><th></th></tr></thead><tbody><template x-for="p in payments" :key="p.paymentId"><tr><td x-text="formatDateOnly(p.paidAt)"></td><td><span class="crm-status" :class="p.direction==='receivable'?'status-paid':'status-pending'" x-text="p.direction==='receivable'?'Received':'Paid'"></span></td><td x-text="p.direction==='receivable'?customerName(p.customerId):supplierName(p.supplierId)"></td><td x-text="humanize(p.mode)"></td><td x-text="p.reference||'—'"></td><td class="text-end fw-semibold" x-text="money(p.amountPaise)"></td><td class="text-end" x-text="money(p.unallocatedPaise)"></td><td x-text="p.reconciled?'Yes':'No'"></td><td class="text-end"><% if (can('finance.reconcile')) { %><button x-show="!p.reconciled" class="btn btn-sm btn-outline-secondary" @click="reconcile(p)">Reconcile</button><% } %></td></tr></template></tbody></table></div></div></div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function financePage(){return{
invoices:[],bills:[],payments:[],customers:[],suppliers:[],orders:[],error:'',showPayment:false,invoiceOrderId:'',payment:{direction:'receivable',partyId:'',amountRupees:0,mode:'bank_transfer',paidAt:new Date().toISOString().slice(0,10),reference:'',documentId:''},
get receivableOutstanding(){return this.invoices.reduce((s,x)=>s+Number(x.outstandingPaise||0),0)},get payableOutstanding(){return this.bills.reduce((s,x)=>s+Number(x.outstandingPaise||0),0)},get invoiceEligibleOrders(){return this.orders.filter(o=>!['draft','cancelled'].includes(o.status))},
get paymentParties(){return this.payment.direction==='receivable'?this.customers:this.suppliers},
get paymentDocuments(){return this.payment.direction==='receivable'?this.invoices.filter(x=>x.customerId===this.payment.partyId&&Number(x.outstandingPaise)>0):this.bills.filter(x=>x.supplierId===this.payment.partyId&&Number(x.outstandingPaise)>0)},
customerName(id){return this.customers.find(x=>x.customerId===id)?.businessName||id},supplierName(id){return this.suppliers.find(x=>x.supplierId===id)?.businessName||id},documentLabel(d){return this.payment.direction==='receivable'?(d.invoiceNumber+' · '+money(d.outstandingPaise)):(d.supplierInvoiceNumber+' · '+money(d.outstandingPaise))},
async load(){try{const[i,b,p,c,s,o]=await Promise.all([apiFetch('/api/finance/invoices?limit=100'),apiFetch('/api/finance/supplier-bills?limit=100'),apiFetch('/api/finance/payments?limit=100'),apiFetch('/api/customers?limit=100'),apiFetch('/api/suppliers?limit=100'),apiFetch('/api/orders?limit=100')]);this.invoices=i.data.items||[];this.bills=b.data.items||[];this.payments=p.data.items||[];this.customers=c.data.items||[];this.suppliers=s.data.items||[];this.orders=o.data.items||[]}catch(e){this.error=e.message}},
async issueInvoice(){if(!this.invoiceOrderId)return;try{const x=(await apiFetch('/api/finance/invoices/order/'+this.invoiceOrderId,{method:'POST',body:'{}'})).data;showCrmToast('Invoice issued');location.href='/invoices/'+x.invoiceId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async recordPayment(){const p=this.payment;if(!p.partyId||Number(p.amountRupees)<=0)return this.error='Select a party and enter a payment amount.';const amountPaise=Math.round(Number(p.amountRupees)*100);const body={direction:p.direction,amountPaise,mode:p.mode,paidAt:p.paidAt,reference:p.reference,allocations:p.documentId?[{documentId:p.documentId,amountPaise}]:[]};if(p.direction==='receivable')body.customerId=p.partyId;else body.supplierId=p.partyId;try{await apiFetch('/api/finance/payments',{method:'POST',body:JSON.stringify(body)});showCrmToast('Payment recorded');this.showPayment=false;this.payment={direction:'receivable',partyId:'',amountRupees:0,mode:'bank_transfer',paidAt:new Date().toISOString().slice(0,10),reference:'',documentId:''};await this.load()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async reconcile(p){try{await apiFetch('/api/finance/payments/'+p.paymentId+'/reconcile',{method:'POST',body:'{}'});showCrmToast('Payment reconciled');await this.load()}catch(e){this.error=e.message}}
}}</script><%- include('partials/scripts') %>
</body></html>