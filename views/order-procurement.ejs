<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Sales order sourcing</div><h1 class="page-title mb-1">Allocate supplier demand</h1><p class="crm-page-subtitle mb-0">Source each product shortage while keeping the sales order and fulfilment warehouse connected.</p></div><a class="btn btn-light" :href="'/orders/'+(location.pathname.split('/')[2]||'')">Back to order</a></div></div>
<div class="content" x-data="orderProcurementPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<div class="card crm-data-card mb-4 crm-order-journey-card" x-show="order" x-cloak>
  <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Sourcing stage</h2><p class="text-muted mb-0">This order cannot move to warehouse picking until every required unit reaches stock-ready state.</p></div><div class="crm-order-current-stage-box"><span>Current stage</span><strong x-text="currentSourcingLabel()"></strong></div></div>
  <div class="card-body">
    <div class="crm-order-lifecycle crm-order-lifecycle-compact crm-order-lifecycle-four" role="list" aria-label="Sourcing and warehouse stages">
      <template x-for="(stage,index) in sourcingStages" :key="stage.label">
        <div class="crm-order-lifecycle-stage" role="listitem" :class="sourcingStageClass(index)">
          <span class="crm-order-lifecycle-node"><span x-show="index>=sourcingStageIndex()" x-text="index+1"></span><span x-show="index<sourcingStageIndex()">✓</span></span>
          <div><strong x-text="stage.label"></strong><small x-text="stage.note"></small></div>
        </div>
      </template>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-xl-7">
    <div class="card crm-data-card mb-4">
      <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1" x-text="crmValue(order,'orderNumber','Sales order')"></h2><p class="text-muted mb-0">Shortage by product and current sourcing coverage.</p></div></div>
      <div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Stage</th><th class="text-end">Order</th><th class="text-end">Reserved</th><th class="text-end">Need</th><th class="text-end">Allocated</th><th class="text-end">Remaining</th></tr></thead><tbody><template x-for="line in shortageLines" :key="line.salesOrderLineId"><tr :class="selectedLineId===line.salesOrderLineId?'table-active':''" @click="selectLine(line)"><td><strong x-text="line.productName"></strong><div class="text-muted fs-sm" x-text="line.sku"></div></td><td><span class="crm-product-stage-badge" :class="sourceStage(line).tone" x-text="sourceStage(line).label"></span></td><td class="text-end" x-text="line.quantity"></td><td class="text-end" x-text="line.stockReservedQty||0"></td><td class="text-end" x-text="line.procurementRequiredQty||0"></td><td class="text-end" x-text="allocated(line)"></td><td class="text-end fw-semibold" x-text="remaining(line)"></td></tr></template><tr x-show="!shortageLines.length"><td colspan="7"><div class="crm-empty-state"><strong>No procurement shortage</strong><span>Warehouse stock is sufficient for this sales order.</span></div></td></tr></tbody></table></div>
    </div>
    <div class="card crm-data-card">
      <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Existing supplier allocations</h2><p class="text-muted mb-0">Multiple allocations are allowed until the shortage quantity is fully covered.</p></div></div>
      <div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th>Supplier</th><th>Location</th><th class="text-end">Qty</th><th class="text-end">Buy price</th><th>Status</th></tr></thead><tbody><template x-for="a in allocations" :key="a.procurementAllocationId"><tr><td x-text="lineName(a.salesOrderLineId)"></td><td x-text="crmValue(a,'supplierSnapshot.businessName','Supplier')"></td><td x-text="joinTruthy([crmValue(a,'supplierLocationSnapshot.name',''),crmValue(a,'supplierLocationSnapshot.city','')])||'—'"></td><td class="text-end" x-text="a.quantity"></td><td class="text-end" x-text="money(a.purchasePricePaise)"></td><td><span class="crm-status" :class="statusClass(a.status)" x-text="humanize(a.status)"></span></td></tr></template><tr x-show="!allocations.length"><td colspan="6"><div class="crm-empty-state"><strong>No supplier allocation yet</strong></div></td></tr></tbody></table></div>
    </div>
  </div>

  <div class="col-xl-5">
    <div class="card crm-data-card sticky-xl-top" style="top:1rem">
      <div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Source selected product</h2><p class="text-muted mb-0" x-text="selectedLine?selectedLine.productName:'Select a shortage line'"></p></div></div>
      <div class="card-body"><template x-if="selectedLine"><div>
        <div class="crm-product-source-summary mb-3"><div><span>Required</span><strong x-text="selectedLine.procurementRequiredQty||0"></strong></div><div><span>Allocated</span><strong x-text="allocated(selectedLine)"></strong></div><div><span>Remaining</span><strong x-text="remaining(selectedLine)"></strong></div></div>
        <div class="mb-3"><label class="form-label">Supplier offers for this product</label><div class="vstack gap-2"><template x-for="o in offers" :key="o.supplierProductOfferId"><button type="button" class="btn btn-light text-start border" @click="useOffer(o)"><div class="d-flex justify-content-between gap-2"><strong x-text="o.supplierName||'Supplier'"></strong><strong x-text="money(o.purchasePricePaise)"></strong></div><div class="text-muted fs-sm"><span x-text="o.supplierLocationName||'Location'"></span><span> · MOQ </span><span x-text="o.moq||1"></span><span> · </span><span x-text="(o.leadTimeDays||0)+' day lead'"></span></div></button></template><div x-show="!offers.length" class="text-muted">No configured supplier offer. Select a supplier manually below.</div></div></div>
        <div class="row g-3"><div class="col-12"><label class="form-label">Supplier</label><select class="form-select" x-model="form.supplierId" @change="loadLocations()"><option value="">Select supplier</option><template x-for="s in suppliers" :key="s.supplierId"><option :value="s.supplierId" x-text="s.businessName"></option></template></select></div><div class="col-12"><label class="form-label">Supplier location</label><select class="form-select" x-model="form.supplierLocationId"><option value="">Select location</option><template x-for="l in locations" :key="l.supplierLocationId"><option :value="l.supplierLocationId" x-text="joinTruthy([l.name,l.city,l.state])"></option></template></select></div><div class="col-4"><label class="form-label">Quantity</label><input type="number" min="1" class="form-control" x-model.number="form.quantity"></div><div class="col-4"><label class="form-label">Buy price ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.purchasePriceRupees"></div><div class="col-4"><label class="form-label">GST %</label><input type="number" min="0" max="100" step="0.01" class="form-control" x-model.number="form.gstPercent"></div></div>
        <button class="btn btn-primary w-100 mt-4" type="button" @click="saveAllocation()" :disabled="saving||remaining(selectedLine)<=0" x-text="saving?'Saving…':'Add supplier allocation'"></button>
      </div></template><div x-show="!selectedLine" class="text-muted">Choose a product shortage from the table to compare supplier offers.</div></div>
    </div>
  </div>
</div>

</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function orderProcurementPage(){return{
orderId:location.pathname.split('/')[2]||'',order:null,allocations:[],suppliers:[],offers:[],locations:[],selectedLineId:'',saving:false,error:'',form:{supplierId:'',supplierLocationId:'',supplierProductOfferId:'',quantity:1,purchasePriceRupees:0,gstPercent:18},
sourcingStages:[
  {label:'Shortage identified',note:'Warehouse demand gap'},
  {label:'Supplier allocation',note:'Choose source & quantity'},
  {label:'Supplier receipt',note:'Stock arrives to warehouse'},
  {label:'Stock ready',note:'Continue to picking'}
],
get shortageLines(){return(this.order?.lines||[]).filter(x=>Number(x.procurementRequiredQty||0)>0)},
get selectedLine(){return this.shortageLines.find(x=>x.salesOrderLineId===this.selectedLineId)||null},
async load(){try{const[o,s]=await Promise.all([apiFetch('/api/orders/'+this.orderId),apiFetch('/api/suppliers?limit=100')]);this.order=o.data;this.allocations=(o.data.procurementAllocations||[]).filter(x=>x.status!=='cancelled');this.suppliers=s.data.items||[];const first=this.shortageLines.find(x=>this.remaining(x)>0)||this.shortageLines[0];if(first)await this.selectLine(first)}catch(e){this.error=e.message}},
allocated(line){return this.allocations.filter(x=>x.salesOrderLineId===line.salesOrderLineId).reduce((s,x)=>s+Number(x.quantity||0),0)},
remaining(line){return Math.max(0,Number(line?.procurementRequiredQty||0)-this.allocated(line||{}))},
lineName(id){return this.order?.lines?.find(x=>x.salesOrderLineId===id)?.productName||'Product'},
sourceStage(line){const need=Number(line?.procurementRequiredQty||0),allocated=this.allocated(line||{});if(need<=0)return{label:'No shortage',tone:'is-success'};if(allocated<=0)return{label:'Needs supplier',tone:'is-warning'};if(allocated<need)return{label:'Partially sourced',tone:'is-warning'};return{label:'Fully allocated',tone:'is-success'}},
sourcingStageIndex(){
  if(this.order?.status==='stock_ready'||['picking','packed','ready_for_dispatch','assigned_for_delivery','out_for_delivery','delivered','partially_delivered'].includes(this.order?.status))return 3;
  if(!this.shortageLines.length)return 3;
  const totalNeed=this.shortageLines.reduce((sum,line)=>sum+Number(line.procurementRequiredQty||0),0),totalAllocated=this.shortageLines.reduce((sum,line)=>sum+this.allocated(line),0);
  if(totalAllocated<=0)return 0;
  if(totalAllocated<totalNeed)return 1;
  return 2;
},
sourcingStageClass(index){const current=this.sourcingStageIndex();if(index<current)return'is-complete';if(index===current)return'is-active';return'is-upcoming'},
currentSourcingLabel(){return this.sourcingStages[this.sourcingStageIndex()]?.label||'Sourcing'},
async selectLine(line){this.selectedLineId=line.salesOrderLineId;this.offers=[];this.resetForm();try{this.offers=(await apiFetch('/api/products/'+line.productId+'/supplier-offers')).data||[]}catch(e){this.error=e.message}},
resetForm(){this.locations=[];this.form={supplierId:'',supplierLocationId:'',supplierProductOfferId:'',quantity:1,purchasePriceRupees:0,gstPercent:18}},
async loadLocations(){this.form.supplierLocationId='';this.locations=[];if(!this.form.supplierId)return;try{const s=(await apiFetch('/api/suppliers/'+this.form.supplierId)).data;this.locations=(s.locations||[]).filter(x=>x.active!==false)}catch(e){this.error=e.message}},
async useOffer(o){this.form={supplierId:o.supplierId,supplierLocationId:o.supplierLocationId,supplierProductOfferId:o.supplierProductOfferId,quantity:Math.max(1,Math.min(this.remaining(this.selectedLine),Number(o.moq||1))),purchasePriceRupees:Number(o.purchasePricePaise||0)/100,gstPercent:Number(o.gstRateBps||0)/100};await this.loadLocations();this.form.supplierLocationId=o.supplierLocationId},
async saveAllocation(){const line=this.selectedLine,f=this.form;if(!line||!f.supplierId||!f.supplierLocationId)return this.error='Select a product, supplier and supplier location.';if(Number(f.quantity)<1||Number(f.quantity)>this.remaining(line))return this.error='Quantity must fit the remaining procurement requirement.';this.saving=true;try{await apiFetch('/api/orders/'+this.orderId+'/procurement',{method:'POST',body:JSON.stringify({salesOrderLineId:line.salesOrderLineId,supplierId:f.supplierId,supplierLocationId:f.supplierLocationId,supplierProductOfferId:f.supplierProductOfferId||'',quantity:Number(f.quantity),purchasePricePaise:Math.round(Number(f.purchasePriceRupees||0)*100),gstRateBps:Math.round(Number(f.gstPercent||0)*100)})});showCrmToast('Supplier allocation added');const data=(await apiFetch('/api/orders/'+this.orderId)).data;this.order=data;this.allocations=(data.procurementAllocations||[]).filter(x=>x.status!=='cancelled');this.resetForm();if(this.remaining(line)>0)await this.selectLine(this.order.lines.find(x=>x.salesOrderLineId===line.salesOrderLineId));else{const next=this.shortageLines.find(x=>this.remaining(x)>0);if(next)await this.selectLine(next)}}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}
}}</script><%- include('partials/scripts') %>
</body></html>
