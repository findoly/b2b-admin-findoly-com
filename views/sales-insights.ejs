<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1">Sales insights</h1><p class="crm-page-subtitle mb-0">See which categories and products drive demand.</p></div></div></div>
<div class="content" x-data="salesInsightsPage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak role="alert" class="alert alert-danger" x-text="error"></div>
<form class="card" @submit.prevent="search()"><div class="card-body"><div class="row g-3"><div class="col-sm-6 col-lg-2"><label class="form-label" for="insight-from">From</label><input id="insight-from" type="date" class="form-control" x-model="from" required></div><div class="col-sm-6 col-lg-2"><label class="form-label" for="insight-to">To</label><input id="insight-to" type="date" class="form-control" x-model="to" required></div><div class="col-sm-6 col-lg-3"><label class="form-label" for="insight-mode">Measure</label><select id="insight-mode" class="form-select" x-model="mode"><option value="orders">Order demand</option><option value="invoices">Invoiced sales</option></select></div><div class="col-sm-6 col-lg-2"><label class="form-label" for="insight-group">Group by</label><select id="insight-group" class="form-select" x-model="dimension"><option value="category">Category</option><option value="subcategory">Subcategory</option><option value="product">Product</option></select></div><div class="col-sm-6 col-lg-3"><label class="form-label" for="insight-rank">Rank by</label><select id="insight-rank" class="form-select" x-model="metric"><option value="valuePaise">Value before GST</option><option value="orderCount">Order / invoice count</option><option value="units">Units</option></select></div></div><div class="d-flex gap-2 flex-wrap mt-3"><button class="btn btn-primary" :disabled="loading">Apply filters</button><button type="button" class="btn btn-light" x-show="categoryId || subcategoryId" @click="clearDrill()">All categories</button><a href="/reports" class="btn btn-light">Business reports</a><span class="align-self-center text-muted" x-text="drillLabel"></span></div></div></form>
<p class="text-muted" x-text="explanation()"></p><div class="alert alert-light border">Older orders without category snapshots appear as Unclassified / historical. Values are before GST and before return credits; use Finance for settled balances. Dates use India Standard Time.</div>
<div x-show="loading" class="p-3" role="status">Loading sales insights…</div>
<div class="row g-3 mb-3"><template x-for="card in cards()" :key="card.label"><div class="col-sm-4"><div class="card mb-0"><div class="card-body"><div class="text-muted" x-text="card.label"></div><strong class="crm-stat-value" x-text="card.value"></strong></div></div></template></div>
<div class="card"><div class="card-header"><h2 class="card-title mb-1">Sales ranking</h2><p class="text-muted mb-0">Select a category to see its products.</p></div><div class="card-body"><div x-show="!loading && !items.length" class="crm-empty-state"><strong>No matching sales</strong><span>Try another date range or measure.</span></div><div class="crm-ranking" role="list"><template x-for="row in items" :key="row.key"><div class="crm-ranking-row" role="listitem"><button class="btn btn-link p-0 text-start" @click="drill(row)" :disabled="!canDrill(row)" x-text="row.label"></button><div class="crm-ranking-track" aria-hidden="true"><span :style="barStyle(row)"></span></div><strong x-text="metricValue(row)"></strong></div></template></div></div>
<div class="table-responsive"><table class="table crm-table crm-mobile-records mb-0"><thead><tr><th>Name</th><th>Category / SKU</th><th x-text="resultMode==='orders'?'Orders':'Invoices'"></th><th>Units</th><th class="text-end">Value before GST</th></tr></thead><tbody><template x-for="row in items" :key="row.key"><tr><td x-text="row.label"></td><td x-text="row.sku || row.category || '—'"></td><td x-text="row.orderCount"></td><td x-text="row.units"></td><td class="text-end" x-text="money(row.valuePaise)"></td></tr></template></tbody></table></div><div class="card-footer d-flex gap-2 align-items-center"><button class="btn btn-light" @click="move(-1)" :disabled="page<=1 || loading">Previous</button><span x-text="'Page '+page+' of '+pages"></span><button class="btn btn-light ms-auto" @click="move(1)" :disabled="page>=pages || loading">Next</button></div></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function salesInsightsPage(){return{from:'',to:'',mode:'orders',dimension:'category',metric:'valuePaise',categoryId:'',subcategoryId:'',drillLabel:'',items:[],totals:{orderCount:0,units:0,valuePaise:0},page:1,pages:1,error:'',loading:false,request:0,resultMode:'orders',resultMetric:'valuePaise',resultDimension:'category',
async load(){this.to=new Date(Date.now()+330*60000).toISOString().slice(0,10);this.from=new Date(Date.now()+330*60000-29*86400000).toISOString().slice(0,10);await this.fetch();},
async fetch(){const version=++this.request;this.loading=true;this.error='';try{const data=(await apiFetch('/api/reports/sales-insights?'+new URLSearchParams({from:this.from,to:this.to,mode:this.mode,dimension:this.dimension,metric:this.metric,categoryId:this.categoryId,subcategoryId:this.subcategoryId,page:this.page}))).data;if(version!==this.request)return;this.items=data.items;this.totals=data.totals;this.pages=data.pages;this.resultMode=data.mode;this.resultMetric=data.metric;this.resultDimension=data.dimension;}catch(e){if(version===this.request){this.error=e.message;this.items=[];this.totals={orderCount:0,units:0,valuePaise:0};}}finally{if(version===this.request)this.loading=false;}},
search(){this.page=1;return this.fetch();},move(n){this.page+=n;return this.fetch();},
explanation(){return this.resultMode==='orders'?'Order demand counts non-draft, non-cancelled sales orders, excluding replacements. It includes orders awaiting approval or delivery.':'Invoiced sales counts issued invoices by invoice creation date. It does not represent cash collected.';},
cards(){return[{label:this.resultMode==='orders'?'Orders':'Invoices',value:this.totals.orderCount},{label:'Units',value:this.totals.units},{label:'Value before GST',value:money(this.totals.valuePaise)}];},
metricValue(row){return this.resultMetric==='valuePaise'?money(row.valuePaise):String(row[this.resultMetric]);},barStyle(row){const max=Math.max(1,...this.items.map(x=>Number(x[this.resultMetric]||0)));return 'width:'+Math.max(0,Math.min(100,Number(row[this.resultMetric]||0)/max*100))+'%';},
canDrill(row){return this.resultDimension!=='product' && Boolean(row.categoryId);},drill(row){if(!this.canDrill(row))return;this.categoryId=row.categoryId;this.subcategoryId=this.resultDimension==='subcategory'?row.subcategoryId:'';this.drillLabel=row.label;this.dimension='product';return this.search();},clearDrill(){this.categoryId='';this.subcategoryId='';this.drillLabel='';this.dimension='category';return this.search();}
};}
</script><%- include('partials/scripts') %>
</body></html>