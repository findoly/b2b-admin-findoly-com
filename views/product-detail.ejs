<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Catalogue</div><h1 class="page-title mb-1" x-text="crmValue(product,'name','Product')"></h1><p class="crm-page-subtitle mb-0"><span x-text="crmValue(product,'sku','')"></span><span x-show="crmValue(product,'brand','')"> · </span><span x-text="crmValue(product,'brand','')||''"></span></p></div><div class="d-flex gap-2"><a class="btn btn-light" href="/products">Back</a><% if (can('products.edit')) { %><a class="btn btn-primary" :href="'/products/'+productId+'/edit'">Edit product</a><% } %></div></div></div>
<div class="content" x-data="productDetailPage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<template x-if="loading"><div class="card crm-data-card"><div class="card-body"><div class="crm-table-loading"><span></span><span></span><span></span></div></div></div></template>
<div x-show="product&&!loading" x-cloak>
<div class="row g-4">
<div class="col-xl-7">
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Product description</h2><p class="text-muted mb-0">Rendered from server-sanitized HTML.</p></div><span class="crm-status" :class="statusClass(crmValue(product,'status',''))" x-text="humanize(crmValue(product,'status',''))"></span></div><div class="card-body"><div x-show="crmValue(product,'descriptionHtml','')" x-effect="setSafeHtml($el, crmValue(product,'descriptionHtml',''))"></div><div x-show="!crmValue(product,'descriptionHtml','')" class="text-muted" x-text="crmValue(product,'description','No description added.')"></div></div></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Photo gallery</h2><p class="text-muted mb-0">Multiple images are attached to the same product; one can be the primary image.</p></div></div><div class="card-body">
<div x-show="activeImages.length"><div class="text-center border rounded p-3 mb-3"><img class="img-fluid rounded" :src="mediaUrl(currentImage)" :alt="crmValue(currentImage,'label',crmValue(product,'name',''))"></div><div class="d-flex flex-wrap gap-2"><template x-for="m in activeImages" :key="m.productMediaId"><button type="button" class="btn btn-light p-1" :class="crmValue(currentImage,'productMediaId','')===m.productMediaId?'border-primary':''" @click="currentImageId=m.productMediaId"><img :src="mediaUrl(m)" :alt="m.label||m.fileName" width="84" height="84" style="object-fit:cover"></button></template></div></div>
<div class="crm-empty-state" x-show="!activeImages.length"><strong>No product photos</strong><span>Upload one or more product images below.</span></div>
<% if (can('products.media')) { %><div class="border-top mt-4 pt-4"><div class="row g-3 align-items-end"><div class="col-md-8"><label class="form-label" for="product-photos">Upload product photos</label><input id="product-photos" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple @change="files=eventFiles($event)"></div><div class="col-md-4"><button class="btn btn-outline-primary w-100" @click="uploadImages()" :disabled="!files.length||uploading" x-text="uploading?'Uploading…':'Upload photos'"></button></div></div><div class="crm-upload-progress" x-show="uploading && uploadKind==='images'" x-cloak role="status" aria-live="polite"><span x-text="'Uploading photos: '+uploadProgress+'%'"></span><progress class="w-100" max="100" :value="uploadProgress" aria-label="Photo upload progress"></progress></div></div><% } %>
<div class="table-responsive mt-4" x-show="activeImages.length"><table class="table crm-table align-middle mb-0"><thead><tr><th>Image</th><th>Role</th><th class="text-end">Actions</th></tr></thead><tbody><template x-for="m in activeImages" :key="m.productMediaId"><tr><td><span x-text="m.label||m.fileName"></span></td><td x-text="m.isPrimary?'Primary':'Gallery'"></td><td class="text-end crm-table-actions"><% if (can('products.media')) { %><button class="btn btn-sm btn-light" x-show="!m.isPrimary" @click="makePrimary(m)">Make primary</button><button class="btn btn-sm btn-outline-danger" @click="hideMedia(m)">Remove</button><% } %></td></tr></template></tbody></table></div>
</div></div>
</div>
<div class="col-xl-5">
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><h2 class="card-title mb-0">Product master</h2></div><div class="card-body"><dl class="row mb-0"><dt class="col-5">SKU</dt><dd class="col-7" x-text="crmValue(product,'sku','')"></dd><dt class="col-5">Barcode</dt><dd class="col-7" x-text="crmValue(product,'barcode','—')"></dd><dt class="col-5">Category</dt><dd class="col-7" x-text="joinTruthy([crmValue(product,'category',''),crmValue(product,'subcategory','')],' / ')||'—'"></dd><dt class="col-5">Manufacturer</dt><dd class="col-7" x-text="crmValue(product,'manufacturer','—')"></dd><dt class="col-5">Unit</dt><dd class="col-7" x-text="crmValue(product,'unit','piece')"></dd><dt class="col-5">Pack / carton</dt><dd class="col-7" x-text="Number(crmValue(product,'packSize',1))+' / '+Number(crmValue(product,'cartonSize',1))"></dd><dt class="col-5">GST</dt><dd class="col-7" x-text="(Number(crmValue(product,'gstRateBps',0))/100)+'%'"></dd><dt class="col-5">MRP</dt><dd class="col-7" x-text="money(crmValue(product,'mrpPaise',0))"></dd><dt class="col-5">Reference</dt><dd class="col-7" x-text="money(crmValue(product,'referenceSellingPricePaise',0))"></dd><dt class="col-5">Minimum</dt><dd class="col-7" x-text="money(crmValue(product,'minimumSellingPricePaise',0))"></dd></dl></div></div>
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Documents</h2><p class="text-muted mb-0">Brochures, certificates and specifications remain separate from the photo gallery.</p></div></div><div class="card-body"><div class="d-grid gap-2"><template x-for="m in activeDocuments" :key="m.productMediaId"><button class="btn btn-light text-start" @click="openMedia(m)" x-text="m.label||m.fileName"></button></template><div class="text-muted" x-show="!activeDocuments.length">No documents attached.</div></div><% if (can('products.media')) { %><div class="border-top mt-3 pt-3"><label class="form-label" for="product-document">Attach document</label><input id="product-document" class="form-control mb-2" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt" @change="documentFile=eventFirstFile($event)"><button class="btn btn-outline-primary" @click="uploadDocument()" :disabled="!documentFile||uploading" x-text="uploading && uploadKind==='document' ? 'Uploading document…' : 'Upload document'">Upload document</button><div class="crm-upload-progress" x-show="uploading && uploadKind==='document'" x-cloak role="status" aria-live="polite"><span x-text="'Uploading document: '+uploadProgress+'%'"></span><progress class="w-100" max="100" :value="uploadProgress" aria-label="Document upload progress"></progress></div></div><% } %></div></div>
<% if (can('suppliers.view')) { %><div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier comparison</h2><p class="text-muted mb-0">Current supplier/location offers for this SKU.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Supplier</th><th class="text-end">Buy price</th><th>MOQ</th><th>Lead</th></tr></thead><tbody><template x-for="o in offers" :key="o.supplierProductOfferId"><tr><td><strong x-text="o.supplierName||'Supplier'"></strong><div class="text-muted fs-sm" x-text="o.supplierLocationName||''"></div></td><td class="text-end" x-text="money(o.purchasePricePaise)"></td><td x-text="o.moq||1"></td><td x-text="(o.leadTimeDays||0)+' days'"></td></tr></template><tr x-show="!offers.length"><td colspan="4"><div class="crm-empty-state"><strong>No supplier offers</strong></div></td></tr></tbody></table></div></div><% } %>
</div>
</div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function productDetailPage(){return{
productId:'',product:null,offers:[],loading:true,uploading:false,uploadProgress:0,uploadKind:'',error:'',files:[],documentFile:null,mediaUrls:{},currentImageId:'',
get activeImages(){return(this.product?.media||[]).filter(m=>m.active!==false&&m.kind==='image').sort((a,b)=>Number(a.sortOrder||0)-Number(b.sortOrder||0))},get activeDocuments(){return(this.product?.media||[]).filter(m=>m.active!==false&&m.kind==='document').sort((a,b)=>Number(a.sortOrder||0)-Number(b.sortOrder||0))},get currentImage(){return this.activeImages.find(m=>m.productMediaId===this.currentImageId)||this.activeImages.find(m=>m.isPrimary)||this.activeImages[0]||null},
async load(){this.productId=decodeURIComponent(location.pathname.split('/').filter(Boolean)[1]||'');try{await this.reloadProduct();<% if (can('suppliers.view')) { %>this.offers=(await apiFetch('/api/products/'+this.productId+'/supplier-offers')).data||[];<% } %>}catch(e){this.error=e.message}finally{this.loading=false}},
async reloadProduct(){this.product=(await apiFetch('/api/products/'+this.productId)).data;await this.loadMediaUrls();const primary=this.activeImages.find(m=>m.isPrimary)||this.activeImages[0];this.currentImageId=primary?.productMediaId||''},
async loadMediaUrls(){this.mediaUrls={};const media=(this.product?.media||[]).filter(m=>m.active!==false);await Promise.all(media.map(async m=>{try{const x=(await apiFetch('/api/products/media/download-url',{method:'POST',body:JSON.stringify({key:m.key})})).data;this.mediaUrls[m.productMediaId]=x.url}catch(_){this.mediaUrls[m.productMediaId]=''}}))},
mediaUrl(m){return m?this.mediaUrls[m.productMediaId]||'':''},
async uploadOne(file,kind,onProgress){const signed=(await apiFetch('/api/products/media/upload-url',{method:'POST',body:JSON.stringify({kind,fileName:this.productId+'-'+Date.now()+'-'+file.name,contentType:file.type||'application/octet-stream',sizeBytes:file.size})})).data;await putPresignedUpload(signed,file,onProgress);await apiFetch('/api/products/'+this.productId+'/media',{method:'POST',body:JSON.stringify({kind,key:signed.key,fileName:file.name,contentType:file.type,label:file.name})})},
async uploadImages(){if(!this.files.length||this.uploading)return;this.uploading=true;this.uploadKind='images';this.uploadProgress=0;this.error='';try{let completed=0;const total=this.files.length;for(const file of this.files){await this.uploadOne(file,'image',percent=>{this.uploadProgress=Math.round((completed+percent/100)*100/total)});completed++;this.uploadProgress=Math.round(completed*100/total)}this.files=[];showCrmToast('Product photos uploaded');await this.reloadProduct()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.uploading=false}},
async uploadDocument(){if(!this.documentFile||this.uploading)return;this.uploading=true;this.uploadKind='document';this.uploadProgress=0;this.error='';try{await this.uploadOne(this.documentFile,'document',percent=>{this.uploadProgress=percent});this.uploadProgress=100;this.documentFile=null;showCrmToast('Product document uploaded');await this.reloadProduct()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.uploading=false}},
async makePrimary(m){try{await apiFetch('/api/products/'+this.productId+'/media/'+m.productMediaId,{method:'PUT',body:JSON.stringify({isPrimary:true})});showCrmToast('Primary image updated');await this.reloadProduct()}catch(e){this.error=e.message}},
async hideMedia(m){try{await apiFetch('/api/products/'+this.productId+'/media/'+m.productMediaId,{method:'PUT',body:JSON.stringify({active:false,isPrimary:false})});showCrmToast('Media removed from product');await this.reloadProduct()}catch(e){this.error=e.message}},
async openMedia(m){const url=this.mediaUrl(m);if(url)window.open(url,'_blank','noopener')}
}}</script><%- include('partials/scripts') %>
</body></html>
