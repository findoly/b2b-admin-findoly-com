<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Sourcing</div><h1 class="page-title mb-1">Suppliers</h1><p class="crm-page-subtitle mb-0">Supplier accounts, locations, SKU offers and purchase-price history.</p></div><% if (can('suppliers.create')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-supplier')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New supplier</button><% } %></div></div>
<div class="content" x-data="suppliersPage()" x-init="load()" @new-supplier.window="showSupplierForm=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<% if (can('suppliers.create')) { %>
<div class="card crm-data-card mb-4" x-show="showSupplierForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">New supplier</h2><p class="text-muted mb-0">Create the supplier master first, then add one or more supply locations.</p></div><button class="btn btn-light btn-sm" @click="showSupplierForm=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-4"><label class="form-label">Business name</label><input class="form-control" x-model="supplierForm.businessName"></div>
<div class="col-lg-4"><label class="form-label">Contact name</label><input class="form-control" x-model="supplierForm.contactName"></div>
<div class="col-lg-4"><label class="form-label">Mobile</label><input class="form-control" x-model="supplierForm.mobile" inputmode="numeric" maxlength="10"></div>
<div class="col-md-4"><label class="form-label">Email</label><input type="email" class="form-control" x-model="supplierForm.email"></div>
<div class="col-md-4"><label class="form-label">GSTIN</label><input class="form-control" x-model="supplierForm.gstin"></div>
<div class="col-md-4"><label class="form-label">Payment term days</label><input type="number" min="0" class="form-control" x-model.number="supplierForm.paymentTermDays"></div>
<div class="col-12"><label class="form-label">Supplier documents</label><input class="form-control" type="file" @change="uploadNewSupplierDocument($event)" accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt"><div class="d-flex flex-wrap gap-2 mt-2"><template x-for="(key,index) in supplierForm.documentKeys||[]" :key="key"><span class="badge bg-light text-dark border d-inline-flex align-items-center gap-2"><span x-text="attachmentName(key)"></span><button type="button" class="btn-close" aria-label="Remove" @click="supplierForm.documentKeys.splice(index,1)"></button></span></template></div></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="createSupplier()">Create supplier</button></div></div></div>
<% } %>

<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Suppliers</h2><p class="text-muted mb-0">Select a supplier to manage locations and sourcing offers.</p></div><div class="d-flex gap-2"><input class="form-control form-control-sm" placeholder="Search supplier" x-model="search" @keyup.enter="searchSuppliers()"><button class="btn btn-light btn-sm" @click="searchSuppliers()">Search</button></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Supplier</th><th>Contact</th><th>GSTIN</th><th>Payment terms</th><th>Status</th><th class="text-end">Manage</th></tr></thead><tbody>
<template x-for="s in suppliers" :key="s.supplierId"><tr><td><strong x-text="s.businessName"></strong><div class="crm-record-id" x-text="s.supplierId"></div></td><td><span x-text="s.mobile"></span><div class="text-muted fs-sm" x-text="s.email||''"></div></td><td x-text="s.gstin||'—'"></td><td x-text="(s.paymentTermDays||0)+' days'"></td><td><span class="crm-status" :class="statusClass(s.status)" x-text="humanize(s.status)"></span></td><td class="text-end"><button class="btn btn-sm btn-outline-primary" @click="selectSupplier(s)">Manage</button></td></tr></template>
<tr x-show="!suppliers.length"><td colspan="6"><div class="crm-empty-state"><strong>No suppliers found</strong></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>

<div x-show="selected" x-cloak>
<div class="row g-4 mb-4">
<% if (can('suppliers.edit')) { %>
<div class="col-lg-5"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier locations</h2><p class="text-muted mb-0" x-text="crmValue(selected,'businessName','')"></p></div></div><div class="card-body">
<div class="mb-4"><label class="form-label">Supplier documents</label><input class="form-control" type="file" @change="uploadSelectedSupplierDocument($event)" accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt"><div class="d-flex flex-wrap gap-2 mt-2"><template x-for="(key,index) in crmList(selected,'documentKeys')" :key="key"><span class="badge bg-light text-dark border d-inline-flex align-items-center gap-2"><button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @click="openSupplierDocument(key)" x-text="attachmentName(key)"></button><button type="button" class="btn-close" aria-label="Remove" @click="removeSelectedSupplierDocument(index)"></button></span></template><span class="text-muted fs-sm" x-show="!crmList(selected,'documentKeys').length">No supplier documents uploaded.</span></div></div>
<div class="mb-3" x-show="locations.length"><template x-for="l in locations" :key="l.supplierLocationId"><div class="border rounded p-2 mb-2"><div class="fw-semibold" x-text="l.name"></div><div class="text-muted fs-sm" x-text="joinTruthy([l.line1,l.city,l.state,l.pincode],', ')"></div><div class="crm-record-id" x-text="l.supplierLocationId"></div></div></template></div>
<div class="row g-2"><div class="col-12"><input class="form-control" placeholder="Location name" x-model="locationForm.name"></div><div class="col-12"><input class="form-control" placeholder="Address line 1" x-model="locationForm.line1"></div><div class="col-4"><input class="form-control" placeholder="City" x-model="locationForm.city"></div><div class="col-4"><input class="form-control" placeholder="State" x-model="locationForm.state"></div><div class="col-4"><input class="form-control" placeholder="Pincode" x-model="locationForm.pincode"></div></div><button class="btn btn-outline-primary mt-3" @click="addLocation()">Add location</button>
</div></div></div>
<% } %>

<% if (can('suppliers.pricing')) { %>
<div class="col-lg-7"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Supplier product offer</h2><p class="text-muted mb-0">Location-specific purchase price, MOQ, GST and lead time.</p></div></div><div class="card-body"><div class="row g-3">
<div class="col-md-6"><label class="form-label">Supplier location</label><select class="form-select" x-model="offerForm.supplierLocationId"><option value="">Select location</option><template x-for="l in locations" :key="l.supplierLocationId"><option :value="l.supplierLocationId" x-text="joinTruthy([l.name,l.city])"></option></template></select></div>
<div class="col-md-6"><label class="form-label">Product</label><div class="input-group mb-2"><input class="form-control" placeholder="Search product" x-model="productSearch" @keyup.enter="searchProducts()"><button class="btn btn-light" type="button" @click="searchProducts()">Find</button></div><select class="form-select" x-model="offerForm.productId"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></div>
<div class="col-md-3"><label class="form-label">Buy price ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="offerForm.purchasePriceRupees"></div>
<div class="col-md-3"><label class="form-label">GST %</label><input type="number" min="0" max="100" step="0.01" class="form-control" x-model.number="offerForm.gstPercent"></div>
<div class="col-md-3"><label class="form-label">MOQ</label><input type="number" min="1" class="form-control" x-model.number="offerForm.moq"></div>
<div class="col-md-3"><label class="form-label">Lead time days</label><input type="number" min="0" class="form-control" x-model.number="offerForm.leadTimeDays"></div>
<div class="col-md-4"><label class="form-label">Pack quantity</label><input type="number" min="1" class="form-control" x-model.number="offerForm.packQuantity"></div>
<div class="col-md-4"><label class="form-label">Price valid until</label><input type="date" class="form-control" x-model="offerForm.priceValidUntil"></div>
<div class="col-md-4"><label class="form-label">Price-change reason</label><input class="form-control" x-model="offerForm.reason"></div>
</div><button class="btn btn-primary mt-3" @click="saveOffer()">Save supplier offer</button></div></div></div>
<% } %>
</div>

<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Purchase price history</h2><p class="text-muted mb-0">Every supplier buy-price change is retained as history.</p></div><button class="btn btn-light btn-sm" @click="loadHistory()">Refresh</button></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Effective</th><th>Product</th><th>Location</th><th class="text-end">Old price</th><th class="text-end">New price</th><th>GST</th><th>Changed by</th><th>Reason</th></tr></thead><tbody>
<template x-for="h in history" :key="h.purchasePriceHistoryId"><tr><td x-text="formatDate(h.effectiveAt)"></td><td><strong x-text="productName(h.productId)"></strong><div class="text-muted fs-sm" x-text="productSku(h.productId)"></div></td><td x-text="locationName(h.supplierLocationId)"></td><td class="text-end" x-text="h.oldPurchasePricePaise===null?'—':money(h.oldPurchasePricePaise)"></td><td class="text-end fw-semibold" x-text="money(h.newPurchasePricePaise)"></td><td x-text="h.gstCharged?((Number(h.gstRateBps||0)/100)+'%'):'Not charged'"></td><td class="small" x-text="h.updatedBy"></td><td x-text="h.reason||'—'"></td></tr></template>
<tr x-show="!history.length"><td colspan="8"><div class="crm-empty-state"><strong>No purchase price history yet</strong><span>History appears when supplier offers are created or repriced.</span></div></td></tr>
</tbody></table></div></div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function suppliersPage(){return{
...crmPager('loadSuppliers'),suppliers:[],products:[],selected:null,locations:[],history:[],error:'',search:'',productSearch:'',showSupplierForm:false,
supplierForm:{businessName:'',contactName:'',mobile:'',email:'',gstin:'',paymentTermDays:0,documentKeys:[]},
locationForm:{name:'',line1:'',city:'',state:'Maharashtra',pincode:''},
offerForm:{supplierLocationId:'',productId:'',purchasePriceRupees:0,gstPercent:18,moq:1,packQuantity:1,leadTimeDays:0,priceValidUntil:'',reason:''},
async load(){try{const p=await apiFetch('/api/products?limit=50');this.products=p.data.items||[];await this.loadSuppliers()}catch(e){this.error=e.message}},async searchProducts(){try{this.products=(await apiFetch('/api/products?limit=100&search='+encodeURIComponent(this.productSearch))).data.items||[]}catch(e){this.error=e.message}},
async loadSuppliers(){try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.search)q.set('search',this.search);const data=(await apiFetch('/api/suppliers?'+q)).data;this.suppliers=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}},searchSuppliers(){this.resetPage();return this.loadSuppliers()},
async uploadNewSupplierDocument(event){const file=event.target.files?.[0];if(!file)return;try{const uploaded=await uploadBusinessAttachment('suppliers',file);this.supplierForm.documentKeys=[...(this.supplierForm.documentKeys||[]),uploaded.key];showCrmToast('Supplier document uploaded')}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{event.target.value=''}},async uploadSelectedSupplierDocument(event){const file=event.target.files?.[0];if(!file||!this.selected)return;try{const uploaded=await uploadBusinessAttachment('suppliers',file),documentKeys=[...(this.selected.documentKeys||[]),uploaded.key];this.selected=(await apiFetch('/api/suppliers/'+this.selected.supplierId,{method:'PUT',body:JSON.stringify({documentKeys})})).data;showCrmToast('Supplier document uploaded')}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{event.target.value=''}},async removeSelectedSupplierDocument(index){if(!this.selected)return;const documentKeys=[...(this.selected.documentKeys||[])];documentKeys.splice(index,1);try{this.selected=(await apiFetch('/api/suppliers/'+this.selected.supplierId,{method:'PUT',body:JSON.stringify({documentKeys})})).data;showCrmToast('Supplier document removed from record')}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},async openSupplierDocument(key){try{await openBusinessAttachment('suppliers',key)}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},async createSupplier(){if(!this.supplierForm.businessName||!this.supplierForm.mobile)return this.error='Business name and mobile are required.';try{const s=(await apiFetch('/api/suppliers',{method:'POST',body:JSON.stringify(this.supplierForm)})).data;showCrmToast('Supplier created');this.showSupplierForm=false;this.supplierForm={businessName:'',contactName:'',mobile:'',email:'',gstin:'',paymentTermDays:0,documentKeys:[]};await this.loadSuppliers();await this.selectSupplier(s)}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async selectSupplier(s){try{this.selected=(await apiFetch('/api/suppliers/'+s.supplierId)).data;this.locations=this.selected.locations||[];await this.loadHistory()}catch(e){this.error=e.message}},
async addLocation(){if(!this.selected||!this.locationForm.name||!this.locationForm.line1)return this.error='Complete the supplier location.';try{await apiFetch('/api/suppliers/'+this.selected.supplierId+'/locations',{method:'POST',body:JSON.stringify(this.locationForm)});showCrmToast('Supplier location added');this.locationForm={name:'',line1:'',city:'',state:'Maharashtra',pincode:''};await this.selectSupplier(this.selected)}catch(e){this.error=e.message}},
async saveOffer(){if(!this.selected||!this.offerForm.supplierLocationId||!this.offerForm.productId)return this.error='Select supplier location and product.';try{await apiFetch('/api/suppliers/offers',{method:'POST',body:JSON.stringify({supplierId:this.selected.supplierId,supplierLocationId:this.offerForm.supplierLocationId,productId:this.offerForm.productId,purchasePricePaise:Math.round(Number(this.offerForm.purchasePriceRupees||0)*100),gstCharged:true,gstRateBps:Math.round(Number(this.offerForm.gstPercent||0)*100),moq:Number(this.offerForm.moq||1),packQuantity:Number(this.offerForm.packQuantity||1),leadTimeDays:Number(this.offerForm.leadTimeDays||0),priceValidUntil:this.offerForm.priceValidUntil||null,reason:this.offerForm.reason})});showCrmToast('Supplier offer saved');await this.loadHistory()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async loadHistory(){if(!this.selected){this.history=[];return}try{this.history=(await apiFetch('/api/suppliers/price-history?supplierId='+this.selected.supplierId+'&limit=100')).data.items||[]}catch(e){this.error=e.message}},
productName(id){return this.products.find(x=>x.productId===id)?.name||id},productSku(id){return this.products.find(x=>x.productId===id)?.sku||''},locationName(id){return this.locations.find(x=>x.supplierLocationId===id)?.name||id}
}}</script><%- include('partials/scripts') %>
</body></html>