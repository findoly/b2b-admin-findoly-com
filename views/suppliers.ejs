<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="suppliersPage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3">
<div class="col-xl-4"><div class="card"><div class="card-header fw-semibold">New supplier</div><div class="card-body"><input class="form-control mb-2" placeholder="Business name" x-model="supplier.businessName"><input class="form-control mb-2" placeholder="Contact" x-model="supplier.contactName"><input class="form-control mb-2" placeholder="Mobile" x-model="supplier.mobile"><input class="form-control mb-2" placeholder="GSTIN" x-model="supplier.gstin"><input class="form-control mb-2" type="number" placeholder="Payment term days" x-model.number="supplier.paymentTermDays"><button class="btn btn-primary" @click="createSupplier()">Create supplier</button></div></div>
<div class="card mt-3"><div class="card-header fw-semibold">Add supplier location</div><div class="card-body"><input class="form-control mb-2" placeholder="Supplier ID" x-model="location.supplierId"><input class="form-control mb-2" placeholder="Location name" x-model="location.name"><input class="form-control mb-2" placeholder="Address" x-model="location.line1"><div class="row g-2"><div class="col"><input class="form-control" placeholder="City" x-model="location.city"></div><div class="col"><input class="form-control" placeholder="State" x-model="location.state"></div><div class="col"><input class="form-control" placeholder="Pincode" x-model="location.pincode"></div></div><button class="btn btn-outline-primary mt-2" @click="createLocation()">Add location</button></div></div></div>
<div class="col-xl-8"><div class="card"><div class="card-header fw-semibold">Suppliers</div><div class="scroll-table"><table class="table mb-0"><thead><tr><th>Business</th><th>Contact</th><th>GSTIN</th><th>Terms</th><th>Status</th></tr></thead><tbody><template x-for="s in items" :key="s.supplierId"><tr @click="location.supplierId=s.supplierId;offer.supplierId=s.supplierId" style="cursor:pointer"><td><strong x-text="s.businessName"></strong><div class="small text-secondary" x-text="s.supplierId"></div></td><td x-text="s.mobile"></td><td x-text="s.gstin||'—'"></td><td x-text="(s.paymentTermDays||0)+' days'"></td><td x-text="s.status"></td></tr></template></tbody></table></div></div>
<div class="card mt-3"><div class="card-header fw-semibold">Supplier + Location + Product offer</div><div class="card-body"><div class="row g-2"><div class="col-md-6"><input class="form-control" placeholder="Supplier ID" x-model="offer.supplierId"></div><div class="col-md-6"><input class="form-control" placeholder="Supplier location ID" x-model="offer.supplierLocationId"></div><div class="col-md-6"><input class="form-control" placeholder="Product ID" x-model="offer.productId"></div><div class="col-md-3"><input class="form-control" type="number" placeholder="Buy paise" x-model.number="offer.purchasePricePaise"></div><div class="col-md-3"><input class="form-control" type="number" placeholder="GST bps" x-model.number="offer.gstRateBps"></div><div class="col-md-3"><input class="form-control" type="number" placeholder="MOQ" x-model.number="offer.moq"></div><div class="col-md-3"><input class="form-control" type="number" placeholder="Lead days" x-model.number="offer.leadTimeDays"></div><div class="col-12"><button class="btn btn-outline-primary" @click="saveOffer()">Save offer & price history</button></div></div></div></div>
<div class="card mt-3"><div class="card-header d-flex justify-content-between"><strong>Purchase price history</strong><button class="btn btn-sm btn-outline-secondary" @click="history()">Refresh</button></div><pre class="small p-3 mb-0" style="max-height:25vh;overflow:auto" x-text="JSON.stringify(priceHistory,null,2)"></pre></div>
</div></div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function suppliersPage(){return{items:[],priceHistory:null,error:'',supplier:{businessName:'',contactName:'',mobile:'',gstin:'',paymentTermDays:0},location:{supplierId:'',name:'',line1:'',city:'',state:'Maharashtra',pincode:''},offer:{supplierId:'',supplierLocationId:'',productId:'',purchasePricePaise:0,gstCharged:true,gstRateBps:1800,moq:1,leadTimeDays:0},async load(){try{this.items=(await apiFetch('/api/suppliers')).data.items}catch(e){this.error=e.message}},async createSupplier(){try{const x=(await apiFetch('/api/suppliers',{method:'POST',body:JSON.stringify(this.supplier)})).data;this.location.supplierId=x.supplierId;this.offer.supplierId=x.supplierId;await this.load()}catch(e){this.error=e.message}},async createLocation(){try{const x=(await apiFetch('/api/suppliers/'+this.location.supplierId+'/locations',{method:'POST',body:JSON.stringify(this.location)})).data;this.offer.supplierLocationId=x.supplierLocationId}catch(e){this.error=e.message}},async saveOffer(){try{await apiFetch('/api/suppliers/offers',{method:'POST',body:JSON.stringify(this.offer)});await this.history()}catch(e){this.error=e.message}},async history(){try{this.priceHistory=(await apiFetch('/api/suppliers/price-history?limit=50')).data}catch(e){this.error=e.message}}}}</script></body></html>