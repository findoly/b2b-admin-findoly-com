<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Inventory</div><h1 class="page-title mb-1">Manual inventory adjustment</h1><p class="crm-page-subtitle mb-0">Use only for audited corrections. Normal stock movement should come from procurement, fulfilment, delivery or returns.</p></div><a class="btn btn-light" href="/inventory">Back to inventory</a></div></div>
<div class="content" x-data="inventoryAdjustPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div class="card crm-data-card"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Warehouse</label><select class="form-select" x-model="form.warehouseId"><option value="">Select warehouse</option><template x-for="w in warehouses" :key="w.warehouseId"><option :value="w.warehouseId" x-text="w.name+' ('+w.code+')'"></option></template></select></div><div class="col-md-6"><label class="form-label">Product</label><div class="input-group mb-2"><input class="form-control" placeholder="Search product" x-model="search" @keyup.enter="searchProducts()"><button class="btn btn-light" @click="searchProducts()">Find</button></div><select class="form-select" x-model="form.productId"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></div><div class="col-md-4"><label class="form-label">Stock bucket</label><select class="form-select" x-model="form.bucket"><option value="available">Available</option><option value="damaged">Damaged</option><option value="returned">Returned</option></select></div><div class="col-md-4"><label class="form-label">Quantity change</label><input type="number" class="form-control" x-model.number="form.quantityDelta" placeholder="+5 or -2"></div><div class="col-md-4"><label class="form-label">Reason</label><input class="form-control" x-model="form.reason" placeholder="Required correction reason"></div></div><div class="text-end mt-4"><button class="btn btn-primary" @click="save()">Save audited adjustment</button></div></div></div></div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function inventoryAdjustPage(){return{warehouses:[],products:[],search:'',error:'',form:{warehouseId:'',productId:'',bucket:'available',quantityDelta:0,reason:''},async load(){try{const[w,p]=await Promise.all([apiFetch('/api/warehouses'),apiFetch('/api/products?limit=100')]);this.warehouses=w.data.items||[];this.products=p.data.items||[]}catch(e){this.error=e.message}},async searchProducts(){this.products=(await apiFetch('/api/products?limit=100&search='+encodeURIComponent(this.search))).data.items||[]},async save(){if(!this.form.warehouseId||!this.form.productId||!Number(this.form.quantityDelta)||!this.form.reason.trim())return this.error='Warehouse, product, non-zero quantity and reason are required.';try{await apiFetch('/api/inventory/adjustments',{method:'POST',body:JSON.stringify(this.form)});showCrmToast('Inventory adjusted');location.href='/inventory/movements'}catch(e){this.error=e.message;showCrmToast(e.message,'error')}}}}</script><%- include('partials/scripts') %>
</body></html>
