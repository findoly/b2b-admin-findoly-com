<!doctype html><html><head><%- include('partials/head') %></head><body><div class="app-shell"><%- include('partials/sidebar') %><main class="main"><%- include('partials/navbar') %><div class="content"><div x-data="auditPage()" x-init="load()"><div class="d-flex gap-2 mb-3"><input class="form-control" placeholder="Entity type" x-model="entityType"><input class="form-control" placeholder="Entity ID" x-model="entityId"><button class="btn btn-outline-secondary" @click="load()">Filter</button></div><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="card"><div class="scroll-table"><table class="table mb-0"><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Entity</th><th>Summary</th></tr></thead><tbody><template x-for="x in items" :key="x.auditLogId"><tr><td x-text="shortDate(x.createdAt)"></td><td class="small" x-text="x.actorEmployeeId"></td><td x-text="x.action"></td><td><span x-text="x.entityType"></span><div class="small text-secondary" x-text="x.entityId"></div></td><td x-text="x.summary||'—'"></td></tr></template></tbody></table></div></div></div></div></main></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function auditPage(){return{items:[],entityType:'',entityId:'',error:'',async load(){try{const q=new URLSearchParams();if(this.entityType)q.set('entityType',this.entityType);if(this.entityId)q.set('entityId',this.entityId);this.items=(await apiFetch('/api/audit?'+q)).data.items}catch(e){this.error=e.message}}}}</script></body></html>