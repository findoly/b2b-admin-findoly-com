<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="auditPage()" x-init="load()"><div class="d-flex gap-2 mb-3"><input class="form-control" placeholder="Entity type" x-model="entityType"><input class="form-control" placeholder="Entity ID" x-model="entityId"><button class="btn btn-outline-secondary" @click="load()">Filter</button></div><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="card crm-data-card"><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Entity</th><th>Summary</th></tr></thead><tbody><template x-for="x in items" :key="x.auditLogId"><tr><td x-text="shortDate(x.createdAt)"></td><td class="small" x-text="x.actorEmployeeId"></td><td x-text="x.action"></td><td><span x-text="x.entityType"></span><div class="small text-secondary" x-text="x.entityId"></div></td><td x-text="x.summary||'—'"></td></tr></template></tbody></table></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function auditPage(){return{items:[],entityType:'',entityId:'',error:'',async load(){try{const q=new URLSearchParams();if(this.entityType)q.set('entityType',this.entityType);if(this.entityId)q.set('entityId',this.entityId);this.items=(await apiFetch('/api/audit?'+q)).data.items}catch(e){this.error=e.message}}}}</script></body></html>