<!doctype html><html lang="en" dir="ltr"><%- include('partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %><div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner"><div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Findoly B2B</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0"><%= subtitle || '' %></p></div></div></div><div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="storagePage()" x-init="load()"><div class="alert alert-danger" x-show="error" x-text="error" x-cloak></div><div class="row g-3"><div class="col-lg-6"><div class="card crm-data-card"><div class="card-header fw-semibold">Upload file</div><div class="card-body"><select class="form-select mb-2" x-model="prefix"><option value="public/b2b/products/">Public product media</option><option value="private/b2b/products/">Private product docs</option><option value="private/b2b/suppliers/">Supplier docs</option><option value="private/b2b/invoices/">Invoice/source docs</option><option value="private/b2b/returns/">Return evidence</option></select><input class="form-control" type="file" @change="file=$event.target.files[0]"><button class="btn btn-primary mt-2" @click="upload()" :disabled="!file">Upload</button><div class="small text-secondary mt-2" x-text="lastKey"></div></div></div></div><div class="col-lg-6"><div class="card crm-data-card"><div class="card-header fw-semibold">Open/download by S3 key</div><div class="card-body"><input class="form-control" placeholder="private/b2b/..." x-model="downloadKey"><button class="btn btn-outline-primary mt-2" @click="download()">Create download link</button><a class="d-block mt-2" x-show="downloadUrl" :href="downloadUrl" target="_blank" rel="noopener">Open file</a></div></div><div class="card mt-3"><div class="card-body"><div class="small text-secondary">S3 status</div><pre class="small mb-0" x-text="JSON.stringify(config,null,2)"></pre></div></div></div></div></div></div><%- include('partials/footer') %></div></div></div><%- include('partials/scripts') %><script nonce="<%= cspNonce %>">function storagePage(){return{config:{},file:null,prefix:'public/b2b/products/',lastKey:'',downloadKey:'',downloadUrl:'',error:'',async load(){try{this.config=(await apiFetch('/api/storage/config')).data}catch(e){this.error=e.message}},async upload(){try{const name=Date.now()+'-'+this.file.name;const x=(await apiFetch('/api/storage/upload-url',{method:'POST',body:JSON.stringify({prefix:this.prefix,fileName:name,contentType:this.file.type||'application/octet-stream',sizeBytes:this.file.size})})).data;const r=await fetch(x.url,{method:'PUT',headers:x.headers,body:this.file});if(!r.ok)throw new Error('S3 upload failed');this.lastKey=x.key}catch(e){this.error=e.message}},async download(){try{const x=(await apiFetch('/api/storage/download-url',{method:'POST',body:JSON.stringify({key:this.downloadKey})})).data;this.downloadUrl=x.url}catch(e){this.error=e.message}}}}</script></body></html>