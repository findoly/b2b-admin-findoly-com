<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Administration</div><h1 class="page-title mb-1">File Manager</h1><p class="crm-page-subtitle mb-0">Upload and retrieve B2B product, supplier, invoice and return documents from S3.</p></div></div></div>
<div class="content" x-data="storagePage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

<div class="row g-4 mb-4">
<div class="col-md-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Storage status</div><div class="d-flex align-items-center gap-2 mt-2"><span class="crm-status" :class="config.configured?'status-paid':'status-pending'" x-text="config.configured?'Configured':'Not configured'"></span></div><div class="text-muted fs-sm mt-3">Region</div><div class="fw-semibold" x-text="config.region||'—'"></div></div></div></div>
<div class="col-md-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Bucket</div><div class="fw-semibold mt-2" x-text="config.bucket||'—'"></div><div class="text-muted fs-sm mt-3">Upload limit</div><div class="fw-semibold" x-text="config.maxUploadMb?config.maxUploadMb+' MB':'—'"></div></div></div></div>
<div class="col-md-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Public delivery</div><div class="fw-semibold mt-2" x-text="config.cloudFrontDomain||'Direct S3 / presigned access'"></div><div class="text-muted fs-sm mt-3">Prefixes</div><div class="small"><span x-text="config.publicPrefix||'—'"></span><br><span x-text="config.privatePrefix||'—'"></span></div></div></div></div>
</div>

<div class="row g-4">
<% if (can('storage.manage')) { %>
<div class="col-lg-6"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Upload file</h2><p class="text-muted mb-0">The browser uploads directly to S3 using a short-lived signed URL.</p></div></div><div class="card-body">
<label class="form-label">Destination</label><select class="form-select mb-3" x-model="prefix"><option value="public/b2b/products/">Public product media</option><option value="private/b2b/products/">Private product documents</option><option value="private/b2b/suppliers/">Supplier documents</option><option value="private/b2b/invoices/">Invoice/source documents</option><option value="private/b2b/returns/">Return evidence</option></select>
<label class="form-label">File</label><input class="form-control" type="file" @change="file=$event.target.files[0]">
<div class="d-flex align-items-center gap-2 mt-3"><button class="btn btn-primary" @click="upload()" :disabled="!file||uploading" x-text="uploading?'Uploading…':'Upload file'"></button><span class="text-success fs-sm" x-show="lastKey" x-text="'Uploaded: '+lastKey"></span></div>
</div></div></div>
<% } %>
<div class="col-lg-6"><div class="card crm-data-card h-100"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Open or download file</h2><p class="text-muted mb-0">Enter an approved B2B S3 key to generate a secure link.</p></div></div><div class="card-body">
<label class="form-label">S3 key</label><input class="form-control" placeholder="private/b2b/..." x-model="downloadKey">
<button class="btn btn-outline-primary mt-3" @click="download()" :disabled="!downloadKey">Create secure link</button>
<div class="alert alert-success mt-3 mb-0" x-show="downloadUrl" x-cloak><div class="fw-semibold">Link ready</div><a :href="downloadUrl" target="_blank" rel="noopener">Open file in a new tab</a></div>
</div></div></div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function storagePage(){return{
config:{},file:null,prefix:'public/b2b/products/',lastKey:'',downloadKey:'',downloadUrl:'',uploading:false,error:'',
async load(){try{this.config=(await apiFetch('/api/storage/config')).data||{}}catch(e){this.error=e.message}},
async upload(){if(!this.file)return;this.uploading=true;try{const name=Date.now()+'-'+this.file.name;const x=(await apiFetch('/api/storage/upload-url',{method:'POST',body:JSON.stringify({prefix:this.prefix,fileName:name,contentType:this.file.type||'application/octet-stream',sizeBytes:this.file.size})})).data;const r=await fetch(x.url,{method:'PUT',headers:x.headers,body:this.file});if(!r.ok)throw new Error('S3 upload failed');this.lastKey=x.key;showCrmToast('File uploaded')}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.uploading=false}},
async download(){try{const x=(await apiFetch('/api/storage/download-url',{method:'POST',body:JSON.stringify({key:this.downloadKey})})).data;this.downloadUrl=x.url}catch(e){this.error=e.message;showCrmToast(e.message,'error')}}
}}</script><%- include('partials/scripts') %>
</body></html>