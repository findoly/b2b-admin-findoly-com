<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Sales</div><h1 class="page-title mb-1">Customer pricing</h1><p class="crm-page-subtitle mb-0">Manage negotiated customer × SKU prices and approval history.</p></div><% if (can('pricing.manage')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-price')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New negotiated price</button><% } %></div></div>
<div class="content" x-data="pricingPage()" x-init="load()" @new-price.window="showForm=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<% if (can('pricing.manage')) { %>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Negotiated price</h2><p class="text-muted mb-0">Prices below the product minimum are blocked. Discounts may require approval.</p></div><button class="btn btn-light btn-sm" @click="showForm=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-4"><label class="form-label" for="price-customer">Customer</label><div class="input-group mb-2"><input class="form-control" aria-label="Find customer by name" placeholder="Search customer" x-model="customerSearch" @keyup.enter="searchCustomers()"><button class="btn btn-light" type="button" @click="searchCustomers()">Find</button></div><select id="price-customer" class="form-select" x-model="form.customerId"><option value="">Select customer</option><template x-for="c in customers" :key="c.customerId"><option :value="c.customerId" x-text="c.businessName+' · '+c.mobile"></option></template></select></div>
<div class="col-lg-4"><label class="form-label" for="price-product">Product</label><div class="input-group mb-2"><input class="form-control" aria-label="Find product for pricing" placeholder="Search product" x-model="productSearch" @keyup.enter="searchProducts()"><button class="btn btn-light" type="button" @click="searchProducts()">Find</button></div><select id="price-product" class="form-select" x-model="form.productId"><option value="">Select product</option><template x-for="p in products" :key="p.productId"><option :value="p.productId" x-text="p.name+' · '+p.sku"></option></template></select></div>
<div class="col-lg-2"><label class="form-label" for="price-field-1">Negotiated price ₹</label><input id="price-field-1" type="number" min="0" step="0.01" class="form-control" x-model.number="form.unitPriceRupees"></div>
<div class="col-lg-2"><label class="form-label" for="price-field-2">Minimum quantity</label><input id="price-field-2" type="number" min="1" class="form-control" x-model.number="form.minimumQuantity"></div>
<div class="col-md-4"><label class="form-label" for="price-field-3">Valid from</label><input id="price-field-3" type="date" class="form-control" x-model="form.validFrom"></div>
<div class="col-md-4"><label class="form-label" for="price-field-4">Valid until</label><input id="price-field-4" type="date" class="form-control" x-model="form.validUntil"></div>
<div class="col-md-4"><label class="form-label" for="price-field-5">Reason / negotiation note</label><input id="price-field-5" class="form-control" x-model="form.reason" placeholder="Optional"></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="createPrice()" :disabled="priceSaving" x-text="priceSaving?'Saving price…':'Save negotiated price'">Save negotiated price</button></div></div></div>
<% } %>
<section class="card crm-filter-card mb-3"><div class="crm-filter-bar"><label class="crm-filter-field crm-filter-field-wide"><span>Approval</span><select aria-label="Negotiated price approval filter" x-model="approvalFilter" @change="filterPrices()"><option value="">All approvals</option><option value="pending">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="expired">Expired</option></select></label><div class="crm-filter-actions"><button class="btn btn-primary" @click="loadPrices()">Refresh</button></div></div></section>
<div class="crm-filter-summary mb-3" x-show="approvalFilter" x-cloak role="status" aria-live="polite"><span>Negotiated prices filtered by approval status</span><button type="button" class="btn btn-light btn-sm" @click="approvalFilter='';filterPrices()">Clear filters</button></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Customer-specific prices</h2><p class="text-muted mb-0">Active and historical agreements.</p></div></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Customer</th><th>Product</th><th class="text-end">Price</th><th class="text-end">MOQ</th><th>Validity</th><th>Status</th><th>Negotiated by</th><th class="text-end">Actions</th></tr></thead><tbody>
<template x-for="x in prices" :key="x.customerProductPriceId"><tr><td><strong x-text="customerName(x.customerId)"></strong></td><td><strong x-text="productName(x.productId)"></strong><div class="text-muted fs-sm" x-text="productSku(x.productId)"></div></td><td class="text-end fw-semibold" x-text="money(x.unitPricePaise)"></td><td class="text-end" x-text="x.minimumQuantity"></td><td><span x-text="formatDateOnly(x.validFrom)"></span><span x-show="x.validUntil"> → <span x-text="formatDateOnly(x.validUntil)"></span></span></td><td><span class="crm-status" :class="statusClass(x.approvalStatus)" x-text="humanize(x.approvalStatus)"></span></td><td class="small" x-text="x.negotiatedBy"></td><td class="text-end crm-table-actions"><% if (can('pricing.approve')) { %><button x-show="x.approvalStatus==='pending'" class="btn btn-sm btn-outline-primary" @click="decide(x,'approved')">Approve</button><button x-show="x.approvalStatus==='pending'" class="btn btn-sm btn-outline-danger" @click="decide(x,'rejected')">Reject</button><% } %></td></tr></template>
<tr x-show="!loading && !prices.length"><td colspan="8"><div class="crm-empty-state"><strong>No negotiated prices found</strong><span>Create a customer-specific price when a sales negotiation is agreed.</span></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function pricingPage(){return{
...crmPager('loadPrices'),prices:[],customers:[],products:[],loading:true,error:'',showForm:false,priceSaving:false,approvalFilter:'',customerSearch:'',productSearch:'',form:{customerId:'',productId:'',unitPriceRupees:0,minimumQuantity:1,validFrom:new Date().toISOString().slice(0,10),validUntil:'',reason:''},
async load(){try{const[c,p]=await Promise.all([apiFetch('/api/customers?limit=50'),apiFetch('/api/products?limit=50')]);this.customers=c.data.items||[];this.products=p.data.items||[];await this.loadPrices()}catch(e){this.error=e.message}finally{this.loading=false}},async searchCustomers(){try{this.customers=(await apiFetch('/api/customers?limit=100&search='+encodeURIComponent(this.customerSearch))).data.items||[]}catch(e){this.error=e.message}},async searchProducts(){try{this.products=(await apiFetch('/api/products?limit=100&search='+encodeURIComponent(this.productSearch))).data.items||[]}catch(e){this.error=e.message}},
async loadPrices(){this.loading=true;try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.approvalFilter)q.set('approvalStatus',this.approvalFilter);const data=(await apiFetch('/api/pricing?'+q)).data;this.prices=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},filterPrices(){this.resetPage();return this.loadPrices()},
customerName(id){return this.customers.find(x=>x.customerId===id)?.businessName||id},productName(id){return this.products.find(x=>x.productId===id)?.name||id},productSku(id){return this.products.find(x=>x.productId===id)?.sku||''},
async createPrice(){if(this.priceSaving)return;this.error='';if(!this.form.customerId||!this.form.productId)return this.error='Customer and product are required.';this.priceSaving=true;try{await apiFetch('/api/pricing',{method:'POST',body:JSON.stringify({customerId:this.form.customerId,productId:this.form.productId,unitPricePaise:Math.round(Number(this.form.unitPriceRupees||0)*100),minimumQuantity:Number(this.form.minimumQuantity||1),validFrom:this.form.validFrom||undefined,validUntil:this.form.validUntil||null,reason:this.form.reason})});showCrmToast('Negotiated price saved');this.showForm=false;this.form={customerId:'',productId:'',unitPriceRupees:0,minimumQuantity:1,validFrom:new Date().toISOString().slice(0,10),validUntil:'',reason:''};await this.loadPrices()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.priceSaving=false}},
async decide(x,status){try{await apiFetch('/api/pricing/'+x.customerProductPriceId+'/decision',{method:'POST',body:JSON.stringify({status})});showCrmToast('Pricing decision saved');await this.loadPrices()}catch(e){this.error=e.message}}
}}</script><%- include('partials/scripts') %>
</body></html>