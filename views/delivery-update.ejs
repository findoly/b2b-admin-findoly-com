<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Delivery workflow</div><h1 class="page-title mb-1">Update delivery</h1><p class="crm-page-subtitle mb-0">Move the delivery through one valid operational step at a time.</p></div><a class="btn btn-light" :href="'/delivery/'+deliveryId">Back to delivery</a></div></div>
<div class="content" x-data="deliveryUpdatePage()" x-init="load()">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<template x-if="loading"><div class="card crm-data-card"><div class="card-body"><div class="crm-table-loading"><span></span><span></span><span></span></div></div></div></template>
<div x-show="delivery&&!loading" x-cloak>
<div class="card crm-data-card mb-4"><div class="card-body"><div class="row g-2"><template x-for="(label,index) in steps" :key="label"><div class="col-4"><button type="button" class="btn w-100" :class="step===index+1?'btn-primary':'btn-light'" :disabled="index+1>step" @click="step=index+1"><span class="me-1" x-text="index+1"></span><span x-text="label"></span></button></div></template></div></div></div>

<div class="card crm-data-card" x-show="step===1" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">1. Select next status</h2><p class="text-muted mb-0"><span x-text="crmValue(delivery,'orderNumber','')"></span> · current status <strong x-text="humanize(crmValue(delivery,'status',''))"></strong></p></div></div><div class="card-body">
<div class="row g-3"><template x-for="s in allowedStatuses(crmValue(delivery,'status',''))" :key="s"><div class="col-md-6 col-xl-4"><button type="button" class="btn w-100 py-3" :class="form.status===s?'btn-primary':'btn-outline-primary'" @click="selectStatus(s)" x-text="humanize(s)"></button></div></template></div>
<div class="alert alert-warning mt-3 mb-0" x-show="!allowedStatuses(crmValue(delivery,'status','')).length">This delivery has reached a final state and has no further status transitions.</div>
<div class="text-end mt-4"><button class="btn btn-primary" @click="next()" :disabled="!form.status">Continue</button></div>
</div></div>

<div class="card crm-data-card" x-show="step===2" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">2. Status details</h2><p class="text-muted mb-0" x-text="'Preparing: '+humanize(form.status)"></p></div></div><div class="card-body">
<div class="alert alert-info" x-show="form.status==='out_for_delivery'">Confirming this step dispatches all mapped product quantities from the packed warehouse stock.</div>
<div class="alert alert-warning" x-show="form.status==='returned'">Returned quantities will be restored to the warehouse returned-stock bucket.</div>
<div class="alert alert-warning" x-show="form.status==='cancelled'">The sales order will return to ready-for-dispatch.</div>
<div class="row g-3"><div class="col-12"><label class="form-label">Status note</label><textarea class="form-control" rows="3" maxlength="1000" x-model="form.note" placeholder="Optional operational note"></textarea></div>
<div class="col-12" x-show="form.status==='failed'"><label class="form-label">Failure reason</label><input class="form-control" maxlength="1000" x-model="form.failureReason" placeholder="Required reason for failed delivery"></div>
<template x-if="['delivered','partially_delivered'].includes(form.status)"><div class="col-12"><div class="row g-3"><div class="col-md-6"><label class="form-label">Collected amount ₹</label><input type="number" min="0" step="0.01" class="form-control" x-model.number="form.collectedRupees"></div><div class="col-md-6"><label class="form-label">Collection mode</label><select class="form-select" x-model="form.collectionMode"><option value="">Not recorded</option><option value="cash">Cash</option><option value="upi">UPI</option><option value="bank_transfer">Bank transfer</option><option value="card">Card</option><option value="cheque">Cheque</option></select></div></div></div></template>
</div>
<div class="mt-4" x-show="form.status==='partially_delivered'" x-cloak><div class="alert alert-info">Enter delivered quantity for every product. Returned quantity is calculated automatically.</div><div class="table-responsive"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Product</th><th>SKU</th><th class="text-end">Taken</th><th style="width:170px">Delivered</th><th class="text-end">Returned</th></tr></thead><tbody><template x-for="line in lines" :key="line.deliveryLineId"><tr><td><a :href="'/products/'+line.productId" x-text="line.productName"></a></td><td x-text="line.sku"></td><td class="text-end" x-text="line.quantity"></td><td><input type="number" min="0" :max="line.quantity" class="form-control" x-model.number="line.deliveredQty" @input="recalculate(line)"></td><td class="text-end fw-semibold" x-text="line.returnedQty"></td></tr></template></tbody></table></div></div>
<div class="d-flex justify-content-between mt-4"><button class="btn btn-light" @click="step=1">Back</button><button class="btn btn-primary" @click="next()">Review</button></div>
</div></div>

<div class="card crm-data-card" x-show="step===3" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">3. Review & confirm</h2><p class="text-muted mb-0">The change is applied transactionally with the existing order and inventory rules.</p></div></div><div class="card-body">
<div class="row g-3"><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Current</div><strong x-text="humanize(crmValue(delivery,'status',''))"></strong></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Next</div><strong x-text="humanize(form.status)"></strong></div></div><div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted fs-sm">Order</div><strong x-text="crmValue(delivery,'orderNumber','')"></strong></div></div></div>
<div x-show="form.status==='partially_delivered'" class="table-responsive mt-4"><table class="table crm-table crm-mobile-records align-middle mb-0"><thead><tr><th>Product</th><th class="text-end">Delivered</th><th class="text-end">Returned</th></tr></thead><tbody><template x-for="line in lines" :key="line.deliveryLineId"><tr><td x-text="line.productName"></td><td class="text-end" x-text="line.deliveredQty"></td><td class="text-end" x-text="line.returnedQty"></td></tr></template></tbody></table></div>
<div class="mt-3" x-show="form.failureReason"><strong>Failure reason:</strong> <span x-text="form.failureReason"></span></div><div class="mt-2" x-show="form.note"><strong>Note:</strong> <span x-text="form.note"></span></div>
<div class="d-flex justify-content-between mt-4"><button class="btn btn-light" @click="step=2">Back</button><button class="btn btn-primary" @click="save()" :disabled="saving" x-text="saving?'Saving…':'Confirm status change'"></button></div>
</div></div>
</div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">
function deliveryUpdatePage(){return{
steps:['Status','Details','Review'],step:1,delivery:null,deliveryId:'',loading:true,saving:false,error:'',lines:[],form:{status:'',collectedRupees:0,collectionMode:'',note:'',failureReason:''},
transitionMap:{assigned:['picked_up','cancelled'],picked_up:['out_for_delivery','cancelled'],out_for_delivery:['delivered','partially_delivered','failed','returned'],failed:['out_for_delivery','returned'],delivered:[],partially_delivered:[],returned:[],cancelled:[]},
allowedStatuses(s){return this.transitionMap[s]||[]},async load(){this.deliveryId=decodeURIComponent(location.pathname.split('/').filter(Boolean)[1]||'');try{this.delivery=(await apiFetch('/api/delivery/'+this.deliveryId)).data;this.form.collectedRupees=Number(this.delivery.collectedPaise||0)/100;this.form.collectionMode=this.delivery.collectionMode||'';this.lines=(this.delivery.lines||[]).map(line=>({...line,deliveredQty:Number(line.deliveredQty||0),returnedQty:Number(line.returnedQty||0)}))}catch(e){this.error=e.message}finally{this.loading=false}},
selectStatus(s){this.form.status=s;this.form.failureReason='';if(s==='partially_delivered')this.lines=(this.delivery.lines||[]).map(line=>({...line,deliveredQty:Number(line.deliveredQty||0),returnedQty:Math.max(0,Number(line.quantity)-Number(line.deliveredQty||0))}))},
recalculate(line){let qty=Number(line.deliveredQty||0);if(!Number.isFinite(qty))qty=0;qty=Math.max(0,Math.min(Number(line.quantity||0),Math.trunc(qty)));line.deliveredQty=qty;line.returnedQty=Math.max(0,Number(line.quantity||0)-qty)},
next(){this.error='';if(this.step===1&&!this.form.status)return this.error='Select the next status.';if(this.step===2){if(this.form.status==='failed'&&!this.form.failureReason.trim())return this.error='Failure reason is required.';if(this.form.status==='partially_delivered'){let delivered=0,returned=0;for(const line of this.lines){this.recalculate(line);delivered+=Number(line.deliveredQty||0);returned+=Number(line.returnedQty||0)}if(delivered<=0||returned<=0)return this.error='A partial delivery must contain both delivered and returned quantities.';}}this.step=Math.min(3,this.step+1);window.scrollTo({top:0,behavior:'smooth'})},
async save(){this.saving=true;this.error='';try{const body={status:this.form.status,collectedPaise:Math.round(Number(this.form.collectedRupees||0)*100),collectionMode:this.form.collectionMode,note:this.form.note,failureReason:this.form.failureReason};if(this.form.status==='partially_delivered')body.lines=this.lines.map(line=>({deliveryLineId:line.deliveryLineId,salesOrderLineId:line.salesOrderLineId,deliveredQty:Number(line.deliveredQty||0),returnedQty:Number(line.returnedQty||0)}));await apiFetch('/api/delivery/'+this.deliveryId+'/status',{method:'POST',body:JSON.stringify(body)});showCrmToast('Delivery status updated');location.href='/delivery/'+this.deliveryId}catch(e){this.error=e.message;showCrmToast(e.message,'error')}finally{this.saving=false}}
}}</script><%- include('partials/scripts') %>
</body></html>
