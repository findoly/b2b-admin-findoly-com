<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Purchase order</div><h1 class="page-title mb-1">Supplier purchase order</h1><p class="crm-page-subtitle mb-0">Supplier, warehouse, product lines and the sales-order demand this PO is fulfilling.</p></div><a class="btn btn-light" href="/procurement">Back to purchase orders</a></div></div>
<div class="content" x-data="procurementDetailPage()" x-init="load()"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="po" x-cloak>
<div class="row g-4 mb-4"><div class="col-lg-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Purchase order</div><h2 class="h5" x-text="po?.poNumber"></h2><span class="crm-status" :class="statusClass(po?.status)" x-text="humanize(po?.status)"></span></div></div></div><div class="col-lg-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Supplier</div><h2 class="h5" x-text="po?.supplierName"></h2><div x-text="[po?.supplierLocationSnapshot?.name,po?.supplierLocationSnapshot?.city].filter(Boolean).join(' · ')"></div></div></div></div><div class="col-lg-4"><div class="card crm-data-card h-100"><div class="card-body"><div class="text-muted fs-sm">Receiving warehouse</div><h2 class="h5" x-text="warehouse?.name||'—'"></h2><div x-text="warehouse?.code||''"></div></div></div></div></div>
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Products</h2><p class="text-muted mb-0">Purchase quantities and receiving progress.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Product</th><th class="text-end">Ordered</th><th class="text-end">Received</th><th class="text-end">Short</th><th class="text-end">Buy price</th></tr></thead><tbody><template x-for="l in po?.lines||[]" :key="l.purchaseOrderLineId"><tr><td><strong x-text="l.productName"></strong><div class="text-muted fs-sm" x-text="l.sku"></div></td><td class="text-end" x-text="l.quantity"></td><td class="text-end" x-text="l.receivedQuantity||0"></td><td class="text-end" x-text="l.shortQuantity||0"></td><td class="text-end" x-text="money(l.unitPurchasePricePaise)"></td></tr></template></tbody></table></div></div>
<div class="card crm-data-card mb-4"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Linked sales-order demand</h2><p class="text-muted mb-0">This makes the supplier purchase traceable back to customer demand without joining collections.</p></div></div><div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Sales order</th><th>Product</th><th class="text-end">Allocated qty</th><th>Status</th></tr></thead><tbody><template x-for="a in allocations" :key="a.procurementAllocationId"><tr><td><a :href="'/orders/'+a.salesOrderId" x-text="a.orderNumber||'Sales order'"></a></td><td x-text="productName(a.productId)"></td><td class="text-end" x-text="a.quantity"></td><td><span class="crm-status" :class="statusClass(a.status)" x-text="humanize(a.status)"></span></td></tr></template><tr x-show="!allocations.length"><td colspan="4"><div class="crm-empty-state"><strong>Manual / replenishment purchase order</strong><span>No sales-order procurement allocation is linked.</span></div></td></tr></tbody></table></div></div>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Purchase-order actions</h2><p class="text-muted mb-0">Approval, placement and receipt are kept on their dedicated workflow.</p></div></div><div class="card-body d-flex flex-wrap gap-2"><% if (can('procurement.approve')) { %><button x-show="po?.status==='draft'" class="btn btn-primary" @click="approve()">Approve</button><button x-show="po?.status==='approved'" class="btn btn-outline-primary" @click="place()">Mark placed</button><button x-show="['draft','approved','placed'].includes(po?.status)" class="btn btn-outline-danger" @click="cancelPo()">Cancel</button><button x-show="['received','partially_received'].includes(po?.status)" class="btn btn-outline-secondary" @click="closePo()">Close</button><% } %><% if (can('procurement.receive')) { %><a x-show="['approved','placed','partially_received'].includes(po?.status)" class="btn btn-primary" :href="'/procurement/'+poId+'/receive'">Receive / GRN</a><% } %></div></div>
</div></div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function procurementDetailPage(){return{poId:location.pathname.split('/')[2]||'',po:null,warehouse:null,allocations:[],products:[],error:'',async load(){try{const[p,a,w,products]=await Promise.all([apiFetch('/api/procurement/'+this.poId),apiFetch('/api/procurement/allocations?purchaseOrderId='+encodeURIComponent(this.poId)+'&limit=100'),apiFetch('/api/warehouses'),apiFetch('/api/products?limit=100')]);this.po=p.data;this.allocations=a.data.items||[];this.warehouse=(w.data.items||[]).find(x=>x.warehouseId===this.po.warehouseId)||null;this.products=products.data.items||[]}catch(e){this.error=e.message}},productName(id){const p=this.products.find(x=>x.productId===id);return p?p.name+' · '+p.sku:'Product'},async refresh(){this.po=(await apiFetch('/api/procurement/'+this.poId)).data},async approve(){try{await apiFetch('/api/procurement/'+this.poId+'/approve',{method:'POST',body:'{}'});showCrmToast('Purchase order approved');await this.refresh()}catch(e){this.error=e.message}},async place(){try{await apiFetch('/api/procurement/'+this.poId+'/place',{method:'POST',body:'{}'});showCrmToast('Purchase order marked placed');await this.refresh()}catch(e){this.error=e.message}},async cancelPo(){try{await apiFetch('/api/procurement/'+this.poId+'/cancel',{method:'POST',body:JSON.stringify({reason:'Cancelled from purchase-order detail'})});showCrmToast('Purchase order cancelled');await this.refresh()}catch(e){this.error=e.message}},async closePo(){try{await apiFetch('/api/procurement/'+this.poId+'/close',{method:'POST',body:JSON.stringify({reason:'Closed from purchase-order detail'})});showCrmToast('Purchase order closed');await this.refresh()}catch(e){this.error=e.message}}}}</script><%- include('partials/scripts') %>
</body></html>
