<!doctype html>
<html lang="en" dir="ltr"><%- include('partials/head') %>
<body x-data="crmShell()" x-init="initShell()"><%- include('partials/navbar') %>
<div class="page-content"><%- include('partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Administration</div><h1 class="page-title mb-1">Employees</h1><p class="crm-page-subtitle mb-0">Manage B2B employee access, roles and operational ownership.</p></div><% if (can('employees.create')) { %><button class="btn btn-primary crm-primary-action" @click="$dispatch('new-employee')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Add employee</button><% } %></div></div>
<div class="content" x-data="employeesPage()" x-init="load()" @new-employee.window="showForm=true">
<div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
<% if (can('employees.create')) { %>
<div class="card crm-data-card mb-4" x-show="showForm" x-cloak><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Add employee</h2><p class="text-muted mb-0">The employee signs in using the registered mobile number and OTP.</p></div><button class="btn btn-light btn-sm" @click="showForm=false">Close</button></div><div class="card-body"><div class="row g-3">
<div class="col-lg-4"><label class="form-label">Full name</label><input class="form-control" x-model="form.name"></div>
<div class="col-lg-4"><label class="form-label">Mobile</label><input class="form-control" inputmode="numeric" maxlength="10" x-model="form.mobile"></div>
<div class="col-lg-4"><label class="form-label">Email</label><input type="email" class="form-control" x-model="form.email"></div>
<div class="col-md-3"><label class="form-label">Employee code</label><input class="form-control" x-model="form.employeeCode"></div>
<div class="col-md-3"><label class="form-label">Designation</label><input class="form-control" x-model="form.designation"></div>
<div class="col-md-3"><label class="form-label">Department</label><input class="form-control" x-model="form.department"></div>
<div class="col-md-3"><label class="form-label">Role</label><select class="form-select" x-model="form.roleId"><option value="">Select role</option><template x-for="r in roles" :key="r.roleId"><option :value="r.roleId" x-text="r.name"></option></template></select></div>
<div class="col-12"><label class="form-check"><input class="form-check-input" type="checkbox" x-model="form.deliveryEligible"><span class="form-check-label">Available for delivery assignment</span></label><div class="text-muted fs-sm">Enabled employees automatically appear in the internal delivery-person dropdown.</div></div>
</div><div class="text-end mt-3"><button class="btn btn-primary" @click="createEmployee()">Add employee</button></div></div></div>
<% } %>
<div class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">B2B employees</h2><p class="text-muted mb-0">Active operational users and their assigned roles.</p></div><div class="d-flex gap-2"><input class="form-control form-control-sm" placeholder="Search employee" x-model="search" @keyup.enter="searchEmployees()"><button class="btn btn-light btn-sm" @click="searchEmployees()">Search</button></div></div>
<div class="table-responsive"><table class="table crm-table align-middle mb-0"><thead><tr><th>Employee</th><th>Contact</th><th>Department</th><th>Role</th><th>Delivery</th><th>Status</th><th>Last login</th><th class="text-end">Action</th></tr></thead><tbody>
<template x-for="e in employees" :key="e.employeeId"><tr><td><strong x-text="e.name"></strong><div class="text-muted fs-sm" x-text="e.employeeCode||e.employeeId"></div></td><td><span x-text="e.mobile"></span><div class="text-muted fs-sm" x-text="e.email||''"></div></td><td><span x-text="e.department||'—'"></span><div class="text-muted fs-sm" x-text="e.designation||''"></div></td><td x-text="roleName(e.roleId)"></td><td><span class="crm-status" :class="e.deliveryEligible!==false?'status-confirmed':'status-pending'" x-text="e.deliveryEligible!==false?'Available':'Not available'"></span></td><td><span class="crm-status" :class="statusClass(e.status)" x-text="humanize(e.status)"></span></td><td x-text="formatDate(e.lastLoginAt)"></td><td class="text-end crm-table-actions"><% if (can('employees.edit')) { %><button class="btn btn-sm btn-light" @click="toggleDelivery(e)" x-text="e.deliveryEligible!==false?'Remove from delivery':'Enable delivery'"></button><button class="btn btn-sm btn-outline-secondary" @click="requestStatusToggle(e)" x-text="pendingStatusId===e.employeeId?'Confirm '+(e.status==='active'?'deactivate':'activate'):(e.status==='active'?'Deactivate':'Activate')"></button><% } %></td></tr></template>
<tr x-show="!loading && !employees.length"><td colspan="8"><div class="crm-empty-state"><strong>No employees found</strong><span>Add a B2B employee and assign a role.</span></div></td></tr>
</tbody></table></div><%- include('partials/pager') %></div>
</div><%- include('partials/footer') %></div></div></div>
<script nonce="<%= cspNonce %>">function employeesPage(){return{
...crmPager('loadEmployees'),employees:[],roles:[],loading:true,error:'',showForm:false,search:'',pendingStatusId:'',form:{name:'',mobile:'',email:'',employeeCode:'',designation:'',department:'',roleId:'',deliveryEligible:true},
async load(){try{const r=(await apiFetch('/api/roles')).data;this.roles=r.items||[];await this.loadEmployees()}catch(e){this.error=e.message}finally{this.loading=false}},
async loadEmployees(){this.loading=true;try{const q=new URLSearchParams({limit:String(this.pageSize),page:String(this.page)});if(this.search)q.set('search',this.search);const data=(await apiFetch('/api/employees?'+q)).data;this.employees=data.items||[];this.setPageMeta(data)}catch(e){this.error=e.message}finally{this.loading=false}},searchEmployees(){this.resetPage();return this.loadEmployees()},
roleName(id){return this.roles.find(x=>x.roleId===id)?.name||id},
async createEmployee(){if(!this.form.name||!this.form.mobile||!this.form.roleId)return this.error='Name, mobile and role are required.';try{await apiFetch('/api/employees',{method:'POST',body:JSON.stringify(this.form)});showCrmToast('Employee added');this.showForm=false;this.form={name:'',mobile:'',email:'',employeeCode:'',designation:'',department:'',roleId:'',deliveryEligible:true};await this.loadEmployees()}catch(e){this.error=e.message;showCrmToast(e.message,'error')}},
async toggleDelivery(e){try{await apiFetch('/api/employees/'+e.employeeId,{method:'PUT',body:JSON.stringify({deliveryEligible:e.deliveryEligible===false})});showCrmToast('Delivery availability updated');await this.loadEmployees()}catch(err){this.error=err.message;showCrmToast(err.message,'error')}},async requestStatusToggle(e){if(this.pendingStatusId!==e.employeeId){this.pendingStatusId=e.employeeId;return}this.pendingStatusId='';return this.toggleStatus(e)},async toggleStatus(e){const status=e.status==='active'?'inactive':'active';try{await apiFetch('/api/employees/'+e.employeeId,{method:'PUT',body:JSON.stringify({status})});showCrmToast('Employee status updated');await this.loadEmployees()}catch(err){this.error=err.message}}
}}</script><%- include('partials/scripts') %>
</body></html>